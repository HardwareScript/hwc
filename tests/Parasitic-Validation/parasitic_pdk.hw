        ild1:   [material: Silicon_Dioxide, thickness: 360nm, routable: false]
        metal2: [material: Aluminum_Met2,   thickness: 360nm, routable: true]
        ild2:   [material: Silicon_Dioxide, thickness: 360nm, routable: false]
        metal3: [material: Aluminum_Met3,   thickness: 845nm, routable: true]

    via:
        min_diameter: 150nm
        min_annular_ring: 60nm
        min_spacing: 170nm
        shape: SquareContact
        contact_depth: 30%
        material_contact_depths:
            Aluminum_Met1: 30%
            Aluminum_Met2: 30%
            Aluminum_Met3: 30%

