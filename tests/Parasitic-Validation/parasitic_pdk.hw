# parasitic_pdk.hw - SkyWater SKY130 Process Design Kit for Parasitic Validation
# Profiles designed to trigger specific parasitic verification errors
# Calibrated to SkyWater SKY130 (130nm) CMOS foundry specifications
import * from @std/primitives/units
import Aluminum_Met1, Aluminum_Met2, Aluminum_Met3, Aluminum_Met4, Aluminum_Met5 from "./materials"
import Local_Interconnect, Polysilicon, Tungsten, Titanium_Nitride, Titanium_Silicide from "./materials"
import Silicon_Dioxide, Silicon_Nitride, Air from "./materials"
import P_Substrate, N_Well, HV_N_Well, N_Diffusion, P_Diffusion from "./materials"

export Aluminum_Met1
export Aluminum_Met2
export Aluminum_Met3
export Aluminum_Met4
export Aluminum_Met5
export Local_Interconnect
export Polysilicon
export Tungsten
export Titanium_Nitride
export Titanium_Silicide
export Silicon_Dioxide
export Silicon_Nitride
export Air
export P_Substrate
export N_Well
export HV_N_Well
export N_Diffusion
export P_Diffusion

export shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

export bridge Polysilicon to Local_Interconnect:
    interface: Titanium_Nitride
    thickness: 5nm
    fill: Tungsten

export bridge Local_Interconnect to Aluminum_Met1:
    interface: Titanium_Nitride
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum_Met1 to Aluminum_Met2:
    interface: Titanium_Nitride
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum_Met2 to Aluminum_Met3:
    interface: Titanium_Nitride
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum_Met3 to Aluminum_Met4:
    interface: Titanium_Nitride
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum_Met4 to Aluminum_Met5:
    interface: Titanium_Nitride
    thickness: 5nm
    fill: Tungsten

export bridge Polysilicon to Aluminum_Met1:
    interface: Titanium_Nitride
    thickness: 5nm
    fill: Tungsten

export profile EM_Test_Profile:
    technology: "ASIC"
    substrate_net: GND
    
    stackup:
        li1:    [material: Local_Interconnect, thickness: 100nm, routable: true]
        ild0:   [material: Silicon_Dioxide,    thickness: 300nm, routable: false]
        metal1: [material: Aluminum_Met1,      thickness: 360nm, routable: true]
        ild1:   [material: Silicon_Dioxide,    thickness: 360nm, routable: false]
        metal2: [material: Aluminum_Met2,      thickness: 360nm, routable: true]

    via:
        min_diameter: 170nm
        min_annular_ring: 60nm
        min_spacing: 170nm
        shape: SquareContact
        contact_depth: 30%
        material_contact_depths:
            Aluminum_Met1: 30%
            Aluminum_Met2: 30%
            Local_Interconnect: 30%

    trace:
        min_width: 150nm
        min_spacing: 140nm
        edge_clearance: 100nm

    manufacturing:
        track_pitch: 10nm
        copper_thickness: 360nm
        circle_segments: 64

    clearance:
        high_voltage: 500nm
        safety_factor: 1.5

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 20C

    layer:
        min_thickness: 50nm
        allowed_conductors: [Aluminum_Met1, Aluminum_Met2, Local_Interconnect]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        min_segment_length: 100nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

    net_type Power:
        routing_style: auto
        escape_stub: 0nm

