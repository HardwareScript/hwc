        nwell:     [material: N_Well,          thickness: 1um,   routable: false]
        poly:      [material: Polysilicon,     thickness: 200nm, routable: true]
        ild0:      [material: Silicon_Dioxide, thickness: 400nm, routable: false]
        metal1:    [material: Aluminum_Met1,   thickness: 360nm, routable: true]

    via:
        min_diameter: 170nm
        min_annular_ring: 60nm
        min_spacing: 170nm
        shape: SquareContact
        contact_depth: 30%
        material_contact_depths:
            Polysilicon: 30%
            Aluminum_Met1: 30%

    trace:
        min_width: 300nm
        min_spacing: 300nm
        edge_clearance: 150nm

    manufacturing:
        track_pitch: 10nm
        copper_thickness: 360nm
        circle_segments: 64

    clearance:
        high_voltage: 1um
        safety_factor: 2.0

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 20C

    layer:
        min_thickness: 100nm
        allowed_conductors: [Aluminum_Met1, Polysilicon]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        min_segment_length: 300nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

    net_type HighVoltage:
        routing_style: auto
        escape_stub: 0nm

