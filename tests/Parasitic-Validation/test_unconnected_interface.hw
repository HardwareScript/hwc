# test_unconnected_interface.hw (RENAMED from test_forbidden_junction.hw)
# Parasitic Validation Test 4: Unconnected Material Interface Violation (Error P45)
# UPGRADED FOR SKYWATER SKY130 PDK COMPLIANCE
#
# PURPOSE: Verify that the compiler HALTS with Error P45 when conductive materials
# are placed directly together without a required PDK bridge interface
#
# TERMINOLOGY CORRECTION:
# - OLD NAME: "Forbidden Junction" - misleading in semiconductor context
# - NEW NAME: "Unconnected Interface" - accurate for missing metal bridge
# - TRUE "Forbidden Junction" = p-n junction voltage overstress (see test_junction_breakdown.hw)
#
# EXPECTED BEHAVIOR:
# - Attempting to place Aluminum_Met1 directly on Polysilicon without required bridge
# - No bridge definition exists for Aluminum_Met1-to-Polysilicon in this test
# - VIOLATION: Direct contact between incompatible materials → Error P45
#
# The compiler should report:
# "Error P45: Unconnected interface at (coordinates)
#  Cannot place Aluminum_Met1 directly on Polysilicon without bridge interface
#  Required: Define bridge Polysilicon to Aluminum_Met1 with appropriate interface
#  (e.g., Titanium Nitride barrier + Tungsten via plug)"
#
# NOTE: This test intentionally OMITS the bridge definition to trigger P45

import * from @std/primitives/units
import Aluminum_Met1, Polysilicon, Silicon_Dioxide from "./materials"

# Shape definition for via contacts
shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

# Intentionally create a PDK WITHOUT the required bridge definition
# NOTE: We import materials directly but NOT the bridge definitions from parasitic_pdk
profile Unconnected_Interface_Profile:
    technology: "ASIC"
    substrate_net: GND
    
    stackup:
        polyres:    [material: Polysilicon,        thickness: 200nm, routable: true]
        ild0:       [material: Silicon_Dioxide,    thickness: 400nm, routable: false]
        metal1:     [material: Aluminum_Met1,      thickness: 360nm, routable: true]

    via:
        min_diameter: 170nm
        min_enclosure: 60nm
        min_spacing: 170nm
        shape: SquareContact
        contact_depth: 30%
        material_contact_depths:
            Polysilicon: 30%
            Aluminum_Met1: 30%

    trace:
        min_width: 300nm
        min_spacing: 300nm
        edge_clearance: 100nm

    manufacturing:
        track_pitch: 10nm
        copper_thickness: 360nm
        circle_segments: 64

    clearance:
        high_voltage: 500nm
        safety_factor: 1.5

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C

    layer:
        min_thickness: 50nm
        allowed_conductors: [Aluminum_Met1, Polysilicon]
        allowed_dielectrics: [Silicon_Dioxide]

    routing:
        min_segment_length: 300nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

# NOTE: NO bridge Polysilicon to Aluminum_Met1 defined!
# This is the unconnected condition that should trigger Error P45

module UnconnectedInterfaceTest:
    pins: [input In, output Out]
    route In to Out

space Unconnected_Interface_Space implements UnconnectedInterfaceTest:
    dimensions: 8.0um by 5.0um
    profile: Unconnected_Interface_Profile

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out: { classification: signal, potential: 0.0V, current: 1.0uA }

    # ========================================================================
    # POLYSILICON BOTTOM LAYER
    # ========================================================================
    
    # THE ONLY ABSOLUTE ANCHOR
    add pour(Polysilicon) named Bottom_Node on layer: polyres:
        net: In
        dimensions: 1.0um by 1.0um
        at: [x: 2.0um, y: 2.5um]    # ← ONLY absolute 'at:' in this space

    # ========================================================================
    # ALUMINUM TOP LAYER - Direct overlap without bridge
    # ========================================================================
    # This should trigger Error P45 during physical verification
    # Aluminum_Met1 cannot be placed directly on Polysilicon without a bridge
    # (e.g., Titanium Nitride barrier + Tungsten via plug)
    
    add pour(Aluminum_Met1) named Top_Contact on layer: metal1:
        net: In
        dimensions: 800nm by 800nm
        align: center_x with Bottom_Node  # Direct overlap - UNCONNECTED!
        align: center_y with Bottom_Node

    # ========================================================================
    # MISSING VIA - Attempting to connect without proper bridge
    # ========================================================================
    # This via definition would fail because no bridge exists
    # The compiler should detect this during layer stack validation
    # and halt with Error P45 before attempting physical synthesis
    
    # INTENTIONALLY COMMENTED OUT - Even declaring it would fail
    # add contact(???) named Missing_Bridge_Via spanning layer: polyres to metal1:
    #     net: In
    #     diameter: 170nm
    #     plating_thickness: 5nm
    #     align: center_x with Bottom_Node
    #     align: center_y with Bottom_Node
    
    # The mere presence of overlapping Aluminum_Met1 and Polysilicon pours
    # without a defined bridge should trigger P45

    # Output pad for reference - RELATIONAL
    add pour(Aluminum_Met1) named Out_Pad on layer: metal1:
        net: Out
        dimensions: 1.0um by 1.0um
        align: center_x with Bottom_Node.right + 4.0um
        align: center_y with Bottom_Node
