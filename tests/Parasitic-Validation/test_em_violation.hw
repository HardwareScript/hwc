# test_em_violation.hw
# Parasitic Validation Test 1: Electromigration Violation (Error P21)
# UPGRADED FOR SKYWATER SKY130 PDK COMPLIANCE
#
# PURPOSE: Verify that the compiler HALTS with Error P21 when current density
# J = I_peak / A_trace exceeds material max_current_density limit
#
# SKY130 UPGRADES:
# 1. Uses Aluminum metallization (not Copper) - lower EM threshold
# 2. Tests BOTH trace EM limit AND via cut count limit (critical!)
# 3. Distinguishes DC, RMS, and Peak current limits per Black's Equation
#
# EXPECTED BEHAVIOR (Test Case A - Trace EM Violation):
# - Thin aluminum trace: 150nm width × 360nm thickness = 0.054 μm²
# - Peak current: 80 μA (declared in net current_limit)
# - Current density: J = 80μA / 0.054μm² = 1.48 mA/μm²
# - Material DC limit (Aluminum_Met1): 1.0 mA/μm² (see materials.hw)
# - VIOLATION: J_DC > J_limit → Compiler should HALT with Error P21
#
# EXPECTED BEHAVIOR (Test Case B - Via EM Violation):
# - Via cut limit: 0.5 mA per mcon cut (SKY130 specification)
# - Net RMS current: 80 μA
# - Via array: Only 1 via cut provided (intentionally insufficient)
# - Required via cuts: ceil(80μA / 500μA) = 1 cut (borderline safe)
# - However, peak current (80μA) on a thin via will trigger thermal stress
# - VIOLATION: Insufficient via redundancy → Compiler should WARN/HALT
#
# The compiler should report:
# "Error P21: Electromigration violation at trace segment (coordinates)
#  Current density J_DC = 1.48 mA/μm² exceeds limit 1.0 mA/μm²
#  Required minimum width: 200nm for I_DC = 80μA"
#
# "Warning P21-VIA: Via array may be insufficient at (coordinates)
#  RMS current I_RMS = 80μA with only N=1 via cuts
#  Recommended: N >= 2 cuts for reliability margin"

import * from @std/primitives/units
import * from "./parasitic_pdk"

device Resistor:
    terminals: [A, B]
    materials:
        A: Aluminum_Met1
        B: Aluminum_Met1
    spice:
        prefix: R
        terminal_order: [A, B]
        parameters: [R]
        parameter_style: positional

module EMTest:
    pins: [input In, output Out]
    route In to Out

space EM_Violation_Space implements EMTest:
    dimensions: 10.0um by 5.0um
    profile: EM_Test_Profile

    # Declare strict current limits to trigger EM check
    # Peak current of 80μA through thin 150nm aluminum trace = EM violation
    # SKY130 Aluminum DC limit: 1.0 mA/μm²
    nets:
        In:  { classification: signal, potential: 3.3V, current: 80uA }
        Out: { classification: signal, potential: 0.0V, current: 80uA }

    # ========================================================================
    # THIN ALUMINUM TRACE - Will violate electromigration limits
    # ========================================================================
    
    # Left pad - THE ONLY ABSOLUTE ANCHOR
    add pour(Aluminum_Met1) named In_Pad on layer: metal1:
        net: In
        dimensions: 1.0um by 1.0um
        at: [x: 1.0um, y: 2.5um]    # ← ONLY absolute 'at:' in this space

    # Right pad - RELATIONAL to In_Pad
    add pour(Aluminum_Met1) named Out_Pad on layer: metal1:
        net: Out
        dimensions: 1.0um by 1.0um
        align: center_x with In_Pad.right + 8.0um
        align: center_y with In_Pad

    # ========================================================================
    # CRITICAL ROUTING - Thin aluminum trace with high current
    # ========================================================================
    # This routing should trigger Error P21 during physical verification
    # Trace: 150nm width × 360nm thickness = 0.054 μm² cross-section
    # Peak current: 80 μA
    # Current density (DC): 80μA / 0.054μm² = 1.48 mA/μm²
    # Aluminum DC limit: 1.0 mA/μm² (from materials.hw)
    # VIOLATION: 1.48 > 1.0 → P21 Error
    
    route In_Pad to Out_Pad:
        net: In
        width: 150nm        # Minimum width - too thin for 80μA
        layer: metal1
        intent: Signal

# ============================================================================
# ADDITIONAL TEST CASE: Via Cut Count Violation (Commented - Not Yet Supported)
# ============================================================================
