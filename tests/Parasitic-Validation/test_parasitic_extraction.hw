# test_parasitic_extraction.hw
# Parasitic Validation Test: Successful Baseline Parasitic Extraction (100% Relational)
# Verified against SkyWater SKY130 (130nm) BEOL Process Specifications

import * from @std/primitives/units
import * from "./parasitic_pdk"

module ParasiticTest:
    pins: [input In, ground GND]

space Parasitic_Extraction_Space implements ParasiticTest:
    dimensions: 20.0um by 10.0um
    profile: Standard_Profile  # 3 metal layers (metal1, metal2, metal3), 360nm SiO2 ILD

    # Conservative electrical specifications (0.5µA through 500nm Al = 0.0028 mA/μm² << 1.0 mA/μm² EM limit)
    nets:
        In:  { classification: signal, potential: 1.8V, current: 0.5uA }
        GND: { classification: ground, potential: 0.0V, current: 0.0uA }

    # ========================================================================
    # PARAMETRIC CONSTANTS
    # ========================================================================
    
    let pad_size = 2.0um
    let via_pad_size = 800nm         # Symmetrical landing pad for 150nm via
    let via_diameter = 150nm         # SKY130 via1 standard drill size
    let trace_width = 500nm          # 500nm wide trace (DRC min = 500nm)
    let lead_length = 3.0um          # Distance from In_Pad to Via 1
    let bridge_length = 6.0um        # Span of elevated metal2 bridge
    let dummy_spacing = 2.0um        # Spacing to GND dummy trace

    # ========================================================================
    # 1. INPUT & OUTPUT TERMINAL PADS (metal1)
    # ========================================================================
    
    add pour(Aluminum_Met1) named In_Pad on layer: metal1:
        net: In
        dimensions: pad_size by pad_size
        at: [x: 2.0um, y: 5.0um]

    add pour(Aluminum_Met1) named Out_Pad on layer: metal1:
        net: In
        dimensions: pad_size by pad_size
        align: center_x with In_Pad.right + lead_length + bridge_length + lead_length + pad_size / 2
        align: center_y with In_Pad

    # ========================================================================
    # 2. VIA 1 TRANSITION NODE (metal1 pad + metal2 pad + via)
    # ========================================================================
    
    add pour(Aluminum_Met1) named Via1_Pad_M1 on layer: metal1:
        net: In
        dimensions: via_pad_size by via_pad_size
        align: center_x with In_Pad.right + lead_length
        align: center_y with In_Pad

    add pour(Aluminum_Met2) named Via1_Pad_M2 on layer: metal2:
        net: In
        dimensions: via_pad_size by via_pad_size
        align: center_x with Via1_Pad_M1
        align: center_y with Via1_Pad_M1

    add contact(Tungsten) named Via_Up spanning layer: metal1 to metal2:
        net: In
        diameter: via_diameter
        align: center_x with Via1_Pad_M1
        align: center_y with Via1_Pad_M1

    # ========================================================================
    # 3. VIA 2 TRANSITION NODE (metal1 pad + metal2 pad + via)
    # ========================================================================
    
    add pour(Aluminum_Met1) named Via2_Pad_M1 on layer: metal1:
        net: In
        dimensions: via_pad_size by via_pad_size
        align: center_x with Via1_Pad_M1.center_x + bridge_length
        align: center_y with Via1_Pad_M1

    add pour(Aluminum_Met2) named Via2_Pad_M2 on layer: metal2:
        net: In
        dimensions: via_pad_size by via_pad_size
        align: center_x with Via2_Pad_M1
        align: center_y with Via2_Pad_M1

    add contact(Tungsten) named Via_Down spanning layer: metal1 to metal2:
        net: In
        diameter: via_diameter
        align: center_x with Via2_Pad_M1
        align: center_y with Via2_Pad_M1

    # ========================================================================
    # 4. CLEAN SYMMETRICAL ROUTING
    # ========================================================================
    
    # Lead 1: In_Pad to Via 1 Landing Pad (metal1)
    route In_Pad to Via1_Pad_M1:
        net: In
        width: trace_width
        layer: metal1
        intent: Signal

    # Bridge: Via 1 Pad to Via 2 Pad (elevated metal2 overpass)
    route Via1_Pad_M2 to Via2_Pad_M2:
        net: In
        width: trace_width
        layer: metal2
        intent: Signal

    # Lead 2: Via 2 Landing Pad to Out_Pad (metal1)
    route Via2_Pad_M1 to Out_Pad:
        net: In
        width: trace_width
        layer: metal1
        intent: Signal

    # ========================================================================
    # 5. DUMMY TRACE (metal1) FOR CROSSTALK EXTRACTION
    # ========================================================================
    
    add pour(Aluminum_Met1) named Dummy_Trace on layer: metal1:
        net: GND
        dimensions: 14.0um by trace_width
        align: center_x with In_Pad.center_x + 7.0um
        align: center_y with In_Pad.center_y - dummy_spacing

# ============================================================================
# TESTBENCH SPECIFICATION
# ============================================================================
test Parasitic_Extraction_Test for Parasitic_Extraction_Space:
    ac: { sweep: dec, points: 20, freq: 100Hz..100MHz }
    tran: { step: 10ps, stop: 200ns }
