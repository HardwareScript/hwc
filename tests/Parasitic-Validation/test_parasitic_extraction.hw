# test_parasitic_extraction.hw
# Parasitic Validation Test: Successful Parasitic Extraction (Baseline)
# UPGRADED FOR SKYWATER SKY130 PDK COMPLIANCE
#
# PURPOSE: Verify that the compiler SUCCESSFULLY extracts and embeds parasitics
# into SPICE without halting. This test should PASS all checks and demonstrate
# proper annotation in build/*/spice/circuit.sp
#
# SKY130 UPGRADES:
# 1. Uses Aluminum metallization (met1, met2, met3) instead of Copper
# 2. Proper via resistance de-embedding for SKY130 via arrays
# 3. Accounts for multi-layer ILD dielectric stack (SiO2 between layers)
# 4. Models distributed RC networks with substrate coupling
# 5. Via inductance extraction for signal integrity analysis
#
# EXPECTED BEHAVIOR:
# - Wide, well-spaced aluminum traces with generous current limits
# - All parasitic checks pass (no P21, P22, or crosstalk violations)
# - Compiler extracts R, C, L parasitics and embeds in SPICE with proper de-embedding
# - Check build/Parasitic_Extraction_Space/spice/circuit.sp for:
#   * RRtr_segment (trace resistance per segment)
#   * RRvia_array (via array resistance = R_single_via / N_cuts)
#   * CCgnd (ground capacitance to substrate/reference plane)
#   * CCcoupling (lateral coupling capacitance between traces)
#   * LLvia (via inductance for high-frequency analysis)
# - Build completes successfully with parasitic annotations
#
# SKY130-SPECIFIC PARASITIC EXTRACTION:
# 
# 1. Trace Resistance (per segment):
#    R_trace = ρ × L / (W × t)
#    For Aluminum met1: ρ = 2.82e-8 Ω·m, t = 360nm
#    For 500nm wide × 5μm long trace: R ≈ 0.78 Ω
#
# 2. Via Resistance (with array de-embedding):
#    R_via_single ≈ 362 mΩ (SKY130 via1 standard resistance)
#    For 3-cut via array: R_via_array = 362mΩ / 3 ≈ 120.6 mΩ
#    OLD BUG: Lumped trace resistance without via de-embedding
#    NEW: Separate R_via elements in netlist
#
# 3. Ground Capacitance:
#    C_gnd = ε0 × εr × (W × L) / t_dielectric
#    For SiO2 (εr=3.9), 500nm wide × 5μm long, 360nm ILD:
#    C_gnd ≈ 0.24 fF
#
# 4. Coupling Capacitance (lateral):
#    C_couple = ε0 × εr × (H × L) / S
#    where H = trace height, L = parallel length, S = spacing
#
# 5. Via Inductance (parasitic):
#    L_via ≈ μ0 × h / (2π) × ln(4h/d)
#    For SKY130 via1: h = 360nm, d = 150nm
#    L_via ≈ 0.1 pH (negligible below 10 GHz)
#
# VERIFICATION STEPS:
# 1. Run: hwc build test_parasitic_extraction.hw
# 2. Expect: Successful build (no errors)
# 3. Inspect: build/Parasitic_Extraction_Space/spice/circuit.sp
# 4. Look for: Extracted parasitic elements with proper via de-embedding
# 5. Open in hsm: Interactive visual probing and waveform analysis

import * from @std/primitives/units
import * from "./parasitic_pdk"

module ParasiticTest:
    pins: [input In, output Out]
    route In to Out

space Parasitic_Extraction_Space implements ParasiticTest:
    dimensions: 20.0um by 10.0um by 2um
    profile: Standard_Profile  # Generous limits, should pass all checks

    # Conservative current limits - well within safe operating region  
    # 0.5μA through 500nm wide aluminum = 0.0028 mA/μm² (well below 1.0 mA/μm² limit)
    nets:
        In:  { classification: signal, potential: 1.8V, current: 0.5uA }
        Out: { classification: signal, potential: 0.0V, current: 0.5uA }

    # ========================================================================
    # PARAMETRIC DIMENSIONS (Self-Healing Layout)
    # ========================================================================
    
    let pad_size = 2.0um
    let via_diameter = 150nm         # SKY130 via1 standard size
    let trace_width = 500nm          # Wide trace - safe for EM
    let dummy_trace_offset = 2.0um   # Offset for crosstalk test

    # ========================================================================
    # 1. THE ONLY ABSOLUTE ANCHOR: Input Pad
    # All other geometry derives from this single root anchor
    # ========================================================================
    
    add pour(Aluminum_Met1) named In_Pad on layer: metal1:
        net: In
        dimensions: pad_size by pad_size
        at: [x: 2.0um, y: 5.0um]    # ← The ONE AND ONLY 'at:' in the entire file!

    # ========================================================================
    # 2. RELATIONAL INTERMEDIATE NODE (Demonstrates Via Inductance)
    # Positioned relative to In_Pad with parametric offset
    # ========================================================================
    
    add pour(Aluminum_Met2) named Mid_Node on layer: metal2:
        net: In
        dimensions: pad_size by pad_size
        align: center_x with In_Pad.center_x + 8.0um
        align: center_y with In_Pad

    # ========================================================================
    # 3. RELATIONAL OUTPUT PAD
    # Positioned relative to Mid_Node
    # ========================================================================
    
    add pour(Aluminum_Met1) named Out_Pad on layer: metal1:
        net: Out
        dimensions: pad_size by pad_size
        align: center_x with Mid_Node.center_x + 8.0um
        align: center_y with Mid_Node

    # ========================================================================
    # 4. RELATIONAL VIA CONNECTIONS (Should Extract Via Resistance + Inductance)
    # ========================================================================
    # SKY130 via1: 150nm × 150nm, single cut resistance ≈ 362 mΩ
    # Using 3-cut array: R_via_array = 362mΩ / 3 ≈ 120.6 mΩ
    
    # Via connecting metal1 to metal2 (via1 type)
    # Should extract:
    # - Via resistance: R_via1 = 120.6 mΩ (de-embedded from trace R)
    # - Via inductance: L_via1 ≈ 0.1 pH (negligible at low freq)
    add contact(Tungsten) named Via_Up spanning layer: metal1 to metal2:
        net: In
        diameter: via_diameter
        align: center_x with In_Pad
        align: center_y with In_Pad

    # Via connecting metal2 back to metal1
    add contact(Tungsten) named Via_Down spanning layer: metal2 to metal1:
        net: In
        diameter: via_diameter
        align: center_x with Mid_Node
        align: center_y with Mid_Node

    # ========================================================================
    # 5. RELATIONAL ROUTING - Should Extract Trace R and Coupling C
    # ========================================================================
    
    # Route segment 1: In_Pad to Via_Up (metal1)
    # Should extract:
    # - RRtr_In_0: Trace resistance (aluminum met1, ρ=2.82e-8, W=500nm, t=360nm)
    # - CCgnd_In_0: Ground capacitance (SiO2 εr=3.9, to substrate reference)
    route In_Pad to Via_Up:
        net: In
        width: trace_width
        layer: metal1
        intent: Signal

    # Route segment 2: Mid_Node to Via_Down (metal2)
    # Should extract:
    # - RRtr_In_1: Trace resistance (aluminum met2, same properties as met1)
    # - CCgnd_In_1: Ground capacitance
    # - CCcoupling_In_Dummy: Lateral coupling to dummy trace (if parallel)
    route Mid_Node to Via_Down:
        net: In
        width: trace_width
        layer: metal2
        intent: Signal

    # Route segment 3: Via_Down to Out_Pad (metal1)
    # Should extract:
    # - RRtr_Out_0: Trace resistance
    # - CCgnd_Out_0: Ground capacitance
    route Via_Down to Out_Pad:
        net: Out
        width: trace_width
        layer: metal1
        intent: Signal

    # ========================================================================
    # 6. RELATIONAL DUMMY TRACE FOR CROSSTALK TESTING
    # Creates coupling capacitance test by placing parallel trace
    # ========================================================================
    
    add pour(Aluminum_Met1) named Dummy_Trace on layer: metal1:
        dimensions: 10.0um by trace_width
        align: center_x with In_Pad.center_x + 5.0um
        align: center_y with In_Pad.center_y - dummy_trace_offset

# ============================================================================
# EXPECTED SPICE OUTPUT (in circuit.sp) - SKY130 COMPLIANT:
# ============================================================================
# * INTEGRATED TRACE PARASITICS (with proper via de-embedding)
# 
# * Trace resistances (aluminum met1/met2, sheet R = 0.125 Ω/□)
# RRtr_In_0 nIn_entry In 7.840000e-1      * Met1 trace: 5μm / (500nm × 360nm)
# RRtr_In_1 In nVia_Up 7.840000e-1        * Met2 trace (same geometry)
# RRtr_Out_0 nVia_Down Out 7.840000e-1    * Met1 trace
# 
# * Via array resistances (SKY130 via1: 362mΩ per cut, 3-cut array = 120.6mΩ)
# RRvia_Up nVia_Up Mid_Node 1.206000e-1   * Via array (de-embedded!)
# RRvia_Down Mid_Node nOut_entry 1.206000e-1
# 
# * Ground capacitances (SiO2 εr=3.9, met1-to-substrate)
# CCgnd_In_0 In GND 2.400000e-16          * 500nm × 5μm over 360nm ILD
# CCgnd_In_1 Mid_Node GND 2.400000e-16
# CCgnd_Out_0 Out GND 2.400000e-16
# 
# * Coupling capacitance (lateral, to dummy trace if parallel)
# CCcoupling_In_Dummy In Dummy_Trace 8.500000e-17  * Lateral fringe cap
# 
# * Via inductance (parasitic, negligible below 10 GHz)
# LLvia_Up nVia_Up Mid_Node 1.000000e-13  * ~0.1 pH
# LLvia_Down Mid_Node nOut_entry 1.000000e-13
#
# NOTE: Via resistance is NOW PROPERLY DE-EMBEDDED from trace resistance!
# OLD BUG: Lumped everything into RRtr with inflated value (0.65Ω + 0.12Ω = 0.77Ω)
# NEW: Separate RRtr (0.78Ω) and RRvia (0.12Ω) elements for accurate modeling

# ============================================================================
# TEST DEFINITION: AC & TRANSIENT ANALYSIS
# ============================================================================
# v0.2.1 Zero-Fallback Compliance: Explicit testbench configuration required
test Parasitic_Extraction_Test for Parasitic_Extraction_Space:
    ac: { sweep: dec, points: 20, freq: 100Hz..100MHz }
    tran: { step: 10ps, stop: 200ns }
