# test_forbidden_junction.hw
# Parasitic Validation Test 5: Forbidden Junction Violation (Error P45)
#
# PURPOSE: Verify that the compiler HALTS with Error P45 when conductive materials
# are placed directly together without a required PDK bridge interface
#
# EXPECTED BEHAVIOR:
# - Attempting to place Copper directly on Polysilicon without required bridge
# - No bridge definition exists for Copper-to-Polysilicon in this test
# - VIOLATION: Direct contact between incompatible materials → Error P45
#
# The compiler should report:
# "Error P45: Forbidden junction at (coordinates)
#  Cannot place Copper directly on Polysilicon without bridge interface
#  Required: Define bridge Polysilicon to Copper with appropriate interface material
#  (e.g., Titanium Silicide)"
#
# NOTE: This test intentionally OMITS the bridge definition to trigger P45

import * from @std/primitives/units
import Copper, Polysilicon, Silicon_Dioxide, Air from "./materials"

# Intentionally create a PDK WITHOUT the required bridge definition
profile Forbidden_Junction_Profile:
    technology: "ASIC"
    
    stackup:
        polyres:    [material: Polysilicon,     thickness: 100nm, routable: true]
        d1:         [material: Silicon_Dioxide, thickness: 200nm, routable: false]
        metal1:     [material: Copper,          thickness: 200nm, routable: true]

    via:
        min_diameter: 200nm
        min_annular_ring: 50nm
        min_spacing: 300nm
        contact_depth: 50nm

    trace:
        min_width: 300nm
        min_spacing: 300nm
        edge_clearance: 100nm

    manufacturing:
        copper_thickness: 200nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm

    clearance:
        high_voltage: 500nm
        safety_factor: 1.5

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 50nm
        allowed_conductors: [Copper, Polysilicon]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        max_local_route_length: 50um
        min_segment_length: 300nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

# NOTE: NO bridge Polysilicon to Copper defined!
# This is the forbidden condition that should trigger Error P45

module ForbiddenJunctionTest:
    pins: [input In, output Out]
    route In to Out

space Forbidden_Junction_Space implements ForbiddenJunctionTest:
    dimensions: 8.0um by 5.0um by 500nm
    resolution: 10nm
    origin: bl by b
    profile: Forbidden_Junction_Profile

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out: { classification: signal, potential: 0.0V, current: 1.0uA }

    # ========================================================================
    # POLYSILICON BOTTOM LAYER
    # ========================================================================
    
    add pour(Polysilicon) named Bottom_Node on layer: polyres:
        net: In
        dimensions: 1.0um by 1.0um
        at: [x: 2.0um, y: 2.5um]

    # ========================================================================
    # COPPER TOP LAYER - Direct overlap without bridge
    # ========================================================================
    # This should trigger Error P45 during physical verification
    # Copper cannot be placed directly on Polysilicon without a bridge
    # (e.g., Titanium Silicide interface layer)
    
    add pour(Copper) named Top_Contact on layer: metal1:
        net: In
        dimensions: 800nm by 800nm
        align: center with Bottom_Node  # Direct overlap - FORBIDDEN!

    # ========================================================================
    # FORBIDDEN VIA - Attempting to connect without proper bridge
    # ========================================================================
    # This via definition will fail because no bridge exists
    # The compiler should detect this during layer stack validation
    # and halt with Error P45 before attempting physical synthesis
    
    # INTENTIONALLY COMMENTED OUT - Even declaring it would fail
    # add contact(???) named Forbidden_Via spanning layer: polyres to metal1:
    #     net: In
    #     diameter: 200nm
    #     plating_thickness: 5nm
    #     align: center with Bottom_Node
    
    # The mere presence of overlapping Copper and Polysilicon pours
    # without a defined bridge should trigger P45

    # Output pad for reference
    add pour(Copper) named Out_Pad on layer: metal1:
        net: Out
        dimensions: 1.0um by 1.0um
        at: [x: 6.0um, y: 2.5um]
