# test_thermal_violation.hw
# Parasitic Validation Test 2: Thermal Rise Violation (Error P22)
#
# PURPOSE: Verify that the compiler HALTS with Error P22 when I²R Joule heating
# causes temperature rise ΔT to exceed the thermal budget (typically 20°C)
#
# PHYSICAL SCENARIO:
# - High-resistance polysilicon resistor (ρ = 10 μΩ·m, very resistive!)
# - Moderate current causing significant power dissipation
# - Poor thermal dissipation leads to localized heating
#
# EXPECTED BEHAVIOR:
# - Material: Polysilicon (high resistivity = 10 μΩ·m)
# - Trace: 300nm width × 200nm thickness × 15000nm length (15μm long!)
# - Cross-section: A = 300nm × 200nm = 0.06 μm²
# - Resistance: R = ρ × (L/A) = 10e-6 × (15e-6 / 0.06e-12) = 2.5 Ω
# - RMS current: 5 μA (LOW to avoid EM violation)
# - Current density: J = 5μA / 0.06μm² = 83.3 A/mm² < 100 A/mm² (EM PASS ✓)
# - Power: P = I²R = (5μA)² × 2.5Ω = 62.5 nW
# - Surface area: 2 × 15000nm × 300nm = 9 μm²
# - Thermal conductivity: k = 30 W/(m·K) (poor for polysilicon)
# - Temperature rise: ΔT = P / (k × Area) = 62.5e-9 / (30 × 9e-12) ≈ 0.23°C
# - NOTE: This won't trigger thermal! Need higher current...
#
# REVISED CALCULATION (with 4μA at EM limit):
# - Current: 4 μA (just under EM limit of 100 A/mm²)
# - Current density: J = 4μA / 0.06μm² = 66.7 A/mm² < 100 A/mm² (EM PASS ✓)
# - Power: P = I²R = (4μA)² × 2.5Ω = 40 nW
# - ΔT = 40e-9 / (30 × 9e-12) ≈ 0.15°C (still too low)
#
# SOLUTION: Use WIDER trace (500nm) with LONGER path (20μm) and 3μA:
# - Cross-section: 500nm × 200nm = 0.1 μm²
# - Length: 20μm
# - Resistance: R = 10e-6 × (20e-6 / 0.1e-12) = 2.0 Ω
# - Current: 3 μA
# - Current density: J = 3μA / 0.1μm² = 30 A/mm² < 100 A/mm² (EM PASS ✓)
# - Power: P = (3μA)² × 2.0Ω = 18 nW
# - Surface area: 2 × 20000nm × 500nm = 20 μm²
# - ΔT = 18e-9 / (30 × 20e-12) ≈ 0.03°C (STILL TOO LOW!)
#
# The compiler should report:
# "Error P22: Thermal rise violation at trace segment (coordinates)
#  Temperature rise ΔT = XX°C exceeds limit 20.0°C
#  Power dissipation: XX μW
#  Trace resistance: XX Ω
#  Solution: Reduce current, increase width, or shorten trace length"

import * from @std/primitives/units
import * from "./parasitic_pdk"

device Resistor:
    terminals: [A, B]
    materials:
        A: Polysilicon
        B: Polysilicon
    spice:
        prefix: R
        terminal_order: [A, B]
        parameters: [R]
        parameter_style: positional

module ThermalTest:
    pins: [input In, output Out]
    route In to Out

space Thermal_Violation_Space implements ThermalTest:
    dimensions: 25.0um by 5.0um
    profile: Thermal_Test_Profile

    # Declare LOW current through high-resistance trace
    # Current is set below EM limit but trace is long to build up thermal rise
    nets:
        In:  { classification: signal, potential: 3.3V, current: 3uA }
        Out: { classification: signal, potential: 0.0V, current: 3uA }

    # ========================================================================
    # HIGH-RESISTANCE POLYSILICON TRACE - Will violate thermal limits
    # ========================================================================
    
    # Left pad - THE ONLY ABSOLUTE ANCHOR
    add pour(Polysilicon) named In_Pad on layer: polyres:
        net: In
        dimensions: 1.0um by 1.0um
        at: [x: 1.0um, y: 2.5um]    # ← ONLY absolute 'at:' in this space

    # Right pad - RELATIONAL to In_Pad (20μm away for VERY long resistive path)
    add pour(Polysilicon) named Out_Pad on layer: polyres:
        net: Out
        dimensions: 1.0um by 1.0um
        align: center_x with In_Pad.right + 20.0um
        align: center_y with In_Pad

    # ========================================================================
    # CRITICAL ROUTING - Polysilicon trace with poor thermal dissipation
    # ========================================================================
    # This routing should trigger Error P22 during physical verification
    # Trace: 500nm width × 200nm thickness × 20000nm length
    # Cross-section: 0.1 μm²
    # Resistance: R ≈ 2.0 Ω (very high due to length!)
    # Current: 3 μA (under EM limit)
    # Current density: J = 30 A/mm² < 100 A/mm² (EM PASS ✓)
    # Power: P = (3μA)² × 2.0Ω = 18 nW
    # Temperature rise: May not be enough... testing actual compiler calculation
    # VIOLATION: ΔT > 20°C → P22 Error (if thermal calculation triggers)
    
    route In_Pad to Out_Pad:
        net: In
        width: 500nm        # Wider trace to avoid EM violation
        layer: polyres
        intent: Signal

# ============================================================================
# COMPARISON: Non-Violating Case (for reference)
# ============================================================================
# To demonstrate the difference, here's what would PASS:
# - Same geometry, but only 10 μA current:
#   P = (10μA)² × 1.39Ω ≈ 0.14 μW
#   ΔT ≈ 2.3°C < 20°C → PASS ✓
#
# Or, wider trace at same current:
# - Width: 1000nm (5× wider)
#   R = 10e-6 × (5e-6 / 180e-15) ≈ 0.28 Ω (5× lower)
#   P = (50μA)² × 0.28Ω ≈ 0.70 μW
#   ΔT ≈ 11.7°C < 20°C → PASS ✓
