# test_thermal_violation.hw
# Parasitic Validation Test 2: Thermal Rise Violation (Error P22)
#
# PURPOSE: Verify that the compiler HALTS with Error P22 when I²R Joule heating
# causes temperature rise ΔT to exceed the thermal budget (typically 20°C)
#
# PHYSICAL SCENARIO:
# - High-resistance polysilicon resistor (ρ = 10 μΩ·m, very resistive!)
# - Moderate current causing significant power dissipation
# - Poor thermal dissipation leads to localized heating
#
# EXPECTED BEHAVIOR:
# - Material: Polysilicon (high resistivity = 10 μΩ·m)
# - Trace: 200nm width × 180nm thickness × 5000nm length
# - Cross-section: A = 200nm × 180nm = 0.036 μm²
# - Resistance: R = ρ × (L/A) = 10e-6 × (5e-6 / 36e-15) ≈ 1.39 Ω
# - RMS current: 50 μA
# - Power: P = I²R = (50μA)² × 1.39Ω ≈ 3.47 μW
# - Surface area: 2 × 5000nm × 200nm = 2 μm²
# - Thermal conductivity: k = 30 W/(m·K) (poor for polysilicon)
# - Temperature rise: ΔT = P / (k × Area) = 3.47e-6 / (30 × 2e-12) ≈ 57.8°C
# - Thermal limit: 20°C (default JEDEC standard)
# - VIOLATION: ΔT = 57.8°C > 20°C → Compiler should HALT with Error P22
#
# The compiler should report:
# "Error P22: Thermal rise violation at trace segment (coordinates)
#  Temperature rise ΔT = 57.8°C exceeds limit 20.0°C
#  Power dissipation: 3.47 μW
#  Trace resistance: 1.39 Ω
#  Solution: Reduce current, increase width, or shorten trace length"

import * from @std/primitives/units
import * from "./parasitic_pdk"

device Resistor:
    terminals: [A, B]
    materials:
        A: Polysilicon
        B: Polysilicon
    spice:
        prefix: R
        terminal_order: [A, B]
        parameters: [R]
        parameter_style: positional

module ThermalTest:
    pins: [input In, output Out]
    route In to Out

space Thermal_Violation_Space implements ThermalTest:
    dimensions: 10.0um by 5.0um
    profile: Thermal_Test_Profile

    # Declare moderate current through high-resistance trace
    # This will cause significant I²R heating
    nets:
        In:  { classification: signal, potential: 3.3V, current: 50uA }
        Out: { classification: signal, potential: 0.0V, current: 50uA }

    # ========================================================================
    # HIGH-RESISTANCE POLYSILICON TRACE - Will violate thermal limits
    # ========================================================================
    
    # Left pad
    add pour(Polysilicon) named In_Pad on layer: poly:
        net: In
        dimensions: 1.0um by 1.0um
        at: [x: 1.0um, y: 2.5um]

    # Right pad - 5μm away (long resistive path)
    add pour(Polysilicon) named Out_Pad on layer: poly:
        net: Out
        dimensions: 1.0um by 1.0um
        align: center_x with In_Pad.right + 5.0um
        align: center_y with In_Pad

    # ========================================================================
    # CRITICAL ROUTING - Polysilicon trace with poor thermal dissipation
    # ========================================================================
    # This routing should trigger Error P22 during physical verification
    # Trace: 200nm width × 180nm thickness × 5000nm length
    # Resistance: R ≈ 1.39 Ω (high!)
    # Power: P = (50μA)² × 1.39Ω ≈ 3.47 μW
    # Temperature rise: ΔT ≈ 57.8°C (exceeds 20°C limit)
    # VIOLATION: ΔT > 20°C → P22 Error
    
    route In_Pad to Out_Pad:
        net: In
        width: 200nm        # Narrow trace = high resistance
        layer: poly
        intent: Signal

# ============================================================================
# COMPARISON: Non-Violating Case (for reference)
# ============================================================================
# To demonstrate the difference, here's what would PASS:
# - Same geometry, but only 10 μA current:
#   P = (10μA)² × 1.39Ω ≈ 0.14 μW
#   ΔT ≈ 2.3°C < 20°C → PASS ✓
#
# Or, wider trace at same current:
# - Width: 1000nm (5× wider)
#   R = 10e-6 × (5e-6 / 180e-15) ≈ 0.28 Ω (5× lower)
#   P = (50μA)² × 0.28Ω ≈ 0.70 μW
#   ΔT ≈ 11.7°C < 20°C → PASS ✓
