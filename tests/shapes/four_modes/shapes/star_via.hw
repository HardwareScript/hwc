import * from @std/primitives/units

shape StarVia(width: Measurement):
    points:
        - [x: width / 2, y: 0nm]
        - [x: width * 0.177, y: width * 0.177]
        - [x: 0nm, y: width / 2]
        - [x: -(width * 0.177), y: width * 0.177]
        - [x: -(width / 2), y: 0nm]
        - [x: -(width * 0.177), y: -(width * 0.177)]
        - [x: 0nm, y: -(width / 2)]
        - [x: width * 0.177, y: -(width * 0.177)]
