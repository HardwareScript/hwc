# Material 4: Semi-Transparent Yellow
material YellowBox:
    category: insulator
    properties:
        resistivity: 1e16Ω·m
        thermal_conductivity: 1.4W/(m·K)
        density: 2200kg/m³
        melting_point: 1713C
        max_current_density: 0A/mm²
        color: "#FFFF00"
        opacity: 0.5
        roughness: 0.1
        metallic: 0.0

