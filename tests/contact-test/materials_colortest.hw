# Color Test Materials - Five Distinct Colors with Different Opacity
# Purpose: Verify OBJ/MTL export system renders colors and transparency correctly

# Material 1: Solid Red (Opaque)
material RedBox:
    category: conductor
    properties:
        resistivity: 1e-6Ω·m
        thermal_conductivity: 400W/(m·K)
        density: 8960kg/m³
        melting_point: 1085C
        max_current_density: 100A/mm²
        color: "#FF0000"
        opacity: 1.0
        roughness: 0.3
        metallic: 0.8

