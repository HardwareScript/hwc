# thick_layer_pdk.hw
# PDK with THICK layers (1um each) and large spacing for clear 3D visualization
# Designed specifically for testing Z-axis stacking and relational constraints

import * from @std/primitives/units
import Silicon_N, Silicon_P, Polysilicon, Aluminum, Tungsten, Titanium_Silicide, Air from "./materials"

export Silicon_N
export Silicon_P
export Aluminum
export Polysilicon
export Tungsten
export Titanium_Silicide
export Air

# Square contact shape for vias
export shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

# Bridges for ohmic contacts
export bridge Silicon_N to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Silicon_P to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Polysilicon to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

# Bridge between metal layers (via)
export bridge Aluminum to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

# Bridges for Tungsten to other metals (v0.2.1: checkerboard test)
export bridge Tungsten to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum to Tungsten:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Tungsten to Tungsten:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

# ============================================================================
# SOLID STACK PROFILE - NO GAPS (For Perfect Pyramid Stacking)
# Each layer is 1um thick with ZERO spacing between layers
# ============================================================================
export profile Thick_3D_Stack:
    technology: "ASIC"
    
    stackup:
        # Layer 0: Active silicon (0-1000nm)
        active:  [material: Silicon_N, thickness: 1000nm, routable: false]
        
        # Layer 1: Metal1 (1000-2000nm) - starts immediately after active
        metal1:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 2: Metal2 (2000-3000nm) - starts immediately after metal1
        metal2:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 3: Metal3 (3000-4000nm)
        metal3:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 4: Metal4 (4000-5000nm)
        metal4:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 5: Metal5 (5000-6000nm)
        metal5:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 6: Metal6 (6000-7000nm)
        metal6:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 7: Metal7 (7000-8000nm)
        metal7:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 8: Metal8 (8000-9000nm)
        metal8:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 9: Metal9 (9000-10000nm)
        metal9:  [material: Aluminum, thickness: 1000nm, routable: true]
        
        # Layer 10: Metal10 (10000-11000nm)
        metal10: [material: Aluminum, thickness: 1000nm, routable: true]

    via:
        min_diameter: 200nm
        min_enclosure: 0nm
        min_spacing: 300nm
        shape: SquareContact
        contact_depth: 100nm

    trace:
        min_width: 200nm
        min_spacing: 0nm
        edge_clearance: 50um

    manufacturing:
        copper_thickness: 1000nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm

    clearance:
        high_voltage: 500nm
        safety_factor: 2.0

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 50nm
        allowed_conductors: [Aluminum, Polysilicon, Silicon_N, Silicon_P]
        allowed_dielectrics: [Air]

    routing:
        max_local_route_length: 10um
        min_segment_length: 200nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000
        net_priority_VDD: 5
        net_priority_GND: 5

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

    net_type PowerRail:
        routing_style: auto
        escape_stub: 0nm
