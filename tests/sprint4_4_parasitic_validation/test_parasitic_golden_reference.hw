## ============================================================================
## Sprint 4.4: Parasitic Extraction Validation - Golden Reference Test
## ============================================================================
##
## This test validates parasitic extraction accuracy against known geometric values.
##
## Test Geometry:
## - Source: 10um × 5um rectangle = 50um² = 5.0e-11 m²
## - Drain:  10um × 5um rectangle = 50um² = 5.0e-11 m²
## - Source Perimeter: 2×(10um + 5um) = 30um = 3.0e-5 m
## - Drain Perimeter:  2×(10um + 5um) = 30um = 3.0e-5 m
##
## Expected Values (with 1% tolerance):
## - AS = 5.0e-11 m² ± 1%
## - AD = 5.0e-11 m² ± 1%
## - PS = 3.0e-5 m ± 1%
## - PD = 3.0e-5 m ± 1%

import * from @std/primitives/units

## ============================================================================
## Logical Schematic (Module)
## ============================================================================

module GoldenReferenceTest:
    pins: [
        input VIN,
        output VOUT,
        ground GND
    ]
    
    add NMOS named M1
    route M1.gate to VIN
    route M1.source to GND
    route M1.drain to VOUT
    route M1.bulk to GND

## ============================================================================
## Physical Layout (Space)
## ============================================================================

space GoldenReferenceLayout implements GoldenReferenceTest:
    dimensions: 100um by 100um by 1mm
    grid: 100 by 100 by 10
    
    net_classifications:
        GND: ground
        VIN: signal
        VOUT: signal
    
    ## Gate: 10um × 10um (W=L=10um for simplicity)
    add pour(Polysilicon) named M1_Gate on z:5:
        device: M1.gate
        net: VIN
        boundary: [x: 10um, y: 10um] to [x: 20um, y: 20um]
    
    ## Source: 10um × 5um = 50um² area
    add pour(Silicon_N) named M1_Source on z:3:
        device: M1.source
        net: GND
        boundary: [x: 10um, y: 5um] to [x: 20um, y: 10um]
    
    ## Drain: 10um × 5um = 50um² area
    add pour(Silicon_N) named M1_Drain on z:3:
        device: M1.drain
        net: VOUT
        boundary: [x: 10um, y: 20um] to [x: 20um, y: 25um]
    
    ## Bulk: P-type substrate (non-overlapping with source/drain)
    add pour(Silicon_P) named M1_Bulk on z:3:
        device: M1.bulk
        net: GND
        boundary: [x: 25um, y: 10um] to [x: 35um, y: 20um]
