# error_circular_dependency_test.hw
# v0.2.1 Test: ERROR CASE - Circular Dependency Detection (Should FAIL)
# 
# This test should FAIL with error C35: Circular spatial dependency detected
# 
# Demonstrates:
# 1. Pad_A references Pad_B.right
# 2. Pad_B references Pad_A.left
# 3. Creates circular dependency: A → B → A (cycle detected)
# 4. Compiler should reject this during DAG validation
# 
# Expected result: COMPILATION ERROR C35

import * from @std/primitives/units

# Minimal inline material definition
material Copper:
    category: conductor
    symbol: "Cu"
    process: deposited
    properties:
        color: "#FF8040"
        metallic: 0.9
        roughness: 0.2
        resistivity: 1.68e-8ohm_m
        thermal_conductivity: 401.0W_mK
        max_current_density: 1e10A_m2

# Minimal inline shape
shape SquareCube(size: Measurement):
    geometry:
        Rectangle(width: size, height: size)

# Minimal inline shape
shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

# Minimal inline profile
profile Minimal_Test_Profile:
    technology: "ASIC"
    stackup:
        active: [material: Copper, thickness: 1000nm, routable: false]
        metal1: [material: Copper, thickness: 1000nm, routable: true]
    via:
        min_diameter: 200nm
        min_annular_ring: 0nm
        min_spacing: 300nm
        shape: SquareContact
        contact_depth: 100nm
    trace:
        min_width: 200nm
        min_spacing: 0nm
        edge_clearance: 50um
    manufacturing:
        copper_thickness: 1000nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm
    clearance:
        high_voltage: 500nm
        safety_factor: 2.0
    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um
    layer:
        min_thickness: 50nm
        allowed_conductors: [Copper]
        allowed_dielectrics: []
    routing:
        max_local_route_length: 10um
        min_segment_length: 200nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000
        net_priority_VDD: 5
        net_priority_GND: 5
    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

space Circular_Dep_Test:
    dimensions: 50um by 50um by 10um
    resolution: 10nm
    origin: bl by b
    profile: Minimal_Test_Profile
    
    nets:
        TEST: { classification: signal }
    
    # ❌ ERROR: Circular dependency A → B → A
    # This should fail with C22: Circular Dependency Detected
    
    # Pad_A depends on Pad_B
    add plane(Copper) named Pad_A on layer: metal1:
        shape: SquareCube(size: 5um)
        at: [
            x: Pad_B.right + 10um,
            y: 25um
        ]
        net: TEST
    
    # Pad_B depends on Pad_A
    add plane(Copper) named Pad_B on layer: metal1:
        shape: SquareCube(size: 5um)
        at: [
            x: Pad_A.left - 10um,
            y: 25um
        ]
        net: TEST
