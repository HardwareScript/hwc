# materials.hw
import * from @std/primitives/units

export material Silicon_N:
    category: semiconductor
    symbol: "Si_N"
    process: deposited
    properties:
        color: "#809080"  # Greenish
        metallic: 0.1
        roughness: 0.7
        resistivity: 0.5ohm_m

export material Silicon_P:
    category: semiconductor
    symbol: "Si_P"
    process: deposited
    properties:
        color: "#C08080"  # Reddish
        metallic: 0.1
        roughness: 0.7
        resistivity: 0.5ohm_m

export material Polysilicon:
    category: conductor
    symbol: "Poly"
    process: deposited
    properties:
        color: "#FF6060"  # Red
        metallic: 0.3
        roughness: 0.8
        resistivity: 1e-4ohm_m
        thermal_conductivity: 30.0W_mK
        max_current_density: 1e9A_m2

export material Aluminum:
    category: conductor
    symbol: "Al"
    process: deposited
    properties:
        color: "#C0C0C0"  # Silver
        metallic: 0.8
        roughness: 0.2
        resistivity: 2.82e-8ohm_m
        thermal_conductivity: 237.0W_mK
        max_current_density: 1e9A_m2

