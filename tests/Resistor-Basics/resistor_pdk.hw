# resistor_pdk.hw - SkyWater SKY130 Resistor PDK Configuration (v0.3.0)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 350 Ohm/sq)
#
# This file now only contains the profile (stackup) definition and device model.
# The PCell generator has been moved to @std/pdk/sky130/resistor where it belongs.

import * from @std/primitives/units
import {
    Polysilicon,
    Aluminum,
    Tungsten,
    Titanium_Silicide,
    Silicon_Dioxide,
    Air,
    Resistor_Poly_Mask,
    P_Plus_Diffusion,
    P_Plus_Implant_Mask,
    N_Plus_Implant_Mask,
    Tap_Mask,
    Pad_Mask
} from "./materials"

# Re-export all materials so users of this PDK only need one import.
export { Polysilicon, Aluminum, Tungsten, Titanium_Silicide, Silicon_Dioxide, Air }
export { Resistor_Poly_Mask, P_Plus_Diffusion, P_Plus_Implant_Mask, N_Plus_Implant_Mask, Tap_Mask, Pad_Mask }


# ── SKY130-Compliant Layer Profile for Resistor Test Structures ───────────────
#
# Describes the full stackup used in this resistor test cell.
# In v0.3.0 a 'profile' block is a named tech descriptor; sub-blocks use
# identifier names followed by '{}'.

export profile Resistor_3D {
    technology "ASIC" {
        substrate_net: "GND"
    }

    stackup {
        # layer_name { material: "...", thickness: <Measurement>, routable: <bool> }
        tap    { material: "Tap_Mask",            thickness: 0nm,   routable: false }  # GDS 65/44
        psdm   { material: "P_Plus_Implant_Mask", thickness: 0nm,   routable: false }  # GDS 94/20
        pdiff  { material: "P_Plus_Diffusion",    thickness: 200nm, routable: true  }
        polyres { material: "Polysilicon",         thickness: 180nm, routable: true  }
        rpm    { material: "Resistor_Poly_Mask",  thickness: 0nm,   routable: false }  # GDS 86/20
        ild0   { material: "Silicon_Dioxide",     thickness: 200nm, routable: false }
        li1    { material: "Titanium_Silicide",   thickness: 100nm, routable: true  }
        ild1   { material: "Silicon_Dioxide",     thickness: 150nm, routable: false }
        metal1 { material: "Aluminum",            thickness: 360nm, routable: true  }
        pad    { material: "Pad_Mask",            thickness: 0nm,   routable: false }  # GDS 122/16
    }

    manufacturing {
        track_pitch:      10nm
        copper_thickness: 500nm
        circle_segments:  64
    }

    via {
        min_diameter:  170nm
        min_enclosure: 40nm     # SKY130 licon.4 / licon.5 / mcon.4
        min_spacing:   200nm    # SKY130 DRC licon.2 / mcon.2
        shape:         "square" # IC-etched licon/mcon are square cuts, NOT circular PCB drills
        contact_depth: 30%      # v0.3.0: Default penetration depth (30% into each layer)
    }

    trace {
        min_width:      300nm
        min_spacing:    300nm
        edge_clearance: 200nm
    }

    clearance {
        high_voltage:  1um
        safety_factor: 2.0
    }

    thermal {
        ambient_temp:          25degC
        max_operating_temp:    125degC
        max_temp_rise:         50degC
        clustering_threshold:  10um
    }

    routing {
        min_segment_length:        300nm
        base_cost:                 1
        via_penalty:               50
        direction_penalty:         10
        tight_clearance_penalty:   2
        crosstalk_penalty:         3
        impedance_penalty:         1
        reference_void_penalty:    5000000
    }
}

# ── SKY130 P+ Poly Precision Resistor SPICE Subcircuit Model ─────────────────
#
# In v0.3.0 a subcircuit is described as a struct carrying its topology
# parameters; the compiler emits the SPICE .subckt card from the device block.
#
# Subcircuit: sky130_fd_pr__res_high_po
#   Terminals : A, B, BULK
#   Parameters: W (width), L (length)
#   Internal   : R_head (362 Ohm) + R_body (350*L/W Ohm) + R_tail (362 Ohm)
#                + substrate parasitics C_sub1/C_sub2 (2 fF * W * L each)

export device Resistor {
    terminals: [A, B, BULK]
    spice {
        prefix:          "X"
        subcircuit:      "sky130_fd_pr__res_high_po"
        terminal_order:  [A, B, BULK]
        parameters:      [W, L]
        parameter_style: "named"
    }
}
