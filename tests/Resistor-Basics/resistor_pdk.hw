# resistor_pdk.hw - SkyWater SKY130 Resistor PDK
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 350 Ω/□)
import * from @std/primitives/units
import Polysilicon, Aluminum, Tungsten, Titanium_Silicide, Silicon_Dioxide, Air, Resistor_Poly_Mask, P_Plus_Diffusion from "./materials"

export Polysilicon
export Aluminum
export Tungsten
export Titanium_Silicide
export Silicon_Dioxide
export Air
export Resistor_Poly_Mask
export P_Plus_Diffusion

export shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

export bridge Polysilicon to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Polysilicon to Titanium_Silicide:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Titanium_Silicide to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge P_Plus_Diffusion to Titanium_Silicide:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

# SKY130-compliant layer stackup with local interconnect (li1)
export profile Resistor_3D:
    technology: "ASIC"
    substrate_net: GND
    
    stackup:
        pdiff:      [material: P_Plus_Diffusion,   thickness: 200nm, routable: true]
        polyres:    [material: Polysilicon,        thickness: 180nm, routable: true]
        rpm:        [material: Resistor_Poly_Mask, thickness: 0nm,   routable: false] # Zero-thickness mask layer
        ild0:       [material: Silicon_Dioxide,    thickness: 200nm, routable: false]
        li1:        [material: Titanium_Silicide,  thickness: 100nm, routable: true]
        ild1:       [material: Silicon_Dioxide,    thickness: 150nm, routable: false]
        metal1:     [material: Aluminum,           thickness: 360nm, routable: true]

    manufacturing:
        track_pitch: 10nm
        copper_thickness: 500nm
        circle_segments: 64

    via:
        min_diameter: 170nm
        min_annular_ring: 50nm
        min_spacing: 400nm
        shape: SquareContact
        contact_depth: 30%
        material_contact_depths:
            Aluminum: 30%
            Polysilicon: 30%
            Titanium_Silicide: 30%
            P_Plus_Diffusion: 30%

    trace:
        min_width: 300nm
        min_spacing: 300nm
        edge_clearance: 200nm

    clearance:
        high_voltage: 1um
        safety_factor: 2.0

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 50nm
        allowed_conductors: [Aluminum, Polysilicon]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        min_segment_length: 300nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

# SKY130 P+ Poly Precision Resistor Subcircuit
# Sheet resistance: 350 Ω/□, End contacts: 362 Ω each, Parasitic cap: 2 fF/μm²
#
# v0.2.1: TRUE FOUNDRY SPICE INTEGRATION (Architecture Proposal Section 4)
# Uses `spice_include` to defer physics to the foundry model instead of
# inline element synthesis. This is the CORRECT approach for production ASICs.
export subcircuit sky130_fd_pr__res_high_po:
    terminals: [PLUS, MINUS, BULK]
    parameters: [W = 1.0um, L = 1.0um]
    spice_include: "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"

# LEGACY: Inline Elements Mode (for reference only)
# Uncomment to use compiler-synthesized subcircuit instead of foundry model
# export subcircuit sky130_fd_pr__res_high_po:
#     terminals: [PLUS, MINUS, BULK]
#     parameters: [W = 1.0um, L = 1.0um]
#     elements:
#         R_head: Resistor(nodes: [PLUS, node_1], value: 362.0ohm)
#         R_tail: Resistor(nodes: [node_2, MINUS], value: 362.0ohm)
#         R_body: Resistor(nodes: [node_1, node_2], value: 350.0ohm * (L / W))
#         C_sub1: Capacitor(nodes: [PLUS, BULK], value: 2.0fF * W * L)
#         C_sub2: Capacitor(nodes: [MINUS, BULK], value: 2.0fF * W * L)

export device Resistor:
    terminals: [A, B, BULK]
    materials:
        A: [Polysilicon, Titanium_Silicide, Aluminum]  # Accept resistor body OR contact materials
        B: [Polysilicon, Titanium_Silicide, Aluminum]  # Accept resistor body OR contact materials
        BULK: [Air, P_Plus_Diffusion, Titanium_Silicide]  # Virtual terminal (Air) OR physical substrate tap (P+ + TiSi2)
    spice:
        prefix: X
        subcircuit: sky130_fd_pr__res_high_po
        terminal_order: [A, B, BULK]
        parameters: [W, L]
        parameter_style: named
