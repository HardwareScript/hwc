# resistor_pdk.hw - SkyWater SKY130 Resistor PDK Configuration (v0.3.0)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 317.4 Ohm/sq)
#
# This file contains the profile (stackup) definition and device model.
# The PCell generator is located in @std/pdk/sky130/resistor.

import * from @std/primitives/units
import {
    Polysilicon,
    Aluminum,
    Tungsten,
    Titanium_Nitride,
    Titanium_Silicide,
    Silicon_Dioxide,
    Air,
    Resistor_Poly_Mask,
    Npc_Mask,
    P_Plus_Diffusion,
    P_Plus_Implant_Mask,
    N_Plus_Implant_Mask,
    Tap_Mask,
    Pad_Mask
} from "./materials"

# Re-export all materials so users of this PDK only need one import.
export { Polysilicon, Aluminum, Tungsten, Titanium_Nitride, Titanium_Silicide, Silicon_Dioxide, Air }
export { Resistor_Poly_Mask, Npc_Mask, P_Plus_Diffusion, P_Plus_Implant_Mask, N_Plus_Implant_Mask, Tap_Mask, Pad_Mask }


# ── SKY130-Compliant Layer Profile for Resistor Test Structures ───────────────
#
# Describes the full stackup used in this resistor test cell.

export profile Resistor_3D {
    technology "ASIC" {
        substrate_net: "GND"
    }

    stackup {
        # layer_name { material: "...", thickness: <Measurement>, routable: <bool> }
        tap     { material: "Tap_Mask",            thickness: 0nm,   routable: false }  # GDS 65/44
        psdm    { material: "P_Plus_Implant_Mask", thickness: 0nm,   routable: false }  # GDS 94/20
        pdiff   { material: "P_Plus_Diffusion",    thickness: 200nm, routable: true  }
        polyres { material: "Polysilicon",         thickness: 180nm, routable: true  }
        rpm     { material: "Resistor_Poly_Mask",  thickness: 0nm,   routable: false }  # GDS 86/20
        npc     { material: "Npc_Mask",            thickness: 0nm,   routable: false }  # GDS 27/20
        ild0    { material: "Silicon_Dioxide",     thickness: 200nm, routable: false }
        li1     { material: "Titanium_Nitride",    thickness: 100nm, routable: true  }
        ild1    { material: "Silicon_Dioxide",     thickness: 150nm, routable: false }
        metal1  { material: "Aluminum",            thickness: 360nm, routable: true  }
        pad     { material: "Pad_Mask",            thickness: 0nm,   routable: false }  # GDS 122/16
    }

    manufacturing {
        track_pitch:      10nm
        copper_thickness: 500nm
        circle_segments:  64
    }

    via {
        min_diameter:  170nm
        min_enclosure: 40nm     # SKY130 licon.4 / licon.5 / mcon.4
        min_spacing:   200nm    # SKY130 DRC licon.2 / mcon.2
        shape:         "square" # IC-etched licon/mcon are square cuts, NOT circular PCB drills
        contact_depth: 30%      # v0.3.0: Default penetration depth (30% into each layer)
    }

    trace {
        min_width:      300nm
        min_spacing:    300nm
        edge_clearance: 200nm
    }

    clearance {
        high_voltage:  1um
        safety_factor: 2.0
    }

    thermal {
        ambient_temp:          25degC
        max_operating_temp:    125degC
        max_temp_rise:         50degC
        clustering_threshold:  10um
    }

    routing {
        min_segment_length:        300nm
        base_cost:                 1
        via_penalty:               50
        direction_penalty:         10
        tight_clearance_penalty:   2
        crosstalk_penalty:         3
        impedance_penalty:         1
        reference_void_penalty:    5000000
    }

    # ── Foundry PDK Model Includes ──────────────────────────────────────────────
    # Architecture 2: The compiler reads `include:` values here and emits one
    # `.include "..."` line per entry. The SPICE simulator owns the physics.
    # ── User-Configurable Parasitic Extraction Rules (PEX) ───────────────────
    extraction {
        via_cluster_radius:    600nm
        via_landing_radius:    300nm
        max_coupling_distance: 3.0um
    }

    # ZERO raw SPICE strings in .hw files — the foundry owns the model files.
    models {
        include: "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"
    }
}

# ── SKY130 P+ Poly Precision Resistor Device Declaration ─────────────────────
#
# Architecture 2: Pure typed metadata.
# The compiler extracts W, L geometry and emits:
#   X<name> <A> <B> <BULK> sky130_fd_pr__res_high_po W=<w>u L=<l>u
#
# The foundry model file (included via `models` above) implements the full
# non-linear BSIM physics. The compiler is 100% foundry-agnostic.

export device Resistor {
    terminals: [A, B, BULK]
    spice {
        prefix:          "X"
        subcircuit:      "sky130_fd_pr__res_high_po"
        include:         "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"
        terminal_order:  [A, B, BULK]
        parameters:      [W, L]
        parameter_style: "named"
    }
}
