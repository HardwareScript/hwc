# resistor_pdk.hw - SkyWater SKY130 Precision Resistor PDK
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor)
# Sheet Resistance: 317.4 Ω/□, Contact Resistance: ~362 Ω/head
# Construction: Polysilicon body with RPM silicide block & P+ implant

import * from @std/primitives/units
import {
    Polysilicon,
    Aluminum,
    Tungsten,
    Titanium_Nitride,
    Titanium_Silicide,
    Silicon_Dioxide,
    Air,
    Resistor_Poly_Mask,
    Npc_Mask,
    P_Plus_Diffusion,
    P_Plus_Implant_Mask,
    N_Plus_Implant_Mask,
    Tap_Mask,
    Pad_Mask
} from "./materials"

export {
    Polysilicon,
    Aluminum,
    Tungsten,
    Titanium_Nitride,
    Titanium_Silicide,
    Silicon_Dioxide,
    Air,
    Resistor_Poly_Mask,
    Npc_Mask,
    P_Plus_Diffusion,
    P_Plus_Implant_Mask,
    N_Plus_Implant_Mask,
    Tap_Mask,
    Pad_Mask,
    Resistor,
    sky130_fd_pr__res_high_po
}


# SKY130-compliant resistor stackup with polyres, RPM, NPC, PSDM, TAP layers
# Construction: Substrate/tap → P+ implant → Polysilicon → RPM silicide block → Li1 → Metal1
# Sheet resistance: 317.4 Ω/□ (nominal)

export profile Resistor_3D {
    technology "ASIC" {
        substrate_net: "GND"
    }

    models {
        include: "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"
    }

    stackup {
        tap     { material: "Tap_Mask",            thickness: 0nm,   routable: false }
        psdm    { material: "P_Plus_Implant_Mask", thickness: 0nm,   routable: false }
        diff    { material: "P_Plus_Diffusion",    thickness: 200nm, routable: true,  device_layer: true }
        polyres { material: "Polysilicon",         thickness: 180nm, routable: true,  device_layer: true }
        rpm     { material: "Resistor_Poly_Mask",  thickness: 0nm,   routable: false, device_layer: true }
        npc     { material: "Npc_Mask",            thickness: 0nm,   routable: false, device_layer: true }
        ild0    { material: "Silicon_Dioxide",     thickness: 200nm, routable: false }
        li1     { material: "Titanium_Nitride",    thickness: 100nm, routable: true }
        ild1    { material: "Silicon_Dioxide",     thickness: 150nm, routable: false }
        metal1  { material: "Aluminum",            thickness: 360nm, routable: true }
        pad     { material: "Pad_Mask",            thickness: 0nm,   routable: false }
    }

    via {
        min_diameter:  170nm
        min_enclosure: 40nm
        min_spacing:   200nm
        contact_depth: 30%
        shape:         "square"
        enclosures {
            diff:    50nm
            polyres: 50nm
            li1:     40nm
            metal1:  50nm
        }
    }

    trace {
        min_width:   300nm
        min_spacing: 300nm
    }

    thermal {
        ambient_temp:         25degC
        max_operating_temp:   125degC
        max_temp_rise:        50degC
        clustering_threshold: 10um
    }

    routing {
        min_segment_length:        300nm
        base_cost:                 1
        via_penalty:               50
        direction_penalty:         10
        tight_clearance_penalty:   2
        crosstalk_penalty:         3
        impedance_penalty:         1
        reference_void_penalty:    5000000
    }

    cuts {
        licon { from: ["polyres", "diff"], to: "li1" }
        mcon  { from: ["li1"], to: "metal1" }
    }

    drc {
        rpm_over_polyres {
            rule: "rpm.3"
            type: "transverse_enclosure"
            layer_a: "rpm"
            layer_b: "polyres"
            min_distance: 200nm
        }
        npc_over_polyres {
            rule: "rpm.5"
            type: "extension"
            layer_a: "npc"
            layer_b: "polyres"
            min_distance: 95nm
        }
        licon_to_rpm {
            rule: "licon.8"
            type: "clearance"
            layer_a: "licon"
            layer_b: "rpm"
            min_distance: 180nm
        }
    }
}

export device Resistor {
    terminals: [A, B, BULK]
    spice {
        prefix:          "X"
        subcircuit:      "sky130_fd_pr__res_high_po"
        include:         "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"
        terminal_order:  [A, B, BULK]
        parameters:      [w, l]
        parameter_style: "named"
    }
}

export device sky130_fd_pr__res_high_po {
    terminals: [A, B, BULK]
    spice {
        prefix:          "X"
        subcircuit:      "sky130_fd_pr__res_high_po"
        include:         "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"
        terminal_order:  [A, B, BULK]
        parameters:      [w, l]
        parameter_style: "named"
    }
}
