# simple_resistor_test.hw - SKY130 P+ Poly Resistor Test
# Device: sky130_fd_pr__res_high_po (350 Ω/□)
# Geometry: 4μm × 1μm = 1400Ω expected
import * from @std/primitives/units
import * from "./resistor_pdk"

module SimpleResistor:
    pins: [input In, output Out]
    route In to Out

space Simple_Resistor_Space implements SimpleResistor:
    dimensions: 20.0um by 10.0um
    profile: Resistor_3D

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out: { classification: signal, potential: 0.0V, current: 1.0uA }
        GND: { classification: ground, potential: 0.0V, current: 0.0uA }

    let res_length = 4.0um
    let res_width = 1.0um
    let contact_size = 400nm
    let resistor_center_x = 10.0um
    let resistor_center_y = 5.0um

    add pour(Polysilicon) named Resistor_Body on layer: polyres:
        device: R1.BULK
        dimensions: res_length by res_width
        at: [x: resistor_center_x, y: resistor_center_y]
        net: GND

    add pour(Aluminum) named Contact_A on layer: metal1:
        device: R1.A
        dimensions: contact_size by contact_size
        at: [x: Resistor_Body.left + contact_size / 2, y: Resistor_Body.center_y]
        net: In
    
    add pour(Aluminum) named Contact_B on layer: metal1:
        device: R1.B
        dimensions: contact_size by contact_size
        at: [x: Resistor_Body.right - contact_size / 2, y: Resistor_Body.center_y]
        net: Out

    add contact(Tungsten) named Via_A spanning layer: polyres to metal1:
        diameter: 300nm
        at: [x: Contact_A.center_x, y: Contact_A.center_y]
        net: In

    add contact(Tungsten) named Via_B spanning layer: polyres to metal1:
        diameter: 300nm
        at: [x: Contact_B.center_x, y: Contact_B.center_y]
        net: Out

    let pad_spacing = 3.0um
    let pad_size = 1.0um
    
    add pour(Aluminum) named In_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        at: [x: Contact_A.left - pad_spacing - (pad_size / 2), y: Contact_A.center_y]
        net: In

    add pour(Aluminum) named Out_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        at: [x: Contact_B.right + pad_spacing + (pad_size / 2), y: Contact_B.center_y]
        net: Out

    route In_Pad to Contact_A:
        net: In
        width: 300nm
        layer: metal1
        intent: Signal

    route Contact_B to Out_Pad:
        net: Out
        width: 300nm
        layer: metal1
        intent: Signal
