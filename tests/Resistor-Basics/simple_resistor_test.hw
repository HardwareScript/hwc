# simple_resistor_test.hw - SKY130 P+ Poly Resistor Test (v0.3.1 Canonical)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor)
#
# PHYSICS: R = R_sheet * (L_body / W) + 2 * R_head
# - Total drawn length (L): 4.0um
# - Width (W): 1.41um
# - Contact head length: 480nm each (silicided for ohmic contact)
# - Body length (L_body): L - 2 * 480nm = 3.04um (RPM silicide-blocked region)
# - R_sheet: 317.4 Ω/□ (SKY130 spec)
# - R_head: ~362 Ω per contact head (total 724 Ω contact resistance)
#
# Expected resistance:
# R = (317.4 Ω/□ * 3.04um / 1.41um) + 724 Ω
# R = 684.3 Ω + 724 Ω = 1408.3 Ω (~1.41 kΩ)
#
# STRUCTURE:
#   Terminal A: contact head on left (metal1)  → In pad
#   Terminal B: contact head on right (metal1) → Out pad
#   BULK:       substrate tap above body (metal1) → GND pad
#   Geometry centered at [80.0um, 50.0um], W=1.41um, L=4.0um
#
# External access pads:
#   Out pad: metal1, right of center → routes on metal1 to B port
#   In  pad: metal1, left of center  → routes on metal1 to A port
#   GND pad: metal1, top of center   → routes on metal1 to BULK port

import * from @std/primitives/units
import * from @std/primitives/math
import { RouteIntent } from @std/routing/intent
import { sky130_res_high_po, Resistor, sky130_fd_pr__res_high_po } from "../pdk/sky130/devices/resistor"
import { pad } from "../pdk/sky130/physical/pad"
import { Resistor_3D } from "./resistor_pdk"

# ── Module Interface ──────────────────────────────────────────────────────────

module SimpleResistor {
    pins: [input In, output Out]
}

# ── Physical Layout Space ─────────────────────────────────────────────────────

space Simple_Resistor_Space implements SimpleResistor {
    dimensions: [160.0um, 140.0um]
    profile: Resistor_3D

    nets {
        In:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Out: { classification: "signal" }
        GND: { classification: "ground", potential: 0.0V, current: 0.0uA }
    }

    # ── Layout constants (must match resistor.hw) ────────────────────────────
    let res_center_x  = 80.0um
    let res_center_y  = 55.0um          # Shifted down to give GND pad room above
    let res_w         = 1.41um
    let res_l         = 4.0um
    let tap_offset    = 2.5um          # Tap sits 2.5um above resistor body
    let pad_size      = 40.0um         # Standard probe pad (40µm × 40µm)
    let pad_spacing   = 10.0um

    # ── 1. Place the Resistor CellLayout ──────────────────────────────────────
    let r_cell = sky130_res_high_po(W: res_w, L: res_l)
    let r1 = space.place(r_cell, at: [res_center_x, res_center_y])

    # ── 2. External pads on the correct layers ────────────────────────────────
    # A, B, and BULK ports are all on metal1
    let in_pad_cell  = pad(size: pad_size, layer: "metal1")
    let out_pad_cell = pad(size: pad_size, layer: "metal1")
    let gnd_pad_cell = pad(size: pad_size, layer: "metal1")

    let in_pad  = space.place(in_pad_cell,  at: [res_center_x - res_l / 2 - pad_spacing - pad_size / 2, res_center_y])
    let out_pad = space.place(out_pad_cell, at: [res_center_x + res_l / 2 + pad_spacing + pad_size / 2, res_center_y])
    let gnd_pad = space.place(gnd_pad_cell, at: [res_center_x, 105.0um])

    # ── 3. Route on matching layers ───────────────────────────────────────────
    # metal1: In_Pad → Terminal A
    route in_pad.port("PORT") to r1.port("A") {
        net: In, intent: RouteIntent.Signal, layer: "metal1", width: 300nm
    }

    # metal1: Terminal B → Out_Pad
    route r1.port("B") to out_pad.port("PORT") {
        net: Out, intent: RouteIntent.Signal, layer: "metal1", width: 300nm
    }

    # metal1: BULK (Substrate Tap) → GND_Pad
    route r1.port("BULK") to gnd_pad.port("PORT") {
        net: GND, intent: RouteIntent.Ground, layer: "metal1", width: 300nm
    }
}

# ── Simulation Testbench ──────────────────────────────────────────────────────

test Simple_Resistor_AC_Test for Simple_Resistor_Space {
    ac:   { sweep: "dec", points: 20, start: 100Hz, stop: 10GHz }
    tran: { step: 10ps, stop: 200ns }
}
