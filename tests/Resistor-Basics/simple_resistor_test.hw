# simple_resistor_test.hw - SKY130 P+ Poly Resistor Test (v0.3.0 Canonical)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 350 Ohm/sq)
# Geometry: 4um x 1.41um body -> ~1.7kOhm expected (L/W * 350 + 724 Ohm contact)
#
# This is the canonical v0.3.0 test file demonstrating proper standard library usage.
# All raw polygon/contact emission is encapsulated in @std/pdk/sky130/resistor.
# This file is under 35 lines (down from 215 lines in the inline version).

import * from @std/primitives/units
import { sky130_res_high_po } from "../pdk/sky130/resistor"
import { pad } from "../pdk/sky130/pad"
import { Resistor_3D } from "./resistor_pdk"


# ── Module Interface ──────────────────────────────────────────────────────────

module SimpleResistor {
    pins: [input In, output Out]
}

# ── Physical Layout Space ─────────────────────────────────────────────────────

space Simple_Resistor_Space implements SimpleResistor {
    dimensions: [20.0um, 10.0um]
    profile: Resistor_3D

    nets {
        In:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Out: { classification: "signal", potential: 0.0V, current: 1.0uA }
        GND: { classification: "ground", potential: 0.0V, current: 0.0uA }
    }

    # 1. Instantiate Precision Resistor PCell (handles all layout internally)
    let r1 = sky130_res_high_po(
        name:   "R1",
        W:      1.41um,
        L:      4.0um,
        at:     [10.0um, 5.0um],
        term_a: In,
        term_b: Out,
        bulk:   GND
    )

    # 2. External Bond Pads
    let in_pad  = pad(name: "In_Pad",  at: [r1.a.center.x - 3.2um, r1.a.center.y], net: In,  size: 1.0um)
    let out_pad = pad(name: "Out_Pad", at: [r1.b.center.x + 3.2um, r1.b.center.y], net: Out, size: 1.0um)

    # 3. Connect Pads to Resistor Ports
    route in_pad.port.center to r1.a.center with intent: Signal
    route r1.b.center to out_pad.port.center with intent: Signal
}

# ── Simulation Testbench ──────────────────────────────────────────────────────

test Simple_Resistor_AC_Test for Simple_Resistor_Space {
    ac:   { sweep: "dec", points: 20, start: 100Hz, stop: 100MHz }
    tran: { step: 10ps, stop: 200ns }
}
