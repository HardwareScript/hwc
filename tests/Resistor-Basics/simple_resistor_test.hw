# simple_resistor_test.hw - SKY130 P+ Poly Resistor Test (v0.3.1 Canonical)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 350 Ohm/sq)
# Geometry: 4um x 1.41um body -> ~1.7kOhm expected (L/W * 350 + 724 Ohm contact)
# Demonstrates v0.3.1 Pure Cell Layout composition, explicit space.place(), and port routing.

import * from @std/primitives/units
import { sky130_res_high_po } from "../pdk/sky130/devices/resistor"
import { pad } from "../pdk/sky130/physical/pad"
import { Resistor_3D } from "./resistor_pdk"

# ── Module Interface ──────────────────────────────────────────────────────────

module SimpleResistor {
    pins: [input In, output Out]
}

# ── Physical Layout Space ─────────────────────────────────────────────────────

space Simple_Resistor_Space implements SimpleResistor {
    dimensions: [20.0um, 10.0um]
    profile: Resistor_3D

    nets {
        In:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Out: { classification: "signal", potential: 0.0V, current: 1.0uA }
        GND: { classification: "ground", potential: 0.0V, current: 0.0uA }
    }

    # 1. Instantiate pure Precision Resistor CellLayout & place explicitly
    let r_cell = sky130_res_high_po(W: 1.41um, L: 4.0um)
    let r1 = space.place(r_cell, at: [10.0um, 5.0um])

    # 2. Instantiate & place external bond pads
    let in_pad_cell  = pad(size: 1.0um)
    let out_pad_cell = pad(size: 1.0um)

    let in_pad  = space.place(in_pad_cell,  at: [6.8um, 5.0um])
    let out_pad = space.place(out_pad_cell, at: [13.2um, 5.0um])

    # 3. Connect Pads to Resistor Ports via placed instance port references
    route in_pad.port("PORT") to r1.port("A") { intent: Signal }
    route r1.port("B") to out_pad.port("PORT") { intent: Signal }
    route r1.port("BULK") to GND { intent: Ground }
}

# ── Simulation Testbench ──────────────────────────────────────────────────────

test Simple_Resistor_AC_Test for Simple_Resistor_Space {
    ac:   { sweep: "dec", points: 20, start: 100Hz, stop: 100MHz }
    tran: { step: 10ps, stop: 200ns }
}
