# variable_resistor_test.hw
# Demonstrates how resistor geometry affects resistance
# Based on sheet resistance formula: R = R_sheet × (L/W)
# where L = length (direction of current flow), W = width (perpendicular to current)
#
# With polysilicon sheet resistance of 400 Ohms/square (from SiliWiz):
# - R1 (Short Fat):  10μm × 10μm = L/W = 10/10 = 1 square  → 400 Ω
# - R2 (Long Thin):  10μm × 1μm  = L/W = 10/1  = 10 squares → 4000 Ω  
# - R3 (Very Long):  20μm × 1μm  = L/W = 20/1  = 20 squares → 8000 Ω

import * from @std/primitives/units
import * from "./resistor_pdk"

# Device definition for resistors
device Resistor:
    terminals: [A, B]
    materials:
        A: Polysilicon
        B: Polysilicon
    spice:
        prefix: R
        terminal_order: [A, B]
        parameters: [R]
        parameter_style: positional

module VariableResistor:
    pins: [input In1, input In2, input In3, output Out1, output Out2, output Out3]
    route In1 to Out1
    route In2 to Out2
    route In3 to Out3

space Variable_Resistor_Space implements VariableResistor:
    # Large space to accommodate multiple resistors
    dimensions: 30.0um by 15.0um by 1.0um
    resolution: 10nm
    origin: bl by b
    profile: Resistor_3D

    nets:
        In1:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out1: { classification: signal, potential: 0.0V, current: 1.0uA }
        In2:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out2: { classification: signal, potential: 0.0V, current: 1.0uA }
        In3:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out3: { classification: signal, potential: 0.0V, current: 1.0uA }

    # ========================================================================
    # RESISTOR 1: SHORT FAT (Low Resistance = 400 Ohms)
    # 10μm × 10μm = 1 square (L/W = 10μm/10μm = 1)
    # ========================================================================

    # Terminal A (left half of resistor body)
    add pour(Polysilicon) named R1_Body_A on layer: polyres:
        device: R1.A
        dimensions: 5.0um by 10.0um
        at: [x: 7.0um, y: 3.0um]

    # Terminal B (right half of resistor body)
    add pour(Polysilicon) named R1_Body_B on layer: polyres:
        device: R1.B
        dimensions: 5.0um by 10.0um
        at: [x: R1_Body_A.right, y: 3.0um]  # ← Relational placement!

    # Metal contacts for routing (NOT device-bound)
    add pour(Aluminum) named R1_Contact_Left on layer: metal1:
        net: In1
        dimensions: 800nm by 800nm
        align: center with R1_Body_A  # ← Relational placement!

    add pour(Aluminum) named R1_Contact_Right on layer: metal1:
        net: Out1
        dimensions: 800nm by 800nm
        align: center with R1_Body_B  # ← Relational placement!

    # Vias (NOT device-bound, using correct via fill material)
    add contact(Tungsten) named R1_Via_Left spanning layer: polyres to metal1:
        net: In1
        diameter: 400nm
        align: center with R1_Contact_Left

    add contact(Tungsten) named R1_Via_Right spanning layer: polyres to metal1:
        net: Out1
        diameter: 400nm
        align: center with R1_Contact_Right

    # ========================================================================
    # RESISTOR 2: LONG THIN (Medium Resistance = 4000 Ohms)
    # 10μm × 1μm = 10 squares (L/W = 10μm/1μm = 10)
    # ========================================================================

    # Terminal A (left half of resistor body)
    add pour(Polysilicon) named R2_Body_A on layer: polyres:
        device: R2.A
        dimensions: 5.0um by 1.0um
        at: [x: 7.0um, y: 7.5um]

    # Terminal B (right half of resistor body)
    add pour(Polysilicon) named R2_Body_B on layer: polyres:
        device: R2.B
        dimensions: 5.0um by 1.0um
        at: [x: R2_Body_A.right, y: 7.5um]  # ← Relational placement!

    # Metal contacts for routing (NOT device-bound)
    add pour(Aluminum) named R2_Contact_Left on layer: metal1:
        net: In2
        dimensions: 800nm by 800nm
        align: center with R2_Body_A  # ← Relational placement!

    add pour(Aluminum) named R2_Contact_Right on layer: metal1:
        net: Out2
        dimensions: 800nm by 800nm
        align: center with R2_Body_B  # ← Relational placement!

    # Vias (NOT device-bound, using correct via fill material)
    add contact(Tungsten) named R2_Via_Left spanning layer: polyres to metal1:
        net: In2
        diameter: 400nm
        align: center with R2_Contact_Left

    add contact(Tungsten) named R2_Via_Right spanning layer: polyres to metal1:
        net: Out2
        diameter: 400nm
        align: center with R2_Contact_Right

    # ========================================================================
    # RESISTOR 3: VERY LONG THIN (High Resistance = 8000 Ohms)
    # 20μm × 1μm = 20 squares (L/W = 20μm/1μm = 20)
    # ========================================================================

    # Terminal A (left half of resistor body)
    add pour(Polysilicon) named R3_Body_A on layer: polyres:
        device: R3.A
        dimensions: 10.0um by 1.0um
        at: [x: 10.0um, y: 12.0um]

    # Terminal B (right half of resistor body)
    add pour(Polysilicon) named R3_Body_B on layer: polyres:
        device: R3.B
        dimensions: 10.0um by 1.0um
        at: [x: R3_Body_A.right, y: 12.0um]  # ← Relational placement!

    # Metal contacts for routing (NOT device-bound)
    add pour(Aluminum) named R3_Contact_Left on layer: metal1:
        net: In3
        dimensions: 800nm by 800nm
        align: center with R3_Body_A  # ← Relational placement!

    add pour(Aluminum) named R3_Contact_Right on layer: metal1:
        net: Out3
        dimensions: 800nm by 800nm
        align: center with R3_Body_B  # ← Relational placement!

    # Vias (NOT device-bound, using correct via fill material)
    add contact(Tungsten) named R3_Via_Left spanning layer: polyres to metal1:
        net: In3
        diameter: 400nm
        align: center with R3_Contact_Left

    add contact(Tungsten) named R3_Via_Right spanning layer: polyres to metal1:
        net: Out3
        diameter: 400nm
        align: center with R3_Contact_Right
