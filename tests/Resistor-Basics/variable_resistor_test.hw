# variable_resistor_test.hw - SKY130 Geometry-Dependent Variable Resistors (v0.3.1 Canonical)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 317.4 Ohm/sq)
#
# FABRICATION REALITY: SkyWater SKY130 does NOT provide voltage-tunable variable resistors.
# Variable resistance is achieved through GEOMETRY SCALING, not voltage control.
#
# Physical Principle: R = R_sheet × (L/W) + R_contact
# - R_sheet: 317.4 Ω/□ (SKY130 P+ polysilicon with RPM mask to block silicide)
# - L: Length of resistor body (current flow direction)
# - W: Width of resistor body (perpendicular to current)
# - R_contact: scales with 1/W (more via cuts at wider heads = lower contact R)
#
# SKY130 Width Quantization: W must be one of {0.35, 0.69, 1.41, 2.85, 5.73}μm
#
# Test Cases (using quantized widths, L_body = 3.04um):
# - R1 (Wide):   L/W ≈ 1.067 sq → Body ≈ 339Ω  + Contact ≈ 358Ω (6 vias/side)  ≈  697Ω
# - R2 (Medium): L/W ≈ 2.156 sq → Body ≈ 684Ω  + Contact ≈ 724Ω (3 vias/side)  ≈ 1408Ω
# - R3 (Narrow): L/W ≈ 4.406 sq → Body ≈ 1398Ω + Contact ≈ 1479Ω (1-2 vias/side) ≈ 2877Ω
#
# This is the canonical v0.3.1 test file demonstrating parametric resistor instantiation.
# Migrated from v0.3.0 inline layout to explicit space.place() + RouteIntent pattern.
#
# Reference: https://skywater-pdk.readthedocs.io/en/main/rules/device-details.html

import * from @std/primitives/units
import { RouteIntent } from @std/routing/intent
import { sky130_res_high_po, Resistor, sky130_fd_pr__res_high_po } from "../pdk/sky130/devices/resistor"
import { pad } from "../pdk/sky130/physical/pad"
import { Resistor_3D } from "./resistor_pdk"


# ── Module Interface ──────────────────────────────────────────────────────────

module GeometryVariableResistor {
    pins: [input In1, input In2, input In3, output Out1, output Out2, output Out3]
}

# ── Physical Layout Space ─────────────────────────────────────────────────────

space Geometry_Variable_Resistor_Space implements GeometryVariableResistor {
    dimensions: [36.0um, 18.0um]
    profile: Resistor_3D

    nets {
        In1:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Out1: { classification: "signal", potential: 0.0V, current: 1.0uA }
        In2:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Out2: { classification: "signal", potential: 0.0V, current: 1.0uA }
        In3:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Out3: { classification: "signal", potential: 0.0V, current: 1.0uA }
        GND:  { classification: "ground", potential: 0.0V, current: 0.0uA }
    }

    # ── 1. Instantiate pure CellLayouts (no geometry emitted yet) ─────────────

    # R1: Wide (W=2.85um) → low resistance ~697Ω
    let r1_cell = sky130_res_high_po(W: 2.85um, L: 4.0um)

    # R2: Medium (W=1.41um) → medium resistance ~1408Ω
    let r2_cell = sky130_res_high_po(W: 1.41um, L: 4.0um)

    # R3: Narrow (W=0.69um) → high resistance ~2877Ω
    let r3_cell = sky130_res_high_po(W: 0.69um, L: 4.0um)

    # ── 2. Place cells explicitly in space (World Coordinates) ────────────────

    let r1 = space.place(r1_cell, at: [6.0um,  6.0um])
    let r2 = space.place(r2_cell, at: [18.0um, 6.0um])
    let r3 = space.place(r3_cell, at: [30.0um, 6.0um])

    # ── 3. Bond pads for external connections ─────────────────────────────────

    let in1_pad_cell  = pad(size: 2.0um, layer: "metal1")
    let out1_pad_cell = pad(size: 2.0um, layer: "metal1")
    let in2_pad_cell  = pad(size: 2.0um, layer: "metal1")
    let out2_pad_cell = pad(size: 2.0um, layer: "metal1")
    let in3_pad_cell  = pad(size: 2.0um, layer: "metal1")
    let out3_pad_cell = pad(size: 2.0um, layer: "metal1")
    let gnd_pad_cell  = pad(size: 2.0um, layer: "metal1")

    # In/Out pads at the resistor terminals (A side left, B side right)
    let in1_pad  = space.place(in1_pad_cell,  at: [2.0um,  6.0um])
    let out1_pad = space.place(out1_pad_cell, at: [10.0um, 6.0um])
    let in2_pad  = space.place(in2_pad_cell,  at: [14.0um, 6.0um])
    let out2_pad = space.place(out2_pad_cell, at: [22.0um, 6.0um])
    let in3_pad  = space.place(in3_pad_cell,  at: [26.0um, 6.0um])
    let out3_pad = space.place(out3_pad_cell, at: [34.0um, 6.0um])

    # Shared GND pad for all three substrate taps
    let gnd_pad = space.place(gnd_pad_cell, at: [18.0um, 14.0um])

    # ── 4. Signal routes: Pads → Resistor terminals ───────────────────────────

    route in1_pad.port("PORT")  to r1.port("A")          { net: In1,  intent: RouteIntent.Signal, layer: "metal1", width: 300nm }
    route r1.port("B")          to out1_pad.port("PORT") { net: Out1, intent: RouteIntent.Signal, layer: "metal1", width: 300nm }

    route in2_pad.port("PORT")  to r2.port("A")          { net: In2,  intent: RouteIntent.Signal, layer: "metal1", width: 300nm }
    route r2.port("B")          to out2_pad.port("PORT") { net: Out2, intent: RouteIntent.Signal, layer: "metal1", width: 300nm }

    route in3_pad.port("PORT")  to r3.port("A")          { net: In3,  intent: RouteIntent.Signal, layer: "metal1", width: 300nm }
    route r3.port("B")          to out3_pad.port("PORT") { net: Out3, intent: RouteIntent.Signal, layer: "metal1", width: 300nm }

    # ── 5. Shared ground bus: chains all three BULK taps to GND pad ───────────
    # Routed as a continuous 300nm ground rail through all three substrate taps,
    # then up to the shared GND pad.

    route r1.port("BULK")  to r2.port("BULK")       { net: GND, intent: RouteIntent.Ground, layer: "metal1", width: 300nm }
    route r2.port("BULK")  to r3.port("BULK")       { net: GND, intent: RouteIntent.Ground, layer: "metal1", width: 300nm }
    route r2.port("BULK")  to gnd_pad.port("PORT")  { net: GND, intent: RouteIntent.Ground, layer: "metal1", width: 300nm }
}

# ── Simulation Testbench ──────────────────────────────────────────────────────
# Characterizes resistance vs. geometry scaling across three width values

test Geometry_Variable_Resistor_AC_Test for Geometry_Variable_Resistor_Space {
    ac:   { sweep: "dec", points: 20, start: 100Hz, stop: 100MHz }
    tran: { step: 10ps, stop: 200ns }
}
