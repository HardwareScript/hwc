# variable_resistor_test.hw - SKY130 Geometry-Dependent Variable Resistors
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 350 Ω/□)
# 
# FABRICATION REALITY: SkyWater SKY130 does NOT provide voltage-tunable variable resistors.
# Variable resistance is achieved through GEOMETRY SCALING, not voltage control.
#
# Physical Principle: R = R_sheet × (L/W) + R_contact
# - R_sheet: 350 Ω/□ (SKY130 P+ polysilicon with RPM mask to block silicide)
# - L: Length of resistor body (current flow direction)
# - W: Width of resistor body (perpendicular to current)
# - R_contact: ~362Ω per contact (built into sky130_fd_pr__res_high_po subcircuit)
#
# SKY130 Width Quantization: W must be one of {0.35, 0.69, 1.41, 2.85, 5.73}μm
#
# Test Cases (using quantized widths):
# - R1 (Square):      4μm × 2.85μm → L/W ≈ 1.4  →  490Ω  + 724Ω contact = 1214Ω
# - R2 (Long Thin):   4μm × 1.41μm → L/W ≈ 2.8  →  980Ω  + 724Ω contact = 1704Ω
# - R3 (Very Long):   4μm × 0.69μm → L/W ≈ 5.8  → 2030Ω  + 724Ω contact = 2754Ω
#
# Reference: https://skywater-pdk.readthedocs.io/en/main/rules/device-details.html

import * from @std/primitives/units
import * from "./resistor_pdk"

module GeometryVariableResistor:
    pins: [input In1, input In2, input In3, output Out1, output Out2, output Out3]
    route In1 to Out1
    route In2 to Out2
    route In3 to Out3

space Geometry_Variable_Resistor_Space implements GeometryVariableResistor:
    dimensions: 30.0um by 15.0um
    profile: Resistor_3D

    nets:
        In1:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out1: { classification: signal, potential: 0.0V, current: 1.0uA }
        In2:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out2: { classification: signal, potential: 0.0V, current: 1.0uA }
        In3:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out3: { classification: signal, potential: 0.0V, current: 1.0uA }
        GND:  { classification: ground, potential: 0.0V, current: 0.0uA }

    # Device virtual terminal bindings (v0.2.1)
    device_nets R1:
        BULK: GND
    
    device_nets R2:
        BULK: GND
    
    device_nets R3:
        BULK: GND

    # ========================================================================
    # RESISTOR 1: LOW RESISTANCE (≈ 1214Ω)
    # 4μm × 2.85μm → L/W ≈ 1.4 squares
    # Body: 350 Ω/□ × 1.4 ≈ 490Ω
    # Contact: ~362Ω × 2 ends = 724Ω
    # Total: 490 + 724 = 1214Ω (from SKY130 subcircuit model)
    # ========================================================================

    let r1_length = 4.0um
    let r1_width = 2.85um  # SKY130 quantized width
    let r1_contact_size = 400nm
    let r1_center_x = 7.0um
    let r1_center_y = 3.0um

    # 1. CONTINUOUS POLYSILICON RESISTOR BODY (PRIMARY RESISTIVE CHANNEL)
    # The resistor body forms the physical resistive element
    # Bound to BOTH Terminal A and Terminal B - this is ONE continuous channel
    # v0.2.2: Multi-terminal device bodies do NOT have net assignments
    add pour(Polysilicon) named R1_Body on layer: polyres:
        device: R1.A, R1.B
        dimensions: r1_length by r1_width
        at: [x: r1_center_x, y: r1_center_y]

    # 1a. RESISTOR POLY MASK (RPM) - ZERO-THICKNESS FABRICATION INSTRUCTION
    # This mask blocks silicide formation on the polysilicon resistor body
    # Category: mask → Z-thickness = 0nm, anchored to Z=180nm (top of polyres)
    # Exported to GDSII for fabrication, skipped in DXF/GLB by structural filter
    # SKY130 DRC: rpm.2 requires ≥180nm overhang on width (360nm total extension)
    add pour(Resistor_Poly_Mask) named R1_RPM_Block on layer: rpm:
        dimensions: r1_length by r1_width + 360nm
        align: center_x with R1_Body
        align: center_y with R1_Body

    # 1b. PSDM MASK (P+ Implant over Poly Resistor body with 130nm enclosure per SKY130 psdm.1/psdm.2)
    add pour(P_Plus_Implant_Mask) named R1_PSDM on layer: psdm:
        dimensions: r1_length + 260nm by r1_width + 260nm
        align: center_x with R1_Body
        align: center_y with R1_Body

    # 2. LEFT CONTACT HEAD (TERMINAL A → NET IN1)
    # Titanium_Silicide contact on li1 layer binds Terminal A to net In1
    # Contact center positioned at resistor left edge + half contact width for proper overlap
    add pour(Titanium_Silicide) named R1_Contact_A_LI on layer: li1:
        device: R1.A
        net: In1
        dimensions: r1_contact_size by r1_width
        align: center_x with R1_Body.left + r1_contact_size / 2
        align: center_y with R1_Body
    
    # 3. RIGHT CONTACT HEAD (TERMINAL B → NET OUT1)
    # Titanium_Silicide contact on li1 layer binds Terminal B to net Out1
    # Contact center positioned at resistor right edge - half contact width for proper overlap
    add pour(Titanium_Silicide) named R1_Contact_B_LI on layer: li1:
        device: R1.B
        net: Out1
        dimensions: r1_contact_size by r1_width
        align: center_x with R1_Body.right - r1_contact_size / 2
        align: center_y with R1_Body

    # 4. VIAS BRIDGING POLYRES → LI1 (Via Arrays for Reliability)
    let via_pitch = 400nm
    for i in 0..3:
        add contact(Tungsten) named R1_Via_A_Poly_{i} spanning layer: polyres to li1:
            diameter: 170nm
            align: center_x with R1_Contact_A_LI
            align: center_y with R1_Contact_A_LI.center_y + (i - 1) * via_pitch
            net: In1

    for i in 0..3:
        add contact(Tungsten) named R1_Via_B_Poly_{i} spanning layer: polyres to li1:
            diameter: 170nm
            align: center_x with R1_Contact_B_LI
            align: center_y with R1_Contact_B_LI.center_y + (i - 1) * via_pitch
            net: Out1

    # 5. METAL1 PADS DIRECTLY ABOVE LI1 CONTACTS
    add pour(Aluminum) named R1_Contact_A_Metal on layer: metal1:
        dimensions: r1_contact_size by r1_width
        align: center_x with R1_Contact_A_LI
        align: center_y with R1_Contact_A_LI
        net: In1

    add pour(Aluminum) named R1_Contact_B_Metal on layer: metal1:
        dimensions: r1_contact_size by r1_width
        align: center_x with R1_Contact_B_LI
        align: center_y with R1_Contact_B_LI
        net: Out1

    # 6. VIAS BRIDGING LI1 → METAL1 (Via Arrays for Reliability)
    for i in 0..3:
        add contact(Tungsten) named R1_Via_A_Metal_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with R1_Contact_A_LI
            align: center_y with R1_Contact_A_LI.center_y + (i - 1) * via_pitch
            net: In1

    for i in 0..3:
        add contact(Tungsten) named R1_Via_B_Metal_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with R1_Contact_B_LI
            align: center_y with R1_Contact_B_LI.center_y + (i - 1) * via_pitch
            net: Out1

    # ========================================================================
    # RESISTOR 2: MEDIUM RESISTANCE (≈ 1704Ω)
    # 4μm × 1.41μm → L/W ≈ 2.8 squares
    # Body: 350 Ω/□ × 2.8 ≈ 980Ω
    # Contact: ~362Ω × 2 ends = 724Ω
    # Total: 980 + 724 = 1704Ω (from SKY130 subcircuit model)
    # ========================================================================

    let r2_length = 4.0um
    let r2_width = 1.41um  # SKY130 quantized width
    let r2_contact_size = 400nm
    let r2_center_x = 15.0um
    let r2_center_y = 3.0um

    # 1. CONTINUOUS POLYSILICON RESISTOR BODY (PRIMARY RESISTIVE CHANNEL)
    add pour(Polysilicon) named R2_Body on layer: polyres:
        device: R2.A, R2.B
        dimensions: r2_length by r2_width
        at: [x: r2_center_x, y: r2_center_y]

    # 1a. RESISTOR POLY MASK (RPM) - ZERO-THICKNESS FABRICATION INSTRUCTION
    # SKY130 DRC: rpm.2 requires ≥180nm overhang on width (360nm total extension)
    add pour(Resistor_Poly_Mask) named R2_RPM_Block on layer: rpm:
        dimensions: r2_length by r2_width + 360nm
        align: center_x with R2_Body
        align: center_y with R2_Body

    # 1b. PSDM MASK (P+ Implant over Poly Resistor body with 130nm enclosure per SKY130 psdm.1/psdm.2)
    add pour(P_Plus_Implant_Mask) named R2_PSDM on layer: psdm:
        dimensions: r2_length + 260nm by r2_width + 260nm
        align: center_x with R2_Body
        align: center_y with R2_Body

    # 2. LEFT CONTACT HEAD (TERMINAL A → NET IN2)
    # Titanium_Silicide contact on li1 layer binds Terminal A to net In2
    add pour(Titanium_Silicide) named R2_Contact_A_LI on layer: li1:
        device: R2.A
        net: In2
        dimensions: r2_contact_size by r2_width
        align: center_x with R2_Body.left + r2_contact_size / 2
        align: center_y with R2_Body
    
    # 3. RIGHT CONTACT HEAD (TERMINAL B → NET OUT2)
    # Titanium_Silicide contact on li1 layer binds Terminal B to net Out2
    add pour(Titanium_Silicide) named R2_Contact_B_LI on layer: li1:
        device: R2.B
        net: Out2
        dimensions: r2_contact_size by r2_width
        align: center_x with R2_Body.right - r2_contact_size / 2
        align: center_y with R2_Body

    # 4. VIAS BRIDGING POLYRES → LI1 (Via Arrays for Reliability)
    for i in 0..3:
        add contact(Tungsten) named R2_Via_A_Poly_{i} spanning layer: polyres to li1:
            diameter: 170nm
            align: center_x with R2_Contact_A_LI
            align: center_y with R2_Contact_A_LI.center_y + (i - 1) * via_pitch
            net: In2

    for i in 0..3:
        add contact(Tungsten) named R2_Via_B_Poly_{i} spanning layer: polyres to li1:
            diameter: 170nm
            align: center_x with R2_Contact_B_LI
            align: center_y with R2_Contact_B_LI.center_y + (i - 1) * via_pitch
            net: Out2

    # 5. METAL1 PADS DIRECTLY ABOVE LI1 CONTACTS
    add pour(Aluminum) named R2_Contact_A_Metal on layer: metal1:
        dimensions: r2_contact_size by r2_width
        align: center_x with R2_Contact_A_LI
        align: center_y with R2_Contact_A_LI
        net: In2

    add pour(Aluminum) named R2_Contact_B_Metal on layer: metal1:
        dimensions: r2_contact_size by r2_width
        align: center_x with R2_Contact_B_LI
        align: center_y with R2_Contact_B_LI
        net: Out2

    # 6. VIAS BRIDGING LI1 → METAL1 (Via Arrays for Reliability)
    for i in 0..3:
        add contact(Tungsten) named R2_Via_A_Metal_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with R2_Contact_A_LI
            align: center_y with R2_Contact_A_LI.center_y + (i - 1) * via_pitch
            net: In2

    for i in 0..3:
        add contact(Tungsten) named R2_Via_B_Metal_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with R2_Contact_B_LI
            align: center_y with R2_Contact_B_LI.center_y + (i - 1) * via_pitch
            net: Out2

    # ========================================================================
    # RESISTOR 3: HIGH RESISTANCE (≈ 2754Ω)
    # 4μm × 0.69μm → L/W ≈ 5.8 squares
    # Body: 350 Ω/□ × 5.8 ≈ 2030Ω
    # Contact: ~362Ω × 2 ends = 724Ω
    # Total: 2030 + 724 = 2754Ω (from SKY130 subcircuit model)
    # ========================================================================

    let r3_length = 4.0um
    let r3_width = 0.69um  # SKY130 quantized width
    let r3_contact_size = 400nm
    let r3_center_x = 23.0um
    let r3_center_y = 3.0um

    # 1. CONTINUOUS POLYSILICON RESISTOR BODY (PRIMARY RESISTIVE CHANNEL)
    add pour(Polysilicon) named R3_Body on layer: polyres:
        device: R3.A, R3.B
        dimensions: r3_length by r3_width
        at: [x: r3_center_x, y: r3_center_y]

    # 1a. RESISTOR POLY MASK (RPM) - ZERO-THICKNESS FABRICATION INSTRUCTION
    # SKY130 DRC: rpm.2 requires ≥180nm overhang on width (360nm total extension)
    add pour(Resistor_Poly_Mask) named R3_RPM_Block on layer: rpm:
        dimensions: r3_length by r3_width + 360nm
        align: center_x with R3_Body
        align: center_y with R3_Body

    # 1b. PSDM MASK (P+ Implant over Poly Resistor body with 130nm enclosure per SKY130 psdm.1/psdm.2)
    add pour(P_Plus_Implant_Mask) named R3_PSDM on layer: psdm:
        dimensions: r3_length + 260nm by r3_width + 260nm
        align: center_x with R3_Body
        align: center_y with R3_Body

    # 2. LEFT CONTACT HEAD (TERMINAL A → NET IN3)
    # Titanium_Silicide contact on li1 layer binds Terminal A to net In3
    add pour(Titanium_Silicide) named R3_Contact_A_LI on layer: li1:
        device: R3.A
        net: In3
        dimensions: r3_contact_size by r3_width
        align: center_x with R3_Body.left + r3_contact_size / 2
        align: center_y with R3_Body
    
    # 3. RIGHT CONTACT HEAD (TERMINAL B → NET OUT3)
    # Titanium_Silicide contact on li1 layer binds Terminal B to net Out3
    add pour(Titanium_Silicide) named R3_Contact_B_LI on layer: li1:
        device: R3.B
        net: Out3
        dimensions: r3_contact_size by r3_width
        align: center_x with R3_Body.right - r3_contact_size / 2
        align: center_y with R3_Body

    # 4. VIAS BRIDGING POLYRES → LI1 (Via Arrays for Reliability)
    for i in 0..3:
        add contact(Tungsten) named R3_Via_A_Poly_{i} spanning layer: polyres to li1:
            diameter: 170nm
            align: center_x with R3_Contact_A_LI
            align: center_y with R3_Contact_A_LI.center_y + (i - 1) * via_pitch
            net: In3

    for i in 0..3:
        add contact(Tungsten) named R3_Via_B_Poly_{i} spanning layer: polyres to li1:
            diameter: 170nm
            align: center_x with R3_Contact_B_LI
            align: center_y with R3_Contact_B_LI.center_y + (i - 1) * via_pitch
            net: Out3

    # 5. METAL1 PADS DIRECTLY ABOVE LI1 CONTACTS
    add pour(Aluminum) named R3_Contact_A_Metal on layer: metal1:
        dimensions: r3_contact_size by r3_width
        align: center_x with R3_Contact_A_LI
        align: center_y with R3_Contact_A_LI
        net: In3

    add pour(Aluminum) named R3_Contact_B_Metal on layer: metal1:
        dimensions: r3_contact_size by r3_width
        align: center_x with R3_Contact_B_LI
        align: center_y with R3_Contact_B_LI
        net: Out3

    # 6. VIAS BRIDGING LI1 → METAL1 (Via Arrays for Reliability)
    for i in 0..3:
        add contact(Tungsten) named R3_Via_A_Metal_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with R3_Contact_A_LI
            align: center_y with R3_Contact_A_LI.center_y + (i - 1) * via_pitch
            net: In3

    for i in 0..3:
        add contact(Tungsten) named R3_Via_B_Metal_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with R3_Contact_B_LI
            align: center_y with R3_Contact_B_LI.center_y + (i - 1) * via_pitch
            net: Out3

    # ========================================================================
    # SUBSTRATE TAPS FOR BULK CONNECTION (SKY130 LVS Requirement)
    # Each resistor needs its own substrate tap
    # ========================================================================
    
    let tap_offset_y = 4.5um  # Position taps below resistor bodies
    let tap_size = 400nm

    # R1 substrate tap
    add pour(Tap_Mask) named R1_Bulk_Tap_Mask on layer: tap:
        dimensions: tap_size by tap_size
        align: center_x with R1_Body
        align: center_y with R1_Body.center_y + tap_offset_y

    add pour(P_Plus_Implant_Mask) named R1_Bulk_Tap_PSDM on layer: psdm:
        dimensions: tap_size + 260nm by tap_size + 260nm
        align: center_x with R1_Body
        align: center_y with R1_Body.center_y + tap_offset_y

    add pour(P_Plus_Diffusion) named R1_Bulk_Tap_Diff on layer: pdiff:
        dimensions: tap_size by tap_size
        align: center_x with R1_Body
        align: center_y with R1_Body.center_y + tap_offset_y
        net: GND
        device: R1.BULK

    add contact(Tungsten) named R1_Bulk_Tap_Contact spanning layer: pdiff to li1:
        diameter: 170nm
        align: center_x with R1_Bulk_Tap_Diff
        align: center_y with R1_Bulk_Tap_Diff
        net: GND

    add pour(Titanium_Silicide) named R1_Bulk_Tap_LI on layer: li1:
        dimensions: tap_size by tap_size
        align: center_x with R1_Bulk_Tap_Diff
        align: center_y with R1_Bulk_Tap_Diff
        net: GND

    add pour(Aluminum) named R1_Bulk_Tap_Metal on layer: metal1:
        dimensions: tap_size by tap_size
        align: center_x with R1_Bulk_Tap_LI
        align: center_y with R1_Bulk_Tap_LI
        net: GND

    add contact(Tungsten) named R1_Bulk_Tap_Via spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with R1_Bulk_Tap_LI
        align: center_y with R1_Bulk_Tap_LI
        net: GND

    # R2 substrate tap
    add pour(Tap_Mask) named R2_Bulk_Tap_Mask on layer: tap:
        dimensions: tap_size by tap_size
        align: center_x with R2_Body
        align: center_y with R2_Body.center_y + tap_offset_y

    add pour(P_Plus_Implant_Mask) named R2_Bulk_Tap_PSDM on layer: psdm:
        dimensions: tap_size + 260nm by tap_size + 260nm
        align: center_x with R2_Body
        align: center_y with R2_Body.center_y + tap_offset_y

    add pour(P_Plus_Diffusion) named R2_Bulk_Tap_Diff on layer: pdiff:
        dimensions: tap_size by tap_size
        align: center_x with R2_Body
        align: center_y with R2_Body.center_y + tap_offset_y
        net: GND
        device: R2.BULK

    add contact(Tungsten) named R2_Bulk_Tap_Contact spanning layer: pdiff to li1:
        diameter: 170nm
        align: center_x with R2_Bulk_Tap_Diff
        align: center_y with R2_Bulk_Tap_Diff
        net: GND

    add pour(Titanium_Silicide) named R2_Bulk_Tap_LI on layer: li1:
        dimensions: tap_size by tap_size
        align: center_x with R2_Bulk_Tap_Diff
        align: center_y with R2_Bulk_Tap_Diff
        net: GND

    add pour(Aluminum) named R2_Bulk_Tap_Metal on layer: metal1:
        dimensions: tap_size by tap_size
        align: center_x with R2_Bulk_Tap_LI
        align: center_y with R2_Bulk_Tap_LI
        net: GND

    add contact(Tungsten) named R2_Bulk_Tap_Via spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with R2_Bulk_Tap_LI
        align: center_y with R2_Bulk_Tap_LI
        net: GND

    # R3 substrate tap
    add pour(Tap_Mask) named R3_Bulk_Tap_Mask on layer: tap:
        dimensions: tap_size by tap_size
        align: center_x with R3_Body
        align: center_y with R3_Body.center_y + tap_offset_y

    add pour(P_Plus_Implant_Mask) named R3_Bulk_Tap_PSDM on layer: psdm:
        dimensions: tap_size + 260nm by tap_size + 260nm
        align: center_x with R3_Body
        align: center_y with R3_Body.center_y + tap_offset_y

    add pour(P_Plus_Diffusion) named R3_Bulk_Tap_Diff on layer: pdiff:
        dimensions: tap_size by tap_size
        align: center_x with R3_Body
        align: center_y with R3_Body.center_y + tap_offset_y
        net: GND
        device: R3.BULK

    add contact(Tungsten) named R3_Bulk_Tap_Contact spanning layer: pdiff to li1:
        diameter: 170nm
        align: center_x with R3_Bulk_Tap_Diff
        align: center_y with R3_Bulk_Tap_Diff
        net: GND

    add pour(Titanium_Silicide) named R3_Bulk_Tap_LI on layer: li1:
        dimensions: tap_size by tap_size
        align: center_x with R3_Bulk_Tap_Diff
        align: center_y with R3_Bulk_Tap_Diff
        net: GND

    add pour(Aluminum) named R3_Bulk_Tap_Metal on layer: metal1:
        dimensions: tap_size by tap_size
        align: center_x with R3_Bulk_Tap_LI
        align: center_y with R3_Bulk_Tap_LI
        net: GND

    add contact(Tungsten) named R3_Bulk_Tap_Via spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with R3_Bulk_Tap_LI
        align: center_y with R3_Bulk_Tap_LI
        net: GND

    # Ground Bus (Connects all substrate taps)
    add pour(Aluminum) named GND_Bus on layer: metal1:
        dimensions: 17.0um by 600nm
        at: [x: 15.0um, y: 7.5um]
        net: GND
