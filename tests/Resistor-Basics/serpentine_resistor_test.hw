# serpentine_resistor_test.hw - SKY130 Serpentine Resistor Testbench (v0.3.1)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 317.4 Ohm/sq)
#
# SERPENTINE/MEANDERING RESISTOR: Folded resistive path for high resistance in compact area
# Physical principle: Multiple connected segments form continuous resistive channel
# Total resistance = (L_eff / Width) × R_sheet + R_contact
#
# This design: 5 horizontal segments (10μm each) + 4 vertical connectors (2μm each)
# Pitch: 3μm center-to-center between parallel segments (provides 2μm clearance)
# Total geometric length: (5×10μm) + (4×2μm) = 58μm
# Corner correction: 8 corners × 0.44□ = 3.52μm + 2×480nm contact exclusion = 0.96μm
# Effective electrical length: L_eff = 58 - 3.52 - 0.96 = 53.52μm
# Width: 1μm
# Expected resistance: (53.52μm/1μm) × 317.4Ω/□ + 724Ω ≈ 16,987Ω + 724Ω ≈ 17,711Ω

import * from @std/primitives/units
import * from @std/primitives/math
import { sky130_serpentine_res_high_po } from "../pdk/sky130/devices/resistor"
import { pad } from "../pdk/sky130/physical/pad"
import { Resistor_3D } from "./resistor_pdk"
import { RouteIntent } from @std/routing/intent

# ── Module Interface ──────────────────────────────────────────────────────────

module SerpentineResistor {
    pins: [input In, output Out]
}

# ── Physical Layout Space ─────────────────────────────────────────────────────

space Serpentine_Resistor_Space implements SerpentineResistor {
    dimensions: [30.0um, 28.0um]
    profile: Resistor_3D

    nets {
        In:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Out: { classification: "signal", potential: 0.0V, current: 1.0uA }
        GND: { classification: "ground", potential: 0.0V, current: 0.0uA }
    }

    # 1. Instantiate PDK PCell and place in the space
    #    5 segments × 10μm + 4 connectors × 2μm = 58μm geometric path
    #    L_eff = 53.52μm (corner-corrected) → R ≈ 317.4 × 53.52 + 724 ≈ 17,711Ω
    let res_cell = sky130_serpentine_res_high_po(W: 1.0um, seg_len: 10.0um, seg_count: 5, pitch: 3.0um)
    let r1 = space.place(res_cell, at: [15.0um, 14.0um])

    # 2. External Bond Pads — placed close to each port's world coordinate
    #    Serpentine at [15, 14]: Port A ≈ world (10.2, 8), B ≈ (19.8, 20), BULK ≈ (15, 22.2)
    let pad_cell = pad(size: 2.0um)
    let in_pad   = space.place(pad_cell, at: [7.5um,  8.0um])
    let out_pad  = space.place(pad_cell, at: [22.5um, 20.0um])
    let gnd_pad  = space.place(pad_cell, at: [15.0um, 24.5um])

    # 3. Thin 400nm signal traces — matching contact_len width, not full poly width
    route in_pad.port("PORT")  to r1.port("A")         { net: In,  intent: RouteIntent.Signal, width: 400nm }
    route r1.port("B")         to out_pad.port("PORT") { net: Out, intent: RouteIntent.Signal, width: 400nm }
    route r1.port("BULK")      to gnd_pad.port("PORT") { net: GND, intent: RouteIntent.Ground, width: 400nm }
}

# ── Simulation Testbench ──────────────────────────────────────────────────────

test Serpentine_Resistor_AC_Test for Serpentine_Resistor_Space {
    ac:   { sweep: "dec", points: 20, start: 100Hz, stop: 100MHz }
    tran: { step: 10ps, stop: 200ns }
}
