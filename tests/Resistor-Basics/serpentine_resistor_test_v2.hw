# serpentine_resistor_test_v2.hw - SKY130 Serpentine Resistor (100% Relational Layout)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 350 Ω/□)
# 
# VERSION 2: PARAMETRIC SERPENTINE RESISTOR (Loop-Based Implementation)
# 
# DESIGN PHILOSOPHY: Single Anchor Law with Loop-Based Generation
# - Seg0 is the ONE AND ONLY absolute 'at:' anchor
# - All segments (Seg1-4) derive from Seg0 using align: with loop variable offsets
# - Vertical connectors positioned relative to Seg0 edges
# - Via arrays use native comptime loops for proper current distribution
# - Self-healing: Change seg_len, seg_width, or pitch → everything adjusts automatically
#
# Demonstrates mid-level parametric generation:
# 1. Loop-based segment generation (for i in 0..5)
# 2. Conditional geometry placement (if i mod 2 = 0)
# 3. Inline coordinate expressions with proper device bindings
# 4. Via arrays for low contact resistance and uniform current distribution
#
# This design: 5 horizontal segments (10μm each) + 4 vertical connectors (2μm each)
# Pitch: 3μm center-to-center between parallel segments (provides 2μm clearance)
# Total path length: (5×10μm) + (4×2μm) = 58μm
# Width: 1μm
# Expected resistance: (58μm/1μm) × 350Ω/□ + 724Ω = 20,300Ω + 724Ω = 21,024Ω
#
# Reference: https://patents.justia.com/patent/20220271116

import * from @std/primitives/units
import * from "./resistor_pdk"

module SerpentineResistor:
    pins: [input In, output Out]
    route In to Out

space Serpentine_Resistor_Space_V2 implements SerpentineResistor:
    dimensions: 20.0um by 20.0um
    profile: Resistor_3D

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out: { classification: signal, potential: 0.0V, current: 1.0uA }
        GND: { classification: ground, potential: 0.0V, current: 0.0uA }

    # Device virtual terminal bindings (v0.2.2)
    device_nets R1:
        BULK: GND

    # ========================================================================
    # PARAMETRIC SERPENTINE CONFIGURATION (Self-Healing Layout)
    # ========================================================================
    
    let seg_len = 10.0um
    let seg_width = 1.0um
    let vert_len = 2.0um
    let vert_width = 1.0um
    let pitch = 3.0um       # Center-to-center spacing between parallel segments (3x trace width)
    let center_x = 10.0um
    let start_y = 2.0um
    let contact_size = 400nm
    let pad_size = 1.0um
    let pad_spacing = 3.0um
    let tap_size = 400nm
    let via_pitch = 400nm   # Via pitch: diameter (170nm) + min_spacing (230nm clearance)
    
    # ========================================================================
    # 1. CONTINUOUS POLYSILICON SERPENTINE PATH (Loop-Based Generation)
    # Creates 5 horizontal segments with 4 vertical connectors
    # All segments are bound to BOTH Terminal A and Terminal B
    # v0.2.2: Multi-terminal device bodies do NOT have net assignments
    # Pitch = 3μm provides 2μm clearance between 1μm-wide parallel segments
    # 
    # Design Change (v0.2.2):
    # - Seg0 uses ONE absolute at: statement (the required anchor)
    # - Seg1-4 use align: with loop variable offsets (pitch-based spacing)
    # - Vertical connectors use align: relative to Seg0 edges
    # - Connectors overlap adjacent segments to form continuous path
    # ========================================================================
    
    # 1a. Anchor Segment (Seg0) - THE ONLY at: STATEMENT
    add pour(Polysilicon) named Seg0 on layer: polyres:
        dimensions: seg_len by seg_width
        at: [x: center_x, y: start_y]
        device: R1.A, R1.B
    
    # 1b. Remaining Horizontal Segments (Seg1-4) - Aligned to Seg0
    # Each segment is positioned at i * pitch from Seg0
    for i in 1..5:
        add pour(Polysilicon) named Seg{i} on layer: polyres:
            dimensions: seg_len by seg_width
            align: center_x with Seg0
            align: center_y with Seg0.center_y + i * pitch
            device: R1.A, R1.B
    
    # 1c. Generate 4 Vertical Connectors (Aligned to Seg0 edges)
    # Connectors positioned to overlap adjacent segments, alternating left/right
    for i in 0..3:
        if i mod 2 = 0:
            add pour(Polysilicon) named Vert{i} on layer: polyres:
                dimensions: vert_width by vert_len
                align: center_x with Seg0.right - vert_width/2
                align: center_y with Seg0.center_y + i * pitch + 1.5um
                device: R1.A, R1.B
        else:
            add pour(Polysilicon) named Vert{i} on layer: polyres:
                dimensions: vert_width by vert_len
                align: center_x with Seg0.left + vert_width/2
                align: center_y with Seg0.center_y + i * pitch + 1.5um
                device: R1.A, R1.B
    
    # ========================================================================
    # 1d. RESISTOR POLY MASK (RPM) - ZERO-THICKNESS FABRICATION INSTRUCTION
    # This mask blocks silicide formation on the polysilicon resistor body
    # Category: mask → Z-thickness = 0nm, anchored to Z=180nm (top of polyres)
    # Exported to GDSII for fabrication, skipped in DXF/GLB by structural filter
    # SKY130 DRC: rpm.1 requires ≥180nm enclosure on all sides (360nm total extension)
    # Total height: 5 segments @ 3μm pitch = 12μm + 1 segment height = 13μm
    # ========================================================================
    add pour(Resistor_Poly_Mask) named RPM_Serpentine on layer: rpm:
        dimensions: seg_len + 360nm by 13.0um + 360nm
        align: center_x with Seg2
        align: center_y with Seg2  # Center on Seg2 (middle of 5 segments)
    # ========================================================================
    # 2. TERMINAL CONTACTS (LEFT END OF BOTTOM SEGMENT → RIGHT END OF TOP)
    # Contact heads positioned at segment edges with mathematical precision
    # ========================================================================
    
    # 2a. LEFT CONTACT HEAD (TERMINAL A → NET IN)
    # Titanium_Silicide contact on li1 layer binds Terminal A to net In
    # Contact center positioned at resistor left edge + half contact width for proper overlap
    add pour(Titanium_Silicide) named Contact_A_LI on layer: li1:
        device: R1.A
        net: In
        dimensions: contact_size by contact_size
        align: center_x with Seg0.left + contact_size / 2
        align: center_y with Seg0
    
    # 2b. RIGHT CONTACT HEAD (TERMINAL B → NET OUT)
    # Titanium_Silicide contact on li1 layer binds Terminal B to net Out
    # Contact center positioned at resistor right edge - half contact width for proper overlap
    add pour(Titanium_Silicide) named Contact_B_LI on layer: li1:
        device: R1.B
        net: Out
        dimensions: contact_size by contact_size
        align: center_x with Seg4.right - contact_size / 2
        align: center_y with Seg4

    # ========================================================================
    # 3. RELATIONAL VIA ARRAYS BRIDGING POLYRES → LI1 (Native Comptime Loops)
    # SKY130 DRC requires contact plugs for low-resistance connection
    # Via specifications (matching simple resistor design):
    #   - Diameter: 170nm (licon.1)
    #   - Min spacing: 200nm edge-to-edge (licon.2)
    #   - Annular ring: 0nm (silicon contact plugs, not PCB pads)
    #   - Pitch: 400nm center-to-center
    #   - Clearance: 400nm - 170nm = 230nm ≥ 200nm ✅
    # Note: Single via per terminal is adequate for 400nm × 400nm contact pads
    # (Contact area too small for multi-via array without DRC violations)
    # ========================================================================
    
    add contact(Tungsten) named Via_A_Poly spanning layer: polyres to li1:
        diameter: 170nm
        align: center_x with Contact_A_LI
        align: center_y with Contact_A_LI
        net: In
    
    add contact(Tungsten) named Via_B_Poly spanning layer: polyres to li1:
        diameter: 170nm
        align: center_x with Contact_B_LI
        align: center_y with Contact_B_LI
        net: Out

    # ========================================================================
    # 4. RELATIONAL METAL1 PADS DIRECTLY ABOVE LI1 CONTACTS
    # ========================================================================
    add pour(Aluminum) named Contact_A_Metal on layer: metal1:
        dimensions: contact_size by contact_size
        align: center_x with Contact_A_LI
        align: center_y with Contact_A_LI
        net: In
    
    add pour(Aluminum) named Contact_B_Metal on layer: metal1:
        dimensions: contact_size by contact_size
        align: center_x with Contact_B_LI
        align: center_y with Contact_B_LI
        net: Out

    # ========================================================================
    # 5. RELATIONAL VIA ARRAYS BRIDGING LI1 → METAL1 (Native Comptime Loops)
    # Matching via pattern for consistent current distribution
    # ========================================================================
    
    add contact(Tungsten) named Via_A_Metal spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Contact_A_LI
        align: center_y with Contact_A_LI
        net: In
    
    add contact(Tungsten) named Via_B_Metal spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Contact_B_LI
        align: center_y with Contact_B_LI
        net: Out

    # ========================================================================
    # 6. RELATIONAL EXTERNAL TEST PADS & ROUTING
    # External pads positioned relative to metal1 contact pads
    # ========================================================================
    
    add pour(Aluminum) named In_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Contact_A_Metal.left - pad_spacing
        align: center_y with Contact_A_Metal
        net: In
    
    add pour(Aluminum) named Out_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Contact_B_Metal.right + pad_spacing
        align: center_y with Contact_B_Metal
        net: Out
    
    # ========================================================================
    # 7. RELATIONAL METAL1 ROUTING FROM CONTACT PADS TO EXTERNAL TEST PADS
    # ========================================================================
    route In_Pad to Contact_A_Metal:
        net: In
        width: 300nm
        layer: metal1
        intent: Signal
    
    route Contact_B_Metal to Out_Pad:
        net: Out
        width: 300nm
        layer: metal1
        intent: Signal

    # ========================================================================
    # 8. RELATIONAL SUBSTRATE TAP FOR BULK CONNECTION (SKY130 LVS Requirement)
    # Positioned relative to middle segment (Seg2) for central placement
    # In SKY130, a proper substrate tap requires THREE layers:
    #   1. P+ diffusion region (pdiff) - physical implant in substrate
    #   2. Local interconnect contact (licon) - via connecting pdiff to li1
    #   3. Local interconnect metal (li1) - connects to GND net
    # ========================================================================
    
    # 8a. P+ DIFFUSION REGION (Physical substrate implant)
    add pour(P_Plus_Diffusion) named Bulk_Tap_Diff on layer: pdiff:
        dimensions: tap_size by tap_size
        align: center_x with Seg2
        align: center_y with Seg2.center_y + 3.0um
        net: GND
        device: R1.BULK
    
    # 8b. LOCAL INTERCONNECT CONTACT (licon - connects pdiff to li1)
    add contact(Tungsten) named Bulk_Tap_Contact spanning layer: pdiff to li1:
        diameter: 170nm
        align: center_x with Bulk_Tap_Diff
        align: center_y with Bulk_Tap_Diff
        net: GND
    
    # 8c. LOCAL INTERCONNECT METAL (li1 layer)
    add pour(Titanium_Silicide) named Bulk_Tap_LI on layer: li1:
        dimensions: tap_size by tap_size
        align: center_x with Bulk_Tap_Diff
        align: center_y with Bulk_Tap_Diff
        net: GND

# ========================================================================
# TEST DEFINITION: AC FREQUENCY RESPONSE & TRANSIENT ANALYSIS
# ========================================================================
# v0.2.1 Zero-Fallback Compliance: Explicit testbench configuration required
# for AC and Transient SPICE export. The compiler FAILS LOUDLY without this.
test Serpentine_Resistor_AC_Test for Serpentine_Resistor_Space_V2:
    ac: { sweep: dec, points: 20, freq: 100Hz..100MHz }
    tran: { step: 10ps, stop: 200ns }
