# serpentine_resistor_test_v2.hw
# v0.2.1+ PARAMETRIC SERPENTINE RESISTOR (Corrected & Streamlined)
# 
# Demonstrates mid-level parametric generation:
# 1. Loop-based segment generation (for i in 0..4)
# 2. Conditional geometry placement (if i mod 2 = 0)
# 3. Inline coordinate expressions with proper device bindings
# 4. Simplified vertical connector positioning (1.5um offset)
#
# Design Philosophy:
# - Single '=' is the canonical HardwareScript equality operator
# - Inline coordinate expressions avoid loop variable scoping issues
# - Device bindings enable proper SPICE extraction
#
# Note: Version 2 still has repetitive contact stacks. Version 3 (PCell)
# would encapsulate this entire serpentine into a 1-line instantiation.

import * from @std/primitives/units
import * from "./resistor_pdk"

module SerpentineResistor:
    pins: [input In, output Out]
    route In to Out

space Serpentine_Resistor_Space_V2 implements SerpentineResistor:
    dimensions: 20.0um by 15.0um
    profile: Resistor_3D

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0uA }
        Out: { classification: signal, potential: 0.0V, current: 1.0uA }
        GND: { classification: ground, potential: 0.0V, current: 0.0uA }

    # Device virtual terminal bindings (v0.2.2+)
    device_nets R1:
        BULK: GND

    # ========================================================================
    # PARAMETRIC SERPENTINE CONFIGURATION
    # ========================================================================
    
    let seg_len = 10.0um
    let seg_width = 1.0um
    let vert_len = 2.0um
    let vert_width = 1.0um
    let vert_spacing = 3.0um
    let center_x = 8.0um
    let start_y = 2.0um
    
    # Derived X coordinates (calculated from geometry, not absolute)
    let right_x = center_x + seg_len/2 - vert_width/2  # = 8 + 5 - 0.5 = 12.5um
    let left_x = center_x - seg_len/2 + vert_width/2   # = 8 - 5 + 0.5 = 3.5um
    
    # ========================================================================
    # POLYSILICON SERPENTINE PATH (Single at: + Relational Positioning)
    # Creates 5 horizontal segments with 4 vertical connectors
    # 
    # Design Change (v0.2.2+):
    # - Seg0 uses ONE absolute at: statement (the required anchor)
    # - Seg1-4 use align: with loop variable offsets
    # - Vertical connectors use align: relative to Seg0 edges
    # - left_x and right_x are now DERIVED from geometry, not absolute
    # ========================================================================
    
    # 1a. Anchor Segment (Seg0) - THE ONLY at: STATEMENT
    add pour(Polysilicon) named Seg0 on layer: polyres:
        dimensions: seg_len by seg_width
        at: [x: center_x, y: start_y]
        device: R1.A, R1.B
    
    # 1b. Remaining Horizontal Segments (Seg1-4) - Aligned to Seg0
    for i in 1..4:
        add pour(Polysilicon) named Seg{i} on layer: polyres:
            dimensions: seg_len by seg_width
            align: center_x with Seg0
            align: center_y with Seg0.center_y + i * vert_spacing
            device: R1.A, R1.B
    
    # 2. Generate 4 Vertical Connectors (Aligned to Seg0 edges)
    for i in 0..3:
        if i mod 2 = 0:
            add pour(Polysilicon) named Vert{i} on layer: polyres:
                dimensions: vert_width by vert_len
                align: center_x with Seg0.right - vert_width/2
                align: center_y with Seg0.center_y + i * vert_spacing + 1.5um
                device: R1.A, R1.B
        else:
            add pour(Polysilicon) named Vert{i} on layer: polyres:
                dimensions: vert_width by vert_len
                align: center_x with Seg0.left + vert_width/2
                align: center_y with Seg0.center_y + i * vert_spacing + 1.5um
                device: R1.A, R1.B
    
    # 3. Resistor Poly Mask (RPM) - Aligned to middle segment (Seg2)
    add pour(Resistor_Poly_Mask) named RPM_Serpentine on layer: rpm:
        dimensions: 10.4um by 13.4um
        align: center_x with Seg0
        align: center_y with Seg2  # Center on Seg2 (middle of 5 segments)
    # ========================================================================
    # TERMINAL CONTACTS
    # ========================================================================
    
    let contact_size = 400nm
    
    # Terminal A (Bottom Left - aligned to Seg0)
    add pour(Titanium_Silicide) named Contact_A_LI on layer: li1:
        net: In
        device: R1.A
        dimensions: contact_size by contact_size
        align: center_x with Seg0.left + contact_size / 2
        align: center_y with Seg0
    
    add contact(Tungsten) named Via_A_Poly spanning layer: polyres to li1:
        diameter: 170nm
        align: center_x with Contact_A_LI
        align: center_y with Contact_A_LI
        net: In
    
    add pour(Aluminum) named Contact_A_Metal on layer: metal1:
        dimensions: contact_size by contact_size
        align: center_x with Contact_A_LI
        align: center_y with Contact_A_LI
        net: In
    
    add contact(Tungsten) named Via_A_Metal spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Contact_A_LI
        align: center_y with Contact_A_LI
        net: In
    
    # Terminal B (Top Right - aligned to Seg4)
    add pour(Titanium_Silicide) named Contact_B_LI on layer: li1:
        net: Out
        device: R1.B
        dimensions: contact_size by contact_size
        align: center_x with Seg4.right - contact_size / 2
        align: center_y with Seg4
    
    add contact(Tungsten) named Via_B_Poly spanning layer: polyres to li1:
        diameter: 170nm
        align: center_x with Contact_B_LI
        align: center_y with Contact_B_LI
        net: Out
    
    add pour(Aluminum) named Contact_B_Metal on layer: metal1:
        dimensions: contact_size by contact_size
        align: center_x with Contact_B_LI
        align: center_y with Contact_B_LI
        net: Out
    
    add contact(Tungsten) named Via_B_Metal spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Contact_B_LI
        align: center_y with Contact_B_LI
        net: Out

    # ========================================================================
    # EXTERNAL TEST PADS & ROUTING
    # ========================================================================
    
    let pad_size = 1.0um
    let overlap = 300nm
    
    add pour(Aluminum) named In_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: right with Contact_A_Metal.left + overlap
        align: center_y with Contact_A_Metal
        net: In
    
    add pour(Aluminum) named Out_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: left with Contact_B_Metal.right - overlap
        align: center_y with Contact_B_Metal
        net: Out
    
    route In_Pad to Contact_A_Metal:
        net: In
        width: 800nm
        layer: metal1
        intent: Signal
    
    route Contact_B_Metal to Out_Pad:
        net: Out
        width: 800nm
        layer: metal1
        intent: Signal
