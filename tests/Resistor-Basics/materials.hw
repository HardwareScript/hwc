    metallic: 0.5
    roughness: 0.5
    resistivity: 1.5e-7ohm_m
    thermal_conductivity: 30.0
    max_current_density: 5e3
}

export material Silicon_Dioxide {
    category: "insulator"
    color: "#E0E8FF"
    opacity: 0.05
    metallic: 0.0
    roughness: 0.1
    relative_permittivity: 3.9
}

export material Air {
    category: "insulator"
    color: "#FFFFFF"
    opacity: 0.0
    metallic: 0.0
    roughness: 0.0
    relative_permittivity: 1.0
}

