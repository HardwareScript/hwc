# materials.hw - SKY130 Material Definitions for Resistor Tests
import * from @std/primitives/units

export material Polysilicon {
    category: "conductor"
    symbol: "Poly"
    process: "deposited"
    color: "#FF6060"
    opacity: 1.0
    metallic: 0.3
    roughness: 0.8
    # For t = 180nm, rho = 5.7132e-5 ohm_m yields Rsh = 317.4 ohm/sq
    resistivity: 5.7132e-5ohm_m
    thermal_conductivity: 30.0
    max_current_density: 1e2
    min_area: 0.13um2
}

export material Aluminum {
    category: "conductor"
    symbol: "Al"
    process: "deposited"
    color: "#C0C0C0"
    opacity: 1.0
    metallic: 0.8
    roughness: 0.2
    resistivity: 4.50e-8ohm_m
    thermal_conductivity: 237.0
    max_current_density: 1e3
    min_area: 0.14um2
}

export material Tungsten {
    category: "conductor"
    symbol: "W"
    process: "deposited"
    color: "#8080FF"
    opacity: 1.0
    metallic: 0.7
    roughness: 0.3
    resistivity: 5.6e-8ohm_m
    thermal_conductivity: 173.0
    max_current_density: 1e4
    contact_resistance: 1e-8ohm_cm2
}

export material Titanium_Nitride {
    category: "conductor"
    symbol: "TiN"
    process: "deposited"
    color: "#404040"
    opacity: 1.0
    metallic: 0.5
    roughness: 0.5
    # For t = 100nm, rho = 1.28e-6 ohm_m yields Rsh = 12.8 ohm/sq
    resistivity: 1.28e-6ohm_m
    thermal_conductivity: 30.0
    max_current_density: 5e3
}

export material Titanium_Silicide {
    category: "conductor"
