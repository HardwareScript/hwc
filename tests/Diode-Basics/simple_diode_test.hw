# simple_diode_test.hw - SKY130 P-N Junction Diode Test (v0.3.1 Canonical)
# Device: Diode (D1) referencing DMOD model
# Physics: Forward V_F ≈ 0.6V, Breakdown V_BV = 40V, C_JO = 0.5pF

import * from @std/primitives/units
import * from @std/primitives/math
import { RouteIntent } from @std/routing/intent
import { sky130_diode } from "../pdk/sky130/devices/diode"
import { pad } from "../pdk/sky130/physical/pad"
import { Diode_Flattened, Diode } from "./diode_pdk"

# ── Module Interface ──────────────────────────────────────────────────────────

module SimpleDiode {
    pins: [input Anode_In, output Cathode_Out]
}

# ── Physical Layout Space ─────────────────────────────────────────────────────

space Simple_Diode_Space implements SimpleDiode {
    dimensions: [12.0um, 8.0um]
    profile: Diode_Flattened

    nets {
        Anode_In:    { classification: "signal", potential: 1.8V, current: 1.0uA }
        Cathode_Out: { classification: "ground", potential: 0.0V, current: 1.0uA }
    }

    # 1. Instantiate pure Diode CellLayout and place in the space
    let d_cell = sky130_diode(size: 1.0um)
    let d1 = space.place(d_cell, at: [6.0um, 4.0um])

    # 2. External I/O Test Bonding Pads
    let pad_cell = pad(size: 1.0um)
    let in_pad   = space.place(pad_cell, at: [2.0um, 4.0um])
    let out_pad  = space.place(pad_cell, at: [10.0um, 4.0um])

    # 3. Interconnect Routing (Collinear, strongly typed metal1 routes)
    route in_pad.port("PORT") to d1.port("ANODE")   { net: Anode_In,    intent: RouteIntent.Signal, width: 300nm }
    route d1.port("CATHODE")  to out_pad.port("PORT") { net: Cathode_Out, intent: RouteIntent.Ground, width: 300nm }
}

# ── Simulation Testbench ──────────────────────────────────────────────────────

test Simple_Diode_Test for Simple_Diode_Space {
    dc:   { sweep: "Anode_In", start: 0.0V, stop: 1.8V, step: 0.02V }
    tran: { step: 10ps, stop: 200ns }
}
