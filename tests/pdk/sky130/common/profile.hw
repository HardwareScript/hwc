# tests/pdk/sky130/common/profile.hw
# SkyWater SKY130 1.8V CMOS Process Profile Definition

import * from @std/primitives/units

export struct LayerConfig {
    name: String,
    layer_num: Int,
    thickness: Measurement,
    resistivity: Float,
}

export struct ProcessProfile {
    name: String,
    voltage: Measurement,
    min_feature_size: Measurement,
    site_width: Measurement,
    site_height: Measurement,
    layers: Array[LayerConfig],
}

export const SKY130_1V8_CMOS: ProcessProfile = ProcessProfile {
    name: "SKY130_1V8_CMOS",
    voltage: 1.8V,
    min_feature_size: 150nm,
    site_width: 0.46um,
    site_height: 2.72um,
    layers: [
        LayerConfig { name: "diff",   layer_num: 1,  thickness: 300nm, resistivity: 10.0 },
        LayerConfig { name: "poly",   layer_num: 2,  thickness: 180nm, resistivity: 25.0 },
        LayerConfig { name: "licon",  layer_num: 3,  thickness: 250nm, resistivity: 5.0 },
        LayerConfig { name: "li1",    layer_num: 4,  thickness: 100nm, resistivity: 12.0 },
        LayerConfig { name: "mcon",   layer_num: 5,  thickness: 200nm, resistivity: 3.0 },
        LayerConfig { name: "metal1", layer_num: 21, thickness: 350nm, resistivity: 0.125 },
        LayerConfig { name: "via1",   layer_num: 22, thickness: 260nm, resistivity: 4.5 },
        LayerConfig { name: "metal2", layer_num: 23, thickness: 350nm, resistivity: 0.125 },
        LayerConfig { name: "via2",   layer_num: 24, thickness: 260nm, resistivity: 4.5 },
        LayerConfig { name: "metal3", layer_num: 25, thickness: 800nm, resistivity: 0.047 },
        LayerConfig { name: "via3",   layer_num: 26, thickness: 300nm, resistivity: 3.5 },
        LayerConfig { name: "metal4", layer_num: 27, thickness: 800nm, resistivity: 0.047 },
        LayerConfig { name: "via4",   layer_num: 28, thickness: 300nm, resistivity: 3.5 },
        LayerConfig { name: "metal5", layer_num: 29, thickness: 1200nm, resistivity: 0.028 },
    ],
}
