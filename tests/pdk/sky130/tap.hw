# @std/pdk/sky130/tap.hw
import * from @std/primitives/units
import * from @std/primitives/math
import { TransistorPort } from "./nmos"


export enum TapType {
    P_Sub,
    N_Well,
}

export struct TapLayout {
    port: TransistorPort,
    bbox: BoundingBox,
}

export fn sky130_tap(type: TapType, at: Point2D, net: Net, size: Measurement) -> TapLayout {
    let implant_margin = 130nm
    let half_size = size / 2

    space.add_polygon(name: "Tap_Mask", layer: "tap", rect: [at.x - half_size, at.y - half_size, size, size])

    # ── Native match statement with dot notation ──
    match type {
        TapType.P_Sub => {
            space.add_polygon(
                name:  "P_Plus_Implant_Mask",
                layer: "psdm",
                rect:  [at.x - half_size - implant_margin, at.y - half_size - implant_margin, size + (2*implant_margin), size + (2*implant_margin)]
            )
            space.add_polygon(
                name:  "Bulk_Tap_Diff",
                layer: "pdiff",
                net:   net,
                rect:  [at.x - half_size, at.y - half_size, size, size]
            )
        },
        TapType.N_Well => {
            space.add_polygon(
                name:  "N_Plus_Implant_Mask",
                layer: "nsdm",
                rect:  [at.x - half_size - implant_margin, at.y - half_size - implant_margin, size + (2*implant_margin), size + (2*implant_margin)]
            )
            space.add_polygon(
                name:  "Bulk_Tap_Diff",
                layer: "ndiff",
                net:   net,
                rect:  [at.x - half_size, at.y - half_size, size, size]
            )
        },
        _ => {
            # Catch-all fallback
        }
    }

    space.add_polygon(name: "Bulk_Tap_LI",    layer: "li1",    net: net, rect: [at.x - half_size, at.y - half_size, size, size])
    space.add_polygon(name: "Bulk_Tap_Metal", layer: "metal1", net: net, rect: [at.x - half_size, at.y - half_size, size, size])

    let diff_layer = match type {
        TapType.P_Sub => "pdiff",
        TapType.N_Well => "ndiff",
        _ => "pdiff"
    }

    space.add_contact(name: "Bulk_Tap_Contact", from: diff_layer, to: "li1",    at: at, diameter: 170nm, net: net)
    space.add_contact(name: "Bulk_Tap_Via",     from: "li1",        to: "metal1", at: at, diameter: 170nm, net: net)

    return TapLayout {
        port: TransistorPort { center: at, layer: "metal1", net: net },
        bbox: BoundingBox {
            min_x: at.x - half_size - implant_margin,
            max_x: at.x + half_size + implant_margin,
            min_y: at.y - half_size - implant_margin,
            max_y: at.y + half_size + implant_margin,
        },
    }
}
