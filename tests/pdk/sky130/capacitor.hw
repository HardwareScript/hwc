# tests/pdk/sky130/capacitor.hw - SKY130 MIM Capacitor PCell
# Device: sky130_fd_pr__cap_mim_m3_1 (Metal-Insulator-Metal Capacitor over Metal-3)

import * from @std/primitives/units
import * from @std/primitives/math

export struct CapacitorPort {
    center: Point2D,
    layer: String,
    net: Net,
}

export struct CapacitorLayout {
    top: CapacitorPort,
    bottom: CapacitorPort,
    bbox: BoundingBox,
}

export fn sky130_cap_mim_m3(
    name: String,
    W: Measurement = 10.0um,
    L: Measurement = 10.0um,
    at: Point2D,
    top_plate: Net,
    bot_plate: Net,
    bulk: Net
) -> CapacitorLayout {
    let metal3_overhang = 500nm
    let metal3_w = W + (2 * metal3_overhang)
    let metal3_l = L + (2 * metal3_overhang)
    let via_pullback = 1.5um
    let contact_size = 400nm
    let via_diameter = 170nm

    let cx = at.x
    let cy = at.y

    space.add_device(
        type: "Capacitor",
        name: name,
        terminals: { c0: top_plate, c1: bot_plate, b: bulk },
        params: { W: W, L: L }
    )

    space.add_polygon(
        name:  "Bottom_Plate",
        layer: "metal3",
        net:   bot_plate,
        rect:  [cx - metal3_w/2, cy - metal3_l/2, metal3_w, metal3_l]
    )

    space.add_polygon(
        name:  "Top_Plate",
        layer: "capm",
        net:   top_plate,
        rect:  [cx - W/2, cy - L/2, W, L]
    )

    let top_contact_x = cx + W/2 - via_pullback
    let top_contact_y = cy

    space.add_polygon(
        name:  "Top_Contact_Metal4",
        layer: "metal4",
        net:   top_plate,
        rect:  [top_contact_x - contact_size/2, top_contact_y - contact_size/2, contact_size, contact_size]
    )

    space.add_contact(
        name:       "Via_Top_CAPM",
        from:       "capm",
        to:         "metal4",
        at:         Point2D { x: top_contact_x, y: top_contact_y },
        diameter:   via_diameter,
        net:        top_plate
    )

    let bbox = bbox_from_rect(
        center: [cx, cy],
        size:   [metal3_w, metal3_l]
    )
    
    return CapacitorLayout {
        top:    CapacitorPort { center: [top_contact_x, top_contact_y], layer: "metal4", net: top_plate },
        bottom: CapacitorPort { center: [cx, cy], layer: "metal3", net: bot_plate },
        bbox:   bbox,
    }
}
