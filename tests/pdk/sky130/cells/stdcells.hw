# tests/pdk/sky130/cells/stdcells.hw
# SkyWater SKY130 HD Standard Cell Layout Wrappers
# v0.3.1: Pure CellLayouts with lower-left [0, 0] origins for standard-cell row grid snapping.

import * from @std/primitives/units
import * from @std/primitives/math

/// Inverter: sky130_fd_sc_hd__inv_1 (1 site = 0.46um x 2.72um)
export fn sky130_fd_sc_hd__inv_1() -> CellLayout {
    let mut cell = CellLayout::new(name: "sky130_fd_sc_hd__inv_1")
    let width = 0.46um
    let height = 2.72um

    # Power Rails (Origin at lower-left [0, 0])
    cell.add_polygon(layer: "metal1", rect: [0um, 0um, width, 480nm])
    cell.add_polygon(layer: "metal1", rect: [0um, height - 480nm, width, 480nm])

    # Ports
    cell.add_port("A",   at: [0.14um, 1.36um], layer: "li1")
    cell.add_port("Y",   at: [0.32um, 1.36um], layer: "li1")
    cell.add_port("VDD", at: [width / 2.0, height], layer: "metal1")
    cell.add_port("VSS", at: [width / 2.0, 0um],    layer: "metal1")

    return cell
}

