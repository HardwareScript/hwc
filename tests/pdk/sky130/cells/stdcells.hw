/// 2-to-1 MUX: sky130_fd_sc_hd__mux2_1 (4 sites = 1.84um x 2.72um)
export fn sky130_fd_sc_hd__mux2_1() -> CellLayout {
    let mut cell = CellLayout::new(name: "sky130_fd_sc_hd__mux2_1")
    let width = 1.84um
    let height = 2.72um

    cell.add_polygon(layer: "metal1", rect: [0um, 0um, width, 480nm])
    cell.add_polygon(layer: "metal1", rect: [0um, height - 480nm, width, 480nm])

    cell.add_port("A0",  at: [0.23um, 0.90um], layer: "li1")
    cell.add_port("A1",  at: [0.23um, 1.82um], layer: "li1")
    cell.add_port("S",   at: [0.69um, 1.36um], layer: "li1")
    cell.add_port("X",   at: [1.38um, 1.36um], layer: "li1")
    cell.add_port("VDD", at: [width / 2.0, height], layer: "metal1")
    cell.add_port("VSS", at: [width / 2.0, 0um],    layer: "metal1")

    return cell
}

/// Positive Edge D-Flip-Flop: sky130_fd_sc_hd__dfxtp_1 (6 sites = 2.76um x 2.72um)
export fn sky130_fd_sc_hd__dfxtp_1() -> CellLayout {
    let mut cell = CellLayout::new(name: "sky130_fd_sc_hd__dfxtp_1")
    let width = 2.76um
    let height = 2.72um

    cell.add_polygon(layer: "metal1", rect: [0um, 0um, width, 480nm])
    cell.add_polygon(layer: "metal1", rect: [0um, height - 480nm, width, 480nm])

    cell.add_port("D",   at: [0.46um, 1.82um], layer: "li1")
    cell.add_port("CLK", at: [0.46um, 0.90um], layer: "li1")
    cell.add_port("Q",   at: [2.30um, 1.36um], layer: "li1")
    cell.add_port("VDD", at: [width / 2.0, height], layer: "metal1")
    cell.add_port("VSS", at: [width / 2.0, 0um],    layer: "metal1")

    return cell
}
