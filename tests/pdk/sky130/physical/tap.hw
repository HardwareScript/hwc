# tests/pdk/sky130/physical/tap.hw
# v0.3.1: Pure CellLayout centered at [0, 0].
# No ambient space mutations. Net binding happens through routing after placement.
import * from @std/primitives/units
import * from @std/primitives/math
import { TapType } from "../common/types"

export fn sky130_tap(type: TapType, size: Measurement) -> CellLayout {
    let mut cell = CellLayout::new(name: "sky130_tap")

    let implant_margin = 130nm
    let half_size = size / 2

    # Tap diffusion opening (centered at [0, 0])
    cell.add_polygon(layer: "tap", rect: [-half_size, -half_size, size, size])

    # Implant mask — depends on tap type
    match type {
        TapType.P_Sub => {
            cell.add_polygon(
                layer: "psdm",
                rect: [
                    -half_size - implant_margin,
                    -half_size - implant_margin,
                    size + (2 * implant_margin),
                    size + (2 * implant_margin)
                ]
            )
            cell.add_polygon(layer: "pdiff", rect: [-half_size, -half_size, size, size], port: "PORT")
            cell.add_contact(from: "pdiff", to: "li1",    at: [0um, 0um], diameter: 170nm)
        },
        TapType.N_Well => {
            cell.add_polygon(
                layer: "nsdm",
                rect: [
                    -half_size - implant_margin,
                    -half_size - implant_margin,
                    size + (2 * implant_margin),
                    size + (2 * implant_margin)
                ]
            )
            cell.add_polygon(layer: "ndiff", rect: [-half_size, -half_size, size, size], port: "PORT")
            cell.add_contact(from: "ndiff", to: "li1",    at: [0um, 0um], diameter: 170nm)
        },
        _ => {}
    }

    cell.add_polygon(layer: "li1",    rect: [-half_size, -half_size, size, size])
    cell.add_polygon(layer: "metal1", rect: [-half_size, -half_size, size, size])
    cell.add_contact(from: "li1", to: "metal1", at: [0um, 0um], diameter: 170nm)

    # Named connection port — net is bound at placement/routing time
    cell.add_port("PORT", at: [0um, 0um], layer: "metal1")

    return cell
}
