# foundry_pdk.hw
import * from @std/primitives/units
import Silicon_P, Silicon_N, Polysilicon, Aluminum, SiO2 from materials
import Titanium_Silicide, Tungsten from materials

profile Silicon_250nm:
    technology: "ASIC"
    
    # Layer stackup declaring physical routing privileges
    stackup:
        substrate:  [material: Silicon_P,   thickness: 100nm, routable: false]
        active:     [material: Silicon_N,   thickness: 200nm, routable: false]
        gate_oxide: [material: SiO2,        thickness: 5.75nm, routable: false] # Based on Cox = 6 fF/um2
        poly:       [material: Polysilicon, thickness: 150nm, routable: local_only]
        d1:         [material: SiO2,        thickness: 500nm, routable: false]
        metal1:     [material: Aluminum,    thickness: 400nm, routable: true]

    # Ohmic bridge rules at metal-semiconductor transitions
    bridge Silicon_N to Aluminum:
        interface: Titanium_Silicide
        thickness: 50nm
        fill: Tungsten

    bridge Silicon_P to Aluminum:
        interface: Titanium_Silicide
        thickness: 50nm
        fill: Tungsten

    bridge Polysilicon to Aluminum:
        interface: Titanium_Silicide
        thickness: 50nm
        fill: Tungsten

    # Aluminum-to-Aluminum via (for vertical connections between metal layers)
    # This handles vias within the same conductor material across different layers
    bridge Aluminum to Aluminum:
        interface: Tungsten  # Use tungsten plug for vertical transition
        thickness: 50nm
        fill: Tungsten



    trace:
        min_width: 250nm   # Minimal width for 0.25um process
        min_spacing: 100nm  # Reduced for tight transistor layouts

    via:
        min_diameter: 250nm
        min_enclosure: 100nm
        min_spacing: 300nm
        shape: cylinder
        default_via_fill: Tungsten

    manufacturing:
        copper_thickness: 400nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm

    clearance:
        high_voltage: 500nm
        safety_factor: 2.0

    layer:
        min_thickness: 100nm
        allowed_conductors: [Aluminum, Polysilicon, Silicon_N, Silicon_P]
        allowed_dielectrics: [SiO2]

    routing:
        max_local_route_length: 10um
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000
        net_priority_VDD: 5
        net_priority_GND: 5

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 10C
