# HardwareScript v0.1.8 Hello World Silicon Inverter
import * from @std/primitives/units
import * from @std/primitives/math
import * from materials
import Silicon_180nm from foundry_pdk

# ============================================================================
# 2. Logical Schematic (The Module)
# ============================================================================
module Inverter_Schematic:
    pins: [
        input VIN,
        output VOUT,
        power VDD,
        ground GND
    ]
    
    # Declare our two devices logically
    add NMOS named M1
    add PMOS named M2
    
    # Establish the logical connections (Netlist)
    route M1.gate to VIN
    route M2.gate to VIN
    
    route M1.drain to VOUT
    route M2.drain to VOUT
    
    route M1.source to GND
    route M1.bulk to GND
    
    route M2.source to VDD
    route M2.bulk to VDD

# ============================================================================
# 3. Transistor Components (The Footprints)
# ============================================================================
component NMOS_Transistor:
    pins: [gate, source, drain, bulk]
    layout:
        # Increased height to 1.8um to accommodate the staggered pads safely
        shape: Rectangle(1.26um, 1.8um, 200nm)
        pin_positions:
            gate at [630nm, 910nm, 1160nm]
            source at [240nm, 310nm, 1160nm]
            drain at [1020nm, 310nm, 1160nm]
            bulk at [630nm, 1510nm, 1160nm]
        
        pad_shapes:
            gate: Rectangle(420nm, 420nm, 0nm)
            source: Rectangle(420nm, 420nm, 0nm)
            drain: Rectangle(420nm, 420nm, 0nm)
            bulk: Rectangle(420nm, 420nm, 0nm)
        
        # 1. Physical Pours (Lower Layers)
        # Gate poly runs through active region
        add pour(Polysilicon) named Gate_Poly on layer: poly:
            device: gate
            boundary: [x: 540nm, y: 0nm] to [x: 720nm, y: 1.12um]
            
        # Widened polysilicon pad region to satisfy via enclosure rules
        # Required: 220nm via + 2x100nm annular ring = 420nm minimum width
        add pour(Polysilicon) named Gate_Poly_Pad on layer: poly:
            device: gate
            boundary: [x: 420nm, y: 700nm] to [x: 840nm, y: 1120nm]
            
        add pour(Silicon_N) named Source_Diff on layer: active:
            device: source
            boundary: [x: 0nm, y: 0nm] to [x: 480nm, y: 1.08um]
            
        add pour(Silicon_N) named Drain_Diff on layer: active:
            device: drain
            boundary: [x: 780nm, y: 0nm] to [x: 1.26um, y: 1.08um]
            
        # Moved bulk contact to active layer (Layer 1) to match active area surface doping
        add pour(Silicon_P) named Bulk_Contact on layer: active:
            device: bulk
            boundary: [x: 420nm, y: 1.30um] to [x: 840nm, y: 1.72um]

        # 2. Metal1 Landing Pads (for routing)
        # Staggered vertically to prevent horizontal short circuits on metal1.
        # Source and Drain sit low, Gate in the middle, Bulk at the top.
        add pour(Aluminum) named Source_Pad on layer: metal1:
            device: source
            boundary: [x: 30nm, y: 100nm] to [x: 450nm, y: 520nm]
            
        add pour(Aluminum) named Drain_Pad on layer: metal1:
            device: drain
            boundary: [x: 810nm, y: 100nm] to [x: 1.23um, y: 520nm]

        add pour(Aluminum) named Gate_Pad on layer: metal1:
            device: gate
            boundary: [x: 420nm, y: 700nm] to [x: 840nm, y: 1120nm]
            
        add pour(Aluminum) named Bulk_Pad on layer: metal1:
            device: bulk
            boundary: [x: 420nm, y: 1300nm] to [x: 840nm, y: 1.72um]

component PMOS_Transistor:
    pins: [gate, source, drain, bulk]
    layout:
        shape: Rectangle(1.26um, 1.8um, 200nm)
        pin_positions:
            gate at [630nm, 910nm, 1160nm]
            source at [240nm, 310nm, 1160nm]
            drain at [1020nm, 310nm, 1160nm]
            bulk at [630nm, 1510nm, 1160nm]
        
        pad_shapes:
            gate: Rectangle(420nm, 420nm, 0nm)
            source: Rectangle(420nm, 420nm, 0nm)
            drain: Rectangle(420nm, 420nm, 0nm)
            bulk: Rectangle(420nm, 420nm, 0nm)
        
        add pour(Polysilicon) named Gate_Poly on layer: poly:
            device: gate
            boundary: [x: 540nm, y: 0nm] to [x: 720nm, y: 1.12um]
            
        add pour(Polysilicon) named Gate_Poly_Pad on layer: poly:
            device: gate
            boundary: [x: 420nm, y: 700nm] to [x: 840nm, y: 1120nm]
            
        add pour(Silicon_P) named Source_Diff on layer: active:
            device: source
            boundary: [x: 0nm, y: 0nm] to [x: 480nm, y: 1.08um]
            
        add pour(Silicon_P) named Drain_Diff on layer: active:
            device: drain
            boundary: [x: 780nm, y: 0nm] to [x: 1.26um, y: 1.08um]
            
        # Moved bulk contact to active layer (Layer 1) to match active area surface doping
        add pour(Silicon_N) named Bulk_Contact on layer: active:
            device: bulk
            boundary: [x: 420nm, y: 1.30um] to [x: 840nm, y: 1.72um]

        add pour(Aluminum) named Source_Pad on layer: metal1:
            device: source
            boundary: [x: 30nm, y: 100nm] to [x: 450nm, y: 520nm]
            
        add pour(Aluminum) named Drain_Pad on layer: metal1:
            device: drain
            boundary: [x: 810nm, y: 100nm] to [x: 1.23um, y: 520nm]

        add pour(Aluminum) named Gate_Pad on layer: metal1:
            device: gate
            boundary: [x: 420nm, y: 700nm] to [x: 840nm, y: 1120nm]
            
        add pour(Aluminum) named Bulk_Pad on layer: metal1:
            device: bulk
            boundary: [x: 420nm, y: 1300nm] to [x: 840nm, y: 1.72um]

# ============================================================================
# 4. Physical Layout (The Space)
# ============================================================================
space CMOS_Inverter implements Inverter_Schematic:
    # Slightly adjusted space dimensions to allow aligned placement of components
    dimensions: 2.16um by 5.4um by 1.36um
    resolution: 1nm
    origin: bl by b
    profile: Silicon_180nm

    nets:
        VIN: signal
        VOUT: signal
        VDD: power
        GND: ground

    # Positioned with space for routing and non-overlapping footprints
    add NMOS_Transistor named M1 at [x: 450nm, y: 720nm] on layer: active
    add PMOS_Transistor named M2 at [x: 450nm, y: 2.88um] on layer: active

    # Connect the logical gates, inputs, and outputs physically on Metal1
    route M1.gate to M2.gate:
        width: 420nm
        layer: metal1
        
    route M1.gate to VIN_Pad:
        width: 420nm
        layer: metal1
        
    route M1.drain to M2.drain:
        width: 420nm
        layer: metal1
        
    route M1.drain to VOUT_Pad:
        width: 420nm
        layer: metal1

    # Connect sources and bulks directly to the power rails
    route M1.source to GND_Rail:
        width: 420nm
        layer: metal1
        
    route M1.bulk to GND_Rail:
        width: 420nm
        layer: metal1
        
    route M2.source to VDD_Rail:
        width: 420nm
        layer: metal1
        
    route M2.bulk to VDD_Rail:
        width: 420nm
        layer: metal1

    # Add IO Pads for VIN and VOUT
    # Placed in the clear middle region between M1 and M2
    add pour(Aluminum) named VIN_Pad on layer: metal1:
        net: VIN
        boundary: [x: 0nm, y: 2.34um] to [x: 0.36um, y: 3.06um]
        
    add pour(Aluminum) named VOUT_Pad on layer: metal1:
        net: VOUT
        boundary: [x: 1.8um, y: 2.34um] to [x: 2.16um, y: 3.06um]

    # Add VDD and GND rails
    add pour(Aluminum) named VDD_Rail on layer: metal1:
        net: VDD
        boundary: [x: 0nm, y: 4.68um] to [x: 2.16um, y: 5.4um]
        
    add pour(Aluminum) named GND_Rail on layer: metal1:
        net: GND
        boundary: [x: 0nm, y: 0nm] to [x: 2.16um, y: 0.72um]
#