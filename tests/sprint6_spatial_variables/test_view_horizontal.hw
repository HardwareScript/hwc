# v0.1.6: Horizontal Orientation (Floor Board)
# Explicitly set to 'horizontal_floor' perspective.

space FloorBoard:
    render:
        view: horizontal_floor
    
    dimensions: 100mm by 100mm by 1.6mm
    grid: 100 by 100 by 1
    origin: bl by b

    add Chip named Processor at [x: 50mm, y: 50mm, z: 0]

component Chip:
    pins: [vcc, gnd]
    layout:
        shape: Rectangle(10mm, 10mm, 1mm)
    render:
        body_color: "#2E7D32" # FR4-like green
