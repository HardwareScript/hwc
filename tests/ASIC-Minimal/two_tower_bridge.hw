# two_tower_bridge.hw
# Testing 3D connectivity: Two vertical contact towers bridged horizontally on Metal 1.
# Spans from Silicon on the left, up to Metal 1, across, and back down to Silicon.

import * from @std/primitives/units
import * from "./minimal_pdk"

# 1. Define the logical schematic (Logical route from A to B)
module TwoTowerBridge:
    pins: [input A, output B]
    route A to B

shape Pad(width: Measurement, height: Measurement):
    geometry:
        Rectangle(width: width, height: height)

space Two_Tower_Space implements TwoTowerBridge:
    # 3um wide, 1um high, tightly bounded to 50nm depth
    dimensions: 3.0um by 1.0um by 50nm
    resolution: 10nm
    origin: bl by b
    profile: ASIC_Flattened

    nets:
        A: { classification: signal, potential: 1.8V, current: 0.1uA }
        B: { classification: signal, potential: 0.0V, current: 0.1uA }

    # ========================================================================
    # Relational Regions
    # ========================================================================
    region Silicon_Zone_A:
        at: [200nm, 300nm]
        boundary: [width: 400nm, height: 400nm]

    # Region B is placed exactly 1.2um to the right of Region A
    # Left edge of Region B will resolve to: 600nm (A right) + 1200nm (spacing) = 1800nm
    region Silicon_Zone_B:
        right_of: Silicon_Zone_A with spacing: 1.2um
        align: y with Silicon_Zone_A
        boundary: [width: 400nm, height: 400nm]

    # ========================================================================
    # Tower A (Left - Net A)
    # ========================================================================
    add plane(Silicon_N) named Pad_A inside: Silicon_Zone_A on layer: active:
        shape: Pad(width: 400nm, height: 400nm)
        at: Silicon_Zone_A.bottom_left
        net: A

    # Via A centered at Silicon_Zone_A center using relational anchor
    add contact(Tungsten) named Via_A at: Silicon_Zone_A.center spanning layer: active to metal1:
        net: A
        diameter: 200nm
        plating_thickness: 5nm

    # ========================================================================
    # Tower B (Right - Net B)
    # ========================================================================
    add plane(Silicon_N) named Pad_B inside: Silicon_Zone_B on layer: active:
        shape: Pad(width: 400nm, height: 400nm)
        at: Silicon_Zone_B.bottom_left
        net: B

    # Via B centered at Silicon_Zone_B center using relational anchor
    add contact(Tungsten) named Via_B at: Silicon_Zone_B.center spanning layer: active to metal1:
        net: B
        diameter: 200nm
        plating_thickness: 5nm

    # ========================================================================
    # Horizontal Interconnect (Metal 1)
    # ========================================================================
    # Routes on Metal 1 from the top of Via_A to the top of Via_B, 
    # completing the physical link between Net A and Net B as declared in the schematic.
    route Via_A to Via_B:
        layer: metal1
        width: 200nm
        intent: Signal
