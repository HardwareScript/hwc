# nmos_transistor.hw
# Full Physical Synthesis of an Active NMOS Transistor
# Uses N-type silicon diffusions (Silicon_N) connected to Ground.

import * from @std/primitives/units
import * from "./minimal_pdk"

export module NMOSTransistor:
    pins: [input In, output Out, ground GND]
    route Out to GND

shape ActiveArea(w: Measurement, h: Measurement):
    geometry:
        Rectangle(width: w, height: h)

shape GatePoly(w: Measurement, h: Measurement):
    geometry:
        Rectangle(width: w, height: h)

shape GroundRail(w: Measurement, h: Measurement):
    geometry:
        Rectangle(width: w, height: h)

export space NMOS_Cell implements NMOSTransistor:
    # 2.0um wide, 3.0um high, 2.0um depth for proper 3D aspect ratio with thick layers
    dimensions: 2.0um by 3.0um by 2.0um
    resolution: 10nm
    origin: bl by b
    profile: Silicon_180nm

    nets:
        In:  { classification: signal, potential: 1.8V, current: 0.1uA }
        Out: { classification: signal, potential: 1.8V, current: 0.1uA }
        GND: { classification: ground, potential: 0.0V, current: 10.0mA }

    # ========================================================================
    # ACTIVE REGIONS (Silicon N-type diffusions)
    # v0.2.1: Refactored to use relational constraints
    # ========================================================================

    # 1. NMOS Source (N-type active diffusion - net GND)
    add pour(Silicon_N) named NMOS_Source on layer: active:
        net: GND
        dimensions: 500nm by 600nm
        at: [x: 650nm, y: 2000nm]  # Center position

    # 2. NMOS Drain (N-type active diffusion - net Out)
    add pour(Silicon_N) named NMOS_Drain on layer: active:
        net: Out
        dimensions: 500nm by 600nm
        align: y with NMOS_Source
        right_of: NMOS_Source by 450nm  # 200nm channel gap + 250nm half-width (center-to-edge spacing)

    # ========================================================================
    # POLYSILICON GATE
    # ========================================================================

    # 3. NMOS Gate (Vertical Polysilicon strip - net In)
    # Centered between source and drain, overlaps each by 100nm
    # Extended vertically for contact pad connection
    add pour(Polysilicon) named Gate_Strip on layer: poly:
        net: In
        dimensions: 400nm by 1200nm
        align: x with (NMOS_Source.right + NMOS_Drain.left) / 2
        align: y with NMOS_Source.center_y

    # ========================================================================
    # METAL 1 PADS AND POWER RAIL
    # ========================================================================

    # 4. GND Source Landing Pad (Metal 1) - Landing pad for source via
    add pour(Aluminum) named GND_Source_Pad on layer: metal1:
        net: GND
        dimensions: 300nm by 300nm
        align: center with NMOS_Source

    # 5. Output Drain Landing Pad (Metal 1) - Landing pad for drain via
    add pour(Aluminum) named Out_Drain_Pad on layer: metal1:
        net: Out
        dimensions: 300nm by 300nm
        align: center with NMOS_Drain

    # 6. Gate Contact Pad (Metal 1) - Landing pad for gate connection
    add pour(Aluminum) named Gate_Pad on layer: metal1:
        net: In
        dimensions: 400nm by 400nm
        align: x with Gate_Strip
        align: y with Gate_Strip.bottom

    # 7. GND Power Rail (Metal 1) - Bottom horizontal power rail
    add pour(Aluminum) named GND_Rail on layer: metal1:
        net: GND
        dimensions: 2000nm by 600nm
        at: [x: 1000nm, y: 400nm]  # Full width at bottom

    # 8. Output Export Pad (Metal 1) - External connection point at top
    add pour(Aluminum) named Out_Export_Pad on layer: metal1:
        net: Out
        dimensions: 600nm by 400nm
        at: [x: 1500nm, y: 2800nm]

    # ========================================================================
    # CONTACTS (Vias)
    # v0.2.1: Using relational alignment for centering
    # ========================================================================

    # 9. Source Via (Active to Metal1)
    add contact(Titanium_Silicide) named Via_Source spanning layer: active to metal1:
        net: GND
        diameter: 200nm
        plating_thickness: 5nm
        align: center with NMOS_Source

    # 10. Drain Via (Active to Metal1)
    add contact(Titanium_Silicide) named Via_Drain spanning layer: active to metal1:
        net: Out
        diameter: 200nm
        plating_thickness: 5nm
        align: center with NMOS_Drain

    # 11. Gate Via (Poly to Metal1)
    add contact(Titanium_Silicide) named Via_Gate spanning layer: poly to metal1:
        net: In
        diameter: 200nm
        plating_thickness: 5nm
        align: x with Gate_Strip
        align: y with (Gate_Strip.bottom + Gate_Pad.top) / 2  # Centered in overlap

    # ========================================================================
    # PHYSICAL INTERCONNECTS (Metal 1 Routing)
    # ========================================================================

    # Ground Strap: Connects NMOS Source landing pad down to GND Rail (Vertical line)
    route GND_Source_Pad to GND_Rail:
        net: GND
        width: 200nm
        layer: metal1
        intent: PowerRail

    # Signal Interconnect: Connects NMOS Drain landing pad up to Out Export Pad
    route Out_Drain_Pad to Out_Export_Pad:
        net: Out
        width: 200nm
        layer: metal1
        intent: Signal
