# pmos_transistor.hw
# Full Physical Synthesis of an Active PMOS Transistor
# Uses P-type silicon diffusions (Silicon_P) connected to VDD.

import * from @std/primitives/units
import * from "./minimal_pdk"

export module PMOSTransistor:
    pins: [input In, output Out, power VDD]
    route Out to VDD

shape ActiveArea(w: Measurement, h: Measurement):
    geometry:
        Rectangle(width: w, height: h)

shape GatePoly(w: Measurement, h: Measurement):
    geometry:
        Rectangle(width: w, height: h)

shape PowerRail(w: Measurement, h: Measurement):
    geometry:
        Rectangle(width: w, height: h)

export space PMOS_Cell implements PMOSTransistor:
    # 2.0um wide, 3.0um high, 2.0um depth for proper 3D aspect ratio with thick layers
    dimensions: 2.0um by 3.0um by 2.0um
    resolution: 10nm
    origin: bl by b
    profile: Silicon_180nm

    nets:
        In:  { classification: signal, potential: 1.8V, current: 0.1uA }
        Out: { classification: signal, potential: 1.8V, current: 0.1uA }
        VDD: { classification: power,  potential: 1.8V, current: 10.0mA }

    # ========================================================================
    # ACTIVE REGIONS (Silicon P-type diffusions)
    # v0.2.1: Refactored to use relational constraints
    # ========================================================================

    # 1. PMOS Source (P-type active diffusion - net VDD)
    add pour(Silicon_P) named PMOS_Source on layer: active:
        net: VDD
        dimensions: 500nm by 600nm
        at: [x: 650nm, y: 1000nm]  # Center position

    # 2. PMOS Drain (P-type active diffusion - net Out)
    add pour(Silicon_P) named PMOS_Drain on layer: active:
        net: Out
        dimensions: 500nm by 600nm
        align: center_y with PMOS_Source
        right_of: PMOS_Source by 450nm  # 200nm channel gap + 250nm half-width (center-to-edge spacing)

    # ========================================================================
    # POLYSILICON GATE
    # ========================================================================

    # 3. PMOS Gate (Vertical Polysilicon strip - net In)
    # Centered between source and drain, overlaps each by 100nm
    # Extended vertically for contact pad connection
    add pour(Polysilicon) named Gate_Strip on layer: poly:
        net: In
        dimensions: 400nm by 1400nm
        align: center_x with (PMOS_Source.right + PMOS_Drain.left) / 2
        align: center_y with PMOS_Source.center_y

    # ========================================================================
    # METAL 1 PADS AND POWER RAIL
    # ========================================================================

    # 4. VDD Source Landing Pad (Metal 1) - Landing pad for source via
    add pour(Aluminum) named VDD_Source_Pad on layer: metal1:
        net: VDD
        dimensions: 300nm by 300nm
        align: center_x with PMOS_Source
        align: center_y with PMOS_Source

    # 5. Output Drain Landing Pad (Metal 1) - Landing pad for drain via
    add pour(Aluminum) named Out_Drain_Pad on layer: metal1:
        net: Out
        dimensions: 300nm by 300nm
        align: center_x with PMOS_Drain
        align: center_y with PMOS_Drain

    # 6. Gate Contact Pad (Metal 1) - Landing pad for gate connection
    add pour(Aluminum) named Gate_Pad on layer: metal1:
        net: In
        dimensions: 400nm by 400nm
        align: center_x with Gate_Strip
        align: center_y with Gate_Strip.top

    # 7. VDD Power Rail (Metal 1) - Top horizontal power rail
    add pour(Aluminum) named VDD_Rail on layer: metal1:
        net: VDD
        dimensions: 2000nm by 600nm
        at: [x: 1000nm, y: 2600nm]  # Full width at top

    # 8. Output Export Pad (Metal 1) - External connection point at bottom
    add pour(Aluminum) named Out_Export_Pad on layer: metal1:
        net: Out
        dimensions: 600nm by 400nm
        at: [x: 1500nm, y: 200nm]

    # ========================================================================
    # CONTACTS (Vias)
    # v0.2.1: Using relational alignment for centering
    # ========================================================================

    # 9. Source Via (Active to Metal1)
    add contact(Titanium_Silicide) named Via_Source spanning layer: active to metal1:
        net: VDD
        diameter: 200nm
        plating_thickness: 5nm
        align: center_x with PMOS_Source
        align: center_y with PMOS_Source

    # 10. Drain Via (Active to Metal1)
    add contact(Titanium_Silicide) named Via_Drain spanning layer: active to metal1:
        net: Out
        diameter: 200nm
        plating_thickness: 5nm
        align: center_x with PMOS_Drain
        align: center_y with PMOS_Drain

    # 11. Gate Via (Poly to Metal1)
    add contact(Titanium_Silicide) named Via_Gate spanning layer: poly to metal1:
        net: In
        diameter: 200nm
        plating_thickness: 5nm
        align: center_x with Gate_Strip
        align: center_y with (Gate_Strip.top + Gate_Pad.bottom) / 2  # Centered in overlap

    # ========================================================================
    # PHYSICAL INTERCONNECTS (Metal 1 Routing)
    # ========================================================================

    # Power Strap: Connects PMOS Source landing pad up to VDD Rail (Vertical line)
    route VDD_Source_Pad to VDD_Rail:
        net: VDD
        width: 200nm
        layer: metal1
        intent: PowerRail

    # Signal Interconnect: Connects PMOS Drain landing pad down to Out Export Pad
    route Out_Drain_Pad to Out_Export_Pad:
        net: Out
        width: 200nm
        layer: metal1
        intent: Signal
