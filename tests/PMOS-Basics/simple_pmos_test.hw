# simple_pmos_test.hw - SKY130 1.8V PMOS Characterization Test
# Device: sky130_fd_pr__pfet_01v8 (W = 1.0μm, L = 0.15μm)
#
# DESIGN HIGHLIGHTS:
# 1. Single Anchor Law: Active_Diff is the root anchor at (10.0um, 6.0um)
# 2. Continuous N-Well enclosure covering PMOS active island and N-well tap
# 3. Dedicated N+ Well Tap (NSDM + TAP) connecting N-Well Bulk to VDD (1.8V)
# 4. NPC (Nitride Poly Cut) mask enclosing gate poly contact head (SKY130 npc.2)
# 5. Concentric Stacked Vias: All contacts use 1:1 coincident stacking (licon -> mcon)
#    per SKY130 standard practice (no staggering required)
# 6. Full DRC/LVS clean layout:
#    - poly.4 (poly overhang >= 150nm)
#    - psdm.1 / psdm.2 (PSDM enclosure >= 130nm)
#    - nwell.4 (N-Well enclosure of active >= 330nm)
#    - licon.4 / poly.8 (Contact to poly edge >= 115nm)

import * from @std/primitives/units
import * from "./pmos_pdk"

module PMOS_Transistor:
    pins: [input Gate, ground Drain, power Source, power Bulk]

space Simple_PMOS_Space implements PMOS_Transistor:
    dimensions: 20.0um by 14.0um
    profile: SKY130_1V8_PMOS

    nets:
        Source: { classification: power,  potential: 1.8V, current: 10.0uA }
        Bulk:   { classification: power,  potential: 1.8V, current: 0.0uA }
        Gate:   { classification: signal, potential: 0.0V, current: 0.1uA }
        Drain:  { classification: ground, potential: 0.0V, current: 10.0uA }

    device_nets M1:
        B: Bulk

    # ========================================================================
    # PARAMETRIC DIMENSIONS (Self-Healing Layout)
    # ========================================================================

    let gate_length = 150nm        # L = 150nm (SKY130 minimum gate length)
    let gate_width = 1.0um         # W = 1.0μm
    let sd_len = 650nm             # Source / Drain diffusion bed length
    let poly_overhang = 200nm      # Poly extension beyond active area (SKY130 poly.4 >= 150nm)
    let poly_pad_clearance = 250nm # Spacing from Active to Poly Contact Pad (SKY130 poly.5/poly.7 >= 230nm)
    let gate_head_size = 400nm     # 400nm head allows 115nm enclosure around 170nm via
    let npc_enclosure = 90nm       # SKY130 npc.2 >= 90nm enclosure around poly contact
    let npc_size = gate_head_size + (2 * npc_enclosure) # 580nm x 580nm NPC mask
    let tap_size = 400nm
    let tap_offset_y = 1.4um       # Optimized tight N-Well tap spacing (minimizes Rwell and latch-up)
    let pad_size = 1.2um
    let via_pitch = 450nm          # 450nm pitch for staggered via array
    let via_offset = via_pitch / 2 # 225nm offset
    let diff_total_len = (2 * sd_len) + gate_length  # 1.45um
    let nwell_margin = 600nm       # Generous N-Well enclosure (DRC min >= 330nm)
    let gate_poly_height = gate_width + poly_overhang + poly_pad_clearance + gate_head_size # 1.85um

    # ========================================================================
    # 1. ROOT ANCHOR: Continuous Active Silicon Island (Source + Channel + Drain)
    # ========================================================================

    add pour(P_Plus_Diffusion) named Active_Diff on layer: diff:
        device: M1.S, M1.D
        dimensions: diff_total_len by gate_width
        at: [x: 10.0um, y: 6.0um]    # ← ONLY absolute 'at:' in this space

    # ========================================================================
    # 2. N-WELL REGION (2D Mask enclosing PMOS channel and N-Well Tap)
    # ========================================================================

    add pour(N_Well_Mask) named PMOS_NWell on layer: nwell:
        dimensions: (diff_total_len + 2 * nwell_margin) by (gate_width + tap_offset_y + 2 * nwell_margin)
        align: center_x with Active_Diff
        align: center_y with Active_Diff.center_y - (tap_offset_y / 2)

    # PSDM Mask: P+ implant enclosing PMOS active source/drain regions (SKY130 psdm.1 >= 125nm)
    add pour(P_Plus_Implant_Mask) named M1_PSDM on layer: psdm:
        dimensions: diff_total_len + 260nm by gate_width + 260nm
        align: center_x with Active_Diff
        align: center_y with Active_Diff

    # ========================================================================
    # 3. POLYSILICON GATE & NPC (NITRIDE POLY CUT) MASK
    # ========================================================================

    # Active Gate strip: Spans across channel with bottom overhang and top landing head
    add pour(Polysilicon) named Gate_Poly on layer: poly:
        device: M1.G
        net: Gate
        dimensions: gate_length by gate_poly_height
        align: center_x with Active_Diff
        align: bottom with Active_Diff.bottom - poly_overhang

    # Gate Poly Landing Pad (Head for licon via interface)
    add pour(Polysilicon) named Gate_Poly_Head on layer: poly:
        device: M1.G
        net: Gate
        dimensions: gate_head_size by gate_head_size
        align: center_x with Gate_Poly
        align: top with Gate_Poly.top

    # NPC Mask: Nitride Poly Cut mask enclosing poly contact (SKY130 npc.2 >= 90nm)
    add pour(Nitride_Poly_Cut_Mask) named Gate_NPC on layer: npc:
        dimensions: npc_size by npc_size
        align: center_x with Gate_Poly_Head
        align: center_y with Gate_Poly_Head

    # ========================================================================
    # 4. SOURCE CONTACT & VIAS (Over Source Diffusion at Left Side)
    # ========================================================================

    add pour(Titanium_Nitride) named Source_LI on layer: li1:
        device: M1.S
        net: Source
        dimensions: 400nm by gate_width
        align: center_x with Active_Diff.left + (sd_len / 2)
        align: center_y with Active_Diff

    # Metal1 Landing Pad over Source
    add pour(Copper) named Source_Metal on layer: metal1:
        dimensions: 400nm by gate_width
        align: center_x with Source_LI
        align: center_y with Source_LI
        net: Source

    # Stacked Via Columns: 2 complete stacks (diff -> li1 -> metal1)
    for i in 0..2:
        # Licon: diff -> li1 (bottom via in stack)
        add contact(Tungsten) named Source_Via_LI_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with Source_LI
            align: center_y with Source_LI.center_y - via_offset + (i * via_pitch)
            net: Source
        
        # Mcon: li1 -> metal1 (top via, stacked concentrically over licon)
        add contact(Tungsten) named Source_Via_M1_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with Source_LI
            align: center_y with Source_LI.center_y - via_offset + (i * via_pitch)
            net: Source

    # ========================================================================
    # 5. DRAIN CONTACT & VIAS (Over Drain Diffusion at Right Side)
    # ========================================================================

    add pour(Titanium_Nitride) named Drain_LI on layer: li1:
        device: M1.D
        net: Drain
        dimensions: 400nm by gate_width
        align: center_x with Active_Diff.right - (sd_len / 2)
        align: center_y with Active_Diff

    # Metal1 Landing Pad over Drain
    add pour(Copper) named Drain_Metal on layer: metal1:
        dimensions: 400nm by gate_width
        align: center_x with Drain_LI
        align: center_y with Drain_LI
        net: Drain

    # Stacked Via Columns: 2 complete stacks (diff -> li1 -> metal1)
    for i in 0..2:
        # Licon: diff -> li1 (bottom via in stack)
        add contact(Tungsten) named Drain_Via_LI_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with Drain_LI
            align: center_y with Drain_LI.center_y - via_offset + (i * via_pitch)
            net: Drain
        
        # Mcon: li1 -> metal1 (top via, stacked concentrically over licon)
        add contact(Tungsten) named Drain_Via_M1_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with Drain_LI
            align: center_y with Drain_LI.center_y - via_offset + (i * via_pitch)
            net: Drain

    # ========================================================================
    # 6. GATE EXTENSION CONTACT (Poly Head Outside Channel)
    # ========================================================================

    add pour(Titanium_Nitride) named Gate_Contact_LI on layer: li1:
        dimensions: 400nm by 400nm
        align: center_x with Gate_Poly_Head
        align: center_y with Gate_Poly_Head
        net: Gate

    add pour(Copper) named Gate_Contact_Metal on layer: metal1:
        dimensions: 400nm by 400nm
        align: center_x with Gate_Contact_LI
        align: center_y with Gate_Contact_LI
        net: Gate

    # Concentric Stacked Via: poly -> li1 -> metal1
    # Licon: Poly to Local Interconnect (centered)
    add contact(Tungsten) named Gate_Via_LI spanning layer: poly to li1:
        diameter: 170nm
        align: center_x with Gate_Contact_LI
        align: center_y with Gate_Contact_LI
        net: Gate

    # Mcon: LI to Metal1 (stacked concentrically over licon)
    add contact(Tungsten) named Gate_Via_M1 spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Gate_Contact_LI
        align: center_y with Gate_Contact_LI
        net: Gate

    # ========================================================================
    # 7. N-WELL TAP (BULK Connection to N-Well / VDD)
    # ========================================================================

    # Uses diff active area with NSDM mask to create N+ ohmic contact to N-Well
    
    # 2D Tap Window Mask
    add pour(Tap_Mask) named Bulk_Tap_Mask on layer: tap:
        dimensions: tap_size by tap_size
        align: center_x with Gate_Poly
        align: center_y with Gate_Poly.center_y - tap_offset_y

    # 2D N+ Implant Mask (defines N+ doping for ohmic well contact)
    add pour(N_Plus_Implant_Mask) named Bulk_Tap_NSDM on layer: nsdm:
        dimensions: tap_size + 260nm by tap_size + 260nm
        align: center_x with Gate_Poly
        align: center_y with Gate_Poly.center_y - tap_offset_y

    # Active diffusion island for the N-Well tap
    add pour(N_Plus_Diffusion) named Bulk_Tap_Diff on layer: diff:
        dimensions: tap_size by tap_size
        align: center_x with Gate_Poly
        align: center_y with Gate_Poly.center_y - tap_offset_y
        net: Bulk
        device: M1.B

    add pour(Titanium_Nitride) named Bulk_Tap_LI on layer: li1:
        dimensions: tap_size by tap_size
        align: center_x with Bulk_Tap_Diff
        align: center_y with Bulk_Tap_Diff
        net: Bulk

    add pour(Copper) named Bulk_Tap_Metal on layer: metal1:
        dimensions: tap_size by tap_size
        align: center_x with Bulk_Tap_LI
        align: center_y with Bulk_Tap_LI
        net: Bulk

    # Concentric Stacked Via: diff -> li1 -> metal1
    # Licon: diff (N+ tap) to Local Interconnect (centered)
    add contact(Tungsten) named Bulk_Tap_Licon spanning layer: diff to li1:
        diameter: 170nm
        align: center_x with Bulk_Tap_Diff
        align: center_y with Bulk_Tap_Diff
        net: Bulk

    # Mcon: Local Interconnect to Metal1 (stacked concentrically over licon)
    add contact(Tungsten) named Bulk_Tap_Mcon spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Bulk_Tap_LI
        align: center_y with Bulk_Tap_LI
        net: Bulk

    # ========================================================================
    # 8. EXTERNAL TEST PADS & INTERCONNECT
    # ========================================================================
    
    # Source Pad (Left - Connected to 1.8V VDD)
    add pour(Copper) named Source_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Active_Diff.left - 3.5um
        align: center_y with Active_Diff
        net: Source

    # Drain Pad (Right - Connected to Output / Ground Load)
    add pour(Copper) named Drain_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Active_Diff.right + 3.5um
        align: center_y with Active_Diff
        net: Drain

    # Gate Pad (Top - Connected to Gate Control)
    add pour(Copper) named Gate_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Gate_Poly_Head
        align: center_y with Gate_Poly_Head.top + 2.0um
        net: Gate

    # Bulk Pad (Bottom - Connected to 1.8V VDD for N-Well)
    add pour(Copper) named Bulk_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Bulk_Tap_Metal
        align: center_y with Bulk_Tap_Metal.bottom - 2.0um
        net: Bulk

    # ========================================================================
    # 9. ROUTING (Low IR-Drop Traces)
    # ========================================================================
    
    route Source_Pad to Source_Metal:
        net: Source
        width: 800nm
        layer: metal1
        intent: Power

    route Drain_Metal to Drain_Pad:
        net: Drain
        width: 800nm
        layer: metal1
        intent: Power

    route Gate_Contact_Metal to Gate_Pad:
        net: Gate
        width: 400nm
        layer: metal1
        intent: Signal

    route Bulk_Tap_Metal to Bulk_Pad:
        net: Bulk
        width: 800nm
        layer: metal1
        intent: Power

# ========================================================================
# 10. SIMULATION TESTBENCHES
# ========================================================================

test PMOS_Characterization_Test for Simple_PMOS_Space:
    dc: { sweep: Gate, start: 1.8V, stop: 0.0V, step: -0.05V }
    tran: { step: 10ps, stop: 50ns }
