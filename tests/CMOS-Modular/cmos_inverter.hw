# cmos_inverter.hw - Tapeout-Ready SkyWater SKY130 1.8V Modular CMOS Inverter
# Hierarchical Integration of PMOS_Cell and NMOS_Cell Sub-Spaces

import * from @std/primitives/units
import * from "./cmos_pdk"
import * from "./pmos_cell"
import * from "./nmos_cell"

# ============================================================================
# LOGICAL MODULE (Schematic Interface)
# ============================================================================

module CMOS_Inverter:
    pins: [input In, output Out, power VDD, ground VSS]

# ============================================================================
# PHYSICAL SYNTHESIS SPACE (Hierarchical Composition)
# ============================================================================

space CMOS_Inverter_Space implements CMOS_Inverter:
    dimensions: 20.0um by 18.0um
    profile: SKY130_1V8_CMOS

    nets:
        VDD: { classification: power,  potential: 1.8V, current: 20.0uA }
        VSS: { classification: ground, potential: 0.0V, current: 20.0uA }
        In:  { classification: signal, potential: 1.8V, current: 0.1uA }
        Out: { classification: signal, current: 20.0uA }

    # ========================================================================
    # 1. HIERARCHICAL PHYSICAL PLACEMENT (Sub-Space Instantiations)
    # ========================================================================

    # Place PMOS Standard Cell in the upper section
    add space PMOS_Cell named PMOS_Inst at [x: 5.0um, y: 11.0um, z: 0nm] rotated 0deg:
        net_map: [
            VDD: VDD,
            Out: Out,
            In: In
        ]

    # Place NMOS Standard Cell in the lower section
    add space NMOS_Cell named NMOS_Inst at [x: 5.0um, y: 2.0um, z: 0nm] rotated 0deg:
        net_map: [
            VSS: VSS,
            Out: Out,
            In: In
        ]

    # ========================================================================
    # 2. EXTERNAL TEST PADS (100% Relational Hierarchical Anchoring)
    # ========================================================================
    let pad_size = 1.2um
    let pad_pitch_x = 3.0um
    let pad_pitch_y = 2.5um

    # VDD Supply Pad - aligned left of PMOS Source, shifted up to avoid VSS_Pad
    add pour(Aluminum) named VDD_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with PMOS_Inst.Source_Pad.left - pad_pitch_x
        align: center_y with PMOS_Inst.Source_Pad.center_y + pad_pitch_y
        net: VDD

    # VSS Ground Pad - aligned left of NMOS Source, shifted down to avoid VDD_Pad
    add pour(Aluminum) named VSS_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with NMOS_Inst.Source_Pad.left - pad_pitch_x
        align: center_y with NMOS_Inst.Source_Pad.center_y - pad_pitch_y
        net: VSS

    # Input Signal Pad - aligned left of gate interconnect midpoint
    add pour(Aluminum) named Input_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with PMOS_Inst.Gate_Pad.left - pad_pitch_x
        align: center_y with PMOS_Inst.Gate_Pad.center_y + ((NMOS_Inst.Gate_Pad.center_y - PMOS_Inst.Gate_Pad.center_y) / 2)
        net: In

    # Output Signal Pad - aligned right of drain interconnect midpoint
    add pour(Aluminum) named Output_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with PMOS_Inst.Out_Pad.right + pad_pitch_x
        align: center_y with PMOS_Inst.Out_Pad.center_y + ((NMOS_Inst.Out_Pad.center_y - PMOS_Inst.Out_Pad.center_y) / 2)
        net: Out

    # ========================================================================
    # 3. GLOBAL SYSTEM ROUTING (Connecting Sub-Cells to Pads & Each Other)
    # ========================================================================

    # Interconnect Gates (PMOS Gate to NMOS Gate)
    route PMOS_Inst.Gate_Pad to NMOS_Inst.Gate_Pad:
        net: In
        width: 200nm
        layer: metal1
        intent: Signal

    # Route Input Pad to Gate Interconnect
    route Input_Pad to PMOS_Inst.Gate_Pad:
        net: In
        width: 200nm
        layer: metal1
        intent: Signal

    # Interconnect Drains (PMOS Drain to NMOS Drain - 250nm clearance from Gate)
    route PMOS_Inst.Out_Pad to NMOS_Inst.Out_Pad:
        net: Out
        width: 200nm
        layer: metal1
        intent: Signal

    # Route Drain Interconnect to Output Pad
    route PMOS_Inst.Out_Pad to Output_Pad:
        net: Out
        width: 200nm
        layer: metal1
        intent: Signal

    # VDD Rail Connection
    route VDD_Pad to PMOS_Inst.Source_Pad:
        net: VDD
        width: 500nm
        layer: metal1
        intent: Power

    # VSS Rail Connection
    route VSS_Pad to NMOS_Inst.Source_Pad:
        net: VSS
        width: 500nm
        layer: metal1
        intent: Power

# ============================================================================
# 4. SIMULATION TESTBENCHES
# ============================================================================

test CMOS_Inverter_Modular_Test for CMOS_Inverter_Space:
    dc: { sweep: In, start: 0.0V, stop: 1.8V, step: 0.02V }
    tran: { step: 5ps, stop: 10ns }
