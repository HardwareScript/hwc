## ============================================================================
## Sprint 4.1: LVS Engine Test - Device Count Mismatch
## ============================================================================
##
## This test verifies that LVS detects device count mismatches.
## Expected: LVS FAILED - Device count mismatch (2 logical, 1 physical)

import * from @std/primitives/units

## ============================================================================
## Logical Schematic (Module) - 2 devices
## ============================================================================

module InverterLogic:
    pins: [
        input VIN,
        output VOUT,
        power VDD,
        ground GND
    ]
    
    add NMOS named M1
    route M1.gate to VIN
    route M1.source to GND
    route M1.drain to VOUT
    route M1.bulk to GND
    
    add PMOS named M2
    route M2.gate to VIN
    route M2.source to VDD
    route M2.drain to VOUT
    route M2.bulk to VDD

## ============================================================================
## Physical Layout (Space) - Only 1 device (missing M2)
## ============================================================================

space InverterLayout implements InverterLogic:
    dimensions: 2mm by 2mm by 1mm
    grid: 20 by 20 by 10
    
    nets:
        VIN: signal
        VOUT: signal
        VDD: power
        GND: ground
    
    ## ========================================================================
    ## NMOS Transistor (M1) - Physically Valid Layout
    ## ========================================================================
    ## Strategy: Make Gate overlap Source/Drain regions to form proper transistor
    ## Gate (Polysilicon) crosses over channel region between Source and Drain
    
    ## M1 Source (Silicon_N) - Bottom region
    add pour(Silicon_N) named M1_Source on z:3:
        net: GND
        boundary: [x: 400um, y: 200um] to [x: 600um, y: 500um]
        device: M1.source
    
    ## M1 Drain (Silicon_N) - Top region
    add pour(Silicon_N) named M1_Drain on z:3:
        net: VOUT
        boundary: [x: 400um, y: 700um] to [x: 600um, y: 1000um]
        device: M1.drain
    
    ## M1 Gate (Polysilicon) - Crosses over channel (overlaps Source and Drain)
    ## This creates the transistor structure: Source-Gate-Drain
    add pour(Polysilicon) named M1_Gate on z:5:
        net: VIN
        boundary: [x: 400um, y: 450um] to [x: 600um, y: 750um]
        device: M1.gate
    
    ## M1 Bulk (Silicon_P) - Substrate contact (adjacent to Source)
    ## Positioned next to Source region for physical connectivity via metal layer
    add pour(Silicon_P) named M1_Bulk on z:3:
        net: GND
        boundary: [x: 400um, y: 100um] to [x: 600um, y: 190um]
        device: M1.bulk
    
    ## ========================================================================
    ## Metal routing for connectivity (makes layout physically valid)
    ## ========================================================================
    
    ## GND metal plane (connects M1.source and M1.bulk)
    add pour(Aluminum) named GND_Metal on z:7:
        net: GND
        boundary: [x: 350um, y: 50um] to [x: 650um, y: 550um]
    
    ## VOUT metal trace (connects M1.drain)
    add pour(Aluminum) named VOUT_Metal on z:7:
        net: VOUT
        boundary: [x: 350um, y: 650um] to [x: 650um, y: 1050um]
    
    ## VIN metal trace (connects M1.gate)
    add pour(Aluminum) named VIN_Metal on z:7:
        net: VIN
        boundary: [x: 350um, y: 450um] to [x: 650um, y: 750um]
    
    ## Vias connecting silicon to metal layers
    add contact(Tungsten) named Via_M1_Bulk net: GND at [x: 500um, y: 145um] spanning z:3 to z:7:
        diameter: 80um
    
    add contact(Tungsten) named Via_M1_Source net: GND at [x: 500um, y: 350um] spanning z:3 to z:7:
        diameter: 100um
    
    add contact(Tungsten) named Via_M1_Drain net: VOUT at [x: 500um, y: 850um] spanning z:3 to z:7:
        diameter: 100um
    
    add contact(Tungsten) named Via_M1_Gate net: VIN at [x: 500um, y: 600um] spanning z:5 to z:7:
        diameter: 100um
    
    ## ========================================================================
    ## M2 is MISSING - This should cause LVS failure!
    ## ========================================================================
    ## Expected: LVS detects device count mismatch (2 logical, 1 physical)
    ## Physical validation should PASS (M1 is properly connected)
    ## LVS validation should FAIL (M2 is missing)
