## Strategy Auto-Routing Test — Prescriptive Net Policies (v0.1.8)
##
## 4 nets with different routing requirements.
## Each net has an explicit route net: policy that binds a strategy globally.
## The Steiner Minimum Tree algorithm decomposes each net into segments,
## and the auto router applies the declared strategy to guide each segment.

import * from @std/primitives/units
import * from @std/routing/strategies
import FR4 from @std/materials/insulators
import Copper from @std/materials/conductors

profile PCB_2_LAYER:
    description: "2-layer PCB for strategy routing test"

    stackup:
        top:    [material: Copper, thickness: 35um]
        d1:     [material: FR4,    thickness: 1200um]
        bottom: [material: Copper, thickness: 35um]

    via:
        min_diameter: 0.3mm
        min_annular_ring: 0.15mm
        min_spacing: 0.2mm

    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm

    bridge Copper to Copper: Copper

    manufacturing:
        copper_thickness: 35um

    clearance:
        high_voltage: 2mm
        safety_factor: 2.0

    layer:
        min_thickness: 0.1mm

component Pad:
    pins: [p]
    layout:
        shape: Rectangle(1mm, 1mm, 35um)
        pin_positions:
            p at [0mm, 0mm]
        add pour(Copper) named Pad_Copper on layer: self:
            device: p
            boundary: [x: 0mm, y: 0mm] to [x: 1mm, y: 1mm]
            net: p
            thickness: 35um

space Strategy_Router_Test:
    dimensions: 50mm by 50mm by 1.27mm
    resolution: 1nm
    origin: bl by b
    profile: PCB_2_LAYER

    nets:
        DDR5_BUS: signal
        PCIE_BUS: signal
        USB_BUS: signal
        RELAXED_BUS: signal

    ## ====================================================================
    ## ROW 0: DDR5 pads at y=10mm
    ## ====================================================================
    for i in 0..2:
        add Pad named D0[i] at [x: i * 15mm + 5mm, y: 10mm] on layer: top:
            net: [p: DDR5_BUS]

    ## ====================================================================
    ## ROW 1: PCIe pads at y=20mm
    ## ====================================================================
    for i in 0..2:
        add Pad named P0[i] at [x: i * 15mm + 5mm, y: 20mm] on layer: top:
            net: [p: PCIE_BUS]

    ## ====================================================================
    ## ROW 2: USB pads at y=30mm
    ## ====================================================================
    for i in 0..2:
        add Pad named U0[i] at [x: i * 15mm + 5mm, y: 30mm] on layer: top:
            net: [p: USB_BUS]

    ## ====================================================================
    ## ROW 3: Relaxed pads at y=40mm
    ## ====================================================================
    for i in 0..2:
        add Pad named R0[i] at [x: i * 15mm + 5mm, y: 40mm] on layer: top:
            net: [p: RELAXED_BUS]

    ## ====================================================================
    ## PRESCRIPTIVE ROUTE POLICIES
    ## ====================================================================

    ## DDR5: Tight length matching (0.1mm tolerance, Trombone pattern)
    route net: DDR5_BUS:
        strategy: DDR5_Match

    ## PCIe: Very tight differential pair matching (0.05mm tolerance, Serpentine)
    route net: PCIE_BUS:
        strategy: PCIe_Gen4_Match

    ## USB: Medium tolerance (0.15mm, Trombone)
    route net: USB_BUS:
        strategy: USB3_Differential

    ## Relaxed: Loose tolerance for low-speed signals (0.5mm, Zigzag)
    route net: RELAXED_BUS:
        strategy: Relaxed_Match
