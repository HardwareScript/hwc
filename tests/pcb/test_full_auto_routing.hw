## PCB Auto-Routing Test — 16 Pads (v0.1.8)
##
## 4×4 grid of copper pads connected to one logical net (ALL_PADS).
## No explicit routes are provided. The Adaptive Router will decide the topology.

import * from @std/primitives/units
import FR4 from @std/materials/insulators
import Copper from @std/materials/conductors

profile PCB_2_LAYER:
    description: "2-layer PCB for auto-routing test"

    stackup:
        top:    [material: Copper, thickness: 35um]
        d1:     [material: FR4,    thickness: 1200um]
        bottom: [material: Copper, thickness: 35um]

    via:
        min_diameter: 0.3mm
        min_annular_ring: 0.15mm
        min_spacing: 0.2mm

    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm

    bridge Copper to Copper: Copper

    manufacturing:
        copper_thickness: 35um

    clearance:
        high_voltage: 2mm
        safety_factor: 2.0

    layer:
        min_thickness: 0.1mm

component Pad:
    pins: [p]
    layout:
        shape: Rectangle(1mm, 1mm, 35um)
        pin_positions:
            p at [0mm, 0mm]
        add pour(Copper) named Pad_Copper on layer: self:
            device: p
            boundary: [x: 0mm, y: 0mm] to [x: 1mm, y: 1mm]
            net: p
            thickness: 35um

space PCB_AutoRoute_16Pad:
    dimensions: 30mm by 30mm by 1.27mm
    resolution: 1nm
    origin: bl by b
    profile: PCB_2_LAYER

    nets:
        ALL_PADS: signal

    ## ====================================================================
    ## ROW 0: 4 pads at y=4mm
    ## ====================================================================
    for i in 0..3:
        add Pad named J0[i] at [x: i * 8mm + 4mm, y: 4mm] on layer: top:
            net: [p: ALL_PADS]

    ## ====================================================================
    ## ROW 1: 4 pads at y=11mm
    ## ====================================================================
    for i in 0..3:
        add Pad named J1[i] at [x: i * 8mm + 4mm, y: 11mm] on layer: top:
            net: [p: ALL_PADS]

    ## ====================================================================
    ## ROW 2: 4 pads at y=18mm
    ## ====================================================================
    for i in 0..3:
        add Pad named J2[i] at [x: i * 8mm + 4mm, y: 18mm] on layer: top:
            net: [p: ALL_PADS]

    ## ====================================================================
    ## ROW 3: 4 pads at y=25mm
    ## ====================================================================
    for i in 0..3:
        add Pad named J3[i] at [x: i * 8mm + 4mm, y: 25mm] on layer: top:
            net: [p: ALL_PADS]

    ## NO EXPLICIT ROUTES.
    ## The compiler will use the Steiner Minimum Tree algorithm to connect ALL_PADS.
