# cmos_inverter.hw - Tapeout-Ready SkyWater SKY130 1.8V CMOS Inverter (100% Relational)
#
# ARCHITECTURAL PURITY:
# 1. Single Anchor Law: NMOS_Diff is the root anchor at [x: 10.0um, y: 5.0um]
# 2. Perfect Symmetrical CMOS Inverter:
#    - NMOS: W = 1.0μm, L = 150nm
#    - PMOS: W = 2.0μm, L = 150nm (2:1 Wp/Wn ratio for symmetric switching threshold ~0.9V)
# 3. Continuous Single-Stripe Polysilicon Gate connecting PMOS & NMOS channels directly
# 4. Local Interconnect (li1) Output Strap bridging PMOS Drain to NMOS Drain
# 5. Dual Bulk Taps:
#    - P+ Substrate Tap (VSS = 0.0V) below NMOS
#    - N+ N-Well Tap (VDD = 1.8V) above PMOS

import * from @std/primitives/units
import * from "./cmos_pdk"

# ============================================================================
# LOGICAL MODULE (Schematic Interface)
# ============================================================================

module CMOS_Inverter:
    pins: [input In, output Out, power VDD, ground VSS]

# ============================================================================
# PHYSICAL SYNTHESIS SPACE
# ============================================================================

space CMOS_Inverter_Space implements CMOS_Inverter:
    dimensions: 20.0um by 18.0um
    profile: SKY130_1V8_CMOS

    nets:
        VDD: { classification: power,  potential: 1.8V, current: 20.0uA }
        VSS: { classification: ground, potential: 0.0V, current: 20.0uA }
        In:  { classification: signal, potential: 1.8V, current: 0.1uA }
        Out: { classification: signal, current: 20.0uA }

    # Explicit nominal device instances
    device NMOS named M_NMOS
    device PMOS named M_PMOS

    # Bind BSIM4 substrate bulk terminals
    device_nets M_NMOS:
        B: VSS
    
    device_nets M_PMOS:
        B: VDD

    # ========================================================================
    # PARAMETRIC GEOMETRY (Self-Healing Layout)
    # ========================================================================
    
    let L_gate = 150nm              # Minimum SKY130 channel length
    let W_nmos = 1.0um              # NMOS channel width
    let W_pmos = 2.0um              # PMOS channel width (2x NMOS for mobility balance)
    let sd_len = 750nm              # Active diffusion contact pad length (increased for clearance)
    let diff_len = (2 * sd_len) + L_gate # 1.65um total active diffusion length
    
    let poly_overhang = 200nm       # Poly extension beyond active (SKY130 poly.4 >= 150nm)
    let cell_spacing_y = 3.5um      # Vertical spacing between NMOS & PMOS active islands
    let tap_size = 300nm            # Tap diffusion size (300nm provides 65nm enclosure for 170nm via)
    let tap_offset_y = 2.2um        # Distance from active to substrate/well tap (increased for gate clearance)
    let nwell_margin = 600nm        # N-Well enclosure margin (SKY130 nwell.4 >= 330nm)
    let gate_head_size = 400nm      # Gate input landing pad size
    let npc_enclosure = 90nm        # SKY130 npc.2 enclosure
    let npc_size = gate_head_size + (2 * npc_enclosure)
    let pad_size = 1.2um

    # Total shared poly length: from NMOS bottom overhang to PMOS top overhang + gate input head
    let total_gate_poly_len = W_nmos + cell_spacing_y + W_pmos + (2 * poly_overhang) + gate_head_size

    # ========================================================================
    # 1. ROOT ANCHOR: NMOS Active Silicon Island
    # ========================================================================

    add pour(N_Plus_Diffusion) named NMOS_Diff on layer: diff:
        device: M_NMOS.S, M_NMOS.D
        dimensions: diff_len by W_nmos
        at: [x: 10.0um, y: 5.0um]    # ← THE ONE AND ONLY absolute 'at:' coordinate!

    # NSDM Mask for NMOS active island
    add pour(N_Plus_Implant_Mask) named NMOS_NSDM on layer: nsdm:
        dimensions: diff_len + 260nm by W_nmos + 260nm
        align: center_x with NMOS_Diff
        align: center_y with NMOS_Diff

    # ========================================================================
    # 2. RELATIONAL PMOS REGION (N-Well + Active P+ Island)
    # ========================================================================

    # PMOS Active P+ Diffusion Island (Positioned directly above NMOS)
    add pour(P_Plus_Diffusion) named PMOS_Diff on layer: diff:
        device: M_PMOS.S, M_PMOS.D
        dimensions: diff_len by W_pmos
        align: center_x with NMOS_Diff
        align: bottom with NMOS_Diff.top + cell_spacing_y

    # N-Well Mask enclosing PMOS channel and upcoming N-Well Tap
    add pour(N_Well_Mask) named PMOS_NWell on layer: nwell:
        dimensions: diff_len + (2  *nwell_margin) by W_pmos + tap_offset_y + (2*  nwell_margin)
        align: center_x with PMOS_Diff
        align: center_y with PMOS_Diff.center_y + (tap_offset_y / 2)

    # PSDM Mask for PMOS active island
    add pour(P_Plus_Implant_Mask) named PMOS_PSDM on layer: psdm:
        dimensions: diff_len + 260nm by W_pmos + 260nm
        align: center_x with PMOS_Diff
        align: center_y with PMOS_Diff

    # ========================================================================
    # 3. CONTINUOUS SHARED GATE POLYSILICON (Input Connection: In)
    # ========================================================================

    # NMOS Channel Gate (150nm x 1.0um with overhang)
    add pour(Polysilicon) named NMOS_Gate on layer: poly:
        device: M_NMOS.G
        net: In
        dimensions: L_gate by W_nmos + (2 * poly_overhang)
        align: center_x with NMOS_Diff
        align: center_y with NMOS_Diff

    # PMOS Channel Gate (150nm x 2.0um with overhang)
    add pour(Polysilicon) named PMOS_Gate on layer: poly:
        device: M_PMOS.G
        net: In
        dimensions: L_gate by W_pmos + (2 * poly_overhang)
        align: center_x with PMOS_Diff
        align: center_y with PMOS_Diff

    # Interconnect Gate Bridge (Spans center-to-center between NMOS and PMOS gates)
    # Bridge height spans from NMOS gate center to PMOS gate center
    let bridge_height = cell_spacing_y + (W_nmos / 2) + (W_pmos / 2)
    
    add pour(Polysilicon) named Gate_Bridge on layer: poly:
        net: In
        dimensions: L_gate by bridge_height
        align: center_x with NMOS_Gate
        align: center_y with (NMOS_Diff.center_y + PMOS_Diff.center_y) / 2

    # Gate Input Landing Pad (External input contact head - pure interconnect)
    add pour(Polysilicon) named Gate_Input_Head on layer: poly:
        net: In
        dimensions: gate_head_size by gate_head_size
        align: center_x with PMOS_Gate
        align: bottom with PMOS_Gate.top

    # NPC (Nitride Poly Cut) Mask enclosing the gate contact head
    add pour(Nitride_Poly_Cut_Mask) named Gate_NPC on layer: npc:
        dimensions: npc_size by npc_size
        align: center_x with Gate_Input_Head
        align: center_y with Gate_Input_Head

    # Gate Contact LI & Metal1 Landing Pads (Pure interconnect, no device binding)
    add pour(Titanium_Nitride) named Gate_Contact_LI on layer: li1:
        dimensions: 400nm by 400nm
        align: center_x with Gate_Input_Head
        align: center_y with Gate_Input_Head
        net: In

    add pour(Aluminum) named Gate_Contact_M1 on layer: metal1:
        dimensions: 400nm by 400nm
        align: center_x with Gate_Contact_LI
        align: center_y with Gate_Contact_LI
        net: In

    # Concentric Stacked Vias for Gate Input (poly -> li1 -> metal1)
    add contact(Tungsten) named Gate_Via_Poly_LI spanning layer: poly to li1:
        diameter: 170nm
        align: center_x with Gate_Contact_LI
        align: center_y with Gate_Contact_LI
        net: In

    add contact(Tungsten) named Gate_Via_LI_M1 spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Gate_Contact_M1
        align: center_y with Gate_Contact_M1
        net: In

    # ========================================================================
    # 4. NMOS TERMINALS & GROUND CONNECTIONS (Source → VSS)
    # ========================================================================

    # NMOS Source Contact (Left - connected to VSS)
    add pour(Titanium_Nitride) named NMOS_Source_LI on layer: li1:
        device: M_NMOS.S
        net: VSS
        dimensions: 400nm by W_nmos
        align: center_x with NMOS_Diff.left + (sd_len / 2)
        align: center_y with NMOS_Diff

    add pour(Aluminum) named NMOS_Source_M1 on layer: metal1:
        dimensions: 400nm by W_nmos
        align: center_x with NMOS_Source_LI
        align: center_y with NMOS_Source_LI
        net: VSS

    for i in 0..2:
        add contact(Tungsten) named NMOS_S_Via_Diff_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with NMOS_Source_LI
            align: center_y with NMOS_Source_LI.center_y - 200nm + (i * 400nm)
            net: VSS
        
        add contact(Tungsten) named NMOS_S_Via_M1_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with NMOS_Source_M1
            align: center_y with NMOS_Source_M1.center_y - 200nm + (i * 400nm)
            net: VSS

    # NMOS Drain Contact (Right - connected to Out)
    add pour(Titanium_Nitride) named NMOS_Drain_LI on layer: li1:
        device: M_NMOS.D
        net: Out
        dimensions: 400nm by W_nmos
        align: center_x with NMOS_Diff.right - (sd_len / 2)
        align: center_y with NMOS_Diff

    for i in 0..2:
        add contact(Tungsten) named NMOS_D_Via_Diff_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with NMOS_Drain_LI
            align: center_y with NMOS_Drain_LI.center_y - 200nm + (i * 400nm)
            net: Out

    # ========================================================================
    # 5. PMOS TERMINALS & POWER CONNECTIONS (Source → VDD)
    # ========================================================================

    # PMOS Source Contact (Left - connected to VDD)
    add pour(Titanium_Nitride) named PMOS_Source_LI on layer: li1:
        device: M_PMOS.S
        net: VDD
        dimensions: 400nm by W_pmos
        align: center_x with PMOS_Diff.left + (sd_len / 2)
        align: center_y with PMOS_Diff

    add pour(Aluminum) named PMOS_Source_M1 on layer: metal1:
        dimensions: 400nm by W_pmos
        align: center_x with PMOS_Source_LI
        align: center_y with PMOS_Source_LI
        net: VDD

    for i in 0..3:
        add contact(Tungsten) named PMOS_S_Via_Diff_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with PMOS_Source_LI
            align: center_y with PMOS_Source_LI.center_y - 400nm + (i * 400nm)
            net: VDD
        
        add contact(Tungsten) named PMOS_S_Via_M1_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with PMOS_Source_M1
            align: center_y with PMOS_Source_M1.center_y - 400nm + (i * 400nm)
            net: VDD

    # PMOS Drain Contact (Right - connected to Out)
    add pour(Titanium_Nitride) named PMOS_Drain_LI on layer: li1:
        device: M_PMOS.D
        net: Out
        dimensions: 400nm by W_pmos
        align: center_x with PMOS_Diff.right - (sd_len / 2)
        align: center_y with PMOS_Diff

    for i in 0..3:
        add contact(Tungsten) named PMOS_D_Via_Diff_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with PMOS_Drain_LI
            align: center_y with PMOS_Drain_LI.center_y - 400nm + (i * 400nm)
            net: Out

    # ========================================================================
    # 6. UNIFIED LOCAL INTERCONNECT (li1) OUTPUT STRAP (PMOS Drain → NMOS Drain)
    # ========================================================================

    # High-density local interconnect strap directly shorting PMOS and NMOS drains
    # Height calculation: W_nmos + cell_spacing_y + W_pmos = 1.0um + 3.5um + 2.0um = 6.5um
    let output_strap_height = W_nmos + cell_spacing_y + W_pmos

    add pour(Titanium_Nitride) named Output_LI_Strap on layer: li1:
        net: Out
        dimensions: 400nm by output_strap_height
        align: center_x with NMOS_Drain_LI
        align: center_y with (NMOS_Diff.center_y + PMOS_Diff.center_y) / 2

    # Metal1 Output Landing Pad (increased to 800nm x 800nm for proper via spacing)
    add pour(Aluminum) named Output_M1_Pad on layer: metal1:
        dimensions: 800nm by 800nm
        align: center_x with Output_LI_Strap
        align: center_y with Output_LI_Strap
        net: Out

    # Mcon stacked vias bridging output LI strap to Metal1 output pad (400nm pitch -> 230nm drill gap)
    for i in 0..2:
        add contact(Tungsten) named Output_Via_M1_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with Output_M1_Pad
            align: center_y with Output_M1_Pad.center_y - 200nm + (i * 400nm)
            net: Out

    # Metal1 bridge paralleling the TiN strap to eliminate the ~450Ω series resistance
    # (TiN Rs ≈ 45Ω/□, 6.5μm / 0.4μm width = 16.25□ → 731Ω without bridge)
    # With this Al bridge (Rs ≈ 0.125Ω/□): R_bridge ≈ 2Ω — negligible
    add pour(Aluminum) named Output_M1_Bridge on layer: metal1:
        net: Out
        dimensions: 400nm by output_strap_height
        align: center_x with Output_LI_Strap
        align: center_y with Output_LI_Strap

    # Bottom via: li1 → metal1 at NMOS Drain level
    add contact(Tungsten) named Output_Bridge_Bot_Via spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Output_M1_Bridge
        align: center_y with NMOS_Drain_LI
        net: Out

    # Top via: li1 → metal1 at PMOS Drain level
    add contact(Tungsten) named Output_Bridge_Top_Via spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Output_M1_Bridge
        align: center_y with PMOS_Drain_LI
        net: Out

    # ========================================================================
    # 7. SUBSTRATE AND WELL TAPS (Latch-Up Prevention)
    # ========================================================================

    # 7a. P-Substrate Tap (Source side, below NMOS)
    add pour(Tap_Mask) named Sub_Tap_Mask on layer: tap:
        dimensions: tap_size by tap_size
        align: center_x with NMOS_Diff.left + (sd_len / 2)
        align: center_y with NMOS_Diff.center_y - tap_offset_y

    add pour(P_Plus_Implant_Mask) named Sub_Tap_PSDM on layer: psdm:
        dimensions: tap_size + 260nm by tap_size + 260nm
        align: center_x with Sub_Tap_Mask
        align: center_y with Sub_Tap_Mask

    add pour(P_Plus_Diffusion) named Sub_Tap_Diff on layer: diff:
        net: VSS
        device: M_NMOS.B
        dimensions: tap_size by tap_size
        align: center_x with Sub_Tap_Mask
        align: center_y with Sub_Tap_Mask

    add pour(Titanium_Nitride) named Sub_Tap_LI on layer: li1:
        net: VSS
        dimensions: tap_size by tap_size
        align: center_x with Sub_Tap_Diff
        align: center_y with Sub_Tap_Diff

    add pour(Aluminum) named Sub_Tap_M1 on layer: metal1:
        net: VSS
        dimensions: tap_size by tap_size
        align: center_x with Sub_Tap_LI
        align: center_y with Sub_Tap_LI

    add contact(Tungsten) named Sub_Tap_Licon spanning layer: diff to li1:
        diameter: 170nm
        align: center_x with Sub_Tap_Diff
        align: center_y with Sub_Tap_Diff
        net: VSS

    add contact(Tungsten) named Sub_Tap_Mcon spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Sub_Tap_LI
        align: center_y with Sub_Tap_LI
        net: VSS

    # 7b. N-Well Tap (Source side, above PMOS)
    add pour(Tap_Mask) named Well_Tap_Mask on layer: tap:
        dimensions: tap_size by tap_size
        align: center_x with PMOS_Diff.left + (sd_len / 2)
        align: center_y with PMOS_Diff.center_y + tap_offset_y

    add pour(N_Plus_Implant_Mask) named Well_Tap_NSDM on layer: nsdm:
        dimensions: tap_size + 260nm by tap_size + 260nm
        align: center_x with Well_Tap_Mask
        align: center_y with Well_Tap_Mask

    add pour(N_Plus_Diffusion) named Well_Tap_Diff on layer: diff:
        net: VDD
        device: M_PMOS.B
        dimensions: tap_size by tap_size
        align: center_x with Well_Tap_Mask
        align: center_y with Well_Tap_Mask

    add pour(Titanium_Nitride) named Well_Tap_LI on layer: li1:
        net: VDD
        dimensions: tap_size by tap_size
        align: center_x with Well_Tap_Diff
        align: center_y with Well_Tap_Diff

    add pour(Aluminum) named Well_Tap_M1 on layer: metal1:
        net: VDD
        dimensions: tap_size by tap_size
        align: center_x with Well_Tap_LI
        align: center_y with Well_Tap_LI

    add contact(Tungsten) named Well_Tap_Licon spanning layer: diff to li1:
        diameter: 170nm
        align: center_x with Well_Tap_Diff
        align: center_y with Well_Tap_Diff
        net: VDD

    add contact(Tungsten) named Well_Tap_Mcon spanning layer: li1 to metal1:
        diameter: 170nm
        align: center_x with Well_Tap_LI
        align: center_y with Well_Tap_LI
        net: VDD

    # ========================================================================
    # 8. EXTERNAL TEST PADS & ROUTING
    # ========================================================================

    # VDD Supply Pad (Top-Left)
    add pour(Aluminum) named VDD_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with PMOS_Source_M1.left - 2.5um
        align: center_y with PMOS_Source_M1
        net: VDD

    # VSS Ground Pad (Bottom-Left)
    add pour(Aluminum) named VSS_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with NMOS_Source_M1.left - 2.5um
        align: center_y with NMOS_Source_M1
        net: VSS

    # Input Pad (Top-Center, straight above gate contact)
    add pour(Aluminum) named Input_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Gate_Contact_M1
        align: bottom with Gate_Contact_M1.top + 2.0um
        net: In

    # Output Pad (Right-Center)
    add pour(Aluminum) named Output_Pad on layer: metal1:
        dimensions: pad_size by pad_size
        align: center_x with Output_M1_Pad.right + 2.5um
        align: center_y with Output_M1_Pad
        net: Out

    # VDD Rail Interconnect
    route VDD_Pad to PMOS_Source_M1:
        net: VDD
        width: 500nm
        layer: metal1
        intent: Power

    route PMOS_Source_M1 to Well_Tap_M1:
        net: VDD
        width: 200nm
        layer: metal1
        intent: Power

    # VSS Rail Interconnect
    route VSS_Pad to NMOS_Source_M1:
        net: VSS
        width: 500nm
        layer: metal1
        intent: Power

    route NMOS_Source_M1 to Sub_Tap_M1:
        net: VSS
        width: 200nm
        layer: metal1
        intent: Power

    # Input / Output Signal Routes
    route Gate_Contact_M1 to Input_Pad:
        net: In
        width: 200nm
        layer: metal1
        intent: Signal

    route Output_M1_Pad to Output_Pad:
        net: Out
        width: 400nm
        layer: metal1
        intent: Signal

# ============================================================================
# 9. SIMULATION TESTBENCHES
# ============================================================================

test CMOS_Inverter_VTC_Test for CMOS_Inverter_Space:
    dc: { sweep: In, start: 0.0V, stop: 1.8V, step: 0.02V }
    tran: { step: 5ps, stop: 10ns }
