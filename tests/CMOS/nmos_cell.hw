# nmos_cell.hw - Parameterized SKY130 1.8V NMOS Standard Cell Component

import * from @std/primitives/units
import * from "./cmos_pdk"

export template NMOS_Cell(W_gate: Measurement, L_gate: Measurement, inst_name: String):
    let sd_len = 650nm
    let poly_overhang = 200nm
    let diff_len = (2 * sd_len) + L_gate
    let via_pitch = 400nm
    let via_count = max(1, (W_gate - 200nm) / via_pitch)
    let via_offset = (via_count - 1) * via_pitch / 2

    # 1. Active N+ Diffusion Island
    add pour(N_Plus_Diffusion) named {inst_name}_Diff on layer: diff:
        dimensions: diff_len by W_gate

    # 2. N+ Implant Mask
    add pour(N_Plus_Implant_Mask) named {inst_name}_NSDM on layer: nsdm:
        dimensions: diff_len + 260nm by W_gate + 260nm
        align: center_x with {inst_name}_Diff
        align: center_y with {inst_name}_Diff

    # 3. Gate Polysilicon Channel
    add pour(Polysilicon) named {inst_name}_Gate on layer: poly:
        device: {inst_name}.G
        dimensions: L_gate by W_gate + (2 * poly_overhang)
        align: center_x with {inst_name}_Diff
        align: center_y with {inst_name}_Diff

    # 4. Source Terminal (Left)
    add pour(Titanium_Nitride) named {inst_name}_Source_LI on layer: li1:
        device: {inst_name}.S
        dimensions: 400nm by W_gate
        align: center_x with {inst_name}_Diff.left + (sd_len / 2)
        align: center_y with {inst_name}_Diff

    add pour(Aluminum) named {inst_name}_Source_M1 on layer: metal1:
        dimensions: 400nm by W_gate
        align: center_x with {inst_name}_Source_LI
        align: center_y with {inst_name}_Source_LI

    for i in 0..via_count:
        add contact(Tungsten) named {inst_name}_S_Via_Diff_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with {inst_name}_Source_LI
            align: center_y with {inst_name}_Source_LI.center_y - via_offset + (i * via_pitch)
            net: {inst_name}.S
        
        add contact(Tungsten) named {inst_name}_S_Via_M1_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with {inst_name}_Source_M1
            align: center_y with {inst_name}_Source_M1.center_y - via_offset + (i * via_pitch)
            net: {inst_name}.S

    # 5. Drain Terminal (Right)
    add pour(Titanium_Nitride) named {inst_name}_Drain_LI on layer: li1:
        device: {inst_name}.D
        dimensions: 400nm by W_gate
        align: center_x with {inst_name}_Diff.right - (sd_len / 2)
        align: center_y with {inst_name}_Diff

    add pour(Aluminum) named {inst_name}_Drain_M1 on layer: metal1:
        dimensions: 400nm by W_gate
        align: center_x with {inst_name}_Drain_LI
        align: center_y with {inst_name}_Drain_LI

    for i in 0..via_count:
        add contact(Tungsten) named {inst_name}_D_Via_Diff_{i} spanning layer: diff to li1:
            diameter: 170nm
            align: center_x with {inst_name}_Drain_LI
            align: center_y with {inst_name}_Drain_LI.center_y - via_offset + (i * via_pitch)
            net: {inst_name}.D
        
        add contact(Tungsten) named {inst_name}_D_Via_M1_{i} spanning layer: li1 to metal1:
            diameter: 170nm
            align: center_x with {inst_name}_Drain_M1
            align: center_y with {inst_name}_Drain_M1.center_y - via_offset + (i * via_pitch)
            net: {inst_name}.D
