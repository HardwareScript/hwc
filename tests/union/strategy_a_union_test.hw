# Strategy A: 2D Polygon Unioning Verification Test
# 
# This test verifies that overlapping copper elements on the same net
# are unified into a single manifold 3D mesh using the Clipper2-rust engine.

import * from @std/primitives/units
import Copper from @std/materials/conductors

material TestFR4:
    category: insulator
    properties:
        resistivity: 1e14Ω·m
        thermal_conductivity: 0.3W/(m·K)
        density: 1850kg/m³
        melting_point: 130C
        max_current_density: 0A/mm²
        color: "#2E7D32"
        dielectric_constant: 4.5

profile UnionTestProfile:
    description: "Profile for Strategy A verification"
    
    stackup:
        top:    [material: Copper,  thickness: 0.1mm]
        core:   [material: TestFR4, thickness: 1.4mm]
        bottom: [material: Copper,  thickness: 0.1mm]

    trace:
        min_width: 100µm
        min_spacing: 100µm
    
    via:
        min_diameter: 200µm
        default_diameter: 500µm
        min_annular_ring: 100µm
    
    manufacturing:
        copper_thickness: 35µm
        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    clearance:
        high_voltage: 2mm
        safety_factor: 2.0

    layer:
        min_thickness: 0.1mm

    export:
        antialiasing: true
        smoothing_tolerance: 5µm
        corner_lock: [45, 90]

module UnionTestModule:
    pins: [UnionNet, IsolationNet]

space UnionTestSpace implements UnionTestModule:
    dimensions: 20mm by 20mm by 1.6mm
    grid: 100 by 100 by 16
    origin: bl by b
    profile: UnionTestProfile

    # --- NET 1: UNION TEST (TOP LAYER) ---
    # Overlapping Rectangles
    add pour(Copper) named RectA on layer: top:
        boundary: [x: 2mm, y: 2mm] to [x: 6mm, y: 6mm]
        net: UnionNet

    add pour(Copper) named RectB on layer: top:
        boundary: [x: 5mm, y: 5mm] to [x: 9mm, y: 9mm]
        net: UnionNet

    # Trace connecting to a via pad
    add pour(Copper) named ConnectingTrace on layer: top:
        boundary: [x: 8mm, y: 3mm] to [x: 12mm, y: 4mm]
        net: UnionNet

    # Bridge between RectB and ConnectingTrace to pass P41 check
    add pour(Copper) named Bridge on layer: top:
        boundary: [x: 8.2mm, y: 3.5mm] to [x: 8.8mm, y: 5.5mm]
        net: UnionNet

    # Circular Landing Pad (Contact)
    # This should be unified with ConnectingTrace
    add contact(Copper) named PadC at [x: 12mm, y: 3.5mm] spanning layer: top to top:
        net: UnionNet
        diameter: 0.5mm  # Standard 500um drill
        annular_ring: 0.25mm # Generous 250um annular ring (Outer Pad = 1.0mm)
        caps: true

    # --- NET 2: ISOLATION TEST (TOP LAYER) ---
    add pour(Copper) named IsolatedRect on layer: top:
        boundary: [x: 15mm, y: 15mm] to [x: 18mm, y: 18mm]
        net: IsolationNet
