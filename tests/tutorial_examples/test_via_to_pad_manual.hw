# Manual Routing: Via-to-Pad (Top Layer Only)
#
# A through-hole via connected to a rectangular pad on the top layer.
# The route is manually defined between the via's top anchor and the pad.

import * from @std/primitives/units
import Copper from @std/materials/conductors

profile RoutingTestProfile:
    stackup:
        top:    [material: Copper, thickness: 35um]
        core:   [material: FR4,    thickness: 1.5mm]
        bottom: [material: Copper, thickness: 35um]
    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm
    via:
        min_diameter: 0.3mm
        min_annular_ring: 0.15mm
        min_spacing: 0.25mm
    manufacturing:
        copper_thickness: 35um
    clearance:
        high_voltage: 1.0mm
        safety_factor: 1.5
    layer:
        min_thickness: 35um

component Pin:
    pins: [P]
    layout:
        shape: Rectangle(0.1mm, 0.1mm, 0.035mm)
        pin_positions:
            P at [0.05mm, 0.05mm, 0mm]

component RectPad:
    pins: [P]
    layout:
        shape: Rectangle(1.0mm, 0.5mm, 0.035mm)
        pin_positions:
            P at [0.5mm, 0.25mm, 0mm]
        add pour(Copper) named Pad on layer: self:
            device: P
            boundary: [x: -0.5mm, y: -0.25mm] to [x: 0.5mm, y: 0.25mm]

space ViaToPadBoard:
    dimensions: 12mm by 6mm by 1.57mm
    grid: 120 by 60 by 16
    origin: bl by b
    profile: RoutingTestProfile

    # Via at (2, 3)
    add contact(Copper) named Via_A at [x: 2.0mm, y: 3.0mm] spanning layer: top to bottom:
        net: NET_A
        drill_diameter: 0.3mm
        annular_ring: 0.2mm

    # Anchor pin for routing to the via
    add Pin named Via_A_Anchor at [x: 2.0mm, y: 3.0mm] on layer: top:
        merge: true

    # Pad at (8, 3)
    add RectPad named Pad_B at [x: 7.5mm, y: 2.75mm] on layer: top:
        merge: true

    # Manual route: via anchor to center of Pad_B
    route Via_A_Anchor.P to Pad_B.P:
        path: [ [x: 2.0mm, y: 3.0mm, z: 1.535mm], [x: 8.0mm, y: 3.0mm, z: 1.535mm] ]
