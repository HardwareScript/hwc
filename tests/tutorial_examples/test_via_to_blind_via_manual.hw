# Manual Routing: Through-Hole to Blind Via (4-Layer Stackup)
#
# Connecting a standard PTH (Through-Hole) to a Blind Via (Top to Inner1)
# with a manual trace on the top layer.

import * from @std/primitives/units
import FR4 from @std/materials/insulators

material ViaCopper:
    category: conductor
    process: drilled_plated
    properties:
        color: "#B87333"
        resistivity: 1.68e-8Ω·m

profile AdvancedViaProfile:
    stackup:
        top:    [material: ViaCopper, thickness: 35um]
        d1:     [material: FR4,       thickness: 200um]
        inner1: [material: ViaCopper, thickness: 35um]
        core:   [material: FR4,       thickness: 1060um]
        inner2: [material: ViaCopper, thickness: 35um]
        d2:     [material: FR4,       thickness: 200um]
        bottom: [material: ViaCopper, thickness: 35um]
    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm
    via:
        min_diameter: 0.3mm
        min_annular_ring: 0.15mm
        min_spacing: 0.25mm
    manufacturing:
        copper_thickness: 35um
    clearance:
        high_voltage: 1.0mm
        safety_factor: 1.5
    layer:
        min_thickness: 35um

component Pin:
    pins: [P]
    layout:
        shape: Rectangle(0.1mm, 0.1mm, 0.035mm)
        pin_positions:
            P at [0.05mm, 0.05mm, 0mm]

space AdvancedViaBoard:
    dimensions: 12mm by 6mm by 1.6mm
    grid: 120 by 60 by 32
    origin: bl by b
    profile: AdvancedViaProfile

    # Via A: Through-hole via at (2, 3) - Spans all layers
    add contact(ViaCopper) named Via_A at [x: 2.0mm, y: 3.0mm] spanning layer: top to bottom:
        net: NET_ADV
        drill_diameter: 0.4mm
        annular_ring: 0.2mm
        top_cap: annular
        bottom_cap: annular

    # Anchor pin for Via A (Top Layer)
    add Pin named Via_A_Anchor at [x: 2.0mm, y: 3.0mm] on layer: top:
        merge: true

    # Via B: Blind via at (8, 3) - Spans Top to Inner1
    add contact(ViaCopper) named Via_B at [x: 8.0mm, y: 3.0mm] spanning layer: top to inner1:
        net: NET_ADV
        drill_diameter: 0.3mm
        annular_ring: 0.15mm
        top_cap: annular
        bottom_cap: solid

    # Anchor pin for Via B (Top Layer)
    add Pin named Via_B_Anchor at [x: 8.0mm, y: 3.0mm] on layer: top:
        merge: true

    # Manual route: PTH Via A to Blind Via B on top layer
    # Z-height for top layer in this 4-layer stackup:
    # bottom(0) + d2(200) + inner2(35) + core(1060) + inner1(35) + d1(200) = 1530um
    route Via_A_Anchor.P to Via_B_Anchor.P:
        path: [ [x: 2.0mm, y: 3.0mm, z: 1.565mm], [x: 8.0mm, y: 3.0mm, z: 1.565mm] ]
