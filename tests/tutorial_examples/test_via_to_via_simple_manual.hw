# Manual Routing: Via-to-Via (Simple Through-Hole)
#
# Connecting two identical through-hole vias with a manual trace on the top layer.
# This verifies that the post-realization drill pass and triangulation work
# correctly for multiple identical via structures.

import * from @std/primitives/units
import Copper from @std/materials/conductors

profile RoutingTestProfile:
    stackup:
        top:    [material: Copper, thickness: 35um]
        core:   [material: FR4,    thickness: 1.5mm]
        bottom: [material: Copper, thickness: 35um]
    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm
    via:
        min_diameter: 0.3mm
        min_annular_ring: 0.15mm
        min_spacing: 0.25mm
    manufacturing:
        copper_thickness: 35um
    clearance:
        high_voltage: 1.0mm
        safety_factor: 1.5
    layer:
        min_thickness: 35um

component Pin:
    pins: [P]
    layout:
        shape: Rectangle(0.1mm, 0.1mm, 0.035mm)
        pin_positions:
            P at [0.05mm, 0.05mm, 0mm]

space ViaToViaSimpleBoard:
    dimensions: 12mm by 6mm by 1.57mm
    grid: 120 by 60 by 16
    origin: bl by b
    profile: RoutingTestProfile

    # Via A: Through-hole via at (2, 3)
    add contact(Copper) named Via_A at [x: 2.0mm, y: 3.0mm] spanning layer: top to bottom:
        net: NET_V2V
        drill_diameter: 0.4mm
        annular_ring: 0.2mm

    # Anchor pin for Via A
    add Pin named Via_A_Anchor at [x: 2.0mm, y: 3.0mm] on layer: top:
        merge: true

    # Via B: Through-hole via at (8, 3)
    add contact(Copper) named Via_B at [x: 8.0mm, y: 3.0mm] spanning layer: top to bottom:
        net: NET_V2V
        drill_diameter: 0.4mm
        annular_ring: 0.2mm

    # Anchor pin for Via B
    add Pin named Via_B_Anchor at [x: 8.0mm, y: 3.0mm] on layer: top:
        merge: true

    # Manual route: Via A to Via B on top layer
    route Via_A_Anchor.P to Via_B_Anchor.P:
        path: [ [x: 2.0mm, y: 3.0mm, z: 1.535mm], [x: 8.0mm, y: 3.0mm, z: 1.535mm] ]
