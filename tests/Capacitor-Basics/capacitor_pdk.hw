# capacitor_pdk.hw - SkyWater SKY130 MIM Capacitor PDK
# Device: sky130_fd_pr__cap_mim_m3_1/m3_2 (Metal-Insulator-Metal Capacitor)
# Capacitance: 2.0 fF/μm² (area) + 0.19 fF/μm (periphery)
# Construction: CAPM over Metal-3 (or CAP2M over Metal-4)
import * from @std/primitives/units
import Aluminum, Tungsten, Titanium_Silicide, Silicon_Dioxide, Air, CAPM from "./materials"

export Aluminum
export Tungsten
export Titanium_Silicide
export Silicon_Dioxide
export Air
export CAPM

export shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

export bridge Polysilicon to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum to CAPM:
    interface: Titanium_Silicide
    thickness: 3nm
    fill: Tungsten

export bridge CAPM to Aluminum:
    interface: Titanium_Silicide
    thickness: 3nm
    fill: Tungsten

export bridge Titanium_Silicide to CAPM:
    interface: Titanium_Silicide
    thickness: 3nm
    fill: Tungsten

export bridge CAPM to Titanium_Silicide:
    interface: Titanium_Silicide
    thickness: 3nm
    fill: Tungsten

export bridge Polysilicon to Titanium_Silicide:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Titanium_Silicide to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

# SKY130-compliant MIM capacitor stackup with local interconnect (li1)
# CAPM Construction: Metal-3 (bottom plate) → thin oxide → CAPM (top plate)
# Capacitance density: 2.0 fF/μm² (area) + 0.19 fF/μm (periphery)
# Top plate (CAPM) sheet resistance: 5.8 Ω/□
export profile Capacitor_MIM:
    technology: "ASIC"
    substrate_net: GND
    
    stackup:
        li1:        [material: Titanium_Silicide, thickness: 100nm, routable: true]
        ild1:       [material: Silicon_Dioxide,   thickness: 150nm, routable: false]
        metal1:     [material: Aluminum,          thickness: 360nm, routable: true]
        ild2:       [material: Silicon_Dioxide,   thickness: 200nm, routable: false]
        metal2:     [material: Aluminum,          thickness: 360nm, routable: true]
        ild3:       [material: Silicon_Dioxide,   thickness: 150nm, routable: false]
        metal3:     [material: Aluminum,          thickness: 845nm, routable: true]
        capm_ox:    [material: Silicon_Dioxide,   thickness: 5nm,   routable: false]
        capm:       [material: CAPM,              thickness: 100nm, routable: true]
        ild4:       [material: Silicon_Dioxide,   thickness: 150nm, routable: false]
        metal4:     [material: Aluminum,          thickness: 845nm, routable: true]

    manufacturing:
        track_pitch: 10nm
        copper_thickness: 500nm
        circle_segments: 64

    via:
        min_diameter: 170nm
        min_enclosure: 50nm
        min_spacing: 400nm
        shape: SquareContact
        contact_depth: 30%
        material_contact_depths:
            Aluminum: 30%
            Titanium_Silicide: 30%
            CAPM: 30%
        
        # Layer-specific enclosure rules (SKY130 capm.5 rule)
        # Via3 must be enclosed by CAPM plate by at least 500nm
        enclosures:
            capm: 500nm
            metal4: 50nm

    trace:
        min_width: 300nm
        min_spacing: 300nm
        edge_clearance: 200nm

    clearance:
        high_voltage: 1um
        safety_factor: 2.0

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 50nm
        allowed_conductors: [Aluminum, CAPM, Titanium_Silicide]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        min_segment_length: 300nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

# SKY130 MIM Capacitor Subcircuit (sky130_fd_pr__cap_mim_m3_1)
# Capacitance: C_area × A + C_perimeter × P
# - C_area = 2.0 fF/μm² (area capacitance)
# - C_perimeter = 0.19 fF/μm (edge/fringe capacitance)
# - Top plate sheet resistance: 5.8 Ω/□ (CAPM layer)
#
# v0.2.1: TRUE FOUNDRY SPICE INTEGRATION
# Uses `spice_include` to defer physics to the foundry model instead of
# inline element synthesis. This is the CORRECT approach for production ASICs.
#
# TERMINALS: c0 (top plate), c1 (bottom plate), b (bulk/substrate)
# The bulk terminal is typically connected to GND for proper substrate coupling
export subcircuit sky130_fd_pr__cap_mim_m3_1:
    terminals: [c0, c1, b]
    parameters: [W = 10.0um, L = 10.0um]
    spice_include: "sky130_fd_pr/models/sky130_fd_pr__cap_mim_m3_1.model.spice"

# LEGACY: Inline Elements Mode (for reference only)
# Uncomment to use compiler-synthesized subcircuit instead of foundry model
# export subcircuit sky130_fd_pr__cap_mim_m3_1:
#     terminals: [c0, c1]
#     parameters: [W = 10.0um, L = 10.0um]
#     elements:
#         C_area: Capacitor(nodes: [c0, c1], value: 2.0fF * W * L)
#         C_perimeter: Capacitor(nodes: [c0, c1], value: 0.19fF * 2 * (W + L))
#         R_top: Resistor(nodes: [c0, node_1], value: 5.8ohm * L / W)

export device Capacitor:
    terminals: [c0, c1, b]
    materials:
        c0: [CAPM, Titanium_Silicide, Aluminum]        # Top plate: CAPM OR contact materials
        c1: [Aluminum, Titanium_Silicide, CAPM]        # Bottom plate: Metal-3 OR contact materials
        b: [Aluminum, Titanium_Silicide]               # Bulk/substrate terminal (typically GND)
    metrics:
        W: span(c0 | c1, along: transverse(c0, c1))
        L: span(c0 | c1, along: flux(c0, c1))
        AREA: area(c0 & c1)
        PJ: perimeter(c0 & c1)
    spice:
        prefix: X
        subcircuit: sky130_fd_pr__cap_mim_m3_1
        terminal_order: [c0, c1, b]
        parameters: [W, L]
        parameter_style: named
