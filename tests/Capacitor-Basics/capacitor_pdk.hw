# capacitor_pdk.hw - SKY130 Capacitor PDK
# Device: MIM (Metal-Insulator-Metal) Capacitor
import * from @std/primitives/units
import Polysilicon, Aluminum, Tungsten, Titanium_Silicide, Silicon_Dioxide, Air, MIMCap from "./materials"

export Polysilicon
export Aluminum
export Tungsten
export Titanium_Silicide
export Silicon_Dioxide
export Air
export MIMCap

export shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

export bridge Polysilicon to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum to MIMCap:
    interface: Titanium_Silicide
    thickness: 2nm
    fill: Tungsten

export bridge MIMCap to Aluminum:
    interface: Titanium_Silicide
    thickness: 2nm
    fill: Tungsten

export bridge Polysilicon to Titanium_Silicide:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Titanium_Silicide to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

# SKY130-compliant MIM capacitor stackup
# Critical: mimcap_dielectric layer is 5nm thick - optimized for high capacitance
# For C = ε₀εᵣ(A/d), thin dielectric = higher capacitance
export profile Capacitor_MIM:
    technology: "ASIC"
    substrate_net: GND
    
    stackup:
        metal1:            [material: Aluminum,         thickness: 20nm, routable: true]
        mimcap_dielectric: [material: Silicon_Dioxide,  thickness: 5nm,  routable: false]
        mimcap:            [material: MIMCap,           thickness: 15nm, routable: true]
        d2:                [material: Silicon_Dioxide,  thickness: 30nm, routable: false]
        metal2:            [material: Aluminum,         thickness: 30nm, routable: true]

    manufacturing:
        track_pitch: 10nm
        copper_thickness: 10nm
        circle_segments: 64

    via:
        min_diameter: 200nm
        min_annular_ring: 50nm
        min_spacing: 300nm
        shape: SquareContact
        contact_depth: 30%
        material_contact_depths:
            Aluminum: 30%
            Polysilicon: 30%
            MIMCap: 30%

    trace:
        min_width: 200nm
        min_spacing: 200nm
        edge_clearance: 100nm

    clearance:
        high_voltage: 500nm
        safety_factor: 1.5

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 5nm
        allowed_conductors: [Aluminum, MIMCap]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        min_segment_length: 200nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

# MIM Capacitor Subcircuit (v0.2.1)
# Uses spice_include to defer physics to foundry model
export subcircuit sky130_fd_pr__cap_mim:
    terminals: [top, bottom]
    parameters: [W = 10.0um, L = 10.0um]
    spice_include: "sky130_fd_pr/models/sky130_fd_pr__cap_mim.model.spice"

export device Capacitor:
    terminals: [top, bottom]
    materials:
        top: [MIMCap, Aluminum]
        bottom: [Aluminum, MIMCap]
    spice:
        prefix: X
        subcircuit: sky130_fd_pr__cap_mim
        terminal_order: [top, bottom]
        parameters: [W, L]
        parameter_style: named
