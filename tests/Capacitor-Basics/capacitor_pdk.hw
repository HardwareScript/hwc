# capacitor_pdk.hw - Process Design Kit for Capacitor Testing
# Simplified PDK focused on parallel-plate capacitors (MIM structures)
import * from @std/primitives/units
import Polysilicon, Aluminum, Tungsten, Titanium_Silicide, Silicon_Dioxide, Air, MIMCap from "./materials"

export Polysilicon
export Aluminum
export Tungsten
export Titanium_Silicide
export Silicon_Dioxide
export Air
export MIMCap

# Define square contact shape for vias
export shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

# Define bridges for layer transitions
export bridge Polysilicon to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

export bridge Aluminum to MIMCap:
    interface: Titanium_Silicide
    thickness: 2nm
    fill: Tungsten

export bridge MIMCap to Aluminum:
    interface: Titanium_Silicide
    thickness: 2nm
    fill: Tungsten

# MIM Capacitor profile - Matches SiliWiz tutorial structure
# Critical: mimcap_dielectric layer is 5nm thick - optimized for high capacitance!
# For C = ε₀εᵣ(A/d), thin dielectric = higher capacitance
export profile Capacitor_MIM:
    technology: "ASIC"
    
    stackup:
        metal1:            [material: Aluminum,         thickness: 20nm, routable: true]   # Z: 0-20nm   (Bottom Plate)
        mimcap_dielectric: [material: Silicon_Dioxide,  thickness: 5nm,  routable: false]  # Z: 20-25nm  (Thin Dielectric!)
        mimcap:            [material: MIMCap,           thickness: 15nm, routable: true]   # Z: 25-40nm  (Top Capacitor Plate)
        d2:                [material: Silicon_Dioxide,  thickness: 30nm, routable: false]  # Z: 40-70nm  (Inter-metal Dielectric)
        metal2:            [material: Aluminum,         thickness: 30nm, routable: true]   # Z: 70-100nm (Top Metal Layer)

    via:
        min_diameter: 200nm
        min_annular_ring: 50nm
        min_spacing: 300nm
        shape: SquareContact
        contact_depth: 30%  # Global default for capacitor contacts
        
        # v0.2.1: Material-specific penetration depths for capacitor structures
        # Shallow penetration preserves plate geometry and uniform E-field
        material_contact_depths:
            Aluminum: 30%      # Shallow penetration into top plate
            Polysilicon: 30%   # Shallow penetration into bottom plate

    trace:
        min_width: 200nm
        min_spacing: 200nm
        edge_clearance: 100nm

    manufacturing:
        copper_thickness: 10nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm

    clearance:
        high_voltage: 500nm
        safety_factor: 1.5

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 5nm
        allowed_conductors: [Aluminum, MIMCap]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        max_local_route_length: 50um
        min_segment_length: 200nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

# Legacy profile for backward compatibility (poly-based capacitors)
# Not recommended - use Capacitor_MIM for better performance
export profile Capacitor_Legacy:
    technology: "ASIC"
    
    stackup:
        polyres:    [material: Polysilicon,      thickness: 200nm, routable: true]   # Bottom Plate
        d1:         [material: Silicon_Dioxide,  thickness: 300nm, routable: false]  # Dielectric
        metal1:     [material: Aluminum,         thickness: 500nm, routable: true]   # Top Plate

    via:
        min_diameter: 300nm
        min_annular_ring: 50nm
        min_spacing: 400nm
        shape: SquareContact
        contact_depth: 30%  # Global default for capacitor contacts
        
        # v0.2.1: Material-specific penetration depths for capacitor structures
        # Shallow penetration preserves plate geometry and uniform E-field
        material_contact_depths:
            Aluminum: 30%      # Shallow penetration into top plate
            Polysilicon: 30%   # Shallow penetration into bottom plate

    trace:
        min_width: 300nm
        min_spacing: 300nm
        edge_clearance: 200nm

    manufacturing:
        copper_thickness: 500nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm

    clearance:
        high_voltage: 1um
        safety_factor: 2.0

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 50nm
        allowed_conductors: [Aluminum, Polysilicon]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        max_local_route_length: 50um
        min_segment_length: 300nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm
