# materials.hw - SKY130 Material Definitions for Capacitor Tests
import * from @std/primitives/units

export material Aluminum {
    category: "conductor"
    symbol: "Al"
    process: "deposited"
    color: "#C0C0C0"
    opacity: 1.0
    metallic: 0.8
    roughness: 0.2
    resistivity: 2.82e-8ohm_m
    thermal_conductivity: 237.0
    max_current_density: 1e3
    min_area: 0.14um2
}

export material Tungsten {
    category: "conductor"
    symbol: "W"
    process: "deposited"
    color: "#8080FF"
    opacity: 1.0
    metallic: 0.7
    roughness: 0.3
    resistivity: 5.6e-8ohm_m
    thermal_conductivity: 173.0
    max_current_density: 1e4
    contact_resistance: 1e-8ohm_cm2
}

export material Titanium_Silicide {
    category: "conductor"
    symbol: "TiSi2"
    process: "deposited"
    color: "#404040"
    opacity: 1.0
    metallic: 0.5
    roughness: 0.5
    resistivity: 1.5e-7ohm_m
    thermal_conductivity: 30.0
    max_current_density: 5e3
}

export material Silicon_Dioxide {
    category: "insulator"
    color: "#E0E8FF"
    opacity: 0.05
    metallic: 0.0
    roughness: 0.1
    relative_permittivity: 3.9
}

export material Air {
    category: "insulator"
    color: "#FFFFFF"
    opacity: 0.0
    metallic: 0.0
    roughness: 0.0
    relative_permittivity: 1.0
}


export material CAPM {
    category: "conductor"
    symbol: "CAPM"
    process: "deposited"
    color: "#FFD700"
    opacity: 1.0
    metallic: 0.85
    roughness: 0.15
    resistivity: 5.8e-7ohm_m
    thermal_conductivity: 200.0
    max_current_density: 8e2
    min_area: 0.14um2
}

export material Pad_Mask {
    category: "mask"
    symbol: "PAD"
    color: "#FFFF00"
    opacity: 0.3
    metallic: 0.0
    roughness: 0.0
}
