# simple_capacitor_test.hw - SKY130 MIM Capacitor Test
# Device: MIM (Metal-Insulator-Metal) Capacitor
# Physics: C = ε₀εᵣ(A/d)
# - Area (A): ~10μm × 10μm = 100μm² (mimcap overlap)
# - Thickness (d): 5nm (mimcap_dielectric layer)
# - εᵣ (SiO2): 3.9
# - Expected C ≈ 690fF
import * from @std/primitives/units
import * from "./capacitor_pdk"

module SimpleCapacitor:
    pins: [input In, output Out]
    route In to Out

space Simple_Capacitor_Space implements SimpleCapacitor:
    dimensions: 30.0um by 20.0um
    profile: Capacitor_MIM

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0nA }
        Out: { classification: signal, potential: 0.0V, current: 1.0nA }

    let cap_area = 10.0um          # Target capacitor overlap area
    let metal1_overhang = 500nm    # metal1 extends beyond mimcap (DRC requirement)
    let metal1_size = cap_area + (2 * metal1_overhang)  # 11μm total
    let mimcap_size = cap_area     # 10μm (sits inside metal1)
    let capacitor_center_x = 15.0um
    let capacitor_center_y = 10.0um
    let pad_spacing = 4.0um
    let pad_size = 2.0um
    let contact_size = 1.0um
    let via_diameter = 400nm

    # 1. BOTTOM PLATE (METAL1) - DEVICE TERMINAL
    # Metal1 bottom plate extends beyond mimcap on all sides (DRC requirement)
    # Bound to Terminal bottom and net Out
    add pour(Aluminum) named Bottom_Plate on layer: metal1:
        device: C1.bottom
        net: Out
        dimensions: metal1_size by metal1_size
        at: [x: capacitor_center_x, y: capacitor_center_y]

    # 2. TOP PLATE (MIMCAP) - DEVICE TERMINAL
    # MIMCap top plate sits centered on metal1 with overhang clearance
    # Bound to Terminal top and net In
    add pour(MIMCap) named Top_Plate on layer: mimcap:
        device: C1.top
        net: In
        dimensions: mimcap_size by mimcap_size
        align: center_x with Bottom_Plate
        align: center_y with Bottom_Plate

    # 3. TOP PLATE CONTACT PAD (METAL2)
    # Metal2 pad provides connection point for routing to top plate
    add pour(Aluminum) named Top_Contact_Metal2 on layer: metal2:
        net: In
        dimensions: contact_size by contact_size
        align: center_x with Top_Plate
        align: center_y with Top_Plate

    # 4. VIA CONNECTING MIMCAP → METAL2
    add contact(Tungsten) named Via_Top spanning layer: mimcap to metal2:
        net: In
        diameter: via_diameter
        align: center_x with Top_Contact_Metal2
        align: center_y with Top_Contact_Metal2

    # 5. EXTERNAL TEST PADS (Using anchor alignment with spacing)
    # Output pad - connects to bottom plate (metal1), positioned to the left
    add pour(Aluminum) named Out_Pad on layer: metal1:
        net: Out
        dimensions: pad_size by pad_size
        align: center_x with Bottom_Plate.left - pad_spacing
        align: center_y with Bottom_Plate

    # Input pad - connects to top plate via metal2, positioned to the right
    add pour(Aluminum) named In_Pad on layer: metal2:
        net: In
        dimensions: pad_size by pad_size
        align: center_x with Bottom_Plate.right + pad_spacing
        align: center_y with Bottom_Plate

    # 6. METAL1 ROUTING FROM OUT PAD TO BOTTOM PLATE
    route Out_Pad to Bottom_Plate:
        net: Out
        width: 500nm
        layer: metal1
        intent: Signal

    # 7. METAL2 ROUTING FROM TOP CONTACT TO IN PAD
    route Top_Contact_Metal2 to In_Pad:
        net: In
        width: 500nm
        layer: metal2
        intent: Signal
