# simple_capacitor_test.hw
# MIM Capacitor Test - Following SiliWiz Tutorial Structure
# https://tinytapeout.com/siliwiz/capacitors/
#
# SiliWiz Key Points:
# 1. metal1 (bottom plate) extends beyond mimcap on all sides (DRC requirement)
# 2. mimcap sits on top of metal1 with small gap around edges
# 3. metal2 via connects mimcap to metal2 for routing
# 4. External pads use relational placement (not hardcoded coordinates)
#
# Physics: C = ε₀εᵣ(A/d)
# - Area (A): ~10μm × 10μm = 100μm² (mimcap overlap)
# - Thickness (d): 5nm (mimcap_dielectric layer)
# - εᵣ (SiO2): 3.9
# - Expected C ≈ 690fF

import * from @std/primitives/units
import * from "./capacitor_pdk"

# Native device contract for MIM capacitor
device Capacitor:
    terminals: [top, bottom]
    materials:
        top: MIMCap
        bottom: Aluminum
    spice:
        prefix: C
        terminal_order: [top, bottom]
        parameters: [C]
        parameter_style: positional

module SimpleCapacitor:
    pins: [input In, output Out]
    route In to Out

space Simple_Capacitor_Space implements SimpleCapacitor:
    dimensions: 30.0um by 20.0um by 100nm
    resolution: 10nm
    origin: bl by b
    profile: Capacitor_MIM

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0nA }
        Out: { classification: signal, potential: 0.0V, current: 1.0nA }

    # ========================================================================
    # MIM CAPACITOR - Following SiliWiz Tutorial Pattern
    # ========================================================================
    
    let cap_area = 10.0um          # Target capacitor overlap area
    let metal1_overhang = 500nm    # metal1 extends beyond mimcap (DRC requirement)
    let metal1_size = cap_area + (2 * metal1_overhang)  # 11μm total
    let mimcap_size = cap_area     # 10μm (sits inside metal1)
    
    # ========================================================================
    # 1. BOTTOM PLATE (metal1) - Device terminal, extends beyond mimcap
    # ========================================================================
    add pour(Aluminum) named Bottom_Plate on layer: metal1:
        device: C1.bottom
        net: Out
        dimensions: metal1_size by metal1_size
        at: [x: 15.0um, y: 10.0um]  # Centered in space

    # ========================================================================
    # 2. TOP PLATE (mimcap) - Device terminal, smaller than metal1
    # ========================================================================
    add pour(MIMCap) named Top_Plate on layer: mimcap:
        device: C1.top
        net: In
        dimensions: mimcap_size by mimcap_size
        align: center with Bottom_Plate  # ← Relational placement!

    # ========================================================================
    # 3. TOP PLATE CONNECTION - metal2 via + metal2 pad
    # ========================================================================
    add pour(Aluminum) named Top_Contact_Metal2 on layer: metal2:
        net: In  # ← NOT device-bound! This is just a routing contact
        dimensions: 1.0um by 1.0um
        align: center with Top_Plate  # ← Relational placement!

    add contact(Tungsten) named Via_Top spanning layer: mimcap to metal2:
        net: In  # ← NOT device-bound! This is just a via for routing
        diameter: 400nm
        align: center with Top_Contact_Metal2  # ← Relational placement!

    # ========================================================================
    # 4. EXTERNAL CONNECTION PADS - Relational placement, FURTHER away
    # ========================================================================
    
    # Output pad - connects to bottom plate (metal1)
    # Place to the LEFT of the capacitor with MORE spacing
    add pour(Aluminum) named Out_Pad on layer: metal1:
        net: Out
        dimensions: 2.0um by 2.0um
        at: [x: Bottom_Plate.left - 4.0um, y: Bottom_Plate.center_y]  # ← More space!

    # Input pad - connects to top plate (metal2)  
    # Place to the RIGHT of the capacitor with MORE spacing
    add pour(Aluminum) named In_Pad on layer: metal2:
        net: In
        dimensions: 2.0um by 2.0um
        at: [x: Bottom_Plate.right + 4.0um, y: Bottom_Plate.center_y]  # ← More space!

    # ========================================================================
    # 5. ROUTING - Simple horizontal traces
    # ========================================================================

    # Connect output pad to bottom plate (both on metal1)
    route Out_Pad to Bottom_Plate:
        net: Out
        width: 500nm
        layer: metal1
        intent: Signal

    # Connect top contact to input pad (both on metal2)
    route Top_Contact_Metal2 to In_Pad:
        net: In
        width: 500nm
        layer: metal2
        intent: Signal
