## Error Handling Test: Circular Dependency Detection
## This test INTENTIONALLY creates a circular dependency to verify error handling
##
## Expected behavior:
## - Build should FAIL with circular dependency error
## - Error message should show the dependency chain
## - Error should suggest using absolute positioning
##
## Circular chain: M1 → M2 → M1

import * from @std/primitives/units

material Copper:
    category: conductor
    properties:
        resistivity: 1.68e-8Ω·m
        color: "#B87333"

material FR4:
    category: insulator
    properties:
        resistivity: 1e16Ω·m
        color: "#2E7D32"

component SimpleResistor:
    pins: [A, B]
    
    layout:
        shape: Rectangle(2mm, 1mm, 0.5mm)
        pin_positions:
            A at [0mm, 0.5mm, 0.25mm]
            B at [2mm, 0.5mm, 0.25mm]
    
    electrical:
        resistance: 1kΩ
    
    metadata:
        component_type: "Resistor"
        value: "1kΩ"
    
    render:
        type: procedural
        shape: box
        body_color: "#B87333"

space CircularDependencyTest:
    dimensions: 20mm by 20mm by 2mm
    grid: 200 by 200 by 20
    origin: tl by t
    
    nets:
        VCC: power
    
    ## Base substrate
    add substrate(FR4) spanning [x:0.1mm, y:0.1mm, z:1] to [x:19.9mm, y:19.9mm, z:2]
    
    ## ========================================================================
    ## CIRCULAR DEPENDENCY ERROR TEST
    ## ========================================================================
    ## This creates an impossible situation:
    ## - M1 is positioned absolutely (valid)
    ## - M2 is positioned relative to M3
    ## - M3 is positioned relative to M2
    ## This creates a circular dependency that should be caught
    
    ## M1: Absolute position (valid, establishes a starting point)
    add SimpleResistor named M1 at [x: 2mm, y: 10mm, z: 3]
    
    ## M2 positioned relative to M3 (M3 doesn't exist yet)
    add SimpleResistor named M2 at M3.right + 1mm
    
    ## M3 positioned relative to M2 (circular!)
    add SimpleResistor named M3 at M2.left + 1mm
