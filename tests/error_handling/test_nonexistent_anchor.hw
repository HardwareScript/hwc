## Error Handling Test: Nonexistent Anchor Detection
## This test INTENTIONALLY references a component that doesn't exist
##
## Expected behavior:
## - Build should FAIL with nonexistent anchor error
## - Error message should list available anchors
## - Error should suggest similar names (M1, M2 when user types M3)
##
## Error: M3 doesn't exist, but M1 and M2 do

import * from @std/primitives/units

material Copper:
    category: conductor
    properties:
        resistivity: 1.68e-8Ω·m
        color: "#B87333"

material FR4:
    category: insulator
    properties:
        resistivity: 1e16Ω·m
        color: "#2E7D32"

component SimpleResistor:
    pins: [A, B]
    
    layout:
        shape: Rectangle(2mm, 1mm, 0.5mm)
        pin_positions:
            A at [0mm, 0.5mm, 0.25mm]
            B at [2mm, 0.5mm, 0.25mm]
    
    electrical:
        resistance: 1kΩ
    
    metadata:
        component_type: "Resistor"
        value: "1kΩ"
    
    render:
        type: procedural
        shape: box
        body_color: "#B87333"

space NonexistentAnchorTest:
    dimensions: 20mm by 20mm by 2mm
    grid: 200 by 200 by 20
    origin: tl by t
    
    nets:
        VCC: power
    
    ## Base substrate
    add substrate(FR4) spanning [x:0.1mm, y:0.1mm, z:1] to [x:19.9mm, y:19.9mm, z:2]
    
    ## ========================================================================
    ## NONEXISTENT ANCHOR ERROR TEST
    ## ========================================================================
    ## Place M1 and M2, then try to reference M3 (which doesn't exist)
    ## Error handler should suggest M1 or M2 as alternatives
    
    ## M1: Absolute position (valid)
    add SimpleResistor named M1 at [x: 2mm, y: 10mm, z: 3]
    
    ## M2: Relative to M1 (valid)
    add SimpleResistor named M2 at M1.right + 1mm
    
    ## M4: Try to position relative to M3 (ERROR - M3 doesn't exist!)
    ## Should suggest "Did you mean: 'M1', 'M2'?"
    add SimpleResistor named M4 at M3.right + 1mm
