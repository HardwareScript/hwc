# materials.hw - SKY130 Material Definitions for Voltage Divider (v0.3.0)
import * from @std/primitives/units

export material Polysilicon {
    category: "conductor"
    color: "#FF6060"
    opacity: 1.0
    metallic: 0.3
    roughness: 0.8
    resistivity: 7e-5ohm_m
    thermal_conductivity: 30.0
    max_current_density: 1e2
    min_area: 0.13um2
}

