# materials.hw - Voltage-Divider Materials
# Focused on polysilicon resistors and metal interconnects for voltage divider circuit
import * from @std/primitives/units

# Polysilicon - The primary resistive material
# Used for polyres layer (resistors R1 and R2)
# Sheet resistance: 400 Ohms per square at 10nm thickness
export material Polysilicon:
    category: conductor
    symbol: "Poly"
    process: deposited
    properties:
        color: "#FF6060"  # Red
        metallic: 0.3
        roughness: 0.8
        opacity: 1.0      # Fully opaque - solid view
        resistivity: 4e-6ohm_m  # 400 Ohms/square at 10nm thickness (R_sheet = ρ/t = 4e-6/10e-9 = 400)
        thermal_conductivity: 30.0W_mK
        max_current_density: 1e2A_mm2

# Aluminum - Low resistance metal for interconnects
# Used for metal1 layer (contacts and routing between resistors)
export material Aluminum:
    category: conductor
    symbol: "Al"
    process: deposited
    properties:
        color: "#C0C0C0"  # Silver
        opacity: 1.0      # Fully opaque - solid view
        metallic: 0.8
        roughness: 0.2
        resistivity: 2.82e-8ohm_m
        thermal_conductivity: 237.0W_mK
        max_current_density: 1e3A_mm2

# Tungsten - Via fill material
# Used for connecting polyres to metal1
export material Tungsten:
    category: conductor
    symbol: "W"
    process: deposited
    properties:
        color: "#8080FF"  # Light Blue
        opacity: 1.0      # Fully opaque - solid view
        metallic: 0.7
        roughness: 0.3
        resistivity: 5.6e-8ohm_m
        thermal_conductivity: 173.0W_mK
        max_current_density: 1e4A_mm2

# Titanium Silicide - Contact interface material
# Forms ohmic contact between polysilicon and tungsten via
export material Titanium_Silicide:
    category: conductor
    symbol: "TiSi2"
    process: deposited
    properties:
        color: "#404040"  # Very Dark Grey
        opacity: 1.0      # Fully opaque - solid view
        resistivity: 1.5e-7ohm_m
        thermal_conductivity: 30.0W_mK
        max_current_density: 5e3A_mm2

# Silicon Dioxide - Insulator/dielectric
# Used between layers for isolation
export material Silicon_Dioxide:
    category: insulator
    symbol: "SiO2"
    process: deposited
    properties:
        color: "#E0E8FF"  # Light blue-white
        opacity: 1.0      # Fully opaque - solid view
        relative_permittivity: 3.9

# Air - Default dielectric for spacing
export material Air:
    category: insulator
    symbol: "Air"
    process: deposited
    properties:
        color: "#F0F4FF"
        opacity: 1.0      # Fully opaque - solid view
        relative_permittivity: 1.0
