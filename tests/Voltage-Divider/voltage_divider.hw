# voltage_divider.hw - SKY130 Voltage Divider (v0.3.1 Canonical)
# Device: sky130_fd_pr__res_high_po (P+ Poly Precision Resistor, 350 Ohm/sq)

import * from @std/primitives/units
import * from @std/primitives/math
import { RouteIntent } from @std/routing/intent
import { sky130_res_high_po } from "../pdk/sky130/devices/resistor"
import { pad } from "../pdk/sky130/physical/pad"
import { Resistor_3D } from "./resistor_pdk"

module VoltageDivider {
    pins: [input In, output Mid, ground GND]
}

space Voltage_Divider_Space implements VoltageDivider {
    dimensions: [25.0um, 12.0um]
    profile: Resistor_3D

    nets {
        In:  { classification: "signal", potential: 1.8V, current: 1.0uA }
        Mid: { classification: "signal", potential: 0.9V, current: 1.0uA }
        GND: { classification: "ground", potential: 0.0V, current: 2.0uA }
    }

    # 1. Pure Precision Resistor CellLayout instances placed explicitly
    let r_cell1 = sky130_res_high_po(W: 1.41um, L: 4.0um)
    let r_cell2 = sky130_res_high_po(W: 1.41um, L: 4.0um)

    let r1 = space.place(r_cell1, at: [6.0um, 5.0um])
    let r2 = space.place(r_cell2, at: [14.0um, 5.0um])

    # 2. External I/O Test Pads (Inline at Y = 5.0um)
    let pad_cell = pad(size: 1.0um)
    let in_pad  = space.place(pad_cell, at: [2.5um,  5.0um])
    let mid_pad = space.place(pad_cell, at: [10.0um, 5.0um])
    let gnd_pad = space.place(pad_cell, at: [17.5um, 5.0um])

    # 3. Interconnect Wiring with strongly-typed RouteIntent enum
    route in_pad.port("PORT")  to r1.port("A")         { net: In,  intent: RouteIntent.Signal, width: 300nm }
    route r1.port("B")         to mid_pad.port("PORT") { net: Mid, intent: RouteIntent.Signal, width: 300nm }
    route mid_pad.port("PORT") to r2.port("A")         { net: Mid, intent: RouteIntent.Signal, width: 300nm }
    route r2.port("B")         to gnd_pad.port("PORT") { net: GND, intent: RouteIntent.Ground, width: 300nm }
}

test Voltage_Divider_AC_Test for Voltage_Divider_Space {
    ac:   { sweep: "dec", points: 20, start: 100Hz, stop: 100MHz }
    tran: { step: 10ps, stop: 200ns }
}
