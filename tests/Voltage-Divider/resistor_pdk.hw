# resistor_pdk.hw - SkyWater SKY130 Resistor PDK Configuration (v0.3.0)
import * from @std/primitives/units
import {
    Polysilicon,
    Aluminum,
    Tungsten,
    Titanium_Nitride,
    Titanium_Silicide,
    Silicon_Dioxide,
    Resistor_Poly_Mask,
    Npc_Mask,
    P_Plus_Diffusion,
    P_Plus_Implant_Mask,
    N_Plus_Implant_Mask,
    Tap_Mask,
    Pad_Mask
} from "./materials"

export {
    Polysilicon,
    Aluminum,
    Tungsten,
    Titanium_Nitride,
    Titanium_Silicide,
    Silicon_Dioxide,
    Resistor_Poly_Mask,
    Npc_Mask,
    P_Plus_Diffusion,
    P_Plus_Implant_Mask,
    N_Plus_Implant_Mask,
    Tap_Mask,
    Pad_Mask
}

export profile Resistor_3D {
    technology "ASIC" {
        substrate_net: "GND"
    }

    stackup {
        tap     { material: "Tap_Mask",            thickness: 0nm,   routable: false }
        psdm    { material: "P_Plus_Implant_Mask", thickness: 0nm,   routable: false }
        diff    { material: "P_Plus_Diffusion",    thickness: 200nm, routable: true  }
        polyres { material: "Polysilicon",         thickness: 180nm, routable: true  }
        rpm     { material: "Resistor_Poly_Mask",  thickness: 0nm,   routable: false }
        npc     { material: "Npc_Mask",            thickness: 0nm,   routable: false }
        ild0    { material: "Silicon_Dioxide",     thickness: 200nm, routable: false }
        li1     { material: "Titanium_Nitride",    thickness: 100nm, routable: true  }
        ild1    { material: "Silicon_Dioxide",     thickness: 150nm, routable: false }
        metal1  { material: "Aluminum",            thickness: 360nm, routable: true  }
        pad     { material: "Pad_Mask",            thickness: 0nm,   routable: false }
    }

    manufacturing {
        track_pitch:      10nm
        copper_thickness: 500nm
        circle_segments:  64
    }

    via {
        min_diameter:  170nm
        min_enclosure: 40nm
        min_spacing:   200nm
        shape:         "square"
        contact_depth: 30%
    }

    trace {
        min_width:      300nm
        min_spacing:    300nm
        edge_clearance: 200nm
    }

    clearance {
        high_voltage:  1um
        safety_factor: 2.0
    }

    thermal {
        ambient_temp:          25degC
        max_operating_temp:    125degC
        max_temp_rise:         50degC
        clustering_threshold:  10um
    }

    routing {
        min_segment_length:        300nm
        base_cost:                 1
        via_penalty:               50
        direction_penalty:         10
        tight_clearance_penalty:   2
        crosstalk_penalty:         3
        impedance_penalty:         1
        reference_void_penalty:    5000000
    }

    # ── Foundry PDK Model Includes ─────────────────────────────────────────────
    models {
        include: "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"
    }
}

export device Resistor {
    terminals: [A, B, BULK]
    spice {
        prefix:          "X"
        subcircuit:      "sky130_fd_pr__res_high_po"
        include:         "sky130_fd_pr/models/sky130_fd_pr__res_high_po.model.spice"
        terminal_order:  [A, B, BULK]
        parameters:      [W, L]
        parameter_style: "named"
    }
}
