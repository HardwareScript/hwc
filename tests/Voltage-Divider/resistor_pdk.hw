# resistor_pdk.hw - Process Design Kit for Voltage Divider
# Simplified PDK focused on polysilicon resistors and metal interconnects
import * from @std/primitives/units
import Polysilicon, Aluminum, Tungsten, Titanium_Silicide, Silicon_Dioxide, Air from "./materials"

export Polysilicon
export Aluminum
export Tungsten
export Titanium_Silicide
export Silicon_Dioxide
export Air

# Define square contact shape for vias
export shape SquareContact(width: Measurement):
    geometry:
        Rectangle(width: width, height: width)

# Define the bridge from polysilicon to metal using silicide + tungsten
export bridge Polysilicon to Aluminum:
    interface: Titanium_Silicide
    thickness: 5nm
    fill: Tungsten

# Flattened profile for 2D voltage divider testing
# Ultra-thin layers to keep geometry simple for multi-device extraction
export profile Resistor_Flattened:
    technology: "ASIC"
    
    stackup:
        polyres:    [material: Polysilicon,      thickness: 10nm, routable: true]
        d1:         [material: Silicon_Dioxide,  thickness: 10nm, routable: false]
        metal1:     [material: Aluminum,         thickness: 10nm, routable: true]

    via:
        min_diameter: 200nm
        min_enclosure: 50nm
        min_spacing: 300nm
        shape: SquareContact
        contact_depth: 10nm  # Match layer thickness to prevent substrate penetration

    trace:
        min_width: 200nm
        min_spacing: 200nm
        edge_clearance: 100nm

    manufacturing:
        copper_thickness: 10nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm

    clearance:
        high_voltage: 500nm
        safety_factor: 1.5

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 5nm
        allowed_conductors: [Aluminum, Polysilicon]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        max_local_route_length: 50um
        min_segment_length: 200nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm

# 3D profile for voltage divider with realistic layer thicknesses
# Similar to Skywater 130nm process layer thicknesses
export profile Resistor_3D:
    technology: "ASIC"
    
    stackup:
        polyres:    [material: Polysilicon,      thickness: 200nm, routable: true]
        d1:         [material: Silicon_Dioxide,  thickness: 300nm, routable: false]
        metal1:     [material: Aluminum,         thickness: 500nm, routable: true]

    via:
        min_diameter: 300nm
        min_enclosure: 50nm
        min_spacing: 400nm
        shape: SquareContact
        contact_depth: 100nm

    trace:
        min_width: 300nm
        min_spacing: 300nm
        edge_clearance: 200nm

    manufacturing:
        copper_thickness: 500nm
        circle_segments: 64
        solder_mask_thickness: 0nm
        solder_mask_expansion: 0nm

    clearance:
        high_voltage: 1um
        safety_factor: 2.0

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 50nm
        allowed_conductors: [Aluminum, Polysilicon]
        allowed_dielectrics: [Silicon_Dioxide, Air]

    routing:
        max_local_route_length: 50um
        min_segment_length: 300nm
        escape_stub: 0nm
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000

    net_type Signal:
        routing_style: auto
        escape_stub: 0nm
