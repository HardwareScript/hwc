# @std/digital/fifo.hw
# Tier 1 Procedural Synchronous FIFO Buffer
# HardwareScript v0.3.1 Standard Library Reference

import * from @std/primitives/units

export struct FifoConfig {
    depth: Int,
    data_width: Int,
    almost_full_watermark: Int,
    almost_empty_watermark: Int,
}

export struct FifoPort {
    wdata: Point2D,
    wen: Point2D,
    full: Point2D,
    almost_full: Point2D,
    rdata: Point2D,
    ren: Point2D,
    empty: Point2D,
    almost_empty: Point2D,
    clk: Point2D,
    rst_n: Point2D,
}

export struct FifoMacro {
    name: String,
    bbox: BoundingBox,
    config: FifoConfig,
    ports: FifoPort,
    area_um2: Float,
}

/// Parametric Synchronous FIFO Buffer Hardware Macro
export fn sync_fifo(
    at: Point2D,
    config: FifoConfig = FifoConfig { depth: 16, data_width: 8, almost_full_watermark: 14, almost_empty_watermark: 2 },
    name: String = "sync_fifo"
) -> FifoMacro {
    # Scale width/height based on data_width and depth
    let width = 20.0um + (config.depth * 1.5um)
    let height = 15.0um + (config.data_width * 0.8um)

    let bbox = BoundingBox {
        min_x: at.x,
        max_x: at.x + width,
        min_y: at.y,
        max_y: at.y + height,
    }

    let ports = FifoPort {
        wdata: Point2D { x: at.x, y: at.y + 4.0um },
        wen: Point2D { x: at.x, y: at.y + 8.0um },
        full: Point2D { x: at.x, y: at.y + 12.0um },
        almost_full: Point2D { x: at.x, y: at.y + 14.0um },
        rdata: Point2D { x: at.x + width, y: at.y + 4.0um },
        ren: Point2D { x: at.x + width, y: at.y + 8.0um },
        empty: Point2D { x: at.x + width, y: at.y + 12.0um },
        almost_empty: Point2D { x: at.x + width, y: at.y + 14.0um },
        clk: Point2D { x: at.x + width / 2.0, y: at.y },
        rst_n: Point2D { x: at.x + width / 2.0, y: at.y + height },
    }

    return FifoMacro {
        name: name,
        bbox: bbox,
        config: config,
        ports: ports,
        area_um2: (width / 1.0um) * (height / 1.0um),
    }
}
