# Silicon Foundry Profiles - ASIC/IC Manufacturing Specs
# Stress test: Nanometer-scale dimensions to test i64 fixed-point math

## Silicon Foundry Overview
## - Process nodes: 180nm (mature), 28nm (mainstream), 5nm (cutting-edge)
## - Metal layers: 6-15 layers for interconnect
## - Extreme precision: Sub-100nm features
## - Different physics: Quantum effects, electromigration, IR drop

# ============================================================================
# TSMC Process Nodes
# ============================================================================

profile TSMC_180nm:
    description: "TSMC 180nm process (mature node, automotive/IoT)"
    
    layer:
        max_count: 6
        min_thickness: 10µm
    
    trace:
        min_width: 180nm
        min_spacing: 180nm
    
    via:
        min_diameter: 200nm
        min_annular_ring: 50nm
    
    clearance:
        high_voltage: 500nm
        safety_factor: 1.5
        low_voltage_threshold: 1.8V
        medium_voltage_threshold: 3.3V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10µm
    
    manufacturing:
        copper_thickness: 500nm
        ipc2221_k_external: 0.024
        ipc2221_k_internal: 0.012
    
    stackup:
        dielectric_height: 1µm
        dielectric_material: "SiO2"
        copper_thickness: 500nm
        default_impedance: 50.0

