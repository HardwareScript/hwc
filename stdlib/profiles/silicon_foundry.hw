# ============================================================================
# Extreme Stress Test Profiles
# ============================================================================

profile Silicon_Extreme_1nm:
    description: "Extreme 1nm process (stress test for nanometer math overflow/underflow)"
    
    layer:
        max_count: 20
        min_thickness: 500nm
    
    trace:
        min_width: 1nm
        min_spacing: 1nm
    
    via:
        min_diameter: 3nm
        min_annular_ring: 1nm
    
    clearance:
        high_voltage: 10nm
        safety_factor: 1.5
        low_voltage_threshold: 0.5V
        medium_voltage_threshold: 0.7V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 100C
        clustering_threshold: 100nm
    
    manufacturing:
        copper_thickness: 10nm
        ipc2221_k_external: 0.024
        ipc2221_k_internal: 0.012
    
    stackup:
        dielectric_height: 10nm
        dielectric_material: "Ultra_Low_k"
        copper_thickness: 10nm
        default_impedance: 50.0

profile Silicon_Picometer_Test:
    description: "Picometer-scale test (extreme stress test for fixed-point precision)"
    
    layer:
        max_count: 10
        min_thickness: 100nm
    
    trace:
        min_width: 100pm
        min_spacing: 100pm
    
    via:
        min_diameter: 500pm
        min_annular_ring: 100pm
    
    clearance:
        high_voltage: 1nm
        safety_factor: 1.5
        low_voltage_threshold: 0.3V
        medium_voltage_threshold: 0.5V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 100C
        clustering_threshold: 10nm
    
    manufacturing:
        copper_thickness: 1nm
        ipc2221_k_external: 0.024
        ipc2221_k_internal: 0.012
    
    stackup:
        dielectric_height: 1nm
        dielectric_material: "Graphene"
        copper_thickness: 1nm
        default_impedance: 50.0

profile Silicon_Mixed_Scale:
    description: "Mixed scale test (millimeter board with nanometer features)"
    
    layer:
        max_count: 8
        min_thickness: 10mm
    
    trace:
        min_width: 5nm
        min_spacing: 5nm
    
    via:
        min_diameter: 10nm
        min_annular_ring: 3nm
    
    clearance:
        high_voltage: 1mm
        safety_factor: 2.0
        low_voltage_threshold: 1V
        medium_voltage_threshold: 5V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 150C
        max_temp_rise: 50C
        clustering_threshold: 1mm
    
    manufacturing:
        copper_thickness: 30nm
        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    stackup:
        dielectric_height: 1mm
        dielectric_material: "SiO2"
        copper_thickness: 30nm
        default_impedance: 50.0
