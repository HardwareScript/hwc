## Heavy Copper Profiles (2oz+)

profile JLCPCB_2Layer_HeavyCopper:
    description: "JLCPCB 2-layer heavy copper (2oz, high current)"
    
    layer:
        max_count: 2
        min_thickness: 1.6mm
    
    trace:
        min_width: 200µm
        min_spacing: 200µm
    
    via:
        min_diameter: 400µm
        min_enclosure: 200µm
    
    clearance:
        high_voltage: 3mm
        safety_factor: 2.5
        low_voltage_threshold: 50V
        medium_voltage_threshold: 150V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 105C
        max_temp_rise: 30C
        clustering_threshold: 8mm
    
    manufacturing:
        copper_thickness: 70µm
        circle_segments: 64                # Circular geometry fidelity (vias, pads, tubes, TSVs)
        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    stackup:
        top:    [material: Copper, thickness: 70µm]
        core:   [material: FR4,    thickness: 1.6mm]
        bottom: [material: Copper, thickness: 70µm]

