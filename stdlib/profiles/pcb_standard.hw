# PCB Standard Profiles - JLCPCB/PCBWay Manufacturing Specs
#
# These profiles define real-world manufacturing constraints from popular PCB fabs
# Based on JLCPCB and PCBWay standard capabilities (as of 2024)
#
# References:
# - JLCPCB Capabilities: https://jlcpcb.com/capabilities/pcb-capabilities
# - PCBWay Capabilities: https://www.pcbway.com/capabilities.html
# - IPC-2221 Standard for PCB Design

## 2-Layer PCB Profiles

profile JLCPCB_2Layer_Standard:
    description: "JLCPCB 2-layer standard process (most economical)"
    
    layer:
        max_count: 2
        min_thickness: 1.6mm
    
    trace:
        min_width: 127µm
        min_spacing: 127µm
    
    via:
        min_diameter: 300µm
        min_enclosure: 150µm
    
    clearance:
        high_voltage: 2mm
        safety_factor: 2.0
        low_voltage_threshold: 50V
        medium_voltage_threshold: 150V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 85C
        max_temp_rise: 20C
        clustering_threshold: 5mm
    
    manufacturing:
        copper_thickness: 35µm
        circle_segments: 64                # Circular geometry fidelity (vias, pads, tubes, TSVs)
        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    stackup:
        top:    [material: Copper, thickness: 35µm]
        core:   [material: FR4,    thickness: 1.6mm]
        bottom: [material: Copper, thickness: 35µm]

profile JLCPCB_2Layer_Fine:
    description: "JLCPCB 2-layer fine pitch (5mil trace/space)"
    
    layer:
        max_count: 2
        min_thickness: 1.6mm
    
    trace:
        min_width: 100µm
        min_spacing: 100µm
    
    via:
        min_diameter: 250µm
        min_enclosure: 125µm
    
    clearance:
        high_voltage: 2mm
        safety_factor: 2.0
