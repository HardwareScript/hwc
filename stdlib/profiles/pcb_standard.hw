        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    stackup:
        top:    [material: Copper, thickness: 35µm]
        core:   [material: FR4,    thickness: 1.6mm]
        bottom: [material: Copper, thickness: 35µm]

profile PCBWay_2Layer_Standard:
    description: "PCBWay 2-layer standard process"
    
    layer:
        max_count: 2
        min_thickness: 1.6mm
    
    trace:
        min_width: 152µm
        min_spacing: 152µm
    
    via:
        min_diameter: 300µm
        min_enclosure: 150µm
    
    clearance:
        high_voltage: 2mm
        safety_factor: 2.0
        low_voltage_threshold: 50V
        medium_voltage_threshold: 150V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 85C
        max_temp_rise: 20C
        clustering_threshold: 5mm
    
    manufacturing:
        copper_thickness: 35µm
        circle_segments: 64                # Circular geometry fidelity (vias, pads, tubes, TSVs)
        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    stackup:
        top:    [material: Copper, thickness: 35µm]
        core:   [material: FR4,    thickness: 1.6mm]
        bottom: [material: Copper, thickness: 35µm]

## 4-Layer PCB Profiles

profile JLCPCB_4Layer_Standard:
