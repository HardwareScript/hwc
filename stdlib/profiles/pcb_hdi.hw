# High-Density Interconnect (HDI) PCB Profiles
# Stress test: Microscopic vias, extreme trace widths, blind/buried vias

## HDI Technology Overview
## - Microvias: Laser-drilled vias (typically 75-150µm diameter)
## - Sequential lamination: Build-up layers added incrementally
## - Fine-pitch capability: 0.4mm BGA pitch and below
## - Blind vias: Connect outer layer to inner layer (not through-board)
## - Buried vias: Connect inner layers only (invisible from outside)

# ============================================================================
# JLCPCB HDI Profiles
# ============================================================================

profile JLCPCB_HDI_4Layer_1_2_1:
    description: "JLCPCB 4-layer HDI with 1+2+1 stackup (microvias on outer layers)"
    
    layer:
        max_count: 4
        min_thickness: 0.8mm
    
    trace:
        min_width: 75µm
        min_spacing: 75µm
    
    via:
        min_diameter: 100µm
        min_enclosure: 50µm
    
    clearance:
        high_voltage: 1.5mm
        safety_factor: 2.0
        low_voltage_threshold: 50V
        medium_voltage_threshold: 150V
    
    thermal:
        ambient_temp: 25C
        max_operating_temp: 130C
        max_temp_rise: 25C
        clustering_threshold: 4mm
    
    manufacturing:
        copper_thickness: 18µm
        circle_segments: 64                # Circular geometry fidelity (vias, pads, tubes, TSVs)
        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    stackup:
        top:    [material: Copper, thickness: 18µm]
        d1:     [material: FR4,    thickness: 100µm]
        inner1: [material: Copper, thickness: 18µm]
        core:   [material: FR4,    thickness: 528µm]
        inner2: [material: Copper, thickness: 18µm]
        d2:     [material: FR4,    thickness: 100µm]
        bottom: [material: Copper, thickness: 18µm]

