## Hardware Script Standard Library - Bridge Materials
## Domain: Material Transition Interfaces - Ohmic Contacts, Die Interconnects, Solder Joints
## Purpose: Define materials used to bridge incompatible material pairs
## Status: Phase 3 - Standard Library Implementation (BRIDGE-IMPLEMENTATION.md)

#[
BRIDGE MATERIALS OVERVIEW:

Bridge materials enable safe electrical connections between incompatible materials.
They are organized into categories based on their application domain:

1. SILICIDES (Silicon-to-Metal Bridges)
   - Titanium Silicide (TiSi₂) - Low resistance, CMOS standard
   - Cobalt Silicide (CoSi₂) - Higher temperature stability
   - Nickel Silicide (NiSi) - Modern CMOS processes
   - Tungsten Silicide (WSi₂) - High-temperature applications
   - Platinum Silicide (PtSi) - Schottky barrier contacts

2. DIE INTERCONNECTS (3D Integration)
   - Gold Bumps - Traditional flip-chip bonding
   - Copper Pillars - Modern high-density interconnects
   - Solder Bumps - C4 (Controlled Collapse Chip Connection)
   - Micro-bumps - TSV and 3D stacking

3. PCB SOLDERS (Board-Level Assembly)
   - SAC305 (Sn96.5Ag3.0Cu0.5) - Lead-free standard
   - SAC405 - Higher silver content
   - SnPb (63/37) - Legacy eutectic solder
   - Low-temp solders - Bismuth alloys

4. BARRIER LAYERS (Diffusion Prevention)
   - Titanium Nitride (TiN) - Copper diffusion barrier
   - Tantalum Nitride (TaN) - Advanced nodes
   - Tungsten - Via liner and barrier

5. ADHESION LAYERS (Mechanical Bonding)
   - Conductive Epoxy - PCB assembly
   - Anisotropic Conductive Film (ACF) - Display bonding
   - Silver Epoxy - High-conductivity adhesive

USAGE IN PROFILES:
These materials are referenced in profile bridge tables:

profile TSMC_180nm:
    bridge Silicon_N to Copper:
        interface: Cobalt_Silicide
        thickness: 50nm
        fill: Tungsten

See: BRIDGE-IMPLEMENTATION.md for complete architecture
]#

## ============================================================================
## SECTION 1: SILICIDES - Silicon-to-Metal Ohmic Contacts
## Application: CMOS transistor source/drain contacts, gate electrodes
## ============================================================================

material Titanium_Silicide:
    category: conductor
    symbol: "TiSi₂"
    description: "Titanium silicide - industry standard for CMOS source/drain contacts"
    
    properties:
        density: 4020kg/m³
        thermal_conductivity: 22W/(m·K)
        resistivity: 13e-8Ω·m                # 13-16 µΩ·cm typical
        max_current_density: 5e6A/cm²         # High current capability
        melting_point: 1540°C
        formation_temp: 650°C                 # Silicidation temperature
        work_function: 4.3eV                  # Mid-gap work function
        schottky_barrier_n: 0.5eV             # N-type silicon barrier
        schottky_barrier_p: 0.6eV             # P-type silicon barrier
        temp_coefficient: +1.5e-3/°C
        sheet_resistance: 3.0Ω/sq             # Typical for 50nm film
        thermal_stability: 700°C              # Max stable temperature
        color: "#4A4A4A"
        
        # Manufacturing properties
        deposition_method: "Sputtering + RTA"
        typical_thickness: 50nm
        min_thickness: 30nm
        max_thickness: 100nm
        
        # Compatibility
        compatible_with: "Silicon, Polysilicon, N+, P+"
        incompatible_with: "Aluminum (reacts)"
        
        # References
        standard: "ITRS Roadmap 2015"
        notes: "Most common silicide for 180nm-350nm CMOS processes"

material Cobalt_Silicide:
    category: conductor
    symbol: "CoSi₂"
    description: "Cobalt silicide - modern CMOS standard with better scalability"
    
    properties:
        density: 4950kg/m³
        thermal_conductivity: 20W/(m·K)
        resistivity: 18e-8Ω·m                # 15-20 µΩ·cm typical
        max_current_density: 8e6A/cm²
        melting_point: 1326°C
        formation_temp: 550°C                 # Lower than TiSi₂
        work_function: 4.5eV
        schottky_barrier_n: 0.65eV
        schottky_barrier_p: 0.45eV
        temp_coefficient: +1.2e-3/°C
        sheet_resistance: 5.0Ω/sq             # For 50nm film
        thermal_stability: 800°C              # Better than TiSi₂
        color: "#3C3C3C"
        
        # Manufacturing properties
        deposition_method: "Sputtering + Two-step RTA"
        typical_thickness: 50nm
        min_thickness: 20nm
        max_thickness: 80nm
        
        # Scalability
        min_feature_size: 45nm                # Scales better than TiSi₂
        line_edge_roughness: 2nm
        
        # Compatibility
        compatible_with: "Silicon, Polysilicon, N+, P+, STI"
        incompatible_with: "Aluminum (reacts)"
        
        # References
        standard: "ITRS Roadmap 2015"
        notes: "Preferred for 45nm-180nm nodes due to lower formation temp and better scalability"

material Nickel_Silicide:
    category: conductor
    symbol: "NiSi"
    description: "Nickel silicide - advanced CMOS nodes (32nm and below)"
    
    properties:
        density: 5330kg/m³
        thermal_conductivity: 18W/(m·K)
        resistivity: 14e-8Ω·m                # 10-15 µΩ·cm for NiSi phase
        max_current_density: 1e7A/cm²         # Excellent current handling
        melting_point: 992°C
        formation_temp: 450°C                 # Lowest formation temp
        work_function: 4.6eV
        schottky_barrier_n: 0.67eV
        schottky_barrier_p: 0.43eV
        temp_coefficient: +1.0e-3/°C
        sheet_resistance: 4.0Ω/sq             # For 50nm NiSi film
        thermal_stability: 750°C              # NiSi → NiSi₂ transition above this
        color: "#505050"
        
        # Manufacturing properties
        deposition_method: "Sputtering + Single-step RTA"
        typical_thickness: 30nm
        min_thickness: 15nm
        max_thickness: 50nm
        
        # Phase control (critical!)
        stable_phase: "NiSi"                  # Monosilicide phase
        unstable_phase: "NiSi₂"               # Disilicide (higher resistivity)
        phase_transition_temp: 750°C
        
        # Scalability
        min_feature_size: 22nm                # Excellent for narrow lines
        line_edge_roughness: 1nm
        
        # Compatibility
        compatible_with: "Silicon, Polysilicon, N+, P+, STI, High-k"
        incompatible_with: "Aluminum"
        
        # References
        standard: "ITRS Roadmap 2015, IEEE IEDM 2008"
        notes: "Industry standard for 22nm-45nm nodes. Low formation temp enables integration with high-k/metal gate"

material Tungsten_Silicide:
    category: ohmic_contact
    symbol: "WSi₂"
    description: "Tungsten silicide - high-temperature gate electrode material"
    
    properties:
        density: 9860kg/m³
        thermal_conductivity: 25W/(m·K)
        resistivity: 70e-8Ω·m                # Higher than other silicides
        max_current_density: 3e6A/cm²
        melting_point: 2165°C                 # Very high melting point
        formation_temp: 1000°C                # High formation temp
        work_function: 4.6eV
        schottky_barrier_n: 0.7eV
        schottky_barrier_p: 0.4eV
        temp_coefficient: +2.0e-3/°C
        sheet_resistance: 15Ω/sq              # For 50nm film
        thermal_stability: 1000°C             # Excellent thermal stability
        color: "#2F2F2F"
        
        # Manufacturing properties
        deposition_method: "CVD or Sputtering"
        typical_thickness: 100nm
        min_thickness: 50nm
        max_thickness: 200nm
        
        # Applications
        primary_use: "Gate electrode"
        secondary_use: "Local interconnect"
        
        # Compatibility
        compatible_with: "Silicon, Polysilicon, SiO₂"
        incompatible_with: "Aluminum (reacts at high temp)"
        
        # References
        standard: "VLSI Technology Handbook"
        notes: "Used in older CMOS processes (>250nm) for gate electrodes. Replaced by polysilicon in modern processes"

material Platinum_Silicide:
    category: ohmic_contact
    symbol: "PtSi"
    description: "Platinum silicide - Schottky barrier diodes and infrared detectors"
    
    properties:
        density: 12400kg/m³
        thermal_conductivity: 30W/(m·K)
        resistivity: 28e-8Ω·m
        max_current_density: 2e6A/cm²
        melting_point: 1229°C
        formation_temp: 300°C                 # Very low formation temp
        work_function: 5.65eV                 # High work function
        schottky_barrier_n: 0.85eV            # High barrier for Schottky diodes
        schottky_barrier_p: 0.25eV            # Low barrier for P-type
        temp_coefficient: +1.8e-3/°C
        sheet_resistance: 8Ω/sq               # For 50nm film
        thermal_stability: 600°C
        color: "#6A6A6A"
        
        # Manufacturing properties
        deposition_method: "Sputtering + Low-temp anneal"
        typical_thickness: 50nm
        min_thickness: 30nm
        max_thickness: 100nm
        
        # Applications
        primary_use: "Schottky barrier diodes"
        secondary_use: "IR detectors (3-5 µm)"
        
        # Electrical properties
        ideality_factor: 1.05                 # Near-ideal Schottky diode
        reverse_leakage: 1e-9A/cm²            # Low leakage
        
        # Compatibility
        compatible_with: "Silicon (P-type preferred)"
        incompatible_with: "Aluminum"
        
        # References
        standard: "IEEE Electron Device Letters"
        notes: "Specialty application for Schottky diodes and infrared sensors. Not used for standard CMOS"

material Palladium_Silicide:
    category: ohmic_contact
    symbol: "Pd₂Si"
    description: "Palladium silicide - low-resistance contact for advanced nodes"
    
    properties:
        density: 9250kg/m³
        thermal_conductivity: 28W/(m·K)
        resistivity: 30e-8Ω·m
        max_current_density: 4e6A/cm²
        melting_point: 1320°C
        formation_temp: 200°C                 # Extremely low formation temp
        work_function: 5.0eV
        schottky_barrier_n: 0.75eV
        schottky_barrier_p: 0.35eV
        temp_coefficient: +1.6e-3/°C
        sheet_resistance: 7Ω/sq
        thermal_stability: 700°C
        color: "#5A5A5A"
        
        # Manufacturing properties
        deposition_method: "Sputtering + Ultra-low-temp RTA"
        typical_thickness: 40nm
        min_thickness: 20nm
        max_thickness: 80nm
        
        # Compatibility
        compatible_with: "Silicon, Germanium, SiGe"
        incompatible_with: "Aluminum"
        
        # References
        notes: "Research material for ultra-low thermal budget processes. Not widely used in production"

## ============================================================================
## SECTION 2: GENERIC SILICIDES - For Prototyping and Generic Profiles
## ============================================================================

material Generic_Silicide:
    category: ohmic_contact
    symbol: "MSi"
    description: "Generic silicide for prototyping - average properties of common silicides"
    
    properties:
        density: 5000kg/m³                    # Average of Ti, Co, Ni silicides
        thermal_conductivity: 20W/(m·K)
        resistivity: 20e-8Ω·m                # Conservative average
        max_current_density: 5e6A/cm²
        melting_point: 1200°C
        formation_temp: 500°C
        work_function: 4.5eV
        schottky_barrier_n: 0.6eV
        schottky_barrier_p: 0.5eV
        temp_coefficient: +1.5e-3/°C
        sheet_resistance: 5Ω/sq
        thermal_stability: 700°C
        color: "#404040"
        
        # Manufacturing properties
        typical_thickness: 50nm
        min_thickness: 30nm
        max_thickness: 100nm
        
        # Compatibility
        compatible_with: "Silicon, Polysilicon"
        
        # References
        notes: "Generic material for use in default profiles when specific foundry data is unavailable"


## ============================================================================
## SECTION 3: DIE INTERCONNECTS - 3D Integration and Flip-Chip Bonding
## Application: Die-to-die connections, chiplet interconnects, HBM stacks
## ============================================================================

material Gold_Bump:
    category: die_interconnect
    symbol: "Au"
    description: "Gold bump - traditional flip-chip bonding for high-reliability"
    
    properties:
        density: 19300kg/m³
        thermal_conductivity: 318W/(m·K)
        resistivity: 2.44e-8Ω·m
        max_current_density: 1e5A/cm²
        melting_point: 1064°C
        bonding_temp: 300°C                   # Thermocompression bonding
        work_function: 5.1eV
        temp_coefficient: +3.4e-3/°C
        contact_resistance: 1e-8Ω·cm²         # Very low contact resistance
        color: "#FFD700"
        
        # Mechanical properties
        youngs_modulus: 79GPa
        yield_strength: 120MPa
        hardness: 25HV                        # Vickers hardness
        
        # Geometry
        typical_diameter: 100µm
        typical_height: 50µm
        min_pitch: 150µm
        
        # Manufacturing
        deposition_method: "Electroplating or wire bonding"
        under_bump_metallization: "Ti/Ni/Au stack"
        
        # Reliability
        thermal_cycling: 1000cycles           # -40°C to 125°C
        electromigration_lifetime: 10years    # At 125°C, 1e4 A/cm²
        
        # Compatibility
        compatible_with: "Silicon, Copper, Nickel, Aluminum"
        incompatible_with: "None (noble metal)"
        
        # References
        standard: "JEDEC JESD22-A104"
        notes: "Gold standard for high-reliability applications (aerospace, military). Expensive but corrosion-free"

material Copper_Pillar:
    category: die_interconnect
    symbol: "Cu-Pillar"
    description: "Copper pillar - modern high-density flip-chip interconnect"
    
    properties:
        density: 8960kg/m³
        thermal_conductivity: 401W/(m·K)
        resistivity: 1.72e-8Ω·m              # Lower than gold!
        max_current_density: 2e5A/cm²
        melting_point: 1085°C
        bonding_temp: 250°C                   # With solder cap
        work_function: 4.65eV
        temp_coefficient: +3.9e-3/°C
        contact_resistance: 5e-9Ω·cm²         # Excellent
        color: "#B87333"
        
        # Mechanical properties
        youngs_modulus: 130GPa
        yield_strength: 200MPa                # Stronger than gold
        hardness: 80HV
        
        # Geometry
        typical_diameter: 40µm                # Smaller than gold bumps
        typical_height: 60µm                  # Taller aspect ratio
        min_pitch: 50µm                       # High density!
        aspect_ratio: 1.5                     # Height/diameter
        
        # Manufacturing
        deposition_method: "Electroplating"
        seed_layer: "Ti/Cu sputtered"
        solder_cap: "SAC305 (5-10 µm)"
        barrier_layer: "TiN or TaN"
        
        # Reliability
        thermal_cycling: 2000cycles           # Better than solder bumps
        electromigration_lifetime: 15years
        
        # Advantages
        advantages: "Lower resistance, higher density, better electromigration"
        
        # Compatibility
        compatible_with: "Silicon, Copper, Nickel, SAC solder"
        incompatible_with: "Aluminum (galvanic corrosion)"
        
        # References
        standard: "JEDEC JEP154, IEEE ECTC 2010"
        notes: "Industry standard for advanced packaging (7nm-3nm nodes). Used in HBM, chiplets, and high-performance computing"

material Solder_Bump_C4:
    category: die_interconnect
    symbol: "C4"
    description: "C4 solder bump - Controlled Collapse Chip Connection (IBM invention)"
    
    properties:
        density: 7400kg/m³                    # SnPb eutectic
        thermal_conductivity: 50W/(m·K)
        resistivity: 15e-8Ω·m
        max_current_density: 5e4A/cm²
        melting_point: 183°C                  # Eutectic SnPb (63/37)
        bonding_temp: 220°C                   # Reflow temperature
        temp_coefficient: +4.0e-3/°C
        contact_resistance: 1e-7Ω·cm²
        color: "#C0C0C0"
        
        # Mechanical properties
        youngs_modulus: 25GPa                 # Soft compared to metals
        yield_strength: 30MPa
        shear_strength: 25MPa
        
        # Geometry
        typical_diameter: 100µm
        typical_height: 80µm
        min_pitch: 200µm
        
        # Manufacturing
        deposition_method: "Evaporation or electroplating + reflow"
        under_bump_metallization: "Cr/Cu/Au or Ti/Ni/Au"
        
        # Reliability
        thermal_cycling: 500cycles            # Limited by solder fatigue
        creep_rate: 1e-6/s                    # At 125°C
        
        # Compatibility
        compatible_with: "Copper, Nickel, Gold"
        incompatible_with: "Aluminum (poor wetting)"
        
        # References
        standard: "IBM C4 Process"
        notes: "Legacy technology (1960s-2000s). Replaced by lead-free solders and copper pillars in modern designs"

material Micro_Bump:
    category: die_interconnect
    symbol: "µBump"
    description: "Micro-bump - ultra-fine-pitch 3D stacking (TSV interconnects)"
    
    properties:
        density: 8960kg/m³                    # Copper core
        thermal_conductivity: 300W/(m·K)      # Copper + solder composite
        resistivity: 3e-8Ω·m                 # Slightly higher due to solder
        max_current_density: 1e5A/cm²
        melting_point: 217°C                  # SAC305 solder
        bonding_temp: 250°C
        temp_coefficient: +3.5e-3/°C
        contact_resistance: 1e-8Ω·cm²
        color: "#D4A574"
        
        # Mechanical properties
        youngs_modulus: 50GPa                 # Composite
        yield_strength: 50MPa
        
        # Geometry (ultra-fine pitch!)
        typical_diameter: 10µm                # 10-20 µm
        typical_height: 15µm
        min_pitch: 20µm                       # 20-40 µm pitch
        aspect_ratio: 1.5
        
        # Manufacturing
        deposition_method: "Dual damascene Cu + SAC solder cap"
        barrier_layer: "TaN (5nm)"
        passivation: "Polyimide or BCB"
        
        # Applications
        primary_use: "TSV interconnects"
        secondary_use: "HBM stacks, 3D NAND"
        
        # Reliability
        thermal_cycling: 1000cycles
        electromigration_lifetime: 10years
        
        # Compatibility
        compatible_with: "Copper, TSV, Silicon"
        
        # References
        standard: "JEDEC JESD235, IEEE IEDM 2012"
        notes: "Enables 3D stacking for HBM, AI accelerators, and advanced packaging. Critical for chiplet architectures"

material Generic_Gold_Bump:
    category: die_interconnect
    symbol: "Au-Generic"
    description: "Generic gold bump for prototyping - conservative properties"
    
    properties:
        density: 19300kg/m³
        thermal_conductivity: 300W/(m·K)
        resistivity: 2.5e-8Ω·m
        max_current_density: 1e5A/cm²
        melting_point: 1064°C
        bonding_temp: 300°C
        contact_resistance: 1e-8Ω·cm²
        color: "#FFD700"
        
        # Geometry
        typical_diameter: 100µm
        typical_height: 50µm
        min_pitch: 150µm
        
        # References
        notes: "Generic material for use in default profiles"

## ============================================================================
## SECTION 4: PCB SOLDERS - Board-Level Assembly
## Application: Component-to-PCB connections, BGA, QFN, through-hole
## ============================================================================

material SAC305_Solder:
    category: pcb_solder
    symbol: "Sn96.5Ag3.0Cu0.5"
    description: "SAC305 lead-free solder - industry standard (RoHS compliant)"
    
    properties:
        density: 7370kg/m³
        thermal_conductivity: 60W/(m·K)
        resistivity: 11e-8Ω·m
        max_current_density: 3e4A/cm²
        melting_point: 217°C                  # Liquidus temperature
        solidus_temp: 217°C                   # Eutectic-like
        reflow_temp: 245°C                    # Peak reflow temperature
        temp_coefficient: +4.2e-3/°C
        contact_resistance: 5e-7Ω·cm²
        color: "#E8E8E8"
        
        # Mechanical properties
        youngs_modulus: 50GPa
        yield_strength: 35MPa
        shear_strength: 28MPa
        tensile_strength: 40MPa
        elongation: 35%                       # Ductility
        
        # Thermal properties
        thermal_expansion: 2.1e-5/°C
        specific_heat: 220J/(kg·K)
        
        # Wetting properties
        wetting_angle: 30deg                  # On copper
        surface_tension: 0.5N/m
        
        # Reliability
        thermal_cycling: 1500cycles           # -40°C to 125°C
        drop_test: 30drops                    # JEDEC JESD22-B111
        vibration_resistance: 20G
        
        # Manufacturing
        flux_type: "No-clean or water-soluble"
        reflow_profile: "Ramp-soak-spike"
        peak_temp: 245°C
        time_above_liquidus: 60s
        
        # Composition
        tin_percent: 96.5%
        silver_percent: 3.0%
        copper_percent: 0.5%
        
        # Compatibility
        compatible_with: "Copper, Nickel, Gold, ENIG, HASL"
        incompatible_with: "Aluminum (poor wetting)"
        
        # Standards
        standard: "IPC J-STD-006, JEDEC JESD22-B106"
        rohs_compliant: true
        notes: "Most common lead-free solder. Excellent balance of cost, reliability, and manufacturability"

material SAC405_Solder:
    category: pcb_solder
    symbol: "Sn95.5Ag4.0Cu0.5"
    description: "SAC405 lead-free solder - higher silver content for improved reliability"
    
    properties:
        density: 7400kg/m³
        thermal_conductivity: 65W/(m·K)       # Slightly better than SAC305
        resistivity: 10e-8Ω·m
        max_current_density: 3.5e4A/cm²
        melting_point: 217°C
        solidus_temp: 217°C
        reflow_temp: 245°C
        temp_coefficient: +4.0e-3/°C
        contact_resistance: 4e-7Ω·cm²
        color: "#F0F0F0"
        
        # Mechanical properties (better than SAC305)
        youngs_modulus: 55GPa
        yield_strength: 40MPa
        shear_strength: 32MPa
        tensile_strength: 45MPa
        elongation: 40%
        
        # Reliability (improved)
        thermal_cycling: 2000cycles
        drop_test: 40drops
        
        # Composition
        tin_percent: 95.5%
        silver_percent: 4.0%
        copper_percent: 0.5%
        
        # Compatibility
        compatible_with: "Copper, Nickel, Gold, ENIG, HASL"
        
        # Standards
        standard: "IPC J-STD-006"
        rohs_compliant: true
        notes: "Higher reliability than SAC305 but more expensive. Used in automotive and aerospace"

material SnPb_Eutectic:
    category: pcb_solder
    symbol: "Sn63Pb37"
    description: "Tin-lead eutectic solder - legacy standard (non-RoHS)"
    
    properties:
        density: 8400kg/m³
        thermal_conductivity: 50W/(m·K)
        resistivity: 15e-8Ω·m
        max_current_density: 2.5e4A/cm²
        melting_point: 183°C                  # True eutectic
        solidus_temp: 183°C
        reflow_temp: 210°C                    # Lower than lead-free
        temp_coefficient: +4.5e-3/°C
        contact_resistance: 3e-7Ω·cm²
        color: "#B0B0B0"
        
        # Mechanical properties
        youngs_modulus: 30GPa
        yield_strength: 25MPa
        shear_strength: 20MPa
        tensile_strength: 35MPa
        elongation: 50%                       # Very ductile
        
        # Wetting properties (excellent)
        wetting_angle: 20deg                  # Better than lead-free
        surface_tension: 0.45N/m
        
        # Reliability
        thermal_cycling: 1000cycles
        
        # Composition
        tin_percent: 63%
        lead_percent: 37%
        
        # Compatibility
        compatible_with: "Copper, Nickel, Gold, Silver"
        
        # Standards
        standard: "IPC J-STD-006 (legacy)"
        rohs_compliant: false
        notes: "Legacy solder. Banned in consumer electronics (RoHS). Still used in aerospace/military (exemptions)"

material Low_Temp_Solder_BiSn:
    category: pcb_solder
    symbol: "Bi58Sn42"
    description: "Bismuth-tin low-temperature solder - for heat-sensitive components"
    
    properties:
        density: 8650kg/m³
        thermal_conductivity: 18W/(m·K)       # Lower than SAC
        resistivity: 35e-8Ω·m                # Higher resistivity
        max_current_density: 1e4A/cm²
        melting_point: 138°C                  # Very low melting point!
        solidus_temp: 138°C
        reflow_temp: 165°C                    # Low reflow temp
        temp_coefficient: +4.8e-3/°C
        contact_resistance: 1e-6Ω·cm²
        color: "#A0A0A0"
        
        # Mechanical properties (brittle)
        youngs_modulus: 40GPa
        yield_strength: 20MPa
        shear_strength: 15MPa
        brittleness: "High"                   # Bismuth is brittle
        
        # Reliability (limited)
        thermal_cycling: 500cycles            # Limited by brittleness
        max_operating_temp: 100°C             # Below melting point
        
        # Composition
        bismuth_percent: 58%
        tin_percent: 42%
        
        # Applications
        primary_use: "Heat-sensitive components"
        secondary_use: "Step soldering (multi-temp assembly)"
        
        # Compatibility
        compatible_with: "Copper, Nickel"
        incompatible_with: "Gold (embrittlement)"
        
        # Standards
        standard: "IPC J-STD-006"
        rohs_compliant: true
        notes: "Used for components that cannot withstand 245°C reflow (displays, sensors, plastics)"

material Generic_Solder:
    category: pcb_solder
    symbol: "Solder"
    description: "Generic solder for prototyping - SAC305-like properties"
    
    properties:
        density: 7400kg/m³
        thermal_conductivity: 60W/(m·K)
        resistivity: 11e-8Ω·m
        max_current_density: 3e4A/cm²
        melting_point: 217°C
        reflow_temp: 245°C
        contact_resistance: 5e-7Ω·cm²
        color: "#E8E8E8"
        
        # Mechanical properties
        youngs_modulus: 50GPa
        yield_strength: 35MPa
        
        # Compatibility
        compatible_with: "Copper, Nickel, Gold"
        
        # Standards
        rohs_compliant: true
        notes: "Generic material for use in default profiles"

## ============================================================================
## SECTION 5: BARRIER LAYERS - Diffusion Prevention
## Application: Copper diffusion barriers, via liners, adhesion layers
## ============================================================================

material Titanium_Nitride:
    category: barrier_layer
    symbol: "TiN"
    description: "Titanium nitride - copper diffusion barrier and via liner"
    
    properties:
        density: 5220kg/m³
        thermal_conductivity: 19W/(m·K)
        resistivity: 25e-8Ω·m                # Conductive barrier
        max_current_density: 1e6A/cm²
        melting_point: 2930°C
        deposition_temp: 400°C                # PVD or CVD
        work_function: 4.6eV
        temp_coefficient: +1.0e-3/°C
        color: "#D4AF37"                      # Gold-like color
        
        # Mechanical properties
        youngs_modulus: 600GPa                # Very hard
        hardness: 2000HV                      # Vickers hardness
        
        # Barrier properties
        barrier_thickness: 10nm               # Typical for copper
        diffusion_coefficient: 1e-18cm²/s     # At 400°C
        barrier_lifetime: 10years             # At 125°C
        
        # Manufacturing
        deposition_method: "PVD (sputtering) or CVD"
        typical_thickness: 10nm
        min_thickness: 5nm
        max_thickness: 50nm
        
        # Compatibility
        compatible_with: "Copper, Tungsten, Silicon, SiO₂"
        barrier_for: "Copper diffusion into silicon"
        
        # Standards
        standard: "ITRS Roadmap"
        notes: "Industry standard copper barrier for 180nm-45nm nodes. Replaced by TaN at advanced nodes"

material Tantalum_Nitride:
    category: barrier_layer
    symbol: "TaN"
    description: "Tantalum nitride - advanced copper barrier for sub-45nm nodes"
    
    properties:
        density: 13900kg/m³
        thermal_conductivity: 22W/(m·K)
        resistivity: 200e-8Ω·m               # Higher than TiN
        max_current_density: 5e5A/cm²
        melting_point: 3090°C
        deposition_temp: 350°C
        work_function: 4.7eV
        temp_coefficient: +0.8e-3/°C
        color: "#8B7355"                      # Brown-gold color
        
        # Mechanical properties
        youngs_modulus: 550GPa
        hardness: 1800HV
        
        # Barrier properties (superior to TiN)
        barrier_thickness: 5nm                # Thinner than TiN
        diffusion_coefficient: 1e-20cm²/s     # Better barrier
        barrier_lifetime: 15years
        
        # Manufacturing
        deposition_method: "ALD or PVD"
        typical_thickness: 5nm
        min_thickness: 2nm                    # ALD enables ultra-thin
        max_thickness: 20nm
        
        # Compatibility
        compatible_with: "Copper, Tungsten, Silicon, Low-k dielectrics"
        barrier_for: "Copper diffusion (advanced nodes)"
        
        # Standards
        standard: "ITRS Roadmap, IEEE IITC"
        notes: "Industry standard for 22nm and below. ALD enables conformal coating in high-aspect-ratio vias"

material Tungsten_Barrier:
    category: barrier_layer
    symbol: "W"
    description: "Tungsten - via liner and local interconnect"
    
    properties:
        density: 19250kg/m³
        thermal_conductivity: 173W/(m·K)
        resistivity: 5.6e-8Ω·m
        max_current_density: 5e6A/cm²
        melting_point: 3422°C
        deposition_temp: 400°C                # CVD
        work_function: 4.55eV
        temp_coefficient: +4.5e-3/°C
        color: "#3C3C3C"
        
        # Mechanical properties
        youngs_modulus: 411GPa
        hardness: 3500HV                      # Very hard
        
        # Manufacturing
        deposition_method: "CVD (WF₆ or W(CO)₆)"
        typical_thickness: 50nm               # Via liner
        min_thickness: 20nm
        max_thickness: 500nm                  # Local interconnect
        
        # Applications
        primary_use: "Via fill and liner"
        secondary_use: "Local interconnect (M0 layer)"
        
        # Compatibility
        compatible_with: "Silicon, Copper, Aluminum, TiN, TaN"
        
        # Standards
        standard: "ITRS Roadmap"
        notes: "Standard via fill material for sub-100nm nodes. Also used as M0 local interconnect"

material Generic_Barrier:
    category: barrier_layer
    symbol: "Barrier"
    description: "Generic barrier layer for prototyping"
    
    properties:
        density: 10000kg/m³
        thermal_conductivity: 20W/(m·K)
        resistivity: 50e-8Ω·m
        max_current_density: 1e6A/cm²
        melting_point: 2500°C
        deposition_temp: 400°C
        color: "#8B7355"
        
        # Manufacturing
        typical_thickness: 10nm
        min_thickness: 5nm
        max_thickness: 50nm
        
        # References
        notes: "Generic barrier material for use in default profiles"

## ============================================================================
## SECTION 6: ADHESION LAYERS - Mechanical Bonding
## Application: PCB assembly, display bonding, die attach
## ============================================================================

material Conductive_Epoxy:
    category: adhesive
    symbol: "Ag-Epoxy"
    description: "Silver-filled conductive epoxy - PCB assembly and die attach"
    
    properties:
        density: 3000kg/m³                    # Composite material
        thermal_conductivity: 3W/(m·K)        # Lower than metals
        resistivity: 1e-4Ω·m                 # Much higher than solder
        max_current_density: 1e3A/cm²         # Limited current capability
        curing_temp: 150°C                    # Thermal cure
        max_operating_temp: 150°C
        temp_coefficient: +5e-3/°C
        contact_resistance: 1e-5Ω·cm²
        color: "#C0C0C0"
        
        # Mechanical properties
        youngs_modulus: 5GPa                  # Flexible
        shear_strength: 10MPa
        tensile_strength: 15MPa
        elongation: 5%
        
        # Thermal properties
        thermal_expansion: 5e-5/°C            # Higher than metals
        glass_transition_temp: 120°C
        
        # Manufacturing
        application_method: "Dispensing or screen printing"
        cure_time: 30min                      # At 150°C
        pot_life: 8hours                      # Working time
        
        # Advantages
        advantages: "No reflow, low temperature, reworkable"
        
        # Disadvantages
        disadvantages: "High resistance, limited current, outgassing"
        
        # Compatibility
        compatible_with: "Copper, Nickel, Gold, FR4, Polyimide"
        
        # Standards
        standard: "IPC-SM-840"
        notes: "Used for heat-sensitive components, EMI shielding, and die attach. Not suitable for high-current applications"

material Anisotropic_Conductive_Film:
    category: adhesive
    symbol: "ACF"
    description: "Anisotropic conductive film - display and flex cable bonding"
    
    properties:
        density: 1500kg/m³                    # Polymer + particles
        thermal_conductivity: 0.5W/(m·K)      # Insulating in X-Y plane
        resistivity_z: 1e-3Ω·m               # Conductive in Z direction
        resistivity_xy: 1e12Ω·m              # Insulating in X-Y plane
        max_current_density: 1e2A/cm²
        bonding_temp: 180°C                   # Thermocompression
        bonding_pressure: 2MPa
        max_operating_temp: 85°C
        contact_resistance: 1e-4Ω·cm²
        color: "#FFFFE0"                      # Light yellow
        
        # Mechanical properties
        youngs_modulus: 2GPa
        shear_strength: 5MPa
        peel_strength: 0.5N/mm
        
        # Particle properties
        particle_size: 5µm                    # Conductive particles
        particle_material: "Nickel or Gold"
        particle_density: 10000particles/mm²
        
        # Manufacturing
        application_method: "Roll lamination"
        bonding_time: 10s
        typical_thickness: 25µm
        
        # Applications
        primary_use: "LCD/OLED display bonding"
        secondary_use: "Flex cable to PCB"
        
        # Advantages
        advantages: "Fine pitch, no shorts, reworkable"
        
        # Compatibility
        compatible_with: "ITO, Copper, Gold, Polyimide"
        
        # Standards
        standard: "IPC-7095"
        notes: "Standard for display bonding. Enables <50µm pitch connections without shorts"

material Silver_Epoxy_High_Conductivity:
    category: adhesive
    symbol: "Ag-Epoxy-HC"
    description: "High-conductivity silver epoxy - premium die attach"
    
    properties:
        density: 4000kg/m³                    # High silver loading
        thermal_conductivity: 10W/(m·K)       # Better than standard epoxy
        resistivity: 1e-5Ω·m                 # 10x better than standard
        max_current_density: 1e4A/cm²
        curing_temp: 150°C
        max_operating_temp: 200°C             # High-temp rated
        temp_coefficient: +3e-3/°C
        contact_resistance: 1e-6Ω·cm²
        color: "#D3D3D3"
        
        # Mechanical properties
        youngs_modulus: 8GPa
        shear_strength: 15MPa
        tensile_strength: 20MPa
        
        # Thermal properties
        thermal_expansion: 3e-5/°C
        glass_transition_temp: 180°C
        
        # Manufacturing
        silver_content: 80%                   # Weight percent
        cure_time: 60min
        
        # Applications
        primary_use: "High-power die attach"
        secondary_use: "RF shielding"
        
        # Compatibility
        compatible_with: "Copper, Nickel, Gold, Aluminum"
        
        # Standards
        notes: "Premium epoxy for high-power and high-frequency applications. 10x more expensive than standard epoxy"

material Generic_Conductive_Adhesive:
    category: adhesive
    symbol: "Adhesive"
    description: "Generic conductive adhesive for prototyping"
    
    properties:
        density: 3000kg/m³
        thermal_conductivity: 3W/(m·K)
        resistivity: 1e-4Ω·m
        max_current_density: 1e3A/cm²
        curing_temp: 150°C
        max_operating_temp: 150°C
        contact_resistance: 1e-5Ω·cm²
        color: "#C0C0C0"
        
        # Mechanical properties
        shear_strength: 10MPa
        
        # References
        notes: "Generic adhesive material for use in default profiles"

## ============================================================================
## END OF BRIDGE MATERIALS LIBRARY
