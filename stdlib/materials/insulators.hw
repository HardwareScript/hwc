## ============================================================================
## SECTION 6: GASES AND VACUUM
## Testing: Extreme low values, scientific notation edge cases, special values
## ============================================================================

material Air:
    category: insulator
    symbol: "Air"
    description: "Standard atmospheric air at sea level (1 atm, 20°C)"
    
    properties:
        ## Ultra-low density
        density: 1.204kg/m³
        thermal_conductivity: 0.026W/(m·K)
        specific_heat: 1005J/(kg·K)
        
        ## Dielectric properties (nearly unity)
        dielectric_constant: 1.00059
        dielectric_constant_1mhz: 1.00059
        dielectric_constant_10ghz: 1.00054
        loss_tangent_1mhz: 0.0
        loss_tangent_10ghz: 0.0
        
        ## Breakdown voltage (depends on gap)
        dielectric_strength: 3000V/mm
        
        ## Electrical resistivity (very high)
        volume_resistivity: 1.3e16Ω·m
        
        ## Temperature properties
        thermal_expansion: 3.43e-3/°C
        max_operating_temp: 1000°C
        min_operating_temp: -273.15°C
        
        ## Composition (by volume)
        nitrogen_percent: 78.08%
        oxygen_percent: 20.95%
        argon_percent: 0.93%
        co2_ppm: 415
        
        ## Viscosity
        dynamic_viscosity: 1.81e-5Pa·s
        kinematic_viscosity: 1.5e-5m²/s
        
        color: "#E3F2FD"
        transparency: 1.0

material Vacuum:
    category: insulator
    symbol: "Vac"
    description: "Perfect vacuum - theoretical ideal for space applications 🚀"
    
    properties:
        ## Zero/minimal values
        density: 0.0kg/m³
        thermal_conductivity: 0.0W/(m·K)
        
        ## Perfect dielectric
        dielectric_constant: 1.0
        dielectric_constant_dc: 1.0
        dielectric_constant_1ghz: 1.0
        dielectric_constant_10ghz: 1.0
        dielectric_constant_100ghz: 1.0
        loss_tangent_dc: 0.0
        loss_tangent_1ghz: 0.0
        loss_tangent_10ghz: 0.0
        
        ## Infinite resistivity
        volume_resistivity: 1e100Ω·m
        
        ## Breakdown (cosmic ray limit)
        dielectric_strength: 1e10V/mm
        
        ## Temperature (space environment)
        max_temp_sunlight: 121°C
        min_temp_shadow: -157°C
        
        ## Physical constants in vacuum
        speed_of_light: 299792458m/s
        permittivity: 8.854187817e-12F/m
        permeability: 1.25663706212e-6H/m
        impedance: 376.730313668Ω
        
        color: "#000000"
        transparency: 1.0


