material Extreme_Test_Material:
    category: insulator
    symbol: "XTM"
    description: "Synthetic test material with extreme values to stress test compiler"
    
    properties:
        ## Extreme scientific notation
        density_min: 1.0e-10kg/m³
        density_max: 1.0e10kg/m³
        
        ## Extreme precision
        dielectric_constant: 1.23456789012345
        loss_tangent: 9.87654321098765e-15
        
        ## Required properties for compiler
        dielectric_strength: 1.0e6V/mm
        thermal_conductivity: 1.0W/(m·K)
        density: 1000kg/m³
        
        ## Extreme temperature range
        temp_absolute_zero: -273.15°C
        temp_sun_surface: 5778°C
        temp_sun_core: 15000000°C
        
        ## Extreme voltages
        breakdown_min: 1.0e-6V/mm
        breakdown_max: 1.0e12V/mm
        
        ## Extreme resistivity
        resistivity_min: 1.0e-20Ω·m
        resistivity_max: 1.0e100Ω·m
        
        ## Boundary values
        zero_value: 0.0
        unity_value: 1.0
        negative_value: -1.0
        
        ## Fractional percentages
        tolerance_tight: 0.001%
        tolerance_loose: 100%
        
        ## Mixed positive/negative
        positive_coeff: +1.5e-3/°C
        negative_coeff: -2.7e-4/°C
        
        color: "#FF00FF"
        transparency: 0.5

