##[ INSULATORS MATERIAL LIBRARY - COMPREHENSIVE STRESS TEST ]##

#[
This file is a BRUTAL stress test for the Hardware Script compiler.
It tests EVERY feature found in:
- Docs/v0.1.5/LANGUAGE-SPEC.md
- Docs/v0.1.4/LANGUAGE-SPEC.md
- ROADMAP/v0.1.5/COMPILER-GAPS-FOUND.md
- hwc/crates/hwc-parser/src/lexer/token.rs
- hwc/crates/hwc-parser/src/parser/definitions/component.rs

DOMAIN: Insulators (dielectrics, substrates, air, vacuum)
GOAL: Expose compiler gaps, not just validate working syntax
]#

## ============================================================================
## SECTION 1: STANDARD PCB SUBSTRATES
## Testing: Basic syntax, standard units, complex SI units
## ============================================================================

material FR4:
    category: insulator
    symbol: "FR4"
    description: "Standard PCB substrate - fiberglass-reinforced epoxy laminate"
    
    properties:
        ## Physical Properties
        density: 1850kg/m³
        thermal_conductivity: 0.3W/(m·K)
        thermal_expansion_xy: 14e-6/°C
        thermal_expansion_z: 70e-6/°C
        
        ## Electrical Properties (frequency-dependent)
        dielectric_constant: 4.5
        dielectric_constant_1mhz: 4.5
        dielectric_constant_1ghz: 4.3
        dielectric_constant_10ghz: 4.2
        loss_tangent_1mhz: 0.02
        loss_tangent_1ghz: 0.025
        loss_tangent_10ghz: 0.03
        dielectric_strength: 20000V/mm
        volume_resistivity: 1e14Ω·m
        surface_resistivity: 1e12Ω
        
        ## Mechanical Properties
        flexural_strength: 415000000Pa
        tensile_strength: 310000000Pa
        youngs_modulus: 22000000000Pa
        
        ## Thermal Properties
        glass_transition_temp: 135°C
        decomposition_temp: 300°C
        max_operating_temp: 130°C
        min_operating_temp: -40°C
        
        ## Moisture Properties
        water_absorption: 0.1%
        
        ## Color & Rendering
        color: "#2E7D32"
        transparency: 0.0

material FR4_High_Tg:
    category: insulator
    symbol: "FR4-HTg"
    description: "High glass transition temperature FR4 for demanding applications"
    
    properties:
        density: 1900kg/m³
        thermal_conductivity: 0.35W/(m·K)
        thermal_expansion_xy: 12e-6/°C
        thermal_expansion_z: 60e-6/°C
        dielectric_constant: 4.4
        dielectric_constant_1ghz: 4.4
        loss_tangent_1ghz: 0.015
        dielectric_strength: 25000V/mm
        glass_transition_temp: 180°C
        max_operating_temp: 170°C
        min_operating_temp: -55°C
        color: "#1B5E20"
        transparency: 0.0

## ============================================================================
## SECTION 2: HIGH-FREQUENCY RF SUBSTRATES
## Testing: Scientific notation, extreme precision, negative values
## ============================================================================

material Rogers_RO4003C:
    category: insulator
    symbol: "RO4003C"
    description: "Low-loss RF substrate for high-frequency applications (DC to 10GHz+)"
    
    properties:
        ## Extreme precision testing
        density: 1.79e3kg/m³
        thermal_conductivity: 6.4e-1W/(m·K)
        thermal_expansion_xy: +1.7e-5/°C
        thermal_expansion_z: +4.6e-5/°C
        
        ## Ultra-precise dielectric properties
        dielectric_constant: 3.38
        dielectric_constant_10ghz: 3.38
        dielectric_constant_77ghz: 3.34
        loss_tangent_10ghz: 2.7e-3
        loss_tangent_77ghz: 3.1e-3
        
        ## Negative temperature coefficient
        temp_coefficient_dielectric: -4.0e-5/°C
        
        ## Extreme values
        dielectric_strength: 3.543e4V/mm
        volume_resistivity: 1.7e10Ω·m
        
        ## Temperature range
        glass_transition_temp: +2.8e2°C
        max_operating_temp: +2.5e2°C
        min_operating_temp: -5.5e1°C
        
        color: "#FFEB3B"
        transparency: 0.1

