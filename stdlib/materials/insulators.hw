material Diamond:
    category: insulator
    symbol: "C"
    description: "Synthetic diamond substrate - extreme thermal conductivity 💎"
    
    properties:
        ## Extreme values
        density: 3515kg/m³
        thermal_conductivity: 2200W/(m·K)
        specific_heat: 509J/(kg·K)
        thermal_diffusivity: 1.2e-3m²/s
        
        ## Dielectric properties
        dielectric_constant: 5.7
        dielectric_constant_1mhz: 5.7
        dielectric_constant_10ghz: 5.68
        loss_tangent_1mhz: 0.00001
        loss_tangent_10ghz: 0.00003
        
        ## Extreme breakdown voltage
        dielectric_strength: 1e7V/mm
        volume_resistivity: 1e16Ω·m
        
        ## Temperature properties
        thermal_expansion: 1.0e-6/°C
        max_operating_temp: 1500°C
        min_operating_temp: -273.15°C
        
        ## Mechanical properties (hardest material)
        hardness_vickers: 10000
        youngs_modulus: 1.22e12Pa
        bulk_modulus: 4.42e11Pa
        shear_modulus: 5.35e11Pa
        
        ## Optical properties
        refractive_index: 2.417
        
        color: "#B9F6CA"
        transparency: 1.0

