## ============================================================================
## SECTION 3: FLEXIBLE SUBSTRATES
## Testing: Unicode in strings, emoji, complex units, keywords as properties
## ============================================================================

material Polyimide_Kapton:
    category: insulator
    symbol: "PI"
    description: "Flexible polyimide film - DuPont™ Kapton® for flex PCBs 🔥"
    
    properties:
        ## Unicode stress test in metadata
        manufacturer: "DuPont™ 杜邦公司 デュポン社"
        notes: "Greek: αβγδε, Math: ∑∫∂∇, Emoji: 🔥⚡📡, RTL: العربية עברית"
        special_chars: "All punctuation: !@#$%^&*()_+-=[]{}|\\;':\",./<>?`~"
        
        ## Physical properties
        density: 1420kg/m³
        thermal_conductivity: 0.12W/(m·K)
        thermal_expansion_xy: 20e-6/°C
        thermal_expansion_z: 20e-6/°C
        
        ## Electrical properties
        dielectric_constant: 3.5
        dielectric_constant_1mhz: 3.5
        dielectric_constant_1ghz: 3.4
        loss_tangent_1mhz: 0.002
        loss_tangent_1ghz: 0.003
        dielectric_strength: 303000V/mm
        volume_resistivity: 1.5e17Ω·m
        
        ## Extreme temperature range
        glass_transition_temp: 360°C
        max_operating_temp: 400°C
        min_operating_temp: -269°C
        melting_point: 0°C
        
        ## Mechanical properties
        tensile_strength: 231000000Pa
        youngs_modulus: 2500000000Pa
        elongation_at_break: 72%
        
        ## Keywords as property names (soft keyword test)
        tolerance: "±5%"
        trace: "Compatible"
        via: "Laser drilled"
        clearance: "Standard"
        category: "Flexible"
        material: "Polyimide"
        profile: "Flex"
        
        color: "#FF6F00"
        transparency: 0.3

