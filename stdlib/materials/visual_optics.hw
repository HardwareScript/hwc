## Hardware Script Standard Library - Visual Optics (Artist Mode)
## Version: v0.1.7 (High-Fidelity Rendering)
## Purpose: Documentation and definitions for advanced PBR optical properties.
## Features: IOR, Clearcoat, Subsurface Scattering, Anisotropy.

#[
ADVANCED RENDERING API (v0.1.7):
- ior: Index of Refraction (>= 1.0). Controls light bending through transparent volumes.
- clearcoat: Glossy protective layer strength (0.0 - 1.0).
- clearcoat_roughness: Roughness of the clearcoat layer (0.0 - 1.0).
- subsurface: Subsurface scattering strength (0.0 - 1.0). Simulates light depth in dielectrics.
- anisotropy: Directional reflection strength (0.0 - 1.0). Simulates brushed/grain effects.
- anisotropy_rotation: Rotation of the anisotropic grain in radians (0.0 - 2PI).
]#

## ============================================================================
## SECTION 1: PROFESSIONAL SOLDER MASKS (Clearcoat & Depth)
## ============================================================================

material SolderMask_PianoBlack:
    category: insulator
    description: "Ultra-glossy 'Piano Black' finish for premium consumer electronics"
    properties:
        color: "#0A0A0A"
        opacity: 1.0
        roughness: 0.2
        metallic: 0.0
        # Advanced Optics
        clearcoat: 1.0              # Maximum gloss
        clearcoat_roughness: 0.02    # Mirror-like finish
        subsurface: 0.1             # Slight depth for solid black look

material SolderMask_MatteGreen:
    category: insulator
    description: "Standard industrial green solder mask with matte finish"
    properties:
        color: "#2E7D32"
        opacity: 0.95
        roughness: 0.7
        metallic: 0.0
        # Advanced Optics
        clearcoat: 0.1              # Very subtle protective sheen
        subsurface: 0.3             # Simulates light entering the resin

material SolderMask_GlossyBlue:
    category: insulator
    description: "High-gloss blue solder mask with refractive depth"
    properties:
        color: "#0D47A1"
        opacity: 0.9
        roughness: 0.4
        metallic: 0.0
        # Advanced Optics
        ior: 1.45                   # Standard epoxy refraction
        clearcoat: 0.8
        clearcoat_roughness: 0.05
        subsurface: 0.2

## ============================================================================
## SECTION 2: PHYSICAL SUBSTRATES (IOR & Subsurface Scattering)
## ============================================================================

material FR4_Visual:
    category: insulator
    description: "Visually accurate FR4 with internal light scattering"
    properties:
        color: "#2D5A27"
        opacity: 1.0
        roughness: 0.8
        # Advanced Optics
        ior: 1.54                   # Glass-reinforced epoxy IOR
        subsurface: 0.4             # 'Milky' scattering of the fiberglass weave
        anisotropy: 0.5             # Simulates grain direction of the weave
        anisotropy_rotation: 0.78    # 45-degree cross-hatch

material Sapphire_Glass:
    category: insulator
    description: "Pure sapphire glass for optical sensors or display windows"
    properties:
        color: "#E3F2FD"
        opacity: 0.1                # High transmission
        roughness: 0.01
        metallic: 0.0
        # Advanced Optics
        ior: 1.76                   # Accurate Sapphire IOR
        clearcoat: 1.0              # Polished surface

## ============================================================================
## SECTION 3: PRECISION METALS (Anisotropy & Metallic PBR)
## ============================================================================

material Copper_Brushed:
    category: conductor
    description: "Brushed copper with mathematical grain simulation"
    properties:
        color: "#B87333"
        opacity: 1.0
        metallic: 0.95              # High metallic reflection
        roughness: 0.3
        # Advanced Optics
        anisotropy: 0.8             # Strong directional grain
        anisotropy_rotation: 1.57    # 90-degree brush marks

material Gold_Polished:
    category: conductor
    description: "Premium ENIG gold finish with high-fidelity reflections"
    properties:
        color: "#FFD700"
        opacity: 1.0
        metallic: 1.0
        roughness: 0.05
        # Advanced Optics
        clearcoat: 0.5              # Extra protective polish
