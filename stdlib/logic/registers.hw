##[
Register Standard Library - Maximum Complexity Stress Test
===========================================================

This file implements flip-flops, registers, register files, and state machines
with extreme complexity to expose any remaining compiler weaknesses:

1. D flip-flops with async reset, sync reset, and enable
2. Multi-bit registers with complex next-state logic
3. Register files with read/write ports and forwarding
4. State machines with nested match expressions
5. Conditional register updates based on enable signals
6. Register chains with data forwarding
7. Shift registers with parallel load
8. Circular buffers with head/tail pointers
9. FIFO queues with full/empty flags
10. Register banks with address decoding

This is the ultimate test for Reg() synthesis and state management.
]##

## Register control modes
enum RegMode:
    Hold = 0x0        ## Keep current value
    Load = 0x1        ## Load new value
    Increment = 0x2   ## Add 1
    Decrement = 0x3   ## Subtract 1

## Reset types
enum ResetType:
    AsyncActive = 0x0
    SyncActive = 0x1
    AsyncInactive = 0x2
    SyncInactive = 0x3

## Register file operation
enum RegFileOp:
    Read = 0x0
    Write = 0x1
    ReadWrite = 0x2
    NoOp = 0x3

## FIFO status
struct FifoStatus:
    full[1]
    empty[1]
    count[3]
    overflow[1]
    underflow[1]
    unused[1]

## ============================================================================
## DFlipFlop - Basic D flip-flop with async reset
## ============================================================================
module DFlipFlop:
    pins:
        D[1],
        Clock[1],
        Reset[1],
        Q[1]
    
    logic:
        ## Test 1: Simple register with Reg() primitive
        let mut state[1] = Reg(clock: Clock, reset: Reset, init: 0)
        
        ## Next state logic
        state.next = if Reset:
            0
        else:
            D
        
        Q = state

## ============================================================================
## DFlipFlopWithEnable - D flip-flop with enable signal
## ============================================================================
module DFlipFlopWithEnable:
    pins:
        D[1],
        Clock[1],
        Reset[1],
        Enable[1],
        Q[1]
    
    logic:
        ## Test 2: Register with conditional update
        let mut state[1] = Reg(clock: Clock, reset: Reset, init: 0)
        
        state.next = if Reset:
            0
        else:
            if Enable:
                D
            else:
                state

        Q = state

## ============================================================================
## Register8 - 8-bit register with mode control
## ============================================================================
module Register8:
    pins:
        Data[8],
        Clock[1],
        Reset[1],
        Enable[1],
        Mode[2],
        Out[8]
    
    logic:
        ## Test 3: Register with complex next-state logic
        let mut reg[8] = Reg(clock: Clock, reset: Reset, init: 0)
        
        reg.next = if Reset:
            0
        else:
            if Enable:
                match Mode:
                    0x0: reg
                    0x1: Data
                    0x2: if reg == 0xFF:
                        ## Wrap around
                        0
                    else:
                        (reg + 1) & 0xFF
                    else: if reg == 0:
                        ## Wrap around
                        0xFF
                    else:
                        (reg - 1) & 0xFF
            else:
                reg
        
        Out = reg

## ============================================================================
## ShiftRegister8 - 8-bit shift register with parallel load
## ============================================================================
module ShiftRegister8:
    pins:
        SerialIn[1],
        ParallelIn[8],
        Clock[1],
        Reset[1],
        Load[1],
        ShiftEnable[1],
        ParallelOut[8],
        SerialOut[1]
    
    logic:
        ## Test 4: Shift register with load/shift modes
        let mut shift_reg[8] = Reg(clock: Clock, reset: Reset, init: 0)
        
        shift_reg.next = if Reset:
            0
        else:
            if Load:
                ## Parallel load
                ParallelIn
            else:
                if ShiftEnable:
                    ## Shift left, insert serial input at LSB
                    if shift_reg[7]:
                        ## MSB is set - check for special patterns
                        match shift_reg[6..4]:
                            0x0: [shift_reg[6..0], SerialIn]
                            0x1: [shift_reg[6..0], SerialIn]
                            0x2: [shift_reg[6..0], SerialIn]
                            0x3: [shift_reg[6..0], SerialIn]
                            0x4: [shift_reg[6..0], SerialIn]
                            0x5: [shift_reg[6..0], SerialIn]
                            0x6: [shift_reg[6..0], SerialIn]
                            else: [shift_reg[6..0], SerialIn]
                    else:
                        [shift_reg[6..0], SerialIn]
                else:
                    shift_reg
        
        ParallelOut = shift_reg
        SerialOut = shift_reg[7]

## ============================================================================
## RegisterFile4x8 - 4-register file with 8-bit registers
## ============================================================================
module RegisterFile4x8:
    pins:
        WriteData[8],
        WriteAddr[2],
        ReadAddr1[2],
        ReadAddr2[2],
        Clock[1],
        Reset[1],
        WriteEnable[1],
        ReadData1[8],
        ReadData2[8]
    
    logic:
        ## Test 5: Register file with address decoding
        let mut reg0[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut reg1[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut reg2[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut reg3[8] = Reg(clock: Clock, reset: Reset, init: 0)
        
        ## Write logic with address decoding
        reg0.next = if Reset:
            0
        else:
            if WriteEnable & (WriteAddr == 0):
                WriteData
            else:
                reg0
        
        reg1.next = if Reset:
            0
        else:
            if WriteEnable & (WriteAddr == 1):
                if WriteData[7]:
                    ## MSB set - special handling
                    match WriteData[6..4]:
                        0x0: WriteData
                        0x1: WriteData
                        0x2: WriteData
                        0x3: WriteData
                        0x4: WriteData
                        0x5: WriteData
                        0x6: WriteData
                        else: WriteData
                else:
                    WriteData
            else:
                reg1
        
        reg2.next = if Reset:
            0
        else:
            if WriteEnable & (WriteAddr == 2):
                WriteData
            else:
                reg2
        
        reg3.next = if Reset:
            0
        else:
            if WriteEnable & (WriteAddr == 3):
                if WriteData == 0xFF:
                    ## Special case: all ones
                    WriteData
                else:
                    WriteData
            else:
                reg3
        
        ## Read port 1 with forwarding
        ReadData1 = if WriteEnable & (WriteAddr == ReadAddr1):
            ## Forward write data if addresses match
            WriteData
        else:
            match ReadAddr1:
                0: reg0
                1: reg1
                2: reg2
                else: reg3
        
        ## Read port 2 with forwarding
        ReadData2 = if WriteEnable & (WriteAddr == ReadAddr2):
            ## Forward write data if addresses match
            WriteData
        else:
            match ReadAddr2:
                0: reg0
                1: if reg1[7..4] > 0x7:
                    reg1
                else:
                    reg1
                2: reg2
                else: reg3

## ============================================================================
## StateMachine4State - 4-state FSM with complex transitions
## ============================================================================
module StateMachine4State:
    pins:
        Input[4],
        Clock[1],
        Reset[1],
        Enable[1],
        State[2],
        Output[4]
    
    logic:
        ## Test 6: State machine with nested match expressions
        let mut current_state[2] = Reg(clock: Clock, reset: Reset, init: 0)
        
        ## Next state logic with complex conditions
        current_state.next = if Reset:
            0
        else:
            if Enable:
                match current_state:
                    0x0: if Input[3]:
                        ## Transition based on MSB
                        match Input[2..0]:
                            0x0: 0
                            0x1: 1
                            0x2: 2
                            0x3: 3
                            0x4: if Input[3..2] == 0x3:
                                1
                            else:
                                0
                            0x5: 2
                            0x6: 3
                            else: 0
                    else:
                        if Input[2..0] > 0x4:
                            1
                        else:
                            0
                    
                    0x1: match Input[3..2]:
                        0x0: 0
                        0x1: if Input[1..0] == 0x3:
                            2
                        else:
                            1
                        0x2: 2
                        else: if Input[0]:
                            3
                        else:
                            1
                    
                    0x2: if Input[3..2] == Input[1..0]:
                        ## Special transition condition
                        match Input[3..2]:
                            0x0: 0
                            0x1: 1
                            0x2: 2
                            else: 3
                    else:
                        if Input[3]:
                            3
                        else:
                            2
                    
                    else: match Input[2..0]:
                        0x0: 0
                        0x1: 1
                        0x2: 2
                        0x3: 3
                        0x4: if Input[3]:
                            0
                        else:
                            3
                        0x5: 1
                        0x6: 2
                        else: 3
            else:
                current_state
        
        State = current_state
        
        ## Output logic based on state
        Output = match current_state:
            0x0: if Input[3]:
                Input
            else:
                [(0 * 4)]
            0x1: match Input[3..2]:
                0x0: Input
                0x1: Input xor 0xF
                0x2: Input & 0xA
                else: Input | 0x5
            0x2: if Input[2..0] > 0x4:
                [Input[3..2], (Input[1..0] + 1)]
            else:
                Input
            else: match Input[1..0]:
                0x0: [(0 * 4)]
                0x1: [(1 * 4)]
                0x2: [Input[3..2], Input[1..0]]
                else: Input

## ============================================================================
## CircularBuffer4x8 - 4-entry circular buffer with head/tail pointers
## ============================================================================
module CircularBuffer4x8:
    pins:
        WriteData[8],
        Clock[1],
        Reset[1],
        WriteEnable[1],
        ReadEnable[1],
        ReadData[8],
        Full[1],
        Empty[1],
        Count[2]
    
    logic:
        ## Test 7: Circular buffer with pointer management
        let mut buffer0[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut buffer1[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut buffer2[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut buffer3[8] = Reg(clock: Clock, reset: Reset, init: 0)
        
        let mut write_ptr[2] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut read_ptr[2] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut count[2] = Reg(clock: Clock, reset: Reset, init: 0)
        
        ## Calculate full and empty flags
        let is_full = (count == 0x3)
        let is_empty = (count == 0x0)
        
        ## Write logic
        buffer0.next = if Reset:
            0
        else:
            if WriteEnable & (write_ptr == 0) & (is_full == 0):
                WriteData
            else:
                buffer0
        
        buffer1.next = if Reset:
            0
        else:
            if WriteEnable & (write_ptr == 1) & (is_full == 0):
                if WriteData[7..4] == 0xF:
                    WriteData
                else:
                    WriteData
            else:
                buffer1
        
        buffer2.next = if Reset:
            0
        else:
            if WriteEnable & (write_ptr == 2) & (is_full == 0):
                WriteData
            else:
                buffer2
        
        buffer3.next = if Reset:
            0
        else:
            if WriteEnable & (write_ptr == 3) & (is_full == 0):
                WriteData
            else:
                buffer3
        
        ## Write pointer update
        write_ptr.next = if Reset:
            0
        else:
            if WriteEnable & (is_full == 0):
                match write_ptr:
                    0: 1
                    1: 2
                    2: 3
                    else: 0
            else:
                write_ptr
        
        ## Read pointer update
        read_ptr.next = if Reset:
            0
        else:
            if ReadEnable & (is_empty == 0):
                match read_ptr:
                    0: 1
                    1: 2
                    2: 3
                    else: 0
            else:
                read_ptr
        
        ## Count update
        count.next = if Reset:
            0
        else:
            if WriteEnable & ReadEnable:
                ## Both operations - count stays same
                if is_full | is_empty:
                    count
                else:
                    count
            else:
                if WriteEnable & (is_full == 0):
                    ## Write only - increment
                    if count == 0x3:
                        count
                    else:
                        (count + 1) & 0x3
                else:
                    if ReadEnable & (is_empty == 0):
                        ## Read only - decrement
                        if count == 0:
                            count
                        else:
                            (count - 1) & 0x3
                    else:
                        count
        
        ## Read data output
        ReadData = match read_ptr:
            0: buffer0
            1: buffer1
            2: buffer2
            else: buffer3
        
        Full = is_full
        Empty = is_empty
        Count = count

## ============================================================================
## CounterWithLoad - Loadable up/down counter with limits
## ============================================================================
module CounterWithLoad:
    pins:
        LoadValue[8],
        Clock[1],
        Reset[1],
        Load[1],
        Enable[1],
        UpDown[1],
        Limit[8],
        Count[8],
        AtLimit[1]
    
    logic:
        ## Test 8: Counter with complex control logic
        let mut counter[8] = Reg(clock: Clock, reset: Reset, init: 0)
        
        counter.next = if Reset:
            0
        else:
            if Load:
                ## Parallel load
                if LoadValue > Limit:
                    ## Clamp to limit
                    Limit
                else:
                    LoadValue
            else:
                if Enable:
                    if UpDown:
                        ## Count up
                        if counter == Limit:
                            ## At limit - wrap or hold
                            if Limit == 0xFF:
                                0
                            else:
                                counter
                        else:
                            if counter == 0xFF:
                                ## Overflow
                                0
                            else:
                                (counter + 1) & 0xFF
                    else:
                        ## Count down
                        if counter == 0:
                            ## At zero - wrap to limit
                            Limit
                        else:
                            (counter - 1) & 0xFF
                else:
                    counter
        
        Count = counter
        AtLimit = if UpDown:
            (counter == Limit)
        else:
            (counter == 0)

## ============================================================================
## PipelineRegister - Pipeline stage with valid/ready handshake
## ============================================================================
module PipelineRegister8:
    pins:
        DataIn[8],
        ValidIn[1],
        ReadyOut[1],
        Clock[1],
        Reset[1],
        DataOut[8],
        ValidOut[1],
        ReadyIn[1]
    
    logic:
        ## Test 9: Pipeline register with handshake protocol
        let mut data_reg[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut valid_reg[1] = Reg(clock: Clock, reset: Reset, init: 0)
        
        ## Transfer occurs when both valid and ready are high
        let transfer = ValidIn & ReadyOut
        let consume = ValidOut & ReadyIn
        
        data_reg.next = if Reset:
            0
        else:
            if transfer:
                ## Load new data
                if DataIn[7]:
                    ## MSB set - check for special values
                    match DataIn[6..4]:
                        0x0: DataIn
                        0x1: DataIn
                        0x2: DataIn
                        0x3: DataIn
                        0x4: DataIn
                        0x5: DataIn
                        0x6: DataIn
                        else: DataIn
                else:
                    DataIn
            else:
                data_reg
        
        valid_reg.next = if Reset:
            0
        else:
            if transfer:
                ## New data arrives
                1
            else:
                if consume:
                    ## Data consumed
                    0
                else:
                    valid_reg
        
        DataOut = data_reg
        ValidOut = valid_reg
        
        ## Ready when not valid or being consumed
        ReadyOut = if valid_reg:
            ReadyIn
        else:
            1

## ============================================================================
## RegisteredALU - ALU with registered inputs and output
## ============================================================================
module RegisteredALU8:
    pins:
        A[8],
        B[8],
        Op[3],
        Clock[1],
        Reset[1],
        Enable[1],
        Result[8],
        Flags[4]
    
    logic:
        ## Test 10: Multi-stage registered ALU
        let mut a_reg[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut b_reg[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut result_reg[8] = Reg(clock: Clock, reset: Reset, init: 0)
        let mut flags_reg[4] = Reg(clock: Clock, reset: Reset, init: 0)
        
        ## Stage 1: Register inputs
        a_reg.next = if Reset:
            0
        else:
            if Enable:
                A
            else:
                a_reg
        
        b_reg.next = if Reset:
            0
        else:
            if Enable:
                B
            else:
                b_reg
        
        ## Stage 2: Compute result
        let alu_result = match Op:
            0x0: (a_reg + b_reg) & 0xFF
            0x1: (a_reg - b_reg) & 0xFF
            0x2: a_reg & b_reg
            0x3: a_reg | b_reg
            0x4: a_reg xor b_reg
            0x5: if a_reg[7]:
                (a_reg << b_reg[2..0]) & 0xFF
            else:
                (a_reg << b_reg[2..0]) & 0xFF
            0x6: if a_reg[7]:
                ## Arithmetic shift right
                match b_reg[2..0]:
                    0: a_reg
                    1: [(a_reg[7] * 1), a_reg[7..1]]
                    2: [(a_reg[7] * 2), a_reg[7..2]]
                    3: [(a_reg[7] * 3), a_reg[7..3]]
                    4: [(a_reg[7] * 4), a_reg[7..4]]
                    5: [(a_reg[7] * 5), a_reg[7..5]]
                    6: [(a_reg[7] * 6), a_reg[7..6]]
                    else: [(a_reg[7] * 7), a_reg[7]]
            else:
                (a_reg >> b_reg[2..0]) & 0xFF
            else: if a_reg > b_reg:
                a_reg
            else:
                b_reg
        
        ## Compute flags: [Zero, Negative, Carry, Overflow]
        let zero_flag = (alu_result == 0)
        let negative_flag = alu_result[7]
        let carry_flag = if Op == 0:
            ## Addition carry
            ((a_reg + b_reg) > 0xFF)
        else:
            if Op == 1:
                ## Subtraction borrow
                (a_reg < b_reg)
            else:
                0
        let overflow_flag = if Op == 0:
            ## Addition overflow
            (a_reg[7] == b_reg[7]) & (alu_result[7] != a_reg[7])
        else:
            if Op == 1:
                ## Subtraction overflow
                (a_reg[7] != b_reg[7]) & (alu_result[7] != a_reg[7])
            else:
                0
        
        result_reg.next = if Reset:
            0
        else:
            if Enable:
                alu_result
            else:
                result_reg
        
        flags_reg.next = if Reset:
            0
        else:
            if Enable:
                [overflow_flag, carry_flag, negative_flag, zero_flag]
            else:
                flags_reg
        
        Result = result_reg
        Flags = flags_reg
