## ============================================================================
## PARAMETRIC RESISTOR - Tests Measurement type parameters (v0.1.5)
## ============================================================================

component Resistor_Generic_0805 (val: Measurement, tol: Measurement):
    metadata:
        manufacturer: "Generic"
        package: "0805"
        description: "Parametric resistor with value and tolerance parameters"
        category: "Passive"
        subcategory: "Resistor"
    
    pins:
        Pin1
        Pin2
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 0.6mm)
        pin_positions:
            Pin1 at [0mm, 0.625mm]
            Pin2 at [2.0mm, 0.625mm]
        pad_shapes:
            Pin1: RoundedRect(0.9mm, 1.0mm, 0.2mm)
            Pin2: RoundedRect(0.9mm, 1.0mm, 0.2mm)
    
    electrical:
        resistance: val        # Direct parameter reference
        tolerance: tol         # Parameter binding
        max_power: 0.125W
        max_voltage: 150V
        temperature_coefficient: 100ppm
        operating_temp_min: -55°C
        operating_temp_max: 155°C
    
    render:
        type: procedural
        shape: smd_passive
        body_color: "#1a1a1a"
        endcap_color: "#c0c0c0"

