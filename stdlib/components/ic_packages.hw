# ============================================================================
# DIP (Dual In-Line Package) - Through-Hole Classic
# ============================================================================

component DIP8:
    metadata:
        manufacturer: "Generic"
        package: "DIP-8"
        description: "8-pin Dual In-Line Package, 2.54mm pitch, through-hole"
        pin_count: "8"
        body_width: "7.62mm"
        body_length: "9.27mm"
        pitch: "2.54mm"
        mounting: "Through-hole"
        notes: "Classic through-hole package with circular pads"
    
    pins:
        Pin1, Pin2, Pin3, Pin4, Pin5, Pin6, Pin7, Pin8
    
    layout:
        shape: Rectangle(7.62mm, 9.27mm, 3.3mm)
        pin_positions:
            Pin1 at [0mm, 1.27mm]
            Pin2 at [0mm, 3.81mm]
            Pin3 at [0mm, 6.35mm]
            Pin4 at [0mm, 8.89mm]
            Pin5 at [7.62mm, 8.89mm]
            Pin6 at [7.62mm, 6.35mm]
            Pin7 at [7.62mm, 3.81mm]
            Pin8 at [7.62mm, 1.27mm]
        pad_shapes:
            Pin1: Circle(1.6mm)
            Pin2: Circle(1.6mm)
            Pin3: Circle(1.6mm)
            Pin4: Circle(1.6mm)
            Pin5: Circle(1.6mm)
            Pin6: Circle(1.6mm)
            Pin7: Circle(1.6mm)
            Pin8: Circle(1.6mm)
    
    electrical:
        max_voltage: 50V
        max_current_per_pin: 1A
    
    render:
        type: procedural
        shape: dip
        body_color: "#1C1C1C"
        pin_color: "#C0C0C0"

