## IC Packages - Compiler Stress Test for Hardware Script v0.1.5
## Tests: Complex pad shapes, high pin counts, parametric packages, thermal pads
## Goal: Expose Gerber export gaps (.gtp paste, .gts mask generation)

##[
    IC Package Stress Test Strategy:
    
    1. Package Types: QFN, SOIC, TSSOP, DIP, LQFP, BGA
    2. Pad Shapes: Circle, Rectangle, Obround, RoundedRect, Polygon
    3. Pin Counts: 8-pin to 256-pin packages
    4. Edge Cases:
       - Thermal pads (exposed pads)
       - Pin pitch variations (0.4mm to 2.54mm)
       - Parametric packages with configurable pin counts
       - Unicode in metadata
       - Scientific notation in measurements
       - Complex pad shape parameters
    
    Expected Compiler Behavior:
    - Parser should handle all pad shape syntaxes
    - Exporter should generate .gtp (paste) and .gts (mask) Gerber files
    - Parametric components should work with pin count parameters
    - Extreme values should not cause overflow
]##

# ============================================================================
# SOIC (Small Outline IC) - Standard Dual-Inline Surface Mount
# ============================================================================

component SOIC8:
    metadata:
        manufacturer: "Generic"
        package: "SOIC-8"
        description: "8-pin Small Outline IC, 1.27mm pitch"
        pin_count: "8"
        body_width: "3.9mm"
        body_length: "4.9mm"
        pitch: "1.27mm"
        notes: "Standard SOIC package with rectangular pads"
    
    pins:
        Pin1, Pin2, Pin3, Pin4, Pin5, Pin6, Pin7, Pin8
    
    layout:
        shape: Rectangle(6.0mm, 4.9mm, 1.5mm)
        pin_positions:
            Pin1 at [0mm, 0.635mm]
            Pin2 at [0mm, 1.905mm]
            Pin3 at [0mm, 3.175mm]
            Pin4 at [0mm, 4.445mm]
            Pin5 at [6.0mm, 4.445mm]
            Pin6 at [6.0mm, 3.175mm]
            Pin7 at [6.0mm, 1.905mm]
            Pin8 at [6.0mm, 0.635mm]
        pad_shapes:
            Pin1: Rectangle(0.6mm, 1.55mm)
            Pin2: Rectangle(0.6mm, 1.55mm)
            Pin3: Rectangle(0.6mm, 1.55mm)
            Pin4: Rectangle(0.6mm, 1.55mm)
            Pin5: Rectangle(0.6mm, 1.55mm)
            Pin6: Rectangle(0.6mm, 1.55mm)
            Pin7: Rectangle(0.6mm, 1.55mm)
            Pin8: Rectangle(0.6mm, 1.55mm)
    
    electrical:
        max_voltage: 50V
        max_current_per_pin: 500mA
    
    render:
        type: procedural
        shape: smd_ic
        body_color: "#1C1C1C"
        pin_color: "#C0C0C0"

