## BGA-144 - 12x12 Grid with Thermal Pad

component BGA_144_12x12_ThermalPad:
    metadata:
        manufacturer: "Advanced Packaging Inc."
        package: "BGA-144"
        description: "12x12 Ball Grid Array with exposed thermal pad"
        pin_count: "144"
        pitch: "0.5mm"
        body_size: "8mm x 8mm"
        thermal_pad: "Yes"
        notes: "High-density BGA with center thermal pad for heat dissipation 🔥"
    
    pins:
        ThermalPad,
        A1, A2, A3, A4, A5, A6, A7, A8, A9, A10, A11, A12,
        B1, B2, B3, B4, B5, B6, B7, B8, B9, B10, B11, B12,
        C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12,
        D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12,
        E1, E2, E3, E4, E5, E6, E7, E8, E9, E10, E11, E12,
        F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12,
        G1, G2, G3, G4, G5, G6, G7, G8, G9, G10, G11, G12,
        H1, H2, H3, H4, H5, H6, H7, H8, H9, H10, H11, H12,
        J1, J2, J3, J4, J5, J6, J7, J8, J9, J10, J11, J12,
        K1, K2, K3, K4, K5, K6, K7, K8, K9, K10, K11, K12,
        L1, L2, L3, L4, L5, L6, L7, L8, L9, L10, L11, L12,
        M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12
    
    layout:
        shape: Rectangle(8mm, 8mm, 1.2mm)
        pin_positions:
            ThermalPad at [4mm, 4mm]
            A1 at [0.5mm, 0.5mm]
            A12 at [7.5mm, 0.5mm]
            M1 at [0.5mm, 7.5mm]
            M12 at [7.5mm, 7.5mm]
        pad_shapes:
            ThermalPad: Rectangle(3mm, 3mm)
            A1: Circle(0.25mm)
            A12: Circle(0.25mm)
            M1: Circle(0.25mm)
            M12: Circle(0.25mm)
    
    electrical:
        max_voltage: 1.8V
        max_current_per_pin: 300mA
        thermal_resistance: 8°C/W
        thermal_pad_resistance: 2°C/W
        operating_temp_min: -55°C
        operating_temp_max: 150°C
        esr_1mhz: 0.001Ω
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#2A2A2A"
        ball_color: "#E0E0E0"

## BGA-256 - Scientific Notation Stress Test

component BGA_256_ScientificNotation:
    metadata:
        manufacturer: "Precision Micro Systems"
        package: "BGA-256"
        description: "16x16 BGA testing scientific notation in all forms"
        pin_count: "256"
        pitch: "0.4mm"
        body_size: "10mm x 10mm"
        special_features: "Tests scientific notation: 1.23456789e-10, 1.23456789e10"
        unicode_test: "Greek: α β γ δ ε ζ η θ, Math: ∑ ∏ ∫ ∂ ∇ √ ∞ ≈, Emoji: 🚀 ⚡ 🔬 🎯"
        punctuation_test: "All chars: '`<>,.?/!@#$%^&*()[]{}|\\-_=+;:~"
    
    pins:
        Data[32], Addr[16], Control[8], Power[4], Ground[4]
    
    layout:
        shape: Rectangle(10mm, 10mm, 1.5mm)
        pin_positions:
            Data[0] at [1mm, 1mm]
            Data[31] at [9mm, 9mm]
            Addr[0] at [0.5mm, 0.5mm]
            Addr[15] at [9.5mm, 9.5mm]
        pad_shapes:
            Data[0]: Circle(0.2mm)
            Data[31]: Circle(0.2mm)
            Addr[0]: Circle(0.2mm)
            Addr[15]: Circle(0.2mm)
    
    electrical:
        capacitance: 1.23456789e-15F
        inductance: 1.23456789e-10H
        resistance: 1.23456789e-3Ω
        voltage_rating: 1.8V
        current_rating: 1.23456789e-1A
        frequency_max: 1.23456789e10Hz
        q_factor: 1.23456789e1
        gain: 2.5e3
        ratio: 1.5e-2
        test_positive: 1.5e10
        test_negative: 2.5e-6
        thermal_conductivity: 401W/(m·K)
        resistivity: 1.68e-8Ω·m
        current_density: 35A/mm²
        mobility: 1400cm²/Vs
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#3A3A3A"
        ball_color: "#F0F0F0"


## BGA-484 - Extreme Values Stress Test

component BGA_484_ExtremeValues:
    metadata:
        manufacturer: "Extreme Test Corp"
        package: "BGA-484"
        description: "22x22 BGA testing extreme values and edge cases"
        pin_count: "484"
        pitch: "0.3mm"
        body_size: "15mm x 15mm"
        extreme_test: "Tests: 0.000001mm to 1000mm, -273.15°C to 1000°C"
    
    pins:
        VDD[64], VSS[64], IO[256], NC[100]
    
    layout:
        shape: Rectangle(15mm, 15mm, 2mm)
        pin_positions:
            VDD[0] at [0.3mm, 0.3mm]
            VSS[0] at [14.7mm, 0.3mm]
            IO[0] at [0.3mm, 14.7mm]
            NC[0] at [14.7mm, 14.7mm]
        pad_shapes:
            VDD[0]: Circle(0.15mm)
            VSS[0]: Circle(0.15mm)
            IO[0]: Circle(0.15mm)
            NC[0]: Circle(0.15mm)
    
    electrical:
        min_dimension: 0.000001mm
        max_dimension: 1000mm
        tiny_capacitance: 0.000001pF
        huge_capacitance: 3000F
        tiny_resistance: 0.000001Ω
        huge_resistance: 1e10Ω
        zero_resistance: 0Ω
        zero_tolerance: 0%
        tiny_current: 0.000000001A
        huge_current: 100A
        min_temp: -273.15°C
        max_temp: 1000°C
        operating_temp: -40°C
        negative_voltage: -55V
        negative_coefficient: -0.05%/°C
        asymmetric_tolerance_plus: +80%
        asymmetric_tolerance_minus: -20%
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#4A4A4A"
        ball_color: "#FFFFFF"

## BGA-676 - Hex/Binary/Octal Integer Test

component BGA_676_IntegerFormats:
    metadata:
        manufacturer: "Binary Systems Ltd"
        package: "BGA-676"
        description: "26x26 BGA testing hex, binary, and octal integers"
        pin_count: "676"
        pitch: "0.25mm"
        body_size: "18mm x 18mm"
        hex_test: "0xDEADBEEF, 0xFF, 0x00"
        binary_test: "0b11111111, 0b1010, 0b0"
        octal_test: "0o777, 0o644, 0o0"
    
    pins:
        DataBus[32], AddrBus[32], ControlBus[16]
    
    layout:
        shape: Rectangle(18mm, 18mm, 2.5mm)
        pin_positions:
            DataBus[0] at [0.5mm, 0.5mm]
            AddrBus[0] at [17.5mm, 0.5mm]
            ControlBus[0] at [0.5mm, 17.5mm]
        pad_shapes:
            DataBus[0]: Circle(0.125mm)
            AddrBus[0]: Circle(0.125mm)
            ControlBus[0]: Circle(0.125mm)
    
    electrical:
        register_value_hex: 0xDEADBEEF
        bitmask_binary: 0b11111111
        permissions_octal: 0o755
        max_voltage: 5V
        max_current: 2A
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#5A5A5A"
        ball_color: "#D0D0D0"

## BGA-900 - All Pad Shapes Test

component BGA_900_AllPadShapes:
    metadata:
