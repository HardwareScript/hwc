        package: "BGA-900"
        description: "30x30 BGA testing all pad shapes"
        pin_count: "900"
        pitch: "0.2mm"
        body_size: "20mm x 20mm"
        pad_shapes_tested: "Circle, Rectangle, Obround, RoundedRect, Polygon"
    
    pins:
        CirclePins[100],
        RectPins[100],
        ObroundPins[100],
        RoundedRectPins[100],
        PolygonPins[100]
    
    layout:
        shape: Rectangle(20mm, 20mm, 3mm)
        pin_positions:
            CirclePins[0] at [1mm, 1mm]
            RectPins[0] at [5mm, 1mm]
            ObroundPins[0] at [10mm, 1mm]
            RoundedRectPins[0] at [15mm, 1mm]
            PolygonPins[0] at [19mm, 1mm]
        pad_shapes:
            CirclePins[0]: Circle(0.1mm)
            RectPins[0]: Rectangle(0.15mm, 0.1mm)
            ObroundPins[0]: Obround(0.2mm, 0.1mm)
            RoundedRectPins[0]: RoundedRect(0.15mm, 0.1mm, 0.02mm)
            PolygonPins[0]: Polygon(0.1mm, 0.1mm, 0.15mm, 0.05mm)
    
    electrical:
        max_voltage: 2.5V
        max_current: 1.5A
        thermal_resistance: 5°C/W
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#6A6A6A"
        ball_color: "#B0B0B0"


## BGA-1024 - Keywords as Properties Test

component BGA_1024_KeywordsAsProperties:
    metadata:
        manufacturer: "Keyword Test Corp"
        package: "BGA-1024"
        description: "32x32 BGA testing keywords as property names"
        pin_count: "1024"
        pitch: "0.15mm"
        body_size: "25mm x 25mm"
        tolerance: "0.01mm"
        trace: "0.1mm"
        via: "0.2mm"
        clearance: "0.3mm"
        category: "High-density BGA"
        properties: "All keywords work as property names"
        metadata: "Even 'metadata' works as a metadata field!"
        pins: "Even 'pins' works!"
        layout: "Even 'layout' works!"
        electrical: "Even 'electrical' works!"
        render: "Even 'render' works!"
    
    pins:
        Power[128],
        Ground[128],
        Signal[768]
    
    layout:
        shape: Rectangle(25mm, 25mm, 3.5mm)
        pin_positions:
            Power[0] at [0.5mm, 0.5mm]
            Ground[0] at [24.5mm, 0.5mm]
            Signal[0] at [0.5mm, 24.5mm]
        pad_shapes:
            Power[0]: Circle(0.075mm)
            Ground[0]: Circle(0.075mm)
            Signal[0]: Circle(0.075mm)
    
    electrical:
        tolerance: 1%
        trace: 0.1mm
        via: 0.2mm
        clearance: 0.3mm
        category: conductor
        max_voltage: 1.2V
        max_current: 5A
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#7A7A7A"
        ball_color: "#A0A0A0"

