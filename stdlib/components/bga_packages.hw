            G8 at [6.0mm, 5.2mm]
            H1 at [0.4mm, 6.0mm]
            H2 at [1.2mm, 6.0mm]
            H3 at [2.0mm, 6.0mm]
            H4 at [2.8mm, 6.0mm]
            H5 at [3.6mm, 6.0mm]
            H6 at [4.4mm, 6.0mm]
            H7 at [5.2mm, 6.0mm]
            H8 at [6.0mm, 6.0mm]
        pad_shapes:
            A1: Circle(0.4mm)
