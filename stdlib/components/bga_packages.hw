## BGA-1849 - Inline Comments Everywhere

component BGA_1849_InlineComments:
    metadata:
        manufacturer: "Comment Test Inc"  # This is a manufacturer
        package: "BGA-1849"  # Package type
        description: "43x43 BGA testing inline comments everywhere"  # Description
        pin_count: "1849"  # Total pins
        pitch: "0.07mm"  # Ball pitch
        body_size: "35mm x 35mm"  # Package dimensions
    
    pins:  # Pin definitions
        Data[512],  # Data bus
        Addr[256],  # Address bus
        Control[128],  # Control signals
        Power[512],  # Power pins
        Ground[441]  # Ground pins
    
    layout:  # Layout block
        shape: Rectangle(35mm, 35mm, 5.5mm)  # Package shape
        pin_positions:  # Pin positions
            Data[0] at [1mm, 1mm]  # First data pin
            Addr[0] at [17.5mm, 1mm]  # First address pin
            Control[0] at [34mm, 1mm]  # First control pin
        pad_shapes:  # Pad shapes
            Data[0]: Circle(0.035mm)  # Circular pad
            Addr[0]: Circle(0.035mm)  # Circular pad
            Control[0]: Circle(0.035mm)  # Circular pad
    
    electrical:  # Electrical properties
        max_voltage: 0.75V  # Maximum voltage
        max_current: 25A  # Maximum current
        thermal_resistance: 2°C/W  # Thermal resistance
        esr_1mhz: 0.0001Ω  # ESR at 1MHz
    
    render:  # Render properties
        type: procedural  # Procedural rendering
        shape: bga_package  # BGA shape
        body_color: "#BABABA"  # Body color
        ball_color: "#606060"  # Ball color

## BGA-2048 - ULTIMATE STRESS TEST (Comptime Math)

#[
This is the ULTIMATE BGA stress test!
It tests:
- 2048 pins (45x45 grid with some missing)
- Comptime math expressions (i % 45, i / 45)
- All features combined
- Maximum complexity
]#

component BGA_2048_Ultimate:
    metadata:
        manufacturer: "Ultimate Test Corp 🚀"
        package: "BGA-2048"
        description: "45x45 BGA - ULTIMATE COMPILER STRESS TEST with comptime math"
        pin_count: "2048"
        pitch: "0.05mm"
        body_size: "40mm x 40mm"
        special_features: "Tests comptime expressions: i % 45, i / 45 for pin placement"
        unicode_extreme: "All Unicode: α β γ δ ε ζ η θ ι κ λ μ ν ξ ο π ρ σ τ υ φ χ ψ ω"
        math_symbols: "∑ ∏ ∫ ∂ ∇ √ ∞ ≈ ≠ ≤ ≥ ± × ÷"
        emoji_test: "🚀 ⚡ 🔬 🎯 🔥 💎 ⭐ 🌟 ✨ 💫 🌈 🎨 🎭 🎪 🎬 🎮 🎲 🎰 🎳"
        punctuation_extreme: "All: '`<>,.?/!@#$%^&*()[]{}|\\-_=+;:~"
    
    pins:
        Ball[2048]
    
    layout:
        shape: Rectangle(40mm, 40mm, 6mm)
        pin_positions:
            Ball[0] at [0.5mm, 0.5mm]
            Ball[44] at [2.7mm, 0.5mm]
            Ball[2025] at [0.5mm, 2.5mm]
            Ball[2047] at [2.7mm, 2.5mm]
        pad_shapes:
            Ball[0]: Circle(0.025mm)
            Ball[44]: Circle(0.025mm)
            Ball[2025]: Circle(0.025mm)
            Ball[2047]: Circle(0.025mm)
    
    electrical:
        max_voltage: 0.6V
        max_current: 50A
        thermal_resistance: 1°C/W
        capacitance_extreme: 1.23456789e-15F
        inductance_extreme: 1.23456789e-10H
        resistance_extreme: 1.23456789e-3Ω
        frequency_extreme: 1.23456789e10Hz
        q_factor_extreme: 1.23456789e1
        density_extreme: 8960kg/m³
        thermal_conductivity_extreme: 401W/(m·K)
        resistivity_extreme: 1.68e-8Ω·m
        current_density_extreme: 35A/mm²
        mobility_extreme: 1400cm²/Vs
        operating_temp_min_extreme: -273.15°C
        operating_temp_max_extreme: 1000°C
        negative_voltage_extreme: -55V
        negative_coefficient_extreme: -0.05%/°C
        zero_resistance_extreme: 0Ω
        zero_tolerance_extreme: 0%
        tiny_current_extreme: 0.000000001A
        huge_resistance_extreme: 1e10Ω
        hex_register_extreme: 0xDEADBEEF
        binary_mask_extreme: 0b11111111
        octal_permissions_extreme: 0o755
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#CACACA"
        ball_color: "#505050"


## BGA-400 - Asymmetric Tolerances Test

component BGA_400_AsymmetricTolerances:
    metadata:
        manufacturer: "Tolerance Test Systems"
        package: "BGA-400"
        description: "20x20 BGA testing asymmetric tolerances"
        pin_count: "400"
        pitch: "0.35mm"
        body_size: "12mm x 12mm"
        notes: "Tests +80%/-20% asymmetric tolerances"
    
    pins:
        Signal[256],
        Power[72],
        Ground[72]
    
    layout:
        shape: Rectangle(12mm, 12mm, 2mm)
        pin_positions:
            Signal[0] at [0.5mm, 0.5mm]
            Power[0] at [11.5mm, 0.5mm]
            Ground[0] at [0.5mm, 11.5mm]
        pad_shapes:
            Signal[0]: Circle(0.175mm)
            Power[0]: Circle(0.175mm)
            Ground[0]: Circle(0.175mm)
    
    electrical:
        tolerance_symmetric: 5%
        tolerance_asymmetric_plus: +80%
        tolerance_asymmetric_minus: -20%
        voltage_tolerance_plus: +10%
        voltage_tolerance_minus: -5%
        max_voltage: 3.3V
        max_current: 3A
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#DADADA"
        ball_color: "#404040"

## BGA-324 - Block Format Pins Test

component BGA_324_BlockFormatPins:
    metadata:
        manufacturer: "Block Format Inc"
        package: "BGA-324"
        description: "18x18 BGA testing block format pin definitions"
        pin_count: "324"
        pitch: "0.45mm"
        body_size: "14mm x 14mm"
    
    pins:
        A1
        A2
        A3
        B1
        B2
        B3
        C1
        C2
        C3
        VDD
        VSS
        GND
        NC
    
    layout:
        shape: Rectangle(14mm, 14mm, 2.2mm)
        pin_positions:
            A1 at [0.5mm, 0.5mm]
            A2 at [1.0mm, 0.5mm]
            A3 at [1.5mm, 0.5mm]
            B1 at [0.5mm, 1.0mm]
            B2 at [1.0mm, 1.0mm]
            B3 at [1.5mm, 1.0mm]
            C1 at [0.5mm, 1.5mm]
            C2 at [1.0mm, 1.5mm]
            C3 at [1.5mm, 1.5mm]
            VDD at [7mm, 7mm]
            VSS at [7mm, 7.5mm]
            GND at [7mm, 8mm]
            NC at [13.5mm, 13.5mm]
        pad_shapes:
            A1: Circle(0.225mm)
            VDD: Circle(0.225mm)
            VSS: Circle(0.225mm)
            GND: Circle(0.225mm)
    
    electrical:
        max_voltage: 2.5V
        max_current: 2.5A
        thermal_resistance: 10°C/W
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#EAEAEA"
        ball_color: "#303030"

## BGA-196 - Doc Comments Test

##[ BGA-196 Documentation Block ]##

#[
This component tests documentation comments.
It has both doc blocks (##[...]) and regular block comments (#[...]).
The compiler should keep doc blocks in the AST for documentation generation.
]#

component BGA_196_DocComments:
    metadata:
        manufacturer: "Documentation Test Corp"
        package: "BGA-196"
        description: "14x14 BGA testing documentation comments"
        pin_count: "196"
        pitch: "0.55mm"
        body_size: "16mm x 16mm"
    
    ## This is a documentation comment for pins
    pins:
        Data[64],  ## Data bus pins
        Addr[32],  ## Address bus pins
        Control[16],  ## Control signal pins
        Power[42],  ## Power supply pins
        Ground[42]  ## Ground pins
    
    ## This is a documentation comment for layout
    layout:
        shape: Rectangle(16mm, 16mm, 2.5mm)
        pin_positions:
            Data[0] at [0.5mm, 0.5mm]  ## First data pin
            Addr[0] at [8mm, 0.5mm]  ## First address pin
            Control[0] at [15.5mm, 0.5mm]  ## First control pin
        pad_shapes:
            Data[0]: Circle(0.275mm)
            Addr[0]: Circle(0.275mm)
            Control[0]: Circle(0.275mm)
    
    ## This is a documentation comment for electrical properties
    electrical:
        max_voltage: 1.8V  ## Maximum operating voltage
        max_current: 4A  ## Maximum current draw
        thermal_resistance: 7°C/W  ## Junction-to-ambient thermal resistance
    
    ## This is a documentation comment for render properties
    render:
        type: procedural
        shape: bga_package
        body_color: "#FAFAFA"
        ball_color: "#202020"

## BGA-100 - Minimal BGA (Edge Case)

component BGA_100_Minimal:
    metadata:
        manufacturer: "Minimal Test"
        package: "BGA-100"
        description: "10x10 BGA - minimal configuration"
        pin_count: "100"
    
    pins: A1, A2, A3, A4, A5, A6, A7, A8, A9, A10
    
    layout:
        shape: Rectangle(5mm, 5mm, 1mm)
        pin_positions:
            A1 at [0.5mm, 0.5mm]
        pad_shapes:
            A1: Circle(0.25mm)
    
    electrical:
        max_voltage: 5V
        max_current: 1A
    
    render:
        type: procedural
        shape: bga_package
        body_color: "#000000"
        ball_color: "#FFFFFF"

##[ End of BGA Packages Stress Test ]##

#[
SUMMARY OF FEATURES TESTED:
✓ 13 BGA components (64 to 2048 pins)
✓ Scientific notation (1.23456789e-10, 1.23456789e10)
✓ Extreme values (0.000001mm to 1000mm, -273.15°C to 1000°C)
✓ Unicode (Greek: α β γ, Math: ∑ ∏ ∫, Emoji: 🚀 ⚡ 🔬)
✓ Negative values (-40°C, -55V, -0.05%/°C)
✓ Hex/binary/octal (0xDEADBEEF, 0b11111111, 0o777)
✓ Complex units (kg/m³, W/(m·K), cm²/Vs, A/mm², Ω·m)
✓ All pad shapes (Circle, Rectangle, Obround, RoundedRect, Polygon)
✓ Keywords as properties (tolerance, trace, via, clearance, etc.)
✓ Keywords as parameters (tolerance: Measurement)
✓ Keywords as variable references (tolerance: tolerance)
✓ Multi-line pin lists with commas
✓ Array pins (Data[32], Addr[16])
✓ Parametric components
✓ Inline comments everywhere
✓ All punctuation in strings ('`<>,.?/!@#$%^&*()[]{}|\\-_=+;:~)
✓ Float with scientific notation (1.23456789e-1)
✓ Zero values (0Ω, 0%, 0.000000001A)
✓ Frequency-dependent properties (esr_100hz to esr_1ghz)
✓ Asymmetric tolerances (+80%/-20%)
✓ Block and inline pin formats
✓ Doc comments (##[...]) and block comments (#[...])
✓ Thermal pads and exposed pads
✓ High pin counts (up to 2048)
✓ Comptime math (i % 45, i / 45) - documented for future implementation

COMPILER GAPS TO FIND:
- Can the lexer handle all Unicode characters?
- Can the parser handle 2048 pins?
- Does scientific notation work everywhere?
- Do keywords work as identifiers in all contexts?
- Are inline comments truly invisible?
- Does the Generic Measurement Parser handle all complex units?
- Can the AST store all this data without panicking?
]#
