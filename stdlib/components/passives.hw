## ============================================================================
## SECTION 14: All Punctuation in Strings (Lexer Stress Test)
## ============================================================================

component Test_All_Punctuation_In_Strings:
    metadata:
        manufacturer: "Test Corp"
        package: "Test"
        category: "Test"
        description: "Tests ALL punctuation in strings"
        punctuation_1: "Comma, period. semicolon; colon:"
        punctuation_2: "Question? Exclamation! At@ Hash#"
        punctuation_3: "Dollar$ Percent% Caret^ Ampersand&"
        punctuation_4: "Asterisk* Parentheses() Brackets[]"
        punctuation_5: "Braces{} Pipe| Backslash\\ Slash/"
        punctuation_6: "Less< Greater> Equals= Plus+"
        punctuation_7: "Hyphen- Underscore_ Tilde~ Backtick`"
        punctuation_8: "Single' Double\" Mixed: 'He said \"hello\"'"
        unicode_math: "Math: ± × ÷ ≠ ≈ ≤ ≥ ∞ √ ∑ ∫ ∂ ∇"
        unicode_greek: "Greek: α β γ δ ε ζ η θ ι κ λ µ ν ξ π ρ σ τ φ χ ψ ω"
        unicode_arrows: "Arrows: ← → ↑ ↓ ↔ ↕ ⇐ ⇒ ⇑ ⇓ ⇔"
        unicode_symbols: "Symbols: © ® ™ € £ ¥ ¢   ¶ † ‡ • ◦ ‣"
        
    pins: Test1, Test2
    
    layout:
        shape: Rectangle(1mm, 1mm, 0.5mm)
        pin_positions:
            Test1 at [0mm, 0.5mm]
            Test2 at [1mm, 0.5mm]
            
    electrical:
        resistance: 1kΩ
        
    render:
        type: procedural
        shape: custom
        body_color: "#FF00FF"

