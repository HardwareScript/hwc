##[
# Passive Components - Comprehensive Stress Test
# 
# This file tests EVERY feature found in:
# - Docs/v0.1.5/LANGUAGE-SPEC.md
# - Docs/v0.1.4/LANGUAGE-SPEC.md  
# - hwc/crates/hwc-parser/src/lexer/token.rs
# - hwc/crates/hwc-parser/src/parser/definitions/component.rs
#
# Goal: Expose compiler gaps, not just validate working syntax
#
# Features tested:
# - All pad shapes (Rectangle, Circle, Obround, RoundedRect, Polygon)
# - Scientific notation (1.23456789e-10)
# - Extreme values (0.000001pF to 1000000F)
# - Unicode everywhere (µ, Ω, °, ±, ≤, ≥)
# - Negative values (-40°C, -55V)
# - Hex/binary/octal integers
# - Complex units (kg/m³, W/(m·K), cm²/Vs)
# - Keywords as property names
# - Multi-line pin lists
# - Parametric components
# - Inline comments everywhere
# - All punctuation in strings
]##

## ============================================================================
## SECTION 1: Extreme Scientific Notation & Unicode Stress Test
## ============================================================================

component Capacitor_Femtofarad_Extreme:
    metadata:
        manufacturer: "Quantum Labs"
        package: "0201"
        category: "Passive"
        subcategory: "Capacitor"
        description: "Tests extreme scientific notation: 1.23456789e-15F (femtofarads)"
        notes: "Unicode test: µ Ω ° ± ≤ ≥ ∞ π Σ ∆ √ ∫ ∂ ∇ ∈ ∉ ⊂ ⊃ ∪ ∩"
        special_chars: "Punctuation: '`<>,.?/!@#$%^&*()[]{}|\\-_=+;:~"
        emoji: "Status: ✅ ❌ ⚠️ 🔥 💡 ⚡ 🌡️ 📊"
        
    pins: Anode, Cathode  # Inline format with comment
    
    layout:
        shape: Rectangle(0.6mm, 0.3mm, 0.15mm)  # Tiny 0201 package
        pin_positions:
            Anode at [0mm, 0.15mm]  # Left pad, centered
            Cathode at [0.6mm, 0.15mm]  # Right pad, centered
            
    electrical:
        capacitance: 1.23456789e-15F  # 1.23456789 femtofarads
        voltage_rating: 5V
        tolerance: 0.05pF  # ±0.05pF
        esr_1mhz: 1.23456789e-3Ω  # Scientific notation ESR
        temperature_coefficient: -750ppm/K  # Negative value
        
    render:
        type: procedural
        shape: smd_passive
        body_color: "#8B4513"  # Brown ceramic
        endcap_color: "#C0C0C0"  # Silver


## ============================================================================
## SECTION 2: Hex/Binary/Octal Integer Literals
## ============================================================================

component Resistor_Network_Hex_Test:
    metadata:
        manufacturer: "Bourns"
        package: "4x0603"
        category: "Passive"
        subcategory: "Resistor Network"
        description: "Tests hex/binary/octal integer literals in pin counts"
        pin_count_decimal: "8"
        pin_count_hex: "0x8"
        pin_count_binary: "0b1000"
        pin_count_octal: "0o10"
        
    pins:
        Pin1, Pin2, Pin3, Pin4,  # Multi-line pin list
        Pin5, Pin6, Pin7, Pin8   # with inline comments
    
    layout:
        shape: Rectangle(3.2mm, 1.6mm, 0.55mm)
        pin_positions:
            Pin1 at [0mm, 0.4mm]
            Pin2 at [0mm, 0.8mm]
            Pin3 at [0mm, 1.2mm]
            Pin4 at [0mm, 1.6mm]
            Pin5 at [3.2mm, 1.6mm]
            Pin6 at [3.2mm, 1.2mm]
            Pin7 at [3.2mm, 0.8mm]
            Pin8 at [3.2mm, 0.4mm]
            
    electrical:
        resistance: 10kΩ
        tolerance: 1%
        max_power: 0.0625W  # Per resistor
        temperature_coefficient: 100ppm/K
        
    render:
        type: procedural
        shape: smd_passive
        body_color: "#000000"
        endcap_color: "#C0C0C0"

## ============================================================================
## SECTION 3: All Pad Shapes - Rectangle, Circle, Obround, RoundedRect
## ============================================================================

component Test_All_Pad_Shapes:
    metadata:
        manufacturer: "Test Corp"
        package: "Custom"
        category: "Test"
        description: "Tests all pad shapes: Rectangle, Circle, Obround, RoundedRect"
        
    pins: Rect, Circ, Obr, Round
    
    layout:
        shape: Rectangle(10mm, 10mm, 1mm)
        pin_positions:
            Rect at [1mm, 1mm]
            Circ at [4mm, 1mm]
            Obr at [7mm, 1mm]
            Round at [1mm, 4mm]
        pad_shapes:
            Rect: Rectangle(1mm, 0.8mm)  # Standard rectangle
            Circ: Circle(0.5mm)  # Circle with diameter
            Obr: Obround(1.5mm, 0.8mm)  # Obround (rounded ends)
            Round: RoundedRect(1mm, 0.8mm, 0.2mm)  # Rounded rectangle
            
    electrical:
        resistance: 0Ω  # Zero ohm jumper
        
    render:
        type: procedural
        shape: custom
        body_color: "#FF0000"


## ============================================================================
## SECTION 4: Extreme Value Ranges - Tiny to Massive
## ============================================================================

component Capacitor_Supercap_Extreme:
    metadata:
        manufacturer: "Maxwell"
        package: "Radial"
        category: "Passive"
        subcategory: "Supercapacitor"
        description: "Tests extreme capacitance: 3000F (3 kilofarads!)"
        voltage_rating_str: "2.7V"
        capacitance_str: "3000F"
        esr_str: "0.00029Ω"
        
    pins: Plus, Minus
    
    layout:
        shape: Rectangle(60mm, 138mm, 60mm)  # Huge cylindrical can
        pin_positions:
            Plus at [30mm, 5mm]
            Minus at [30mm, 133mm]
        pad_shapes:
            Plus: Circle(5mm)  # Large terminal
            Minus: Circle(5mm)
            
    electrical:
        capacitance: 3000F  # 3 kilofarads!
        voltage_rating: 2.7V
        esr_100hz: 0.00029Ω  # 0.29 milliohms
        max_current: 100A  # Extreme current
        leakage_current: 0.001A  # 1mA
        lifetime: 1000000h  # 1 million hours
        temperature_min: -40°C  # Negative temperature
        temperature_max: 65°C
        
    render:
        type: procedural
        shape: cylinder
        body_color: "#1E90FF"  # Blue can
        label: "3000F 2.7V"

component Capacitor_Picofarad_Tiny:
    metadata:
        manufacturer: "Murata"
        package: "01005"
        category: "Passive"
        subcategory: "Capacitor"
        description: "Tests tiny capacitance: 0.1pF"
        
    pins: A, B
    
    layout:
        shape: Rectangle(0.4mm, 0.2mm, 0.13mm)  # Microscopic 01005
        pin_positions:
            A at [0mm, 0.1mm]
            B at [0.4mm, 0.1mm]
            
    electrical:
        capacitance: 0.1pF  # 100 femtofarads
        voltage_rating: 25V
        tolerance: 0.05pF
        esr_1ghz: 0.5Ω
        
    render:
        type: procedural
        shape: smd_passive
        body_color: "#D2B48C"
        endcap_color: "#C0C0C0"


## ============================================================================
## SECTION 5: Complex Units with Parentheses and Operators
## ============================================================================

component Thermistor_NTC_Complex_Units:
    metadata:
        manufacturer: "Vishay"
        package: "0805"
        category: "Passive"
        subcategory: "Thermistor"
        description: "Tests complex units: kg/m³, W/(m·K), cm²/Vs"
        material_density: "8960kg/m³"  # Copper density
        thermal_conductivity: "401W/(m·K)"  # Copper thermal conductivity
        mobility: "1400cm²/Vs"  # Electron mobility
        
    pins: T1, T2
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 0.6mm)
        pin_positions:
            T1 at [0mm, 0.625mm]
            T2 at [2.0mm, 0.625mm]
            
    electrical:
        resistance_25c: 10kΩ  # Resistance at 25°C
        beta: 3950K  # Beta value
        tolerance: 1%
        temperature_min: -55°C  # Negative temperature
        temperature_max: 125°C
        dissipation_constant: 1.5mW/K  # Complex unit
        thermal_time_constant: 10s
        
    render:
        type: procedural
        shape: smd_passive
        body_color: "#2F4F4F"  # Dark slate gray
        endcap_color: "#C0C0C0"

## ============================================================================
## SECTION 6: Keywords as Property Names (Stress Test)
## ============================================================================

component Test_Keywords_As_Properties:
    metadata:
        manufacturer: "Test Corp"
        package: "Test"
        category: "Test"  # 'category' is a keyword
        description: "Tests using keywords as property names"
        
    pins: In, Out
    
    layout:
        shape: Rectangle(1mm, 1mm, 0.5mm)
        pin_positions:
            In at [0mm, 0.5mm]
            Out at [1mm, 0.5mm]
            
    electrical:
        tolerance: 5%  # 'tolerance' is a keyword
        trace: 0.254mm  # 'trace' is a keyword
        via: 0.3mm  # 'via' is a keyword
        layer: 1  # 'layer' is a keyword (but value is identifier, not keyword)
        clearance: 0.2mm  # 'clearance' is a keyword
        material: Copper  # 'material' is a keyword
        profile: Standard  # 'profile' is a keyword
        component: Generic  # 'component' is a keyword
        space: 0.5mm  # 'space' is a keyword
        test: Pass  # 'test' is a keyword
        
    render:
        type: procedural
        shape: custom
        body_color: "#00FF00"


## ============================================================================
## SECTION 7: Parametric Components with Keyword Arguments
## ============================================================================

component Resistor_Parametric_Test (resistance: Measurement, tolerance: Measurement, power: Measurement):
    metadata:
        manufacturer: "Generic"
        package: "0805"
        category: "Passive"
        subcategory: "Resistor"
        description: "Parametric resistor with 3 parameters"
        
    pins: Pin1, Pin2
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 0.6mm)
        pin_positions:
            Pin1 at [0mm, 0.625mm]
            Pin2 at [2.0mm, 0.625mm]
            
    electrical:
        resistance: resistance  # Parameter reference
        tolerance: tolerance  # Parameter reference
        max_power: power  # Parameter reference
        voltage_rating: 150V
        temperature_coefficient: 100ppm/K
        
    render:
        type: procedural
        shape: smd_passive
        body_color: "#111111"
        endcap_color: "#C0C0C0"

component Capacitor_Parametric_Test (capacitance: Measurement, voltage: Measurement):
    metadata:
        manufacturer: "Generic"
        package: "0805"
        category: "Passive"
        subcategory: "Capacitor"
        description: "Parametric capacitor with 2 parameters"
        
    pins: Anode, Cathode
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 0.6mm)
        pin_positions:
            Anode at [0mm, 0.625mm]
            Cathode at [2.0mm, 0.625mm]
            
    electrical:
        capacitance: capacitance  # Parameter reference
        voltage_rating: voltage  # Parameter reference
        tolerance: 10%
        esr_100khz: 0.1Ω
        
    render:
        type: procedural
        shape: smd_passive
        body_color: "#8B4513"
        endcap_color: "#C0C0C0"

