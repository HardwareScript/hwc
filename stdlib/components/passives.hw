component Fuse_Inline_Comments_Test:
    metadata:
        manufacturer: "Bel Fuse"  # Leading manufacturer
        package: "0603"  # Small package
        category: "Passive"  # Component category
        subcategory: "Fuse"  # Subcategory
        description: "Tests inline comments in metadata block"  # Description
        current_rating: "500mA"  # Maximum current
        voltage_rating: "32V"  # Maximum voltage
        breaking_capacity: "50A"  # Short circuit current
        time_constant: "Fast"  # Response time
        
    pins: In, Out  # Input and output pins
    
    layout:
        shape: Rectangle(1.6mm, 0.8mm, 0.45mm)  # Standard 0603
        pin_positions:
            In at [0mm, 0.4mm]  # Left pad
            Out at [1.6mm, 0.4mm]  # Right pad
            
    electrical:
        resistance: 0.5Ω  # Cold resistance
        current_rating: 0.5A  # 500mA
        voltage_rating: 32V  # Maximum voltage
        breaking_capacity: 50A  # Short circuit
        i2t: 0.01A²s  # Melting integral
        
    render:
