component Connector_Array_Pins_Test:
    metadata:
        manufacturer: "Molex"
        package: "Custom"
        category: "Connector"
        description: "Tests block format pins with array syntax"
        
    pins:
        Data[16]  # 16-bit data bus
        Addr[8]  # 8-bit address bus
        Control[4]  # 4-bit control bus
        VCC
        GND
        
    layout:
        shape: Rectangle(20mm, 10mm, 5mm)
        pin_positions:
            Data at [1mm, 1mm]
            Addr at [1mm, 3mm]
            Control at [1mm, 5mm]
            VCC at [1mm, 7mm]
            GND at [1mm, 9mm]
            
    electrical:
        voltage_rating: 5V
        current_rating: 1A
        
    render:
        type: procedural
        shape: connector
        body_color: "#000000"


