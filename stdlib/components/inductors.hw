##[ Hardware Script Standard Library - Inductors
    Comprehensive stress test for v0.1.5 compiler
    Tests: Parametric components, extreme values, unicode, scientific notation,
           inductor-specific properties, all pad shapes, edge cases
]##

## ============================================================================
## STRESS TEST STRATEGY
## ============================================================================
## This file intentionally uses EVERY feature found in:
## - Docs/v0.1.5/LANGUAGE-SPEC.md
## - Docs/v0.1.4/LANGUAGE-SPEC.md
## - hwc/crates/hwc-parser/src/parser/definitions/component.rs
## - hwc/crates/hwc-parser/src/lexer/token.rs
##
## Goal: Expose compiler gaps, not just validate working syntax
## ============================================================================

## ============================================================================
## SECTION 1: SMD POWER INDUCTORS (Shielded, High Current)
## ============================================================================

component Inductor_1210_Shielded (ind: Measurement, isat: Measurement, dcr: Measurement):
    metadata:
        manufacturer: "Murata"
        package: "1210"
        category: "Passive"
        subcategory: "Power Inductor"
        type: "Shielded"
        core_material: "Ferrite"
        shielding: "Magnetic shielding for low EMI"
        mounting: "SMD"
        
    pins:
        Pin1
        Pin2
        
    layout:
        shape: Rectangle(3.2mm, 2.5mm, 1.0mm)
        pin_positions:
            Pin1 at [0mm, 1.25mm]
            Pin2 at [3.2mm, 1.25mm]
        pad_shapes:
            Pin1: Rectangle(1.2mm, 2.0mm)
            Pin2: Rectangle(1.2mm, 2.0mm)
            
    electrical:
        inductance: ind
        saturation_current: isat
        dc_resistance: dcr
        tolerance: 20%
        max_current: isat
        
    render:
        type: procedural
        shape: smd_inductor
        body_color: "#2C2C2C"
        marking_color: "#FFFFFF"


## ============================================================================
## SECTION 2: EXTREME VALUE TESTS - Scientific Notation & Edge Cases
## ============================================================================

component Inductor_Nano_Extreme:
    metadata:
        manufacturer: "Test Corp"
        package: "0201"
        notes: "Extreme scientific notation test: 1.23456789e-10H"
        description: "Tests lexer with extreme precision and scientific notation"
        
    pins: A, B
    
    layout:
        shape: Rectangle(0.6mm, 0.3mm, 0.23mm)
        pin_positions:
            A at [0mm, 0.15mm]
            B at [0.6mm, 0.15mm]
        pad_shapes:
            A: Circle(0.15mm)
            B: Circle(0.15mm)
            
    electrical:
        inductance: 1.23456789e-10H
        saturation_current: 50mA
        dc_resistance: 0.001Ω
        srf: 10GHz
        q_factor: 50
        tolerance: 5%
        
    render:
        type: procedural
        shape: smd_passive
        body_color: "#000000"

component Inductor_Mega_Extreme:
    metadata:
        manufacturer: "Test Corp"
        package: "Custom"
        notes: "Extreme high values: 1000H, 100A saturation"
        description: "Tests parser with massive inductor values"
        
    pins: Terminal1, Terminal2
    
    layout:
        shape: Rectangle(50mm, 50mm, 30mm)
        pin_positions:
            Terminal1 at [0mm, 25mm]
            Terminal2 at [50mm, 25mm]
        pad_shapes:
            Terminal1: Rectangle(10mm, 20mm)
            Terminal2: Rectangle(10mm, 20mm)
            
    electrical:
        inductance: 1000H
        saturation_current: 100A
        dc_resistance: 0.5Ω
        max_voltage: 1000V
        max_power: 500W
        tolerance: 10%
        
    render:
        type: procedural
        shape: through_hole_inductor
        body_color: "#4A4A4A"


## ============================================================================
## SECTION 3: UNICODE & SPECIAL CHARACTERS TEST
## ============================================================================

component Inductor_Unicode_Test:
    metadata:
        manufacturer: "Test™ Corp®"
        package: "Custom"
        notes: "Special chars: '`<>,.?/ and unicode: µΩ°"
        description: "Tests lexer string literal handling with all punctuation"
        emoji_test: "High power 🔥 inductor with ⚡ fast response"
        rtl_test: "مُحَرِّض (Arabic for inductor)"
        chinese_test: "电感器 (Chinese for inductor)"
        math_symbols: "∫∂∇∞≈≠±×÷"
        
    pins: Plus, Minus
    
    layout:
        shape: Rectangle(5mm, 5mm, 3mm)
        pin_positions:
            Plus at [0mm, 2.5mm]
            Minus at [5mm, 2.5mm]
        pad_shapes:
            Plus: Obround(2mm, 1mm)
            Minus: Obround(2mm, 1mm)
            
    electrical:
        inductance: 10µH
        saturation_current: 5A
        dc_resistance: 0.015Ω
        temperature_coefficient: 100ppm
        tolerance: 20%
        
    render:
        type: procedural
        shape: smd_inductor
        body_color: "#FF6600"

## ============================================================================
## SECTION 4: ALL PAD SHAPES TEST
## ============================================================================

component Inductor_AllPadShapes:
    metadata:
        manufacturer: "Pad Shape Test Corp"
        package: "Custom Multi-Pad"
        description: "Tests all available pad shapes in parser"
        
    pins: Pad1, Pad2, Pad3, Pad4, Pad5, Pad6
    
    layout:
        shape: Rectangle(10mm, 10mm, 2mm)
        pin_positions:
            Pad1 at [1mm, 1mm]
            Pad2 at [5mm, 1mm]
            Pad3 at [9mm, 1mm]
            Pad4 at [1mm, 5mm]
            Pad5 at [5mm, 5mm]
            Pad6 at [9mm, 5mm]
        pad_shapes:
            Pad1: Circle(0.8mm)
            Pad2: Rectangle(1.5mm, 1.0mm)
            Pad3: Obround(2.0mm, 1.0mm)
            Pad4: RoundedRect(1.5mm, 1.5mm, 0.3mm)
            Pad5: Polygon(1mm, 1mm, 1mm, 1mm, 1mm, 1mm)
            Pad6: Octagon(1.2mm)
            
    electrical:
        inductance: 22µH
        saturation_current: 3A
        dc_resistance: 0.025Ω
        
    render:
        type: procedural
        shape: custom
        body_color: "#00FF00"


