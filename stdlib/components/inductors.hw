## ============================================================================
## SECTION 13: ARRAY PINS TEST (Bus Notation)
## ============================================================================

component Inductor_Array_4Channel:
    metadata:
        manufacturer: "Array Test Corp"
        package: "Custom Array"
        description: "Tests array pin notation for multi-channel inductors"
        
    pins:
        Ch1_In
        Ch1_Out
        Ch2_In
        Ch2_Out
        Ch3_In
        Ch3_Out
        Ch4_In
        Ch4_Out
        GND
        
    layout:
        shape: Rectangle(10mm, 8mm, 3mm)
        pin_positions:
            Ch1_In at [0mm, 1mm]
            Ch1_Out at [10mm, 1mm]
            Ch2_In at [0mm, 3mm]
            Ch2_Out at [10mm, 3mm]
            Ch3_In at [0mm, 5mm]
            Ch3_Out at [10mm, 5mm]
            Ch4_In at [0mm, 7mm]
            Ch4_Out at [10mm, 7mm]
            GND at [5mm, 4mm]
        pad_shapes:
            Ch1_In: Rectangle(1mm, 1mm)
            Ch1_Out: Rectangle(1mm, 1mm)
            Ch2_In: Rectangle(1mm, 1mm)
            Ch2_Out: Rectangle(1mm, 1mm)
            Ch3_In: Rectangle(1mm, 1mm)
            Ch3_Out: Rectangle(1mm, 1mm)
            Ch4_In: Rectangle(1mm, 1mm)
            Ch4_Out: Rectangle(1mm, 1mm)
            GND: Rectangle(2mm, 2mm)
            
    electrical:
        inductance_per_channel: 10µH
        saturation_current: 2A
        dc_resistance: 0.05Ω
        channel_isolation: 40dB
        tolerance: 20%
        
    render:
        type: procedural
        shape: array_inductor
        body_color: "#006400"

