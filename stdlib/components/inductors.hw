## ============================================================================
## SECTION 7: COUPLED INDUCTORS & TRANSFORMERS
## ============================================================================

component Inductor_Coupled_CommonMode:
    metadata:
        manufacturer: "Wurth Elektronik"
        package: "WE-CMB"
        type: "Common Mode Choke"
        application: "EMI filtering, differential signal lines"
        coupling_coefficient: "0.98"
        
    pins: L1_A, L1_B, L2_A, L2_B
    
    layout:
        shape: Rectangle(7mm, 6mm, 4mm)
        pin_positions:
            L1_A at [0mm, 1.5mm]
            L1_B at [0mm, 4.5mm]
            L2_A at [7mm, 1.5mm]
            L2_B at [7mm, 4.5mm]
        pad_shapes:
            L1_A: Rectangle(1.5mm, 2mm)
            L1_B: Rectangle(1.5mm, 2mm)
            L2_A: Rectangle(1.5mm, 2mm)
            L2_B: Rectangle(1.5mm, 2mm)
            
    electrical:
        inductance_l1: 100µH
        inductance_l2: 100µH
        leakage_inductance: 2µH
        saturation_current: 3A
        dc_resistance_l1: 0.08Ω
        dc_resistance_l2: 0.08Ω
        coupling_coefficient: 0.98
        tolerance: 20%
        
    render:
        type: procedural
        shape: coupled_inductor
        body_color: "#2E2E2E"

component Inductor_Transformer_Flyback:
    metadata:
        manufacturer: "Coilcraft"
        package: "Custom"
        type: "Flyback Transformer"
        application: "Isolated DC-DC converters"
        turns_ratio: "1:3"
        
    pins: Pri_Dot, Pri_NoDot, Sec_Dot, Sec_NoDot
    
    layout:
        shape: Rectangle(15mm, 12mm, 10mm)
        pin_positions:
            Pri_Dot at [0mm, 3mm]
            Pri_NoDot at [0mm, 9mm]
            Sec_Dot at [15mm, 3mm]
            Sec_NoDot at [15mm, 9mm]
        pad_shapes:
            Pri_Dot: Circle(1.5mm)
            Pri_NoDot: Circle(1.5mm)
            Sec_Dot: Circle(1.5mm)
            Sec_NoDot: Circle(1.5mm)
            
    electrical:
        primary_inductance: 100µH
        secondary_inductance: 900µH
        leakage_inductance: 5µH
        turns_ratio: 3
        saturation_current: 5A
        dc_resistance_primary: 0.05Ω
        dc_resistance_secondary: 0.45Ω
        isolation_voltage: 3000V
        tolerance: 10%
        
    render:
        type: procedural
        shape: transformer
        body_color: "#1A1A1A"


