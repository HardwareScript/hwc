component Antenna_PCB_Inverted_F:
    metadata:
        manufacturer: "Custom Design"
        part_number: "IFA-2450-PCB"
        package: "PCB Trace"
        frequency_band: "2.4GHz"
        antenna_type: "Inverted-F Antenna (IFA)"
        notes: "Testing Polygon pad shape with complex coordinates"
    
    pins: Feed, Ground, Stub
    
    layout:
        shape: Rectangle(20mm, 10mm, 0.035mm)  # PCB copper thickness
        pin_positions:
            Feed at [5mm, 5mm]
            Ground at [0mm, 5mm]
            Stub at [10mm, 5mm]
        pad_shapes:
            Feed: Circle(1mm)
            Ground: Rectangle(2mm, 2mm)
            Stub: Circle(0.8mm)
    
    electrical:
        center_frequency: 2.45GHz
        bandwidth: 83MHz  # 2.4-2.483 GHz
        impedance: 50Ω
        vswr: 1.5
        gain: 2.15  # dBi (typical for IFA)
        efficiency: 0.70
        polarization: "Linear"
        radiation_pattern: "Directional"
        trace_width: 1.5mm
        trace_length: 30.6mm  # λ/4 at 2.45GHz
        ground_plane_size: "50mm x 50mm"
        max_power: 2W


component Antenna_PCB_Fractal_Koch:
    ##[ 
    Fractal Koch Snowflake Antenna - Tests Polygon pad shape with mathematical coordinates
    This is a STRESS TEST for the parser's ability to handle complex polygon definitions
    ]##
    metadata:
        manufacturer: "Custom Design"
        part_number: "KOCH-2450-FRACTAL"
        package: "PCB Trace"
        frequency_band: "2.4GHz"
        antenna_type: "Fractal Koch Snowflake"
        notes: "Testing: Polygon with 18+ vertices, mathematical coordinates, unicode ❄️"
        special_features: "Multiband operation due to fractal geometry"
    
    pins:
        Feed
        Ground
        Tuning[3]  # Array pins for impedance tuning stubs
    
    layout:
        shape: Rectangle(30mm, 30mm, 0.035mm)
        pin_positions:
            Feed at [15mm, 15mm]
            Ground at [15mm, 0mm]
            Tuning[0] at [10mm, 15mm]
            Tuning[1] at [20mm, 15mm]
            Tuning[2] at [15mm, 25mm]
        pad_shapes:
            Feed: Circle(1.2mm)
            Ground: Rectangle(3mm, 3mm)
            Tuning[0]: Circle(0.6mm)
            Tuning[1]: Circle(0.6mm)
            Tuning[2]: Circle(0.6mm)
    
    electrical:
        freq_primary: 2.45GHz
        freq_secondary: 5.2GHz  # Harmonic resonance
        freq_tertiary: 7.8GHz  # Second harmonic
        bandwidth_primary: 200MHz
        bandwidth_secondary: 400MHz
        impedance: 50Ω
        vswr_primary: 1.3
        vswr_secondary: 2.5
        gain_primary: 4.5  # dBi (fractal gain enhancement)
        gain_secondary: 3.0  # dBi
        efficiency_primary: 0.85
        efficiency_secondary: 0.65
        polarization: "Circular"  # Due to fractal symmetry
        radiation_pattern: "Omnidirectional"
        fractal_iteration: 3  # Koch snowflake iteration level
        trace_width: 0.5mm
        max_power: 1W
        test_extreme_precision: 1.234567890123456789e-20F  # Extreme precision test


