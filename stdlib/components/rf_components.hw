component Filter_SAW_2.4GHz:
    metadata:
        manufacturer: "Murata"
        part_number: "SAFEA2G45MA0F0A"
        package: "1411"
        filter_type: "SAW (Surface Acoustic Wave)"
        frequency_band: "2.4GHz ISM"
        notes: "Testing: Complex frequency response, S-parameters, unicode 🎚️"
    
    pins: Input, Output, Ground[2]
    
    layout:
        shape: Rectangle(1.4mm, 1.1mm, 0.5mm)
        pin_positions:
            Input at [0mm, 0.55mm]
            Output at [1.4mm, 0.55mm]
            Ground[0] at [0.35mm, 0mm]
            Ground[1] at [1.05mm, 0mm]
        pad_shapes:
            Input: Rectangle(0.4mm, 0.6mm)
            Output: Rectangle(0.4mm, 0.6mm)
            Ground[0]: Rectangle(0.4mm, 0.6mm)
            Ground[1]: Rectangle(0.4mm, 0.6mm)
    
    electrical:
        center_frequency: 2.45GHz
        passband_width: 83MHz  # 2.4-2.483 GHz
        insertion_loss: -2.5  # dB (typical)
        insertion_loss_max: -3.5  # dB (max)
        return_loss: -10  # dB
        rejection_900mhz: -40  # dB at 900MHz
        rejection_5ghz: -35  # dB at 5GHz
        ripple: 1.5  # dB in passband
        group_delay: 150  # nanoseconds (stored as unitless)
        impedance_input: 50Ω
        impedance_output: 50Ω
        power_handling: 0.5W
        operating_temp_min: -40°C
        operating_temp_max: +85°C
        temp_coefficient: -0.03  # ppm/°C (negative value)
        test_extreme_negative: -273.15°C  # Absolute zero test


