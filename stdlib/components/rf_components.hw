## ============================================================================
## EXTREME EDGE CASES - Unicode, Punctuation, Special Values
## ============================================================================

component RF_Test_Unicode_Extreme:
    metadata:
        manufacturer: "Test Corp 测试公司 テスト会社"
        part_number: "UNICODE-TEST-αβγδε-🔬"
        package: "Custom"
        notes: "Testing: Unicode everywhere - Greek α β γ δ ε, Math ∑ ∫ ∂ ∇, Emoji 📡 📶 ⚡ 🔌 🎚️ 🔀 ⚖️ 🔬"
        special_chars: "All punctuation: !@#$%^&*()_+-=[]{}|\\;':\",./<>?`~"
        rtl_text: "العربية עברית"  # Arabic and Hebrew (RTL test)
        math_symbols: "∞ ≈ ≠ ≤ ≥ ± ∓ × ÷ √ ∛ ∜ ∑ ∏ ∫ ∂ ∇ ∆"
        greek_alphabet: "αβγδεζηθικλμνξοπρστυφχψω ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ"
        subscripts: "H₂O CO₂ x₁ x₂ x₃"
        superscripts: "m² m³ x⁰ x¹ x² x³"
    
    pins:
        Signal_Alpha
        Signal_Beta
        Ground_Inf
    
    layout:
        shape: Rectangle(3mm, 3mm, 1mm)
        pin_positions:
            Signal_Alpha at [0mm, 1.5mm]
            Signal_Beta at [3mm, 1.5mm]
            Ground_Inf at [1.5mm, 0mm]
        pad_shapes:
            Signal_Alpha: Circle(0.8mm)
            Signal_Beta: Circle(0.8mm)
            Ground_Inf: Rectangle(1.5mm, 1.5mm)
    
    electrical:
        frequency_inf: 1e100Hz  # Extreme frequency (100 EHz)
        impedance_ohm: 50Ω
        gain_alpha: 1.23456789012345678901234567890e-100  # Extreme precision
        gain_beta: 9.87654321098765432109876543210e+100  # Extreme large
        temp_min_delta: -273.15°C  # Absolute zero
        temp_max_delta: +1000000°C  # Extreme high
        voltage_plusminus: 1000V  # Using ± symbol in metadata only
        current_micro: 0.000000000001A  # Picoamp
        resistance_inf: 1e15Ω  # Petaohm
        capacitance_integral: 1e-18F  # Attofarad
        inductance_partial: 1e-15H  # Femtohenry
        test_all_zeros: 0.000000000000000000000000000000Hz


component RF_Test_All_Pad_Shapes:
    ##[ Testing ALL pad shapes supported by the parser ]##
    metadata:
        manufacturer: "Test Corp"
