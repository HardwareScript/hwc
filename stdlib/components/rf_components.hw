component Connector_SMA_EdgeMount:
    metadata:
        manufacturer: "Amphenol RF"
        part_number: "132289"
        package: "SMA Edge Mount"
        connector_type: "SMA Female"
        impedance_rating: "50Ω"
        notes: "Testing: Through-hole pins, complex geometry, unicode ⚡"
    
    pins:
        Signal
        Ground[4]  # 4 ground pins for shielding
    
    layout:
        shape: Rectangle(9.5mm, 9.5mm, 13mm)  # Body extends above PCB
        pin_positions:
            Signal at [4.75mm, 4.75mm]
            Ground[0] at [0mm, 0mm]
            Ground[1] at [9.5mm, 0mm]
            Ground[2] at [0mm, 9.5mm]
            Ground[3] at [9.5mm, 9.5mm]
        pad_shapes:
            Signal: Circle(1.5mm)  # Through-hole
            Ground[0]: Circle(2.0mm)
            Ground[1]: Circle(2.0mm)
            Ground[2]: Circle(2.0mm)
            Ground[3]: Circle(2.0mm)
    
    electrical:
        impedance: 50Ω
        frequency_range_min: 0Hz  # DC to 18GHz
        frequency_range_max: 18GHz
        vswr_max: 1.3
        insertion_loss: -0.15  # dB (negative value)
        return_loss: -25  # dB (negative value)
        voltage_rating: 500V
        current_rating: 1.5A
        contact_resistance: 0.003Ω  # Milliohm range
        insulation_resistance: 1e9Ω  # 1 GigaOhm (scientific notation)
        dielectric_withstanding: 1500V
        operating_temp_min: -65°C
        operating_temp_max: +165°C
        mating_cycles: 500  # Durability spec
        test_hex: 0xDEADBEEF  # Hex integer test
        test_binary: 0b11111111  # Binary integer test
        test_octal: 0o777  # Octal integer test


component Connector_UFL_Micro:
    metadata:
        manufacturer: "Hirose"
        part_number: "U.FL-R-SMT-1(10)"
        package: "U.FL SMD"
        connector_type: "U.FL/IPEX Micro Coax"
        impedance_rating: "50Ω"
        notes: "Ultra-small RF connector for PCB antennas 🔌"
    
    pins: Signal, Ground[2]
    
    layout:
        shape: Rectangle(2.5mm, 2.5mm, 1.2mm)
        pin_positions:
            Signal at [1.25mm, 1.25mm]
            Ground[0] at [0mm, 1.25mm]
            Ground[1] at [2.5mm, 1.25mm]
        pad_shapes:
            Signal: Circle(0.6mm)
            Ground[0]: Rectangle(1.0mm, 1.5mm)
            Ground[1]: Rectangle(1.0mm, 1.5mm)
    
    electrical:
        impedance: 50Ω
        frequency_range_max: 6GHz
        vswr_max: 1.5
        insertion_loss: -0.2  # dB at 3GHz
        voltage_rating: 100V
        current_rating: 0.5A
        contact_resistance: 0.05Ω
        operating_temp_min: -40°C
        operating_temp_max: +85°C
        mating_cycles: 30  # Limited durability (micro connector)
        test_positive_prefix: +100V  # Explicit positive prefix
        test_negative_prefix: -50V  # Explicit negative prefix


