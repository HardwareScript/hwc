component Transmission_Line_Microstrip_50ohm:
    metadata:
        manufacturer: "Custom PCB Design"
        part_number: "MICROSTRIP-50-FR4"
        package: "PCB Trace"
        transmission_line_type: "Microstrip"
        impedance_target: "50Ω"
        notes: "Testing: Transmission line parameters, field solver inputs 📏"
    
    pins: Port1, Port2, Ground
    
    layout:
        shape: Rectangle(20mm, 1mm, 0.035mm)  # Trace dimensions
        pin_positions:
            Port1 at [0mm, 0.5mm]
            Port2 at [20mm, 0.5mm]
            Ground at [10mm, 0mm]
        pad_shapes:
            Port1: Rectangle(1mm, 1mm)
            Port2: Rectangle(1mm, 1mm)
            Ground: Rectangle(20mm, 1mm)  # Ground plane
    
    electrical:
        characteristic_impedance: 50Ω
        trace_width: 1.9mm  # For 50Ω on FR4, h=1.6mm
        trace_length: 20mm
        substrate_height: 1.6mm
        substrate_er: 4.5  # FR4 dielectric constant
        loss_tangent: 0.02  # FR4 loss tangent
        copper_thickness: 35µm  # 1oz copper
        frequency_design: 2.45GHz
        propagation_delay: 6.7  # ns/m (nanoseconds per meter)
        velocity_factor: 0.45  # Relative to speed of light
        attenuation_1ghz: -0.05  # dB/cm
        attenuation_10ghz: -0.15  # dB/cm
        skin_depth_1ghz: 2.1µm
        skin_depth_10ghz: 0.66µm
        effective_er: 3.2  # Effective dielectric constant
        test_complex_unit_2: 8960kg/m³  # Density unit test


