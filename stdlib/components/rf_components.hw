            Power_Det: Rectangle(0.4mm, 0.4mm)
            Temp_Sense: Rectangle(0.4mm, 0.4mm)
    
    electrical:
        frequency_min: 4.9GHz
        frequency_max: 5.9GHz
        gain: 28  # dB
        output_power_max: +23  # dBm (200mW)
