        operating_temp_max: +95°C
        thermal_resistance: 15  # °C/W (junction to ambient)
        esd_protection: 2000V  # Human Body Model
        test_zero: 0Ω  # Zero value test
        test_tiny: 0.000000001A  # Picoamp range


