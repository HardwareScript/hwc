## RF BALUNS - Impedance Transformers
## ============================================================================

component Balun_2.4GHz_50to100:
    metadata:
        manufacturer: "Johanson Technology"
        part_number: "0900BM15A0001"
        package: "0805"
        balun_type: "Impedance Transformer"
        impedance_ratio: "50Ω to 100Ω differential"
        notes: "Testing: Differential signals, impedance transformation, unicode ⚖️"
    
    pins:
        Unbalanced
        Balanced_P
        Balanced_N
        Ground
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 0.6mm)
        pin_positions:
            Unbalanced at [0mm, 0.625mm]
            Balanced_P at [2.0mm, 0.3mm]
            Balanced_N at [2.0mm, 0.95mm]
            Ground at [1.0mm, 0mm]
        pad_shapes:
            Unbalanced: Rectangle(0.7mm, 0.9mm)
            Balanced_P: Rectangle(0.7mm, 0.5mm)
            Balanced_N: Rectangle(0.7mm, 0.5mm)
            Ground: Rectangle(0.8mm, 0.6mm)
    
    electrical:
        frequency_min: 2.4GHz
        frequency_max: 2.5GHz
        impedance_unbalanced: 50Ω
        impedance_balanced: 100Ω  # Differential
        impedance_ratio: 2.0  # 1:2 transformer
        insertion_loss: -0.8  # dB
        return_loss_unbalanced: -15  # dB
        return_loss_balanced: -15  # dB
        amplitude_balance: 0.5  # dB (P vs N)
        phase_balance: 5  # degrees (P vs N)
        common_mode_rejection: -25  # dB
        power_handling: 0.5W
        operating_temp_min: -40°C
        operating_temp_max: +125°C
        test_keyword_as_property: 50Ω  # Using 'tolerance' as property name
        tolerance: 10%  # Keyword as property name test


