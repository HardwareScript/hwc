        test_circle: 0.8mm
        test_obround: 2mm
        test_rounded: 1.5mm
        test_polygon: 1mm

component RF_Test_Inline_Comments_Everywhere:
    metadata:  # Inline comment after colon
        manufacturer: "Test"  # Inline comment after value
        part_number: "COMMENT-TEST"  # Another comment
    
    pins: A, B, C  # Inline comment after pins
    
    layout:  # Comment after layout
        shape: Rectangle(2mm, 2mm, 1mm)  # Comment after shape
        pin_positions:  # Comment after pin_positions
            A at [0mm, 1mm]  # Comment after position
            B at [1mm, 1mm]  # Another position comment
            C at [2mm, 1mm]  # Yet another comment
        pad_shapes:  # Comment after pad_shapes
            A: Circle(0.5mm)  # Comment after pad shape
            B: Circle(0.5mm)  # Another pad comment
            C: Circle(0.5mm)  # Final pad comment
    
    electrical:  # Comment after electrical
        frequency: 2.45GHz  # Comment after frequency
        impedance: 50Ω  # Comment after impedance
        gain: 3.0  # Comment after gain


