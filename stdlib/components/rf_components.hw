component Amplifier_LNA_2.4GHz:
    metadata:
        manufacturer: "Skyworks"
        part_number: "SKY65111-348LF"
        package: "QFN-8"
        amplifier_type: "LNA (Low Noise Amplifier)"
        frequency_band: "2.4GHz"
        notes: "Testing: Complex RF parameters, S-parameters, noise figure 📡"
    
    pins:
        RF_In
        RF_Out
        VCC
        GND[3]
        Enable
        Bias
    
    layout:
        shape: Rectangle(2mm, 2mm, 0.75mm)
        pin_positions:
            RF_In at [0mm, 1mm]
            RF_Out at [2mm, 1mm]
            VCC at [1mm, 0mm]
            GND[0] at [0mm, 0mm]
            GND[1] at [2mm, 0mm]
            GND[2] at [1mm, 2mm]
            Enable at [0mm, 2mm]
            Bias at [2mm, 2mm]
        pad_shapes:
            RF_In: Rectangle(0.4mm, 0.6mm)
            RF_Out: Rectangle(0.4mm, 0.6mm)
            VCC: Rectangle(0.6mm, 0.6mm)
            GND[0]: Rectangle(0.6mm, 0.6mm)
            GND[1]: Rectangle(0.6mm, 0.6mm)
            GND[2]: Rectangle(0.6mm, 0.6mm)
            Enable: Rectangle(0.4mm, 0.4mm)
            Bias: Rectangle(0.4mm, 0.4mm)
    
    electrical:
        frequency_min: 2.4GHz
        frequency_max: 2.5GHz
        gain: 15.5  # dB
        gain_flatness: 0.5  # dB
        noise_figure: 1.2  # dB (critical LNA spec)
        input_p1db: -10  # dBm (1dB compression point)
        output_p1db: +5  # dBm
        iip3: +5  # dBm (third-order intercept)
        oip3: +20  # dBm
        input_impedance: 50Ω
        output_impedance: 50Ω
        vswr_input: 1.5
        vswr_output: 1.5
        supply_voltage: 3.3V
        supply_current: 12mA
        power_consumption: 39.6mW  # Calculated: 3.3V * 12mA
        enable_high: 2.0V
        enable_low: 0.8V
        operating_temp_min: -40°C
        operating_temp_max: +85°C
        test_complex_unit: 401W/(m·K)  # Complex unit test


component Amplifier_PA_5GHz_WiFi:
    metadata:
        manufacturer: "Qorvo"
        part_number: "QPF4528"
        package: "3x3mm QFN"
        amplifier_type: "PA (Power Amplifier)"
