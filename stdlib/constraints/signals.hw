## Standard Signal Group Constraints
##
## This library provides standard signal group definitions for high-speed interfaces.
## Signal groups define electrical constraints like impedance, length matching, and
## differential pair requirements for buses like DDR5, PCIe, USB, and more.
##
## STRESS TEST: Complex impedance constraints to test the EM Physics solver.
## The solver must calculate microstrip impedance based on trace width, substrate
## height, and dielectric constant to meet target impedance.

# DDR5 Memory Bus
# High-speed memory interface with strict timing requirements
# Requires matched lengths, controlled impedance, and proper termination
signal_group DDR5_Bus:
    type: bus
    target_impedance: 40
    differential_impedance: 80
    max_length_mismatch: 0.1mm
    max_length: 150mm
    min_spacing: 0.2mm
    max_vias: 2
    max_frequency: 6400

# DDR4 Memory Bus
# Previous generation memory interface
# Slightly relaxed constraints compared to DDR5
signal_group DDR4_Bus:
    type: bus
    target_impedance: 40
    differential_impedance: 80
    max_length_mismatch: 0.15mm
    max_length: 200mm
    min_spacing: 0.15mm
    max_vias: 3
    max_frequency: 3200

# PCIe Gen4 x16 Interface
# High-speed serial interface with differential pairs
# Requires tight impedance control and length matching
signal_group PCIe_Gen4:
    type: differential_pair
    differential_impedance: 85
    intra_pair_skew: 0.05
    inter_pair_skew: 0.5
    max_length: 300mm
    min_spacing: 0.3mm
    max_vias: 4
    max_frequency: 16000

# PCIe Gen3 x4 Interface
# Previous generation, more relaxed constraints
signal_group PCIe_Gen3:
    type: differential_pair
    differential_impedance: 85
    intra_pair_skew: 0.1
    inter_pair_skew: 1.0
    max_length: 400mm
    min_spacing: 0.25mm
    max_vias: 6
    max_frequency: 8000

# USB 3.2 Gen 2 Interface
# SuperSpeed USB with differential pairs
# 10 Gbps data rate
signal_group USB3_Gen2:
    type: differential_pair
    differential_impedance: 90
    usb2_differential_impedance: 90
    max_length_mismatch: 0.15mm
    max_length: 150mm
    min_spacing: 0.2mm
    max_vias: 2
    max_frequency: 5000

# USB 2.0 High-Speed Interface
# Legacy USB interface (480 Mbps)
signal_group USB2_HighSpeed:
    type: differential_pair
    differential_impedance: 90
    max_length_mismatch: 0.5mm
    max_length: 300mm
    min_spacing: 0.15mm
    max_vias: 4
    max_frequency: 480

# Ethernet 10GBASE-KR Interface
# 10 Gigabit Ethernet backplane
signal_group Ethernet_10G:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.05
    max_length: 500mm
    min_spacing: 0.3mm
    max_vias: 6
    max_frequency: 10312

# Gigabit Ethernet (1000BASE-T)
# Standard Ethernet with 4 differential pairs
signal_group Ethernet_1G:
    type: bus
    differential_impedance: 100
    max_length_mismatch: 1.0mm
    max_length: 1000mm
    min_spacing: 0.2mm
    max_vias: 8
    max_frequency: 125

# HDMI 2.1 Interface
# High-speed video interface with TMDS differential pairs
signal_group HDMI_2_1:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.1
    inter_pair_skew: 0.5
    max_length: 200mm
    min_spacing: 0.25mm
    max_vias: 3
    max_frequency: 12000

# DisplayPort 1.4 Interface
# High-speed video interface
signal_group DisplayPort_1_4:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.05
    inter_pair_skew: 0.3
    max_length: 250mm
    min_spacing: 0.3mm
    max_vias: 4
    max_frequency: 8100

# MIPI CSI-2 Camera Interface
# Mobile camera interface with differential pairs
signal_group MIPI_CSI2:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.05
    inter_pair_skew: 0.2
    max_length: 100mm
    min_spacing: 0.15mm
    max_vias: 2
    max_frequency: 2500

# MIPI DSI Display Interface
# Mobile display interface
signal_group MIPI_DSI:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.05
    inter_pair_skew: 0.2
    max_length: 100mm
    min_spacing: 0.15mm
    max_vias: 2
    max_frequency: 2500

# SATA 3.0 Interface
# Serial ATA storage interface (6 Gbps)
signal_group SATA_3_0:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.1
    max_length: 1000mm
    min_spacing: 0.25mm
    max_vias: 6
    max_frequency: 6000

# SAS 12G Interface
# Serial Attached SCSI (12 Gbps)
signal_group SAS_12G:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.05
    max_length: 800mm
    min_spacing: 0.3mm
    max_vias: 4
    max_frequency: 12000

# LVDS Interface
# Low-Voltage Differential Signaling
signal_group LVDS_Standard:
    type: differential_pair
    differential_impedance: 100
    intra_pair_skew: 0.1
    max_length: 500mm
    min_spacing: 0.2mm
    max_vias: 4
    max_frequency: 1000

# CAN Bus Interface
# Controller Area Network (automotive)
signal_group CAN_Bus:
    type: differential_pair
    differential_impedance: 120
    max_length_mismatch: 5.0mm
    max_length: 5000mm
    min_spacing: 0.3mm
    max_vias: 10
    max_frequency: 1

# RS-485 Interface
# Industrial differential signaling
signal_group RS485:
    type: differential_pair
    differential_impedance: 120
    max_length_mismatch: 10.0mm
    max_length: 10000mm
    min_spacing: 0.3mm
    max_vias: 20
    max_frequency: 10

# STRESS TEST: Extreme Impedance Constraint
# Forces the EM Physics solver to calculate precise microstrip geometry
# Target impedance of 90Ω requires specific trace width/height ratio
signal_group Extreme_Impedance_Test:
    type: differential_pair
    differential_impedance: 90
    impedance_tolerance: 0.5
    max_length_mismatch: 0.01mm
    max_length: 50mm
    min_spacing: 0.1mm
    max_vias: 1
    max_frequency: 20000

# STRESS TEST: Mixed Impedance Bus
# Tests solver with multiple impedance targets in same bus
signal_group Mixed_Impedance_Bus:
    type: bus
    target_impedance: 50
    data_differential_impedance: 85
    clock_differential_impedance: 100
    max_length_mismatch: 0.1mm
    min_spacing: 0.2mm
    max_frequency: 5000

# STRESS TEST: Ultra-High-Speed Interface
# Tests solver at extreme frequencies (50 GHz)
signal_group Ultra_High_Speed:
    type: differential_pair
    differential_impedance: 85
    impedance_tolerance: 0.1
    intra_pair_skew: 0.001
    max_length: 25mm
    min_spacing: 0.5mm
    max_vias: 0
    max_frequency: 50000

