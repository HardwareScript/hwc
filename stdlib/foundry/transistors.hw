## Standard Library: Foundry Primitives (v0.1.6)
## Defines the physical contracts for semiconductor devices
##
## Sprint 1.5: Device Contract Enforcement
## These device definitions specify:
## - Required terminals for each device type
## - Expected materials for each terminal
##
## The compiler uses these contracts to validate physical layouts:
## - NMOS source/drain must use Silicon_N (n-doped)
## - PMOS source/drain must use Silicon_P (p-doped)
## - Gates must use Polysilicon or Aluminum (metal gate)
## - Bulk connections enforce proper biasing
##
## Contract Validation:
## - LVS engine uses these contracts to validate physical geometry
## - Device extractor checks material constraints
## - Physics validator ensures bulk connections are correct

device NMOS:
    terminals: [gate, source, drain, bulk]
    materials:
        gate: [Polysilicon, Aluminum]
        source: Silicon_N
        drain: Silicon_N
        bulk: Silicon_P
    metrics:
        L: channel_length(from: source, to: drain, control: gate)
        W: channel_width(from: source, to: drain, control: gate)

device PMOS:
    terminals: [gate, source, drain, bulk]
    materials:
        gate: [Polysilicon, Aluminum]
        source: Silicon_P
        drain: Silicon_P
        bulk: Silicon_N
    metrics:
        L: channel_length(from: source, to: drain, control: gate)
        W: channel_width(from: source, to: drain, control: gate)

device Resistor:
    terminals: [A, B]
    materials:
        A: Polysilicon
        B: Polysilicon
    metrics:
        R: resistance(from: A, to: B)

device Capacitor:
    terminals: [top, bottom]
    materials:
        top: Aluminum
        bottom: Aluminum
    metrics:
        C: capacitance(plate_a: top, plate_b: bottom)
