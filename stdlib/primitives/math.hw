##[ Hardware Script Standard Library - Physical Constants
    
    This file defines fundamental physical constants for hardware design.
    These are empirical values measured from experiments, not mathematical derivations.
    
    Constants are parsed at compiler startup and replaced with their values during
    AST construction, enabling compile-time constant folding.
    
    v0.2.1: Trigonometric and mathematical functions are built-in.
    Mathematical constants like PI, E should be added as compiler built-ins in the future.
]##

## ============================================================================
## FUNDAMENTAL PHYSICAL CONSTANTS
## ============================================================================
## Universal constants for RF design, antenna calculations, and EM simulations.
## These are MEASURED values, not computed mathematical constants.

const SPEED_OF_LIGHT: 299792458              # m/s - Speed of light in vacuum (exact by definition)
const VACUUM_PERMITTIVITY: 8.854187817e-12   # F/m - ε₀ (epsilon naught)
const VACUUM_PERMEABILITY: 1.25663706212e-6  # H/m - μ₀ (mu naught)
const BOLTZMANN_CONSTANT: 1.380649e-23       # J/K - Boltzmann constant
const ELEMENTARY_CHARGE: 1.602176634e-19     # C - Elementary charge

## ============================================================================
## BUILT-IN FUNCTIONS (v0.2.1+)
## ============================================================================
## The compiler provides these functions natively in all expression contexts:
##
## TRIGONOMETRIC (input in radians):
##   sin(x), cos(x), tan(x)
##   asin(x), acos(x), atan(x), atan2(y, x)
##
## ANGLE CONVERSION:
##   radians(degrees) - Convert degrees to radians
##   degrees(radians) - Convert radians to degrees
##
## MATHEMATICAL:
##   sqrt(x), abs(x)
##   floor(x), ceil(x), round(x)
##   min(a, b), max(a, b)
##   pow(base, exponent) - or use ^ operator
##
## EXAMPLE: Circular placement with trigonometry
## ----------------------------------------------
## for i in 0..7:
##     let angle = radians(i * 45)  # 45° increments
##     add plane(Copper) named Pad_{i} on layer: metal1:
##         at: [
##             x: center_x + radius * cos(angle),
##             y: center_y + radius * sin(angle)
##         ]
##
## EXAMPLE: RF wavelength calculation
## -----------------------------------
## let wavelength = SPEED_OF_LIGHT / frequency_hz
##
## EXAMPLE: Capacitance from geometry
## -----------------------------------
## let capacitance = VACUUM_PERMITTIVITY * area / distance
##
## EXAMPLE: Thermal noise calculation
## -----------------------------------
## let noise_power = BOLTZMANN_CONSTANT * temperature * bandwidth
##
## ============================================================================

## ============================================================================
## FUTURE: MATHEMATICAL CONSTANTS
## ============================================================================
## Mathematical constants (PI, E, TAU, etc.) should be added as compiler
## built-ins rather than text-file constants. Users shouldn't need to type
## 3.14159265358979323846 when they mean PI.
##
## For now, if you need them, use literal values or define them in your code:
##   let pi = 3.14159265358979323846
##   let tau = 2 * pi
##
## ============================================================================
