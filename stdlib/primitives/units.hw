# @std/primitives/units.hw
# HardwareScript v0.3.0 Standard Library: Physical Units & Physical Constants

# Standard physical unit scale constants (picometers base for length, nanovolts for voltage)
export const PM: Measurement = 1pm
export const NM: Measurement = 1nm
export const UM: Measurement = 1um
export const MM: Measurement = 1mm
export const CM: Measurement = 1cm
export const M:  Measurement = 1m

export const NV: Measurement = 1nV
export const UV: Measurement = 1uV
export const MV: Measurement = 1mV
export const V:  Measurement = 1V
export const KV: Measurement = 1kV

export const PA: Measurement = 1pA
export const NA: Measurement = 1nA
export const UA: Measurement = 1uA
export const MA: Measurement = 1mA
export const A:  Measurement = 1A
