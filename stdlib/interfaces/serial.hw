# Hardware Script Standard Library - Serial Communication Interfaces
# Stress Test: Complex protocol bindings with multiple configurations
# Bridges logical protocol signals to physical controller pins

## Standard UART Binding (Generic MCU)
interface Standard_UART_Binding:
    target: Generic_MCU
    
    bindings:
        Primary_RX = Generic_MCU.UART_RX
        Primary_TX = Generic_MCU.UART_TX

## Standard SPI Binding (Generic MCU)
interface Standard_SPI_Binding:
    target: Generic_MCU
    
    protocols:
        SPI_Bus:
            MOSI: Generic_MCU.SPI_MOSI
            MISO: Generic_MCU.SPI_MISO
            SCK: Generic_MCU.SPI_SCK
            CS: Generic_MCU.SPI_SS

## Standard I2C Binding (Generic MCU)
interface Standard_I2C_Binding:
    target: Generic_MCU
    
    protocols:
        I2C_Bus:
            SDA: Generic_MCU.I2C_SDA
            SCL: Generic_MCU.I2C_SCL
            speed: 100kHz

## Multi-Protocol Binding (Generic MCU with all serial interfaces)
interface Multi_Protocol_Binding:
    target: Generic_MCU
    
    bindings:
        UART_TX = Generic_MCU.GPIO1
        UART_RX = Generic_MCU.GPIO3
        SPI_CS = Generic_MCU.GPIO5
        I2C_INT = Generic_MCU.GPIO4
        CAN_TX = Generic_MCU.GPIO25
        CAN_RX = Generic_MCU.GPIO26
    
    protocols:
        UART:
            TX: Generic_MCU.GPIO1
            RX: Generic_MCU.GPIO3
            speed: 115200Hz
        
        SPI:
            MOSI: Generic_MCU.GPIO23
            MISO: Generic_MCU.GPIO19
            SCK: Generic_MCU.GPIO18
            CS: Generic_MCU.GPIO5
        
        I2C:
            SDA: Generic_MCU.GPIO21
            SCL: Generic_MCU.GPIO22
            speed: 400kHz

## Quad SPI Binding (High-speed flash memory interface)
interface QSPI_Flash_Binding:
    target: Generic_MCU
    
    protocols:
        QSPI:
            IO0: Generic_MCU.QSPI_IO0
            IO1: Generic_MCU.QSPI_IO1
            IO2: Generic_MCU.QSPI_IO2
            IO3: Generic_MCU.QSPI_IO3
            SCK: Generic_MCU.QSPI_SCK
            CS: Generic_MCU.QSPI_CS
            speed: 133MHz

## CAN Bus Binding (Automotive/Industrial)
interface CAN_Bus_Binding:
    target: Generic_MCU
    
    bindings:
        CAN_TX = Generic_MCU.CAN_TX
        CAN_RX = Generic_MCU.CAN_RX
        CAN_STBY = Generic_MCU.GPIO_CAN_STBY
    
    protocols:
        CAN:
            TX: Generic_MCU.CAN_TX
            RX: Generic_MCU.CAN_RX
            speed: 500kHz

## RS485 Binding (Industrial serial)
interface RS485_Binding:
    target: Generic_MCU
    
    bindings:
        RS485_TX = Generic_MCU.UART_TX
        RS485_RX = Generic_MCU.UART_RX
        RS485_DE = Generic_MCU.GPIO_DE
        RS485_RE = Generic_MCU.GPIO_RE
    
    protocols:
        RS485:
            TX: Generic_MCU.UART_TX
            RX: Generic_MCU.UART_RX
            speed: 115200Hz

## 1-Wire Binding (Temperature sensors, etc.)
interface OneWire_Binding:
    target: Generic_MCU
    
    bindings:
        OneWire_DQ = Generic_MCU.GPIO_DQ
    
    protocols:
        OneWire:
            DQ: Generic_MCU.GPIO_DQ
            speed: 16kHz

## LIN Bus Binding (Automotive low-speed)
interface LIN_Bus_Binding:
    target: Generic_MCU
    
    bindings:
        LIN_TX = Generic_MCU.UART_TX
        LIN_RX = Generic_MCU.UART_RX
        LIN_SLEEP = Generic_MCU.GPIO_LIN_SLEEP
    
    protocols:
        LIN:
            TX: Generic_MCU.UART_TX
            RX: Generic_MCU.UART_RX
            speed: 19200Hz

## Multi-UART Binding (4 UART channels)
interface Multi_UART_Binding:
    target: Generic_MCU
    
    protocols:
        UART0:
            TX: Generic_MCU.UART0_TX
            RX: Generic_MCU.UART0_RX
            speed: 115200Hz
        
        UART1:
            TX: Generic_MCU.UART1_TX
            RX: Generic_MCU.UART1_RX
            speed: 115200Hz
        
        UART2:
            TX: Generic_MCU.UART2_TX
            RX: Generic_MCU.UART2_RX
            speed: 9600Hz
        
        UART3:
            TX: Generic_MCU.UART3_TX
            RX: Generic_MCU.UART3_RX
            speed: 9600Hz

## Multi-SPI Binding (3 SPI buses with multiple CS lines)
interface Multi_SPI_Binding:
    target: Generic_MCU
    
    bindings:
        SPI0_CS0 = Generic_MCU.GPIO_SPI0_CS0
        SPI0_CS1 = Generic_MCU.GPIO_SPI0_CS1
        SPI0_CS2 = Generic_MCU.GPIO_SPI0_CS2
        SPI1_CS0 = Generic_MCU.GPIO_SPI1_CS0
        SPI2_CS0 = Generic_MCU.GPIO_SPI2_CS0
    
    protocols:
        SPI0:
            MOSI: Generic_MCU.SPI0_MOSI
            MISO: Generic_MCU.SPI0_MISO
            SCK: Generic_MCU.SPI0_SCK
            CS: Generic_MCU.GPIO_SPI0_CS0
            speed: 10MHz
        
        SPI1:
            MOSI: Generic_MCU.SPI1_MOSI
            MISO: Generic_MCU.SPI1_MISO
            SCK: Generic_MCU.SPI1_SCK
            CS: Generic_MCU.GPIO_SPI1_CS0
            speed: 5MHz
        
        SPI2:
            MOSI: Generic_MCU.SPI2_MOSI
            MISO: Generic_MCU.SPI2_MISO
            SCK: Generic_MCU.SPI2_SCK
            CS: Generic_MCU.GPIO_SPI2_CS0
            speed: 1MHz

## Multi-I2C Binding (3 I2C buses)
interface Multi_I2C_Binding:
    target: Generic_MCU
    
    protocols:
        I2C0:
            SDA: Generic_MCU.I2C0_SDA
            SCL: Generic_MCU.I2C0_SCL
            speed: 100kHz
        
        I2C1:
            SDA: Generic_MCU.I2C1_SDA
            SCL: Generic_MCU.I2C1_SCL
            speed: 400kHz
        
        I2C2:
            SDA: Generic_MCU.I2C2_SDA
            SCL: Generic_MCU.I2C2_SCL
            speed: 1MHz
