        USART1:
            TX: STM32F407VGT6.PA9
            RX: STM32F407VGT6.PA10
            speed: 115200Hz
        
        USART2:
            TX: STM32F407VGT6.PA2
            RX: STM32F407VGT6.PA3
            speed: 115200Hz
        
        USART3:
            TX: STM32F407VGT6.PD8
            RX: STM32F407VGT6.PD9
            speed: 115200Hz
        
        UART4:
            TX: STM32F407VGT6.PC10
            RX: STM32F407VGT6.PC11
            speed: 115200Hz
        
        UART5:
            TX: STM32F407VGT6.PC12
            RX: STM32F407VGT6.PD2
            speed: 115200Hz
        
        USART6:
            TX: STM32F407VGT6.PC6
            RX: STM32F407VGT6.PC7
            speed: 115200Hz
