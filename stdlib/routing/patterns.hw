##[
    HWS Standard Library - v0.1.8-alpha
    Continuous Vector-First Routing Patterns

    Context-free templates for meanders and delay lines.
    No imports — expects the 'Measurement' type to be resolved
    by the compiling workspace.
]##

# Zigzag Pattern
# 90° orthogonal meander for length matching.
# Each step alternates perpendicular to the trace direction,
# creating a visible back-and-forth meander.
pattern Zigzag (gap: Measurement):
    strategy_goal = delay_line
    steps: [
        [length = gap, angle = 90],
        [length = gap, angle = 0],
        [length = gap, angle = -90],
        [length = gap, angle = 0]
    ]

# Trombone Pattern
# DDR5-style meander with gap and amplitude.
# Commonly used for high-speed memory interfaces.
pattern Trombone (gap: Measurement, amp: Measurement):
    strategy_goal = impedance_match
    steps: [
        [length = gap,       angle = 0],
        [length = amp,       angle = 90],
        [length = gap * 2,   angle = 0],
        [length = amp,       angle = -90],
        [length = gap,       angle = 0]
    ]

# Serpentine Pattern
# Wave pattern with wavelength and amplitude.
# Good for RF and high-speed differential pairs.
pattern Serpentine (wavelength: Measurement, amplitude: Measurement):
    strategy_goal = differential_skew
    steps: [
        [length = amplitude,      angle = 90],
        [length = wavelength / 2, angle = 0],
        [length = amplitude * 2,  angle = -90],
        [length = wavelength / 2, angle = 0],
        [length = amplitude,      angle = 90]
    ]

# Spiral Pattern
# Circular spiral pattern using polar coordinates.
# Each step rotates -45° creating an octagonal spiral.
pattern Spiral (gap: Measurement):
    strategy_goal = compact_length
    steps: [
        [length = gap * 3, angle = -45],
        [length = gap * 3, angle = -45],
        [length = gap * 3, angle = -45],
        [length = gap * 3, angle = -45],
        [length = gap * 3, angle = -45],
        [length = gap * 3, angle = -45],
        [length = gap * 3, angle = -45],
        [length = gap * 3, angle = -45]
    ]
