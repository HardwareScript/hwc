##[
    HWS Standard Library - v0.1.8-alpha
    High-Speed Signal Group Routing Strategies

    Context-free templates.
    No imports — expects 'Trombone', 'Serpentine', and 'Zigzag'
    to be resolved in the compiling workspace.
]##

# DDR5 Length Matching Strategy
strategy DDR5_Match:
    target = match_longest
    tolerance = 0.1mm
    pattern = Trombone(gap: 0.3mm, amp: 2.5mm)

# PCIe Gen4 Differential Pair Strategy
strategy PCIe_Gen4_Match:
    target = match_longest
    tolerance = 0.05mm
    pattern = Serpentine(wavelength: 2.0mm, amplitude: 1.0mm)

# USB 3.2 Differential Pair Strategy
strategy USB3_Differential:
    target = match_longest
    tolerance = 0.15mm
    pattern = Trombone(gap: 0.5mm, amp: 2.0mm)

# High-Speed Serial Match Shortest Strategy
strategy MatchShortest_Standard:
    target = match_shortest
    tolerance = 0.1mm
    pattern = Zigzag(gap: 0.5mm)

# Fixed Length Strategy
strategy FixedLength_50mm:
    target = 50.0mm
    tolerance = 0.1mm
    pattern = Serpentine(wavelength: 3.0mm, amplitude: 1.5mm)

# Extreme Tolerance Test Strategy
strategy Extreme_Precision:
    target = match_longest
    tolerance = 0.001mm
    pattern = Trombone(gap: 0.2mm, amp: 1.0mm)

# RF Time-of-Flight (TOF) Matched Strategy
strategy RF_Delay_Match:
    target = 150.0ps
    tolerance = 0.5ps
    pattern = Serpentine(wavelength: 1.0mm, amplitude: 0.5mm)
