# @std/pdk/sky130/stdcells.hw
# SkyWater SKY130 HD Standard Cell Layout Wrappers
# HardwareScript v0.3.1 Standard Library Reference

import * from @std/primitives/units
import * from @std/primitives/math

export struct InvPins {
    a: Point2D,
    y: Point2D,
    vdd: Point2D,
    vss: Point2D,
}

export struct InvCellInstance {
    cell_type: String,
    name: String,
    bbox: BoundingBox,
    sites: Int,
    pins: InvPins,
}

/// Inverter: sky130_fd_sc_hd__inv_1 (1 site = 0.46um x 2.72um)
export fn sky130_fd_sc_hd__inv_1(
    at: Point2D,
    name: String = "inv"
) -> InvCellInstance {
    let width = 0.46um
    let height = 2.72um
    let pins = InvPins {
        a: Point2D { x: at.x + 0.14um, y: at.y + 1.36um },
        y: Point2D { x: at.x + 0.32um, y: at.y + 1.36um },
        vdd: Point2D { x: at.x + width / 2.0, y: at.y + height },
        vss: Point2D { x: at.x + width / 2.0, y: at.y },
    }

    return InvCellInstance {
        cell_type: "sky130_fd_sc_hd__inv_1",
        name: name,
        bbox: BoundingBox { min_x: at.x, max_x: at.x + width, min_y: at.y, max_y: at.y + height },
        sites: 1,
        pins: pins,
    }
}

