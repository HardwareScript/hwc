# @std/pdk/sky130/ga_filler.hw
# SkyWater SKY130 HD Mask-Programmable Gate-Array (GA) Filler Cell
# HardwareScript v0.3.1 Standard Library Reference

import * from @std/primitives/units
import * from @std/primitives/math

export struct GaFillerPort {
    p_gate: Point2D,
    n_gate: Point2D,
    p_diff_a: Point2D,
    p_diff_b: Point2D,
    n_diff_a: Point2D,
    n_diff_b: Point2D,
}

export struct GaFillerInstance {
    name: String,
    bbox: BoundingBox,
    site_count: Int,
    ports: Array[GaFillerPort],
    is_committed: Bool,
}

/// Gate-Array Filler Cell PCell: sky130_fd_sc_hd__ga_fill
/// Pre-populates uncommitted PMOS and NMOS transistor diffusions and poly gates in Base Layers 1-20.
/// Terminals sit floating beneath Metal-1 until configured by post-mask ECO routing.
export fn sky130_fd_sc_hd__ga_fill(
    at: Point2D,
    sites: Int = 1,
    name: String = "ga_fill"
) -> GaFillerInstance {
    let site_w = 0.46um
    let site_h = 2.72um
    let total_w = site_w * sites

    let bbox = BoundingBox {
        min_x: at.x,
        max_x: at.x + total_w,
        min_y: at.y,
        max_y: at.y + site_h,
    }

    let mut ports = []

    # Populate uncommitted PMOS & NMOS transistor locations per site
    for s in 0..sites {
        let site_cx = at.x + site_w * s + (site_w / 2.0)
        
        # Base silicon uncommitted PMOS terminal coordinates (top half of standard cell)
        let p_gate_pos   = Point2D { x: site_cx, y: at.y + 1.95um }
        let p_diff_a_pos = Point2D { x: site_cx - 0.12um, y: at.y + 1.95um }
        let p_diff_b_pos = Point2D { x: site_cx + 0.12um, y: at.y + 1.95um }

        # Base silicon uncommitted NMOS terminal coordinates (bottom half of standard cell)
        let n_gate_pos   = Point2D { x: site_cx, y: at.y + 0.77um }
        let n_diff_a_pos = Point2D { x: site_cx - 0.12um, y: at.y + 0.77um }
        let n_diff_b_pos = Point2D { x: site_cx + 0.12um, y: at.y + 0.77um }

        ports.push(GaFillerPort {
            p_gate: p_gate_pos,
            n_gate: n_gate_pos,
            p_diff_a: p_diff_a_pos,
            p_diff_b: p_diff_b_pos,
            n_diff_a: n_diff_a_pos,
            n_diff_b: n_diff_b_pos,
        })
    }

    return GaFillerInstance {
        name: name,
        bbox: bbox,
        site_count: sites,
        ports: ports,
        is_committed: false,
    }
}
