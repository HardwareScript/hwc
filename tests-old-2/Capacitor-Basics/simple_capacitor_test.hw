# simple_capacitor_test.hw - SKY130 MIM Capacitor Test (100% Relational Layout)
# Device: sky130_fd_pr__cap_mim_m3_1 (Metal-Insulator-Metal Capacitor over Metal-3)
# 
# DESIGN PHILOSOPHY: Single Anchor Law
# - Bottom_Plate is the ONE AND ONLY absolute 'at:' anchor
# - 100% of geometry derives from Bottom_Plate using align: and anchor queries
# - Self-healing: Change cap_area or metal3_overhang → everything adjusts automatically
#
# PHYSICS: C = C_area × A + C_perimeter × P
# - Area (A): 10μm × 10μm = 100μm² (overlap between metal3 bottom plate and CAPM top plate)
# - Perimeter (P): 2 × (10μm + 10μm) = 40μm
# - C_area: 2.0 fF/μm² (SKY130 spec)
# - C_perimeter: 0.19 fF/μm (edge/fringe capacitance)
# 
# Expected capacitance:
# C = (2.0 fF/μm² × 100μm²) + (0.19 fF/μm × 40μm)
# C = 200 fF + 7.6 fF = 207.6 fF
#
# SKY130 MIM CAPACITOR STRUCTURE (CAPM over Metal-3):
# - Bottom plate: metal3 layer (Aluminum, 845nm thick)
# - Dielectric: Ultra-thin oxide (~5nm equivalent)
# - Top plate: CAPM layer (special capacitor metal, 100nm thick, 5.8 Ω/□)
# - Top plate requires metal4 routing for external connection
#
# Reference: https://skywater-pdk.readthedocs.io/en/main/rules/device-details.html#mim-capacitors

import * from @std/primitives/units
import * from "./capacitor_pdk"

module SimpleCapacitor:
    pins: [input In, output Out]
    route In to Out

space Simple_Capacitor_Space implements SimpleCapacitor:
    dimensions: 30.0um by 20.0um
    profile: Capacitor_MIM

    nets:
        In:  { classification: signal, potential: 1.8V, current: 1.0nA }
        Out: { classification: signal, potential: 0.0V, current: 1.0nA }

    # ========================================================================
    # PARAMETRIC MIM CAPACITOR GEOMETRY (Self-Healing Layout)
    # ========================================================================
    
    let cap_area = 10.0um              # Target capacitor overlap area (10μm × 10μm)
    let metal3_overhang = 500nm        # Bottom plate extends beyond top plate (DRC requirement)
    let metal3_size = cap_area + (2 * metal3_overhang)  # 11μm total
    let capm_size = cap_area           # 10μm (sits inside metal3)
    let capacitor_center_x = 15.0um    # Center X position
    let capacitor_center_y = 10.0um    # Center Y position
    let contact_size = 400nm           # Contact pad size
    let via_diameter = 170nm           # Via diameter (SKY130 minimum)
    let pad_spacing = 4.0um            # Distance from capacitor to external pads
    let pad_size = 2.0um               # External test pad size

    # ========================================================================
    # 1. THE ONLY ABSOLUTE ANCHOR: Bottom Plate (Metal-3)
    # All other geometry derives from this single root anchor
    # Bottom plate extends beyond CAPM on all sides (DRC requirement)
    # ========================================================================
    add pour(Aluminum) named Bottom_Plate on layer: metal3:
        device: C1.c1
        net: Out
        dimensions: metal3_size by metal3_size
        at: [x: capacitor_center_x, y: capacitor_center_y]    # ← The ONE AND ONLY 'at:' in the file!

    # ========================================================================
    # 2. RELATIONAL TOP PLATE (CAPM) - Centered on Bottom Plate
    # CAPM top plate sits centered on metal3 with overhang clearance
    # Forms the dielectric sandwich: Metal-3 → Oxide → CAPM
    # ========================================================================
    add pour(CAPM) named Top_Plate on layer: capm:
        device: C1.c0
        net: In
        dimensions: capm_size by capm_size
        align: center_x with Bottom_Plate
        align: center_y with Bottom_Plate

    # ========================================================================
    # 3. RELATIONAL BULK/SUBSTRATE TERMINAL (Virtual Terminal → GND)
    # The bulk terminal must be tied to GND for proper substrate coupling
    # This is a virtual terminal that doesn't correspond to physical MIM geometry
    # but is required by the PDK model for substrate effects
    # Positioned in corner, away from capacitor structure, using relational placement
    # ========================================================================
    add pour(Aluminum) named Bulk_Tie on layer: metal1:
        device: C1.b
        net: GND
        dimensions: 1.0um by 1.0um
        align: left with Bottom_Plate.left - 10.0um
        align: bottom with Bottom_Plate.bottom - 6.0um

    # ========================================================================
    # 4. RELATIONAL TERMINAL CONTACTS
    # Bottom plate (metal3) and top plate (CAPM) provide direct connectivity
    # No separate contact heads needed - routing connects directly to plates
    # ========================================================================
    
    # 4a. BOTTOM PLATE CONTACT (TERMINAL c1 → NET Out)
    # Bottom plate itself provides metal3 connectivity
    # External routing can connect directly to Bottom_Plate pour
    
    # 4b. TOP PLATE CONTACT (TERMINAL c0 → NET In)
    # Top plate itself provides CAPM connectivity
    # Metal4 routing pad positioned at edge to minimize routing over MIM dielectric
    
    # ========================================================================
    # 5. RELATIONAL METAL4 PAD FOR TOP PLATE ROUTING
    # CAPM top plate connects to metal4 for external routing
    # Pulled well back from edge to satisfy SkyWater capm.5 rule (>= 500nm enclosure)
    # Via PAD must be fully enclosed by CAPM with 500nm margin
    # Contact pad: 400nm → radius 200nm
    # Required clearance: pad_radius (200nm) + enclosure (500nm) = 700nm minimum
    # Using 1.5um pullback for safe margin
    # ========================================================================
    let via_edge_pullback = 1.5um      # Conservative clearance from CAPM edge
    
    add pour(Aluminum) named Top_Contact_Metal4 on layer: metal4:
        net: In
        dimensions: contact_size by contact_size
        align: center_x with Top_Plate.right - via_edge_pullback
        align: center_y with Top_Plate

    # ========================================================================
    # 6. RELATIONAL VIA BRIDGING CAPM → METAL4 (Top plate connection)
    # Via connects Top_Plate directly to Metal4 routing pad
    # ========================================================================
    add contact(Tungsten) named Via_Top_CAPM spanning layer: capm to metal4:
        diameter: via_diameter
        align: center_x with Top_Contact_Metal4
        align: center_y with Top_Contact_Metal4
        net: In

    # ========================================================================
    # 7. RELATIONAL EXTERNAL TEST PADS
    # Positioned relative to capacitor plates with parametric spacing
    # ========================================================================
    
    # 7a. Output pad - connects to bottom plate (metal3), positioned to the left
    add pour(Aluminum) named Out_Pad on layer: metal3:
        net: Out
        dimensions: pad_size by pad_size
        align: center_x with Bottom_Plate.left - pad_spacing
        align: center_y with Bottom_Plate

    # 7b. Input pad - connects to top plate via metal4, positioned to the right
    add pour(Aluminum) named In_Pad on layer: metal4:
        net: In
        dimensions: pad_size by pad_size
        align: center_x with Bottom_Plate.right + pad_spacing
        align: center_y with Bottom_Plate

    # ========================================================================
    # 8. RELATIONAL ROUTING FROM CONTACT PADS TO EXTERNAL TEST PADS
    # ========================================================================
    
    # 8a. METAL3 ROUTING: Out pad → Bottom plate (direct connection)
    route Out_Pad to Bottom_Plate:
        layer: metal3
        net: Out
        width: 300nm
        intent: Signal

    # 8b. METAL4 ROUTING: Top plate contact → In pad
    route Top_Contact_Metal4 to In_Pad:
        layer: metal4
        net: In
        width: 300nm
        intent: Signal

# ========================================================================
# TEST DEFINITION: FULL CHARACTERIZATION (Scenario A - Recommended)
# ========================================================================
# v0.2.1 Zero-Fallback Compliance: Explicit testbench configuration.
# This test requests BOTH AC and transient analysis for complete characterization.
# 
# AC analysis proves:
#   - Extracted capacitance C across frequency (C = 1/(2πf|Z|))
#   - Equivalent Series Resistance (ESR) and Quality Factor (Q)
#   - Self-Resonant Frequency (SRF) from parasitic inductance
# 
# Transient analysis proves:
#   - RC time constants (τ = RC)
#   - Charging/discharging voltage slopes and slew rates
#   - Voltage ripple on power supply rails during switching
# 
# Outputs: circuit.sp, dc.sp, ac.sp, tran.sp (4 files)
test Simple_Capacitor_AC_Test for Simple_Capacitor_Space:
    ac: { sweep: dec, points: 20, freq: 100Hz..100MHz }
    tran: { step: 10ps, stop: 200ns }
