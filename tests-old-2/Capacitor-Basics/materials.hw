# materials.hw - SKY130 Material Definitions
import * from @std/primitives/units

export material Aluminum:
    category: conductor
    symbol: Al
    process: deposited
    properties:
        color: "#C0C0C0"
        metallic: 0.8
        roughness: 0.2
        resistivity: 2.82e-8ohm_m
        thermal_conductivity: 237.0W_mK
        max_current_density: 1e3A_mm2
        min_area: 0.14um2  # SKY130 m1.2/m3.2: Minimum metal area to prevent peeling in CMP

export material Tungsten:
    category: conductor
    symbol: W
    process: deposited
    properties:
        color: "#8080FF"
        metallic: 0.7
        roughness: 0.3
        resistivity: 5.6e-8ohm_m
        thermal_conductivity: 173.0W_mK
        max_current_density: 1e4A_mm2
        contact_resistance: 1e-8ohm_cm2  # SKY130: ~5-10Ω per mcon, ~10-30Ω per licon (single via)

export material Titanium_Silicide:
    category: conductor
    symbol: TiSi2
    process: deposited
    properties:
        color: "#404040"
        resistivity: 1.5e-7ohm_m
        thermal_conductivity: 30.0W_mK
        max_current_density: 5e3A_mm2

export material Silicon_Dioxide:
    category: insulator
    symbol: SiO2
    properties:
        color: "#E0E8FF"
        opacity: 0.05
        relative_permittivity: 3.9

export material Air:
    category: insulator
    symbol: Air
    properties:
        relative_permittivity: 1.0

# CAPM Material (MIM Capacitor Top Plate)
# SKY130 dedicated capacitor metal layer over Metal-3
# Sheet resistance: 5.8 Ω/□
export material CAPM:
    category: conductor
    symbol: CAPM
    process: deposited
    properties:
        color: "#FFD700"
        metallic: 0.85
        roughness: 0.15
        resistivity: 5.8e-7ohm_m
        thermal_conductivity: 200.0W_mK
        max_current_density: 8e2A_mm2
