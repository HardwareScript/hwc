# simple_diode_test.hw
# Basic test: P-N Junction Diode on Silicon
# Anode (Silicon_P) touching Cathode (Silicon_N)
#
# Physics: Forward voltage drop V_F = 0.45V to 0.6V
# Reverse voltage blocking V_RRM = 20V to 40V
# Junction capacitance C_J ≈ 55pF (parasitic)
# Matches Multicomp 1N5817/1N5818/1N5819 Schottky diode behavior
#
# ARCHITECTURAL BOUNDARY:
# - Compiler: Extracts W, L, terminal connectivity from layout geometry
# - PDK (diode_pdk.hw): Declares IS, N, RS, BV (cannot be calculated from geometry)
# - Simulator: Solves I-V curves using Shockley equation

import * from @std/primitives/units
import * from "./diode_pdk"  # Imports DMOD spice_model from PDK

# ========================================================================
# DEVICE CONTRACT: Topology + SPICE Formatting
# ========================================================================
# The device contract tells the compiler:
# 1. What terminals exist (Anode, Cathode)
# 2. What materials are allowed (Silicon_P, Silicon_N)
# 3. How to format the SPICE card (prefix D, terminal order, no calculated params)
# 4. Which model card to reference (DMOD - imported from PDK above)

device Diode:
    terminals: [Anode, Cathode]
    materials:
        Anode: Silicon_P
        Cathode: Silicon_N
    spice:
        prefix: D
        terminal_order: [Anode, Cathode]
        parameters: []              # No geometry-derived parameters
        model: DMOD                 # References spice_model DMOD from diode_pdk.hw
        parameter_style: positional

# ========================================================================
# MODULE & SPACE: Physical Layout
# ========================================================================

module SimpleDiode:
    pins: [input Anode_In, output Cathode_Out]
    route Anode_In to Cathode_Out

space Simple_Diode_Space implements SimpleDiode:
    dimensions: 6.0um by 3.0um by 100nm
    resolution: 10nm
    origin: bl by b
    profile: Diode_Flattened

    nets:
        Anode_In:    { classification: signal, potential: 1.8V, current: 1.0uA }
        Cathode_Out: { classification: signal, potential: 0.0V, current: 1.0uA }

    # ========================================================================
    # P-N JUNCTION - Silicon_P (Anode) touching Silicon_N (Cathode)
    # ========================================================================
    # Anode Region (Silicon_P)
    add pour(Silicon_P) named Anode_Region on layer: active:
        device: D1.Anode
        dimensions: 1.0um by 1.0um
        at: [x: 2.0um, y: 1.5um]

    # Cathode Region (Silicon_N) - Placed directly adjacent to Anode
    add pour(Silicon_N) named Cathode_Region on layer: active:
        device: D1.Cathode
        dimensions: 1.0um by 1.0um
        at: [x: 3.0um, y: 1.5um]

    # ========================================================================
    # METAL CONTACTS & VIAS
    # ========================================================================
    add pour(Aluminum) named Contact_Anode on layer: metal1:
        net: Anode_In
        dimensions: 400nm by 400nm
        at: [x: 2.0um, y: 1.5um]

    add pour(Aluminum) named Contact_Cathode on layer: metal1:
        net: Cathode_Out
        dimensions: 400nm by 400nm
        at: [x: 3.0um, y: 1.5um]

    add contact(Titanium_Silicide) named Via_Anode spanning layer: active to metal1:
        net: Anode_In
        diameter: 200nm
        align: center with Contact_Anode

    add contact(Titanium_Silicide) named Via_Cathode spanning layer: active to metal1:
        net: Cathode_Out
        diameter: 200nm
        align: center with Contact_Cathode

    # ========================================================================
    # EXTERNAL PADS & ROUTING
    # ========================================================================
    add pour(Aluminum) named Anode_Pad on layer: metal1:
        net: Anode_In
        dimensions: 600nm by 600nm
        at: [x: 600nm, y: 1.5um]

    add pour(Aluminum) named Cathode_Pad on layer: metal1:
        net: Cathode_Out
        dimensions: 600nm by 600nm
        at: [x: 4.4um, y: 1.5um]

    route Anode_Pad to Contact_Anode:
        net: Anode_In
        width: 500nm
        layer: metal1

    route Contact_Cathode to Cathode_Pad:
        net: Cathode_Out
        width: 500nm
        layer: metal1

# ========================================================================
# EXPECTED SPICE OUTPUT
# ========================================================================
# The compiler will generate:
#
# .model DMOD D (IS=1e-12 N=1.0 RS=0.1 BV=40.0 IBV=1e-10 CJO=5e-13 VJ=0.7 M=0.5)
# DD1 Anode_In Cathode_Out DMOD
#
# This can be simulated directly in:
# - LTSpice
# - ngspice  
# - Xyce
# - hsm (HardwareScript Monitor with ngspice.wasm)
