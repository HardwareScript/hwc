# test_crosstalk_violation.hw
# Parasitic Validation Test 3: Crosstalk / Signal Integrity Violation
# UPGRADED FOR SKYWATER SKY130 PDK COMPLIANCE
#
# PURPOSE: Verify that the compiler HALTS when coupling capacitance C_12
# between adjacent traces exceeds the max_crosstalk_db declared in routing intent
#
# SKY130 UPGRADES:
# 1. Replaced High-K dielectric (HfO2, εr=25) with Silicon Nitride (Si3N4, εr=7.0)
#    - SKY130 BEOL does NOT support high-k dielectrics
#    - Only SiO2 (εr=3.9) and Si3N4 (εr=7.0) passivation available
# 2. Uses minimum SKY130 metal spacing (140nm) to maximize lateral coupling
# 3. Models shielding effects from adjacent power rails (not yet implemented)
# 4. Accounts for fringe capacitance in multi-layer stackup
#
# EXPECTED BEHAVIOR:
# - Dielectric: Silicon Nitride (εr = 7.0) between metal layers
# - Two parallel traces running side-by-side with tight spacing (140nm)
# - Long parallel run (8μm) maximizes coupling length
# - Clock net with strict max_crosstalk_db: -40dB budget (from net_type Clock)
# - Sakurai microstrip equation calculates C_12 coupling capacitance
# - With εr = 7.0 (vs. 25.0 in old test), coupling is reduced
# - Adjust spacing to 140nm (SKY130 minimum) to compensate
#
# Coupling capacitance estimate:
#   C_12 ≈ ε0 × εr × (H/S) × L
#   where H = trace height (360nm), S = spacing (140nm), L = parallel length (8μm)
#   C_12 ≈ 8.85e-12 × 7.0 × (360e-9 / 140e-9) × 8e-6 ≈ 1.28 fF
#
# Crosstalk voltage coupling (capacitive divider):
#   V_victim / V_aggressor ≈ C_12 / (C_12 + C_gnd)
#   Assuming C_gnd ≈ 2 fF, coupling ≈ 1.28/(1.28+2) ≈ 39% ≈ -8dB
#
# VIOLATION: -8dB coupling exceeds -40dB budget → Compiler should HALT
#
# The compiler should report signal integrity budget violation and suggest
# increasing spacing, using different routing layers, or adding ground shields

import * from @std/primitives/units
import * from "./parasitic_pdk"

module CrosstalkTest:
    pins: [input Clock, input Data, output Clock_Out, output Data_Out]
    route Clock to Clock_Out
    route Data to Data_Out

space Crosstalk_Violation_Space implements CrosstalkTest:
    dimensions: 12.0um by 6.0um
    profile: Crosstalk_Test_Profile

    # Declare nets with strict crosstalk budget for clock
    nets:
        Clock:      { classification: signal, potential: 1.8V, current: 1uA }
        Clock_Out:  { classification: signal, potential: 0.0V, current: 1uA }
        Data:       { classification: signal, potential: 1.8V, current: 1uA }
        Data_Out:   { classification: signal, potential: 0.0V, current: 1uA }

    # ========================================================================
    # CLOCK NET - Sensitive to crosstalk
    # ========================================================================
    
    # Clock input pad - THE ONLY ABSOLUTE ANCHOR
    add pour(Aluminum_Met1) named Clock_In_Pad on layer: metal1:
        net: Clock
        dimensions: 800nm by 800nm
        at: [x: 1.0um, y: 4.0um]    # ← ONLY absolute 'at:' in this space

    # Clock output pad - RELATIONAL to Clock_In_Pad
    add pour(Aluminum_Met1) named Clock_Out_Pad on layer: metal1:
        net: Clock_Out
        dimensions: 800nm by 800nm
        align: center_x with Clock_In_Pad.right + 10.0um
        align: center_y with Clock_In_Pad

    # ========================================================================
    # DATA NET - Aggressor signal running parallel to clock
    # ========================================================================
    
    # Data input pad - RELATIONAL to Clock_In_Pad
    # Place pads far apart vertically to avoid overlap, but traces will route close
    add pour(Aluminum_Met1) named Data_In_Pad on layer: metal1:
        net: Data
        dimensions: 800nm by 800nm
        align: center_x with Clock_In_Pad
        align: center_y with Clock_In_Pad.center_y - 1.5um

    # Data output pad - RELATIONAL to Data_In_Pad
    add pour(Aluminum_Met1) named Data_Out_Pad on layer: metal1:
        net: Data_Out
        dimensions: 800nm by 800nm
        align: center_x with Clock_Out_Pad
        align: center_y with Data_In_Pad

    # ========================================================================
    # CRITICAL ROUTING - Parallel traces with SKY130 minimum spacing
    # ========================================================================
    # Strategy: Route traces with waypoints to force tight parallel run
    # The router will create a ~8μm parallel section with 140-200nm spacing
    # This tight coupling will violate the -40dB crosstalk budget
    
    # Clock trace - sensitive victim net with strict crosstalk budget
    route Clock_In_Pad to Clock_Out_Pad:
        net: Clock
        width: 200nm
        layer: metal1
        intent: Clock        # This intent has max_crosstalk_db: -40dB (from PDK)
        # Straight horizontal route at Y=4000nm

    # Data trace - aggressor net that will route parallel to clock
    route Data_In_Pad to Data_Out_Pad:
        net: Data
        width: 200nm
        layer: metal1
        intent: Signal
        # Router will route this parallel to Clock, creating tight coupling