# materials.hw
# Master Materials Database for the standard cell library

import * from @std/primitives/units
import * from @std/primitives/math

# ============================================================================
# PUBLIC SYMBOLS (Exported - available to importing files)
# ============================================================================

export material Air:
  category: insulator
  symbol: "Air"
  description: "Air or vacuum for empty space in 3D models"
  properties:
    color: "#E0E8FF"
    metallic: 0.0
    roughness: 1.0
    opacity: 0.0
    dielectric_strength: 3.0kV_mm
    relative_permittivity: 1.0
    thermal_conductivity: 0.026W_mK
    density: 1.2kg_m3

export material Silicon_P:
  category: semiconductor
  symbol: "Si_P"
  description: "Public P-type silicon substrate for NMOS bulk"
  properties:
    color: "#90A090"
    metallic: 0.1
    roughness: 0.7
    opacity: 1.0
    band_gap: 1.12eV
    electron_mobility: 1400.0cm2_Vs
    hole_mobility: 450.0cm2_Vs
    resistivity: 1.0ohm_m
    thermal_conductivity: 150.0W_mK
    density: 2330.0kg_m3

export material Silicon_N:
  category: semiconductor
  symbol: "Si_N"
  description: "Public N-type silicon substrate for PMOS bulk / N-well"
  properties:
    color: "#809080"
    metallic: 0.1
    roughness: 0.7
    opacity: 1.0
    band_gap: 1.12eV
    electron_mobility: 1400.0cm2_Vs
    hole_mobility: 450.0cm2_Vs
    resistivity: 0.5ohm_m
    thermal_conductivity: 150.0W_mK
    density: 2330.0kg_m3

export material Polysilicon:
  category: conductor
  symbol: "Poly"
  description: "Public polysilicon gate routing layer"
  properties:
    color: "#708090"
    metallic: 0.4
    roughness: 0.6
    opacity: 1.0
    resistivity: 1.0e-3ohm_m
    thermal_conductivity: 30.0W_mK
    density: 2330.0kg_m3
    max_current_density: 10.0A_mm2
    melting_point: 1414.0C

export material Aluminum:
  category: conductor
  symbol: "Al"
  description: "Public aluminum routing metal"
  properties:
    color: "#C0C0C0"
    metallic: 0.9
    roughness: 0.3
    opacity: 1.0
    resistivity: 2.82e-8ohm_m
    thermal_conductivity: 237.0W_mK
    density: 2700.0kg_m3
    max_current_density: 20.0A_mm2
    melting_point: 660.0C

export material SiO2:
  category: insulator
  symbol: "SiO2"
  description: "Public silicon dioxide interlayer dielectric"
  properties:
    color: "#F0F0F0"
    metallic: 0.0
    roughness: 0.4
    opacity: 0.9
    dielectric_strength: 10000.0kV_mm
    relative_permittivity: 3.9
    thermal_conductivity: 1.4W_mK
    density: 2200.0kg_m3

export material Titanium_Silicide:
  category: conductor
  symbol: "TiSi2"
  description: "Titanium silicide ohmic contact interface"
  properties:
    color: "#808080"
    metallic: 0.8
    roughness: 0.3
    opacity: 1.0
    resistivity: 1.5e-7ohm_m
    thermal_conductivity: 50.0W_mK
    density: 4300.0kg_m3
    max_current_density: 50.0A_mm2
    melting_point: 1500.0C

export material Tungsten:
  category: conductor
  symbol: "W"
  description: "Tungsten via fill material"
  properties:
    color: "#A0A0A0"
    metallic: 1.0
    roughness: 0.2
    opacity: 1.0
    resistivity: 5.6e-8ohm_m
    thermal_conductivity: 173.0W_mK
    density: 19250.0kg_m3
    max_current_density: 100.0A_mm2
    melting_point: 3422.0C

export material PublicCopper:
  category: conductor
  symbol: "Cu"
  description: "Public copper material"
  properties:
    color: "#B87333"
    metallic: 1.0
    roughness: 0.2
    opacity: 1.0
    resistivity: 1.68e-8ohm_m
    thermal_conductivity: 401.0W_mK
    density: 8960.0kg_m3
    max_current_density: 35.0A_mm2
    melting_point: 1085.0C

export shape PublicPad(w: Measurement, h: Measurement):
  geometry:
    Rectangle(width: w, height: h)

# ============================================================================
# PRIVATE SYMBOLS (Not exported - internal use only)
# ============================================================================

material _InternalCopper:
  category: conductor
  symbol: "Cu_Int"
  description: "Internal copper variant - DO NOT USE EXTERNALLY"
  properties:
    color: "#A86323"
    metallic: 1.0
    roughness: 0.15
    opacity: 1.0
    resistivity: 1.72e-8ohm_m
    thermal_conductivity: 395.0W_mK
    density: 8900.0kg_m3
    max_current_density: 30.0A_mm2
    melting_point: 1085.0C

shape _PrivatePad(w: Measurement, h: Measurement):
  geometry:
    Rectangle(width: w, height: h)
