# foundry_pdk.hw
import * from @std/primitives/units
import Silicon_P, Silicon_N, Polysilicon, Aluminum, SiO2 from materials
import Titanium_Silicide from stdlib/materials/bridges
import Tungsten from stdlib/materials/conductors

profile Silicon_180nm:
    technology: "ASIC"
    
    stackup:
        substrate:  [material: Silicon_P,   thickness: 100nm, routable: false]
        active:     [material: Silicon_N,   thickness: 200nm, routable: false]
        gate_oxide: [material: SiO2,        thickness: 10nm,  routable: false]
        poly:       [material: Polysilicon, thickness: 150nm, routable: local_only]
        d1:         [material: SiO2,        thickness: 500nm, routable: false]
        metal1:     [material: Aluminum,    thickness: 400nm, routable: true]

    # Explicitly declare physical transition bridges inside the PDK profile
    bridge Silicon_N to Aluminum:
        interface: Titanium_Silicide
        thickness: 50nm
        fill: Tungsten

    bridge Silicon_P to Aluminum:
        interface: Titanium_Silicide
        thickness: 50nm
        fill: Tungsten

    bridge Polysilicon to Aluminum:
        interface: Titanium_Silicide
        thickness: 50nm
        fill: Tungsten

    trace:
        min_width: 180nm
        min_spacing: 180nm
        edge_clearance: 50um          # Minimum clearance from die edge for wire-bonding and seal-ring

    via:
        min_diameter: 220nm
        min_enclosure: 100nm
        min_spacing: 300nm
        shape: cylinder
        default_via_fill: Tungsten

    manufacturing:
        copper_thickness: 400nm
        circle_segments: 64
        solder_mask_thickness: 0nm

    clearance:
        high_voltage: 500nm
        safety_factor: 2.0

    thermal:
        ambient_temp: 25C
        max_operating_temp: 125C
        max_temp_rise: 50C
        clustering_threshold: 10um

    layer:
        min_thickness: 100nm
        allowed_conductors: [Aluminum, Polysilicon, Silicon_N, Silicon_P]
        allowed_dielectrics: [SiO2]

    routing:
        max_local_route_length: 10um
        min_segment_length: 180nm
        escape_stub: 0nm              # v0.1.9: Global default - immediate turns allowed
        base_cost: 1
        via_penalty: 50
        direction_penalty: 10
        tight_clearance_penalty: 2
        crosstalk_penalty: 3
        impedance_penalty: 1
        reference_void_penalty: 5000000
        net_priority_VDD: 5
        net_priority_GND: 5

    # CIR Phase 2.2: User-declared net types (routing intents)
    net_type Clock:
        routing_style: straight
        escape_stub: 50um             # v0.1.9: Clock nets need long perpendicular escapes for signal integrity
        cost_weights:
            via_penalty: 50000
            direction_penalty: 5
            crosstalk_penalty: 100

    net_type PowerRail:
        routing_style: manhattan
        escape_stub: 0nm              # v0.1.9: Power rails can turn immediately (no impedance concerns)
        cost_weights:
            via_penalty: 10
            tight_clearance_penalty: 5

    net_type Signal:
        routing_style: auto
        escape_stub: 50um             # v0.1.10: Increased to accommodate 45° miter chamfers (1.5×30µm = 45µm)
