# Hardware Script Standard Profiles Library
# Version: 0.1.4
# Last Updated: March 20, 2026
#
# Fabrication constraint profiles based on industry standards
# All values use official SI notation (NIST/BIPM standards)

# ============================================================================
# HIGH-VOLTAGE PROFILE
# ============================================================================
# Based on IPC-2221 and IEC 60950 standards for high-voltage applications
# Suitable for power supplies, motor controllers, and industrial equipment
#
# SOURCES:
# - IPC-2221A Table 6-1: Conductor spacing for external conductors (uncoated)
#   Available: https://shop.ipc.org/ipc-2221 (paid standard)
# - IEC 60950-1: Safety of information technology equipment
#   Available: https://webstore.iec.ch/en/publication/4020 (paid standard)
# - Reference calculations from:
#   https://resources.altium.com/p/using-an-ipc-2221-calculator-for-high-voltage-design/
# - Clearance tables from:
#   https://www.allpcb.com/allelectrohub/high-voltage-pcb-design-mastering-pad-to-pad-spacing-for-safety-and-reliability
#
# KEY VALUES FROM IPC-2221:
# - 150V: ~0.8mm clearance (external conductors, uncoated)
# - 300V: ~2.5mm clearance (external conductors, uncoated)
# - 500V: ~2.5-3mm clearance (external conductors, uncoated)
# - 1000V: ~8mm clearance (external conductors, uncoated)
#
# SAFETY FACTORS:
# - 3.0× safety factor applied (higher than standard 2.0×)
# - Conservative values for worst-case environmental conditions
# - Suitable for industrial and safety-critical applications

profile HighVoltage:
    description: "IPC-2221 compliant constraints for high-voltage PCB designs (>150V)"
    
    trace:
        min_width: 254µm        # 10 mil (wider for current capacity)
        min_spacing: 508µm      # 20 mil (increased for safety)
    
    via:
        min_diameter: 508µm     # 20 mil (larger for reliability)
        min_annular_ring: 254µm # 10 mil (stronger mechanical connection)
    
    clearance:
        # Based on IPC-2221 Table 6-1 for external conductors (uncoated)
        high_voltage: 8.0mm     # For >150V (IPC-2221: ~8mm for 1000V)
        safety_factor: 3.0      # Higher safety factor for high-voltage
    
    layer:
        min_thickness: 70µm     # 2oz copper for better current capacity

# ============================================================================
# STANDARD PCB PROFILE
# ============================================================================
# Based on IPC-2221 Class 2 (General Industrial Electronics)
# Suitable for most consumer and industrial PCB applications

profile StandardPCB:
    description: "IPC-2221 Class 2 constraints for general PCB designs"
    
    trace:
        min_width: 100µm        # 4 mil (typical for modern PCB fab)
        min_spacing: 100µm      # 4 mil (typical for modern PCB fab)
    
    via:
        min_diameter: 300µm     # 12 mil (standard via size)
        min_annular_ring: 150µm # 6 mil (standard annular ring)
    
    clearance:
        high_voltage: 2.0mm     # For voltages up to 150V
        safety_factor: 2.0      # Standard safety factor
    
    layer:
        min_thickness: 35µm     # 1oz copper (standard)

# ============================================================================
# PROTOTYPE PROFILE
# ============================================================================
# Relaxed constraints for hobbyist/prototype PCB fabrication
# Compatible with most low-cost PCB manufacturers

profile Prototype:
    description: "Relaxed constraints for hobbyist and prototype PCBs"
    
    trace:
        min_width: 150µm        # 6 mil (easy to manufacture)
        min_spacing: 150µm      # 6 mil (easy to manufacture)
    
    via:
        min_diameter: 400µm     # 16 mil (larger for reliability)
        min_annular_ring: 200µm # 8 mil (larger for reliability)
    
    clearance:
        high_voltage: 1.0mm     # For low-voltage designs (<50V)
        safety_factor: 2.0      # Standard safety factor
    
    layer:
        min_thickness: 35µm     # 1oz copper (standard)

# ============================================================================
# NOTES
# ============================================================================
#
# Clearance Guidelines (IPC-2221):
# - <50V: 0.5mm minimum
# - 50-150V: 1.5mm minimum
# - 150-300V: 2.5mm minimum
# - 300-500V: 2.5-3mm minimum
# - >500V: Calculate based on IPC-2221 Table 6-1
#
# Altitude Effects (Paschen's Law):
# - Clearances increase significantly above 3050m altitude
# - Consider conformal coating to reduce clearance requirements
#
# Current Capacity (IPC-2221):
# - 1oz copper (35µm): ~1A per mm width (10°C rise, external)
# - 2oz copper (70µm): ~2A per mm width (10°C rise, external)
# - Internal traces: Reduce by ~50% due to reduced cooling
#
