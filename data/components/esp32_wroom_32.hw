# Espressif ESP32-WROOM-32 - WiFi + Bluetooth Module
# Real-world component from Espressif datasheet
# Package: SMD Module 18mm x 25.5mm x 3.1mm
# Features: WiFi 802.11 b/g/n, Bluetooth v4.2 BR/EDR and BLE
# Source: https://www.espressif.com/

component ESP32_WROOM_32:
    metadata:
        manufacturer: "Espressif Systems"
        part_number: "ESP32-WROOM-32"
        package: "SMD-38"
        value: "ESP32"
        description: "WiFi + Bluetooth Module, ESP32-D0WDQ6, 4MB Flash"
        datasheet: "https://www.espressif.com/sites/default/files/documentation/esp32-wroom-32_datasheet_en.pdf"
        category: "Integrated Circuits"
        subcategory: "Wireless Module"
        features: "WiFi, Bluetooth, 240MHz, 520KB RAM, 4MB Flash"
    
    pins:
        GND
        VDD
        EN
        GPIO0
        GPIO2
        GPIO4
        GPIO5
        TXD0
        RXD0
        GPIO12
        GPIO13
        GPIO14
        GPIO15
        GPIO21
        GPIO22
    
    layout:
        shape: Rectangle(18mm, 25.5mm, 3.1mm)
        pin_positions:
            GND at [0mm, 0mm]
            VDD at [0mm, 1.27mm]
            EN at [0mm, 2.54mm]
            GPIO0 at [0mm, 3.81mm]
            GPIO2 at [0mm, 5.08mm]
            GPIO4 at [0mm, 6.35mm]
            GPIO5 at [0mm, 7.62mm]
            TXD0 at [18mm, 0mm]
            RXD0 at [18mm, 1.27mm]
            GPIO12 at [18mm, 2.54mm]
            GPIO13 at [18mm, 3.81mm]
            GPIO14 at [18mm, 5.08mm]
            GPIO15 at [18mm, 6.35mm]
            GPIO21 at [18mm, 7.62mm]
            GPIO22 at [18mm, 8.89mm]
    
    electrical:
        supply_voltage: 3.3V
        supply_voltage_min: 3.0V
        supply_voltage_max: 3.6V
        active_current: 80mA
        modem_sleep_current: 20mA
        light_sleep_current: 0.8mA
        deep_sleep_current: 10µA
        max_current: 500mA
        max_voltage: 3.6V
        gpio_current_source: 40mA
        gpio_current_sink: 28mA
        operating_temp_min: -40°C
        operating_temp_max: 85°C
        wifi_tx_power: 20dBm
        bluetooth_tx_power: 12dBm
    
    render:
        type: asset
        asset: "assets/esp32_wroom_32.glb"
        fallback_color: "#2c3e50"
