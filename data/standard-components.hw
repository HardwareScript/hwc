# Hardware Script Standard Components Library
# Version: 0.1.4
# Last Updated: March 20, 2026
#
# Real-world components from manufacturer datasheets
# All dimensions and specifications verified against official datasheets

# ============================================================================
# CAPACITORS - 0805 PACKAGE
# ============================================================================

# Murata GRM21BR61C106KE15L - 10µF 0805 Ceramic Capacitor
# Source: https://www.murata.com/en-us/products/productdetail?partno=GRM21BR61C106KE15%23
# Package: 0805 (2012 Metric)
# Dielectric: X5R (±15% over -55°C to +85°C)
# Voltage Rating: 16V DC

component Capacitor_0805_10uF:
    metadata:
        manufacturer: "Murata"
        part_number: "GRM21BR61C106KE15L"
        package: "0805"
        value: "10µF"
        tolerance: "±10%"
        voltage_rating: "16V"
        dielectric: "X5R"
        description: "Multilayer Ceramic Capacitor, 0805, 10µF, 16V, X5R, ±10%"
        datasheet: "https://www.murata.com/en-us/products/productdetail?partno=GRM21BR61C106KE15%23"
        category: "Passive"
        subcategory: "Capacitor"
    
    pins:
        Pin1
        Pin2
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 1.25mm)
        pin_positions:
            Pin1 at [0, 0.625mm]      # Left terminal
            Pin2 at [2.0mm, 0.625mm]  # Right terminal
    
    electrical:
        capacitance: 10µF
        tolerance: 10%
        rated_voltage: 16V
        max_voltage: 16V
        dissipation_factor: 5%        # 5% max at 1kHz
        insulation_resistance: 10GΩ   # 10GΩ minimum
        operating_temp_min: -55°C
        operating_temp_max: 85°C
    
    render:
        type: procedural
        shape: smd_passive
        body_color: "#8b7355"         # Tan/brown ceramic
        endcap_color: "#c0c0c0"       # Silver terminals
        label: "106"                   # Capacitor code for 10µF

# ============================================================================
# RESISTORS - 0805 PACKAGE
# ============================================================================

# Yageo RC0805FR-0710KL - 10kΩ 0805 Thick Film Resistor
# Source: https://www.yageo.com/
# Package: 0805 (2012 Metric)
# Tolerance: ±1%
# Power Rating: 0.125W

component Resistor_0805_10K:
    metadata:
        manufacturer: "Yageo"
        part_number: "RC0805FR-0710KL"
        package: "0805"
        value: "10kΩ"
        tolerance: "±1%"
        power_rating: "0.125W"
        description: "Thick Film Resistor, 0805, 10kΩ, ±1%, 0.125W"
        category: "Passive"
        subcategory: "Resistor"
    
    pins:
        Pin1
        Pin2
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 0.5mm)
        pin_positions:
            Pin1 at [0, 0.625mm]
            Pin2 at [2.0mm, 0.625mm]
    
    electrical:
        resistance: 10kΩ
        tolerance: 1%
        max_power: 0.125W
        max_voltage: 150V
        operating_temp_min: -55°C
        operating_temp_max: 155°C
    
    render:
        type: procedural
        shape: smd_passive
        body_color: "#111111"         # Black body
        endcap_color: "#c0c0c0"       # Silver terminals
        label: "103"                   # Resistor code for 10kΩ

# ============================================================================
# LEDS - 0805 PACKAGE
# ============================================================================

# Generic 0805 Red LED
# Typical specifications for standard 0805 SMD LEDs
# Forward Voltage: 2.0V typical
# Forward Current: 20mA maximum

component LED_0805_Red:
    metadata:
        package: "0805"
        color: "Red"
        description: "Standard 0805 Red LED, 2.0V forward voltage"
        category: "Active"
        subcategory: "LED"
    
    pins:
        Anode
        Cathode
    
    layout:
        shape: Rectangle(2.0mm, 1.25mm, 0.8mm)
        pin_positions:
            Anode at [0, 0.625mm]     # Positive terminal
            Cathode at [2.0mm, 0.625mm] # Negative terminal
    
    electrical:
        forward_voltage: 2.0V
        max_forward_current: 20mA
        typical_forward_current: 10mA
        reverse_voltage: 5V
        operating_temp_min: -40°C
        operating_temp_max: 85°C
    
    render:
        type: procedural
        shape: smd_led
        body_color: "#ff0000"         # Red LED
        endcap_color: "#c0c0c0"       # Silver terminals
        emissive: true

# ============================================================================
# NOTES
# ============================================================================
#
# Component Naming Convention:
# - Type_Package_Value (e.g., Capacitor_0805_10uF)
# - Use standard package codes (0805, 0603, SOT-23, etc.)
# - Use SI prefixes for values (µF, kΩ, mH)
#
# Pin Naming:
# - Passive components: Pin1, Pin2 (polarity-agnostic)
# - Polarized components: Anode/Cathode, Plus/Minus
# - ICs: Use datasheet pin names (VCC, GND, IN, OUT, etc.)
#
# Layout Dimensions:
# - All dimensions from manufacturer datasheets
# - Pin positions relative to component origin (0,0)
# - Use metric units (mm preferred)
#
# Electrical Specifications:
# - All values from manufacturer datasheets
# - Include operating temperature ranges
# - Include maximum ratings for safety
#
