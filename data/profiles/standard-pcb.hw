# Standard PCB Fabrication Constraints
# Based on IPC-2221 standards for general PCB manufacturing
#
# SOURCES:
# - IPC-2221A: Generic Standard on Printed Board Design
#   Available: https://shop.ipc.org/ipc-2221 (paid standard)
# - Reference values from: https://www.protoexpress.com/blog/ipc-2221-circuit-board-design/
# - Trace width calculations: https://philipmcgaw.com/ipc-2221-standard-trace-widths/
#
# VALIDATION:
# Cross-referenced with multiple PCB manufacturers:
# - JLCPCB capabilities: https://jlcpcb.com/capabilities/pcb-capabilities
# - PCBWay capabilities: https://www.pcbway.com/capabilities.html
# - OSH Park capabilities: https://docs.oshpark.com/services/

profile StandardPCB:
    description: "IPC-2221 compliant constraints for standard PCB fabrication"
    
    trace:
        min_width: 152µm
        min_spacing: 152µm
    
    via:
        min_diameter: 305µm
        min_annular_ring: 127µm
    
    clearance:
        high_voltage: 2.0mm
        safety_factor: 2.0
    
    layer:
        min_thickness: 35µm
