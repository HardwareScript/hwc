# Standard 2-Layer PCB Stackup
# Industry-standard stackup for 2-layer FR4 boards
#
# SOURCES:
# - PCB Hero standard stackups: https://www.pcb-hero.com/blogs/lisas-column/standard-multi-layer-pcb-stack-ups-2-4-6-8-and-10
# - Altium PCB stackup guide: https://resources.altium.com/p/pcb-layer-stack
# - IPC-2221A: Generic Standard on Printed Board Design
#
# VALIDATION:
# Cross-referenced with:
# - JLCPCB standard 2-layer stackup
# - PCBWay standard 2-layer stackup
# - OSH Park 2-layer stackup

profile Standard2LayerStackup:
    description: "Industry-standard 2-layer FR4 PCB stackup (1.6mm total thickness)"
    
    trace:
        min_width: 152µm
        min_spacing: 152µm
    
    via:
        min_diameter: 305µm
        min_annular_ring: 127µm
    
    clearance:
        high_voltage: 2.0mm
        safety_factor: 2.0
    
    layer:
        min_thickness: 35µm
        max_count: 2
