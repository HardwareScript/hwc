# High-Voltage PCB Fabrication Constraints
# Based on IPC-2221 and IEC 60950 standards for high-voltage applications
# Suitable for power supplies, motor controllers, and industrial equipment
#
# SOURCES:
# - IPC-2221A Table 6-1: Conductor spacing for external conductors (uncoated)
#   Available: https://shop.ipc.org/ipc-2221 (paid standard)
# - IEC 60950-1: Safety of information technology equipment
#   Available: https://webstore.iec.ch/en/publication/4020 (paid standard)
# - Reference calculations from:
#   https://resources.altium.com/p/using-an-ipc-2221-calculator-for-high-voltage-design/
# - Clearance tables from:
#   https://www.allpcb.com/allelectrohub/high-voltage-pcb-design-mastering-pad-to-pad-spacing-for-safety-and-reliability
# - Stack Exchange engineering discussions:
#   https://electronics.stackexchange.com/questions/583301/minimum-pcb-trace-spacing-for-500-vdc
#
# METHODOLOGY:
# High-voltage clearances are based on dielectric breakdown voltage of air
# and substrate materials. IPC-2221 Table 6-1 provides minimum spacing
# based on voltage levels and environmental conditions.
#
# KEY VALUES FROM IPC-2221:
# - 150V: ~0.8mm clearance (external conductors, uncoated)
# - 300V: ~2.5mm clearance (external conductors, uncoated)
# - 500V: ~2.5-3mm clearance (external conductors, uncoated)
# - 1000V: ~8mm clearance (external conductors, uncoated)
#
# IMPORTANT NOTES:
# - Clearances increase significantly above 3050m altitude (Paschen's Law)
# - Conformal coating can reduce required clearances
# - Pollution degree affects creepage requirements (IEC 60950)
# - These values assume standard atmospheric conditions (sea level, 50% humidity)
#
# SAFETY FACTORS:
# - 3.0× safety factor applied (higher than standard 2.0×)
# - Conservative values for worst-case environmental conditions
# - Suitable for industrial and safety-critical applications
#
# VALIDATION:
# Cross-referenced with:
# - UL 60950-1 safety standard
# - IEC 61010-1 (measurement equipment)
# - Real-world high-voltage PCB designs from power supply manufacturers
#
# ADDITIONAL RESOURCES:
# - Paschen's Law and altitude effects:
#   https://electronics.stackexchange.com/questions/718732/why-does-ipc-2221-require-so-much-more-spacing-at-elevation
# - Creepage vs clearance explained:
#   https://www.analog.com/en/technical-articles/comparative-tracking-index-and-working-voltage.html
#
# Last verified: March 2026

name: "High Voltage"
description: "IPC-2221 compliant constraints for high-voltage PCB designs (>150V)"

trace:
  min_width_nm: 254000        # 10 mil = 254µm (wider for current capacity)
  max_width_nm: 0             # unlimited
  min_spacing_nm: 508000      # 20 mil = 508µm (increased for safety)
  default_width_nm: 508000    # 20 mil = 508µm

via:
  min_diameter_nm: 508000     # 20 mil = 508µm (larger for reliability)
  max_diameter_nm: 0          # unlimited
  min_annular_ring_nm: 254000 # 10 mil = 254µm (stronger mechanical connection)
  default_diameter_nm: 762000 # 30 mil = 762µm

clearance:
  # Based on IPC-2221 Table 6-1 for external conductors (uncoated)
  # Values include safety margins for standard atmospheric conditions
  low_voltage_nm: 500000      # 500µm for <50V (conservative baseline)
  medium_voltage_nm: 1500000  # 1.5mm for 50-150V (IPC-2221 guideline)
  high_voltage_nm: 8000000    # 8mm for >150V (IPC-2221: ~8mm for 1000V)
  safety_factor: 3.0          # Higher safety factor for high-voltage

layer:
  min_thickness_nm: 70000     # 70µm (2oz copper for better current capacity)
  max_thickness_nm: 0         # unlimited
  allowed_conductors:
    - copper
    - silver      # Better for high-current applications
  allowed_dielectrics:
    - fr4
    - polyimide   # Better thermal stability
    - air

# Additional notes:
# - For 300V: ~2.5mm clearance (IPC-2221)
# - For 500V: ~2.5-3mm clearance (IPC-2221)
# - For 1000V: ~8mm clearance (IPC-2221)
# - Clearances increase significantly above 3050m altitude (Paschen's Law)
# - Consider conformal coating to reduce clearance requirements
# - Follow IEC 60950-1 for safety-critical applications
