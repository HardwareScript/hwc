# Standard 2-Layer PCB Stackup
# Industry-standard stackup for 2-layer FR4 boards
#
# SOURCES:
# - PCB Hero standard stackups: https://www.pcb-hero.com/blogs/lisas-column/standard-multi-layer-pcb-stack-ups-2-4-6-8-and-10
# - Altium PCB stackup guide: https://resources.altium.com/p/pcb-layer-stack
# - IPC-2221A: Generic Standard on Printed Board Design
#
# METHODOLOGY:
# This stackup represents the most common 2-layer PCB construction used in the industry.
# Values are extracted from multiple PCB manufacturers' standard offerings.
#
# VALIDATION:
# Cross-referenced with:
# - JLCPCB standard 2-layer stackup
# - PCBWay standard 2-layer stackup
# - OSH Park 2-layer stackup
#
# Last verified: March 2026

name: "Standard 2-Layer Stackup"
description: "Industry-standard 2-layer FR4 PCB stackup (1.6mm total thickness)"

# Board specifications
board:
  total_thickness_nm: 1600000      # 1.6mm (0.062") ± 10%
  tolerance_percent: 10.0
  copper_weight_oz: 1              # 1oz copper (35µm)

# Layer stackup (top to bottom)
layers:
  - name: "Top"
    type: "signal"
    material: "copper"
    thickness_nm: 35000            # 1oz copper = 35µm (0.0014")
    
  - name: "Core"
    type: "dielectric"
    material: "fr4"
    thickness_nm: 1530000          # 1.53mm (0.057") FR4 core
    dielectric_constant: 4.2       # FR4 typical εr
    
  - name: "Bottom"
    type: "signal"
    material: "copper"
    thickness_nm: 35000            # 1oz copper = 35µm (0.0014")

# Impedance control parameters
impedance:
  # For microstrip (top layer trace over ground plane)
  microstrip_dielectric_height_nm: 1530000  # Distance to bottom ground plane
  
  # Typical controlled impedance values
  single_ended_50ohm_trace_width_nm: 3000000  # ~3mm for 50Ω (approximate)
  single_ended_75ohm_trace_width_nm: 1500000  # ~1.5mm for 75Ω (approximate)

# Manufacturing notes
notes:
  - "Standard 2-layer construction with FR4 core"
  - "Total thickness: 1.6mm ± 10%"
  - "Copper weight: 1oz (35µm) on both layers"
  - "Dielectric constant (εr): 4.2 typical for FR4"
  - "Suitable for general-purpose PCB designs"
  - "Not recommended for high-speed differential pairs (use 4-layer)"
