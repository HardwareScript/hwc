# Prototype/Hobbyist PCB Fabrication Constraints
# Relaxed constraints for rapid prototyping and hobbyist projects
# Suitable for hand-soldering and low-volume production
#
# SOURCES:
# - KiCad forum discussions on hobbyist design rules
#   https://forum.kicad.info/t/design-rules-for-hand-solderable-layout/61592
# - Adafruit PCB design tutorial for beginners
#   https://learn.adafruit.com/pcb-design-tutorial
# - SparkFun PCB design guidelines
#   https://www.sparkfun.com/tutorials/115
# - AllPCB beginner guidelines
#   https://www.allpcb.com/allelectrohub/minimum-trace-spacing-for-beginners-simple-rules-for-pcb-layout
#
# METHODOLOGY:
# These values are intentionally relaxed compared to IPC-2221 to provide:
# 1. Easier hand-soldering (wider traces and pads)
# 2. More forgiving alignment tolerances (larger annular rings)
# 3. Higher safety margins (increased clearances)
# 4. Better compatibility with home PCB fabrication methods
#
# RATIONALE:
# - 10 mil (254µm) minimum is achievable with most hobbyist methods
# - 20 mil (508µm) default provides comfortable hand-soldering
# - Larger vias are easier to drill manually
# - Conservative clearances prevent beginner mistakes
#
# VALIDATION:
# Tested against common hobbyist PCB manufacturers:
# - OSH Park (https://oshpark.com)
# - PCBWay economy service
# - JLCPCB standard service
#
# Last verified: March 2026

name: "Prototype"
description: "Relaxed constraints for hobbyist projects and rapid prototyping"

trace:
  min_width_nm: 254000        # 10 mil = 254µm (easier to hand-solder)
  max_width_nm: 0             # unlimited
  min_spacing_nm: 254000      # 10 mil = 254µm (safer for beginners)
  default_width_nm: 508000    # 20 mil = 508µm (generous default)

via:
  min_diameter_nm: 508000     # 20 mil = 508µm (easier to drill)
  max_diameter_nm: 0          # unlimited
  min_annular_ring_nm: 254000 # 10 mil = 254µm (forgiving for alignment)
  default_diameter_nm: 762000 # 30 mil = 762µm (large for hand-drilling)

clearance:
  low_voltage_nm: 300000      # 300µm for <50V (extra safety margin)
  medium_voltage_nm: 800000   # 800µm for 50-150V (conservative)
  high_voltage_nm: 3000000    # 3mm for >150V (very conservative)
  safety_factor: 2.5          # Higher safety factor for hobbyists

layer:
  min_thickness_nm: 35000     # 35µm (1oz copper - standard)
  max_thickness_nm: 0         # unlimited
  allowed_conductors:
    - copper
  allowed_dielectrics:
    - fr4
    - air
