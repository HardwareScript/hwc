# Standard 4-Layer PCB Stackup
# Industry-standard stackup for 4-layer FR4 boards with impedance control
#
# SOURCES:
# - PCB Hero standard stackups: https://www.pcb-hero.com/blogs/lisas-column/standard-multi-layer-pcb-stack-ups-2-4-6-8-and-10
# - Altium PCB stackup guide: https://resources.altium.com/p/pcb-layer-stack
# - IPC-2221A: Generic Standard on Printed Board Design
#
# METHODOLOGY:
# This stackup represents the most common 4-layer PCB construction with dedicated
# power and ground planes for improved signal integrity and impedance control.
#
# VALIDATION:
# Cross-referenced with:
# - JLCPCB standard 4-layer stackup
# - PCBWay standard 4-layer stackup
# - Industry-standard USB, Ethernet designs
#
# Last verified: March 2026

name: "Standard 4-Layer Stackup"
description: "Industry-standard 4-layer FR4 PCB stackup with power/ground planes (1.6mm total thickness)"

# Board specifications
board:
  total_thickness_nm: 1600000      # 1.6mm (0.062") ± 10%
  tolerance_percent: 10.0
  copper_weight_oz: 1              # 1oz copper (35µm)

# Layer stackup (top to bottom)
layers:
  - name: "Top"
    type: "signal"
    material: "copper"
    thickness_nm: 35000            # 1oz copper = 35µm (0.0014")
    
  - name: "Prepreg 1"
    type: "dielectric"
    material: "fr4"
    thickness_nm: 231000           # 0.231mm (0.0091") - 2116 prepreg (2 sheets)
    dielectric_constant: 4.2
    
  - name: "Inner 1 (Ground)"
    type: "plane"
    material: "copper"
    thickness_nm: 35000            # 1oz copper
    
  - name: "Core"
    type: "dielectric"
    material: "fr4"
    thickness_nm: 94000            # 0.094mm (0.0037") FR4 core
    dielectric_constant: 4.2
    
  - name: "Inner 2 (Power)"
    type: "plane"
    material: "copper"
    thickness_nm: 35000            # 1oz copper
    
  - name: "Prepreg 2"
    type: "dielectric"
    material: "fr4"
    thickness_nm: 231000           # 0.231mm (0.0091") - 2116 prepreg (2 sheets)
    dielectric_constant: 4.2
    
  - name: "Bottom"
    type: "signal"
    material: "copper"
    thickness_nm: 35000            # 1oz copper

# Impedance control parameters
impedance:
  # For microstrip (top layer trace over ground plane)
  microstrip_dielectric_height_nm: 231000  # Distance to ground plane (prepreg 1)
  
  # For stripline (inner traces between planes)
  stripline_dielectric_height_nm: 94000    # Core thickness
  
  # Typical controlled impedance values (based on standard geometry)
  single_ended_50ohm_trace_width_nm: 254000   # 0.254mm (10 mil) for 50Ω microstrip
  single_ended_75ohm_trace_width_nm: 152400   # 0.152mm (6 mil) for 75Ω microstrip
  differential_90ohm_trace_width_nm: 152400   # 0.152mm (6 mil) per trace
  differential_90ohm_spacing_nm: 152400       # 0.152mm (6 mil) spacing

# Manufacturing notes
notes:
  - "Standard 4-layer construction with dedicated power/ground planes"
  - "Total thickness: 1.6mm ± 10%"
  - "Copper weight: 1oz (35µm) on all layers"
  - "Dielectric constant (εr): 4.2 typical for FR4"
  - "Suitable for high-speed designs (USB, Ethernet, DDR)"
  - "Ground plane on Layer 2, Power plane on Layer 3"
  - "Microstrip impedance controlled on top/bottom layers"
