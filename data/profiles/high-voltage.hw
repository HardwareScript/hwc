# High-Voltage PCB Fabrication Constraints
# Based on IPC-2221 and IEC 60950 standards for high-voltage applications
# Suitable for power supplies, motor controllers, and industrial equipment
#
# SOURCES:
# - IPC-2221A Table 6-1: Conductor spacing for external conductors (uncoated)
#   Available: https://shop.ipc.org/ipc-2221 (paid standard)
# - IEC 60950-1: Safety of information technology equipment
#   Available: https://webstore.iec.ch/en/publication/4020 (paid standard)
# - Reference calculations from:
#   https://resources.altium.com/p/using-an-ipc-2221-calculator-for-high-voltage-design/
#
# KEY VALUES FROM IPC-2221:
# - 150V: ~0.8mm clearance (external conductors, uncoated)
# - 300V: ~2.5mm clearance (external conductors, uncoated)
# - 500V: ~2.5-3mm clearance (external conductors, uncoated)
# - 1000V: ~8mm clearance (external conductors, uncoated)

profile HighVoltage:
    description: "IPC-2221 compliant constraints for high-voltage PCB designs (>150V)"
    
    trace:
        min_width: 254µm
        min_spacing: 508µm
    
    via:
        min_diameter: 508µm
        min_annular_ring: 254µm
    
    clearance:
        high_voltage: 8.0mm
        safety_factor: 3.0
    
    layer:
        min_thickness: 70µm
