# Standard ASIC Fabrication Constraints
# Typical foundry design rules for silicon chip fabrication
#
# SOURCES:
# - FreePDK45: Open-source 45nm process design kit
#   Available: https://eda.ncsu.edu/freepdk/freepdk45/
# - Skywater 130nm PDK: Open-source process design kit
#   Available: https://github.com/google/skywater-pdk
# - Generic foundry rules from academic literature
#
# METHODOLOGY:
# These values represent typical constraints for modern CMOS processes.
# They are based on open-source PDKs (Process Design Kits) which are
# publicly available for research and education.
#
# NOTES:
# - Real foundry PDKs (TSMC, Intel, Samsung) are under NDA
# - These values are conservative estimates suitable for educational use
# - For production silicon, use manufacturer-specific PDK files
#
# VALIDATION:
# Cross-referenced with:
# - FreePDK45 design rules
# - Skywater 130nm design rules
# - Academic VLSI design textbooks
#
# Last verified: March 2026

name: "Standard ASIC"
description: "Typical foundry constraints for ASIC/IC fabrication"

trace:
  min_width_nm: 180           # 180nm minimum feature size
  max_width_nm: 0             # unlimited
  min_spacing_nm: 180         # 180nm minimum spacing
  default_width_nm: 500       # 500nm default

via:
  min_diameter_nm: 200        # 200nm minimum via
  max_diameter_nm: 0          # unlimited
  min_annular_ring_nm: 50     # 50nm annular ring
  default_diameter_nm: 300    # 300nm default

clearance:
  low_voltage_nm: 500         # 500nm for <5V
  medium_voltage_nm: 1000     # 1µm for 5-15V
  high_voltage_nm: 5000       # 5µm for >15V
  safety_factor: 1.5

layer:
  min_thickness_nm: 100       # 100nm minimum metal thickness
  max_thickness_nm: 0         # unlimited
  allowed_conductors:
    - copper
    - aluminum
    - gold
  allowed_dielectrics:
    - silicon_dioxide
    - air
