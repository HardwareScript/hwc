# Prototype/Hobbyist PCB Fabrication Constraints
# Relaxed constraints for rapid prototyping and hobbyist projects
# Suitable for hand-soldering and low-volume production
#
# SOURCES:
# - KiCad forum discussions on hobbyist design rules
#   https://forum.kicad.info/t/design-rules-for-hand-solderable-layout/61592
# - Adafruit PCB design tutorial for beginners
#   https://learn.adafruit.com/pcb-design-tutorial
# - SparkFun PCB design guidelines
#   https://www.sparkfun.com/tutorials/115
#
# RATIONALE:
# - 10 mil (254µm) minimum is achievable with most hobbyist methods
# - 20 mil (508µm) default provides comfortable hand-soldering
# - Larger vias are easier to drill manually
# - Conservative clearances prevent beginner mistakes

profile Prototype:
    description: "Relaxed constraints for hobbyist projects and rapid prototyping"
    
    trace:
        min_width: 254µm
        min_spacing: 254µm
    
    via:
        min_diameter: 508µm
        min_annular_ring: 254µm
    
    clearance:
        high_voltage: 3.0mm
        safety_factor: 2.5
    
    layer:
        min_thickness: 35µm
