# Standard PCB Fabrication Constraints
# Based on IPC-2221 standards for general PCB manufacturing
#
# SOURCES:
# - IPC-2221A: Generic Standard on Printed Board Design
#   Available: https://shop.ipc.org/ipc-2221 (paid standard)
# - Reference values from: https://www.protoexpress.com/blog/ipc-2221-circuit-board-design/
# - Trace width calculations: https://philipmcgaw.com/ipc-2221-standard-trace-widths/
# - Clearance guidelines: https://resources.altium.com/p/using-an-ipc-2221-calculator-for-high-voltage-design/
#
# METHODOLOGY:
# IPC-2221 is the industry-standard specification for PCB design. Values below are
# extracted from Table 6-1 (conductor spacing) and related tables in the standard.
# These are widely published and used across the PCB manufacturing industry.
#
# VALIDATION:
# Cross-referenced with multiple PCB manufacturers:
# - JLCPCB capabilities: https://jlcpcb.com/capabilities/pcb-capabilities
# - PCBWay capabilities: https://www.pcbway.com/capabilities.html
# - OSH Park capabilities: https://docs.oshpark.com/services/
#
# Last verified: March 2026

name: "Standard PCB"
description: "IPC-2221 compliant constraints for standard PCB fabrication"

trace:
  min_width_nm: 152400        # 6 mil = 152.4µm
  max_width_nm: 0             # unlimited
  min_spacing_nm: 152400      # 6 mil = 152.4µm
  default_width_nm: 254000    # 10 mil = 254µm

via:
  min_diameter_nm: 304800     # 12 mil = 304.8µm
  max_diameter_nm: 0          # unlimited
  min_annular_ring_nm: 127000 # 5 mil = 127µm
  default_diameter_nm: 508000 # 20 mil = 508µm

clearance:
  low_voltage_nm: 200000      # 200µm for <50V
  medium_voltage_nm: 500000   # 500µm for 50-150V
  high_voltage_nm: 2000000    # 2mm for >150V
  safety_factor: 2.0

layer:
  min_thickness_nm: 35000     # 35µm (1oz copper)
  max_thickness_nm: 0         # unlimited
  allowed_conductors:
    - copper
    - gold
    - aluminum
  allowed_dielectrics:
    - fr4
    - polyimide
    - air
