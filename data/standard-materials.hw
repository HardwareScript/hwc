# Hardware Script Standard Materials Library
# Version: 0.1.4
# Last Updated: March 20, 2026
#
# Data Sources:
# - Materials Project API (https://materialsproject.org/)
# - IPC Standards (IPC-2221, IPC-4101)
# - NIST Chemistry WebBook
# - Engineering Toolbox (engineeringtoolbox.com)
#
# All values use official SI notation (NIST/BIPM standards)
# - Resistivity: Ω·m (ohm-meter with center dot)
# - Thermal conductivity: W/(m·K) (preferred) or W/mK (acceptable)
# - Density: kg/m³ (with superscript)
# - Current density: A/mm² (with superscript)
# - Temperature: °C (with degree symbol)

# ============================================================================
# CONDUCTORS
# ============================================================================

material Copper:
    category: conductor
    symbol: "Cu"
    description: "Universal PCB trace material, most common conductor"
    
    properties:
        # Source: Materials Project API (mp-1056079)
        density: 8960kg/m³
        resistivity: 1.68e-8Ω·m
        thermal_conductivity: 401W/mK
        
        # Source: IPC-2221 standard for external traces
        max_current_density: 35A/mm²
        
        # Source: NIST Chemistry WebBook
        melting_point: 1085C
        
        # Temperature coefficients (Source: NIST)
        resistivity_temp_coeff: 0.00429
        thermal_conductivity_temp_coeff: -0.0008
        reference_temp: 20C
        
        # Visual
        color: "#B87333"

material Aluminum:
    category: conductor
    symbol: "Al"
    description: "Chip-level routing, heat sinks, lightweight conductor"
    
    properties:
        # Source: Materials Project API
        density: 2533kg/m³
        resistivity: 2.82e-8Ω·m
        thermal_conductivity: 237W/mK
        
        # Source: IPC-2221 (lower than copper due to higher resistivity)
        max_current_density: 20A/mm²
        
        # Source: NIST Chemistry WebBook
        melting_point: 660C
        
        # Temperature coefficients (Source: NIST)
        resistivity_temp_coeff: 0.0038
        thermal_conductivity_temp_coeff: -0.0007
        reference_temp: 20C
        
        # Visual
        color: "#C0C0C0"

material Gold:
    category: conductor
    symbol: "Au"
    description: "Contact pads, wire bonding, corrosion-resistant connections"
    
    properties:
        # Source: Materials Project API
        density: 16731kg/m³
        resistivity: 2.44e-8Ω·m
        thermal_conductivity: 318W/mK
        
        # Source: Wire bonding industry standards
        max_current_density: 30A/mm²
        
        # Source: NIST Chemistry WebBook
        melting_point: 1064C
        
        # Temperature coefficients (Source: NIST)
        resistivity_temp_coeff: 0.0034
        thermal_conductivity_temp_coeff: -0.0006
        reference_temp: 20C
        
        # Visual
        color: "#FFD700"

# ============================================================================
# INSULATORS / DIELECTRICS
# ============================================================================

material FR4:
    category: insulator
    symbol: "FR4"
    description: "Standard PCB substrate material (flame retardant fiberglass)"
    
    properties:
        # Source: IPC-4101 specification
        density: 1850kg/m³
        thermal_conductivity: 0.3W/mK
        
        # Electrical properties (Source: IPC-4101)
        relative_permittivity: 4.5
        dielectric_strength: 20000V/m
        
        # Thermal limits (Source: IPC-4101)
        glass_transition_temp: 130C
        max_operating_temp: 130C
        
        # Temperature coefficients (Source: IPC-4101)
        thermal_conductivity_temp_coeff: 0.001
        reference_temp: 25C
        
        # Visual
        color: "#2E7D32"

material Air:
    category: insulator
    symbol: "Air"
    description: "Ambient environment, lowest dielectric constant"
    
    properties:
        # Source: NIST (at sea level, 20°C)
        density: 1.225kg/m³
        thermal_conductivity: 0.026W/mK
        
        # Electrical properties (Source: NIST)
        relative_permittivity: 1.00059
        dielectric_strength: 3000V/m
        
        # Visual (transparent)
        color: "#00000000"

material silicon_dioxide:
    category: insulator
    symbol: "SiO2"
    description: "Microchip insulator, glass substrate for ICs"
    
    properties:
        # Source: Materials Project API
        density: 2082kg/m³
        thermal_conductivity: 1.4W/mK
        
        # Electrical properties (Source: Semiconductor industry standards)
        relative_permittivity: 3.9
        dielectric_strength: 10000V/m
        
        # Visual
        color: "#F0F0F0"

# ============================================================================
# SEMICONDUCTORS
# ============================================================================

material Silicon:
    category: semiconductor
    symbol: "Si"
    description: "Primary semiconductor material for transistors and ICs"
    
    properties:
        # Source: Materials Project API
        density: 2600kg/m³
        thermal_conductivity: 150W/mK
        
        # Electrical properties (Source: Semiconductor Physics textbooks)
        band_gap: 1.12eV
        electron_mobility: 1400cm2/Vs
        hole_mobility: 450cm2/Vs
        
        # Thermal limits
        max_operating_temp: 150C
        
        # Visual
        color: "#808080"

# ============================================================================
# NOTES
# ============================================================================
#
# Temperature Coefficients:
# - Copper resistivity: +0.429%/°C (at 20°C reference)
# - Aluminum resistivity: +0.38%/°C (at 20°C reference)
# - Gold resistivity: +0.34%/°C (at 20°C reference)
#
# Current Density Standards (IPC-2221):
# - External traces (air cooling): 35 A/mm² for copper
# - Internal traces (board cooling): 25 A/mm² for copper
# - Values assume 10°C temperature rise
#
# Dielectric Strength:
# - Values are for breakdown voltage in uniform field
# - Actual clearance requirements include safety factors
# - See IPC-2221 for voltage-dependent clearances
#
