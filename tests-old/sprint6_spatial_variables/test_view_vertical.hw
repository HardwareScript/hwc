# v0.1.6: Vertical Orientation (Standing Card)
# Explicitly set to 'vertical_standing' perspective.

space StandingCard:
    render:
        view: vertical_standing
    
    dimensions: 100mm by 100mm by 1.6mm
    grid: 100 by 100 by 1
    origin: bl by b

    add Chip named Connector at [x: 50mm, y: 5mm, z: 0]

component Chip:
    pins: [vcc, gnd]
    layout:
        shape: Rectangle(10mm, 10mm, 1mm)
    render:
        body_color: "#B87333" # Copper-like color
