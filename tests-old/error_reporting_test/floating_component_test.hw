## ============================================================================
## FLOATING COMPONENT TEST
## ============================================================================
##
## This file tests the P44 (Floating Component) error reporting.
## Component is placed at z:4, but substrate ends at z:2.

import * from @std/primitives/units
import Copper from @std/materials/conductors
import FR4 from @std/materials/insulators

## ============================================================================
## COMPONENT DEFINITION
## ============================================================================

component SimplePad:
    pins: [terminal]
    
    layout:
        shape: Rectangle(2mm, 2mm, 200um)
        
        add pour(Copper) named Pad on z:2:
            boundary: [x: 200um, y: 200um] to [x: 1800um, y: 1800um]
            device: terminal
        
        pin_positions:
            terminal at [1000um, 1000um]
    
    render:
        type: procedural
        shape: box
        body_color: "#FFD700"

## ============================================================================
## LOGICAL SCHEMATIC
## ============================================================================

module SimpleCircuit:
    pins: [
        power VDD
    ]
    
    add SimplePad named PAD1
    route PAD1.terminal to VDD

## ============================================================================
## PHYSICAL LAYOUT (WITH FLOATING COMPONENT ERROR)
## ============================================================================

space SimpleCircuitLayout implements SimpleCircuit:
    dimensions: 10mm by 10mm by 2mm
    grid: 10000 by 10000 by 20
    origin: tl by t
    
    nets:
        VDD: power
    
    ## Substrate ends at z:2
    add substrate(FR4) spanning [x:1um, y:1um, z:0] to [x:9999um, y:9999um, z:2]
    
    ## ERROR: Component placed at z:4 (floating above substrate which ends at z:2)
    ## This should trigger P44: Floating Component at the Commit Gate
    add SimplePad named PAD1 at [x: 4mm, y: 4mm, z: 4]:
        net: [terminal: VDD]
