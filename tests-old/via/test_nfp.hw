import * from @std/primitives/units
import FR4 from @std/materials/insulators

material ViaCopper:
    category: conductor
    process: drilled_plated
    properties:
        color: "#B87333"
        resistivity: 1.68e-8Ω·m

profile NFP_Test_Profile:
    stackup:
        top:    [material: ViaCopper, thickness: 35um]
        d1:     [material: FR4,       thickness: 200um]
        inner1: [material: ViaCopper, thickness: 35um]
        core:   [material: FR4,       thickness: 1060um]
        inner2: [material: ViaCopper, thickness: 35um]
        d2:     [material: FR4,       thickness: 200um]
        bottom: [material: ViaCopper, thickness: 35um]
    
    via:
        min_diameter: 0.1mm
        min_enclosure: 0.05mm
        min_spacing: 0.15mm

    trace:
        min_width: 0.1mm
        min_spacing: 0.1mm

    manufacturing:
        copper_thickness: 35um
        ipc2221_k_external: 0.048
        ipc2221_k_internal: 0.024
    
    clearance:
        high_voltage: 2mm
        safety_factor: 2.0
        
    layer:
        min_thickness: 0.1mm

module NFP_Test_Module:
    pins: [SIG]

space NFP_Test_Board implements NFP_Test_Module:
    dimensions: 10mm by 10mm by 1.6mm
    grid: 100 by 100 by 32
    origin: bl by b
    profile: NFP_Test_Profile

    # Ground plane on inner1 (different net than via)
    add pour(ViaCopper) named Inner1_GND on layer: inner1:
        boundary: [x: 1.0mm, y: 1.0mm] to [x: 9.0mm, y: 9.0mm]
        net: GND
        merge: true

    # Signal plane on inner2 (same net as via)
    add pour(ViaCopper) named Inner2_SIG on layer: inner2:
        boundary: [x: 1.0mm, y: 1.0mm] to [x: 9.0mm, y: 9.0mm]
        net: SIG
        merge: true

    # PTH Via: Connects Top to Bottom, passes through inner1 and inner2
    # - On inner1 (GND plane, different net): NFP - no pad, just barrel through antipad
    # - On inner2 (SIG plane, same net): pad exists (annular ring)
    add contact(ViaCopper) named NFP_Via at [x: 5mm, y: 5mm] spanning layer: bottom to top:
        net: SIG
        drill_diameter: 0.3mm
        plating_thickness: 25um
        enclosure: 0.1mm
        top_cap: annular
        bottom_cap: annular
