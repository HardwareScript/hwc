## Error Handling Test: No Components Placed Yet
## This test tries to use relative positioning when no components exist
##
## Expected behavior:
## - Build should FAIL with nonexistent anchor error
## - Error should explain that no components have been placed yet
## - Error should suggest using absolute positioning for the first component
##
## Error: Trying to use relative positioning before any components exist

import * from @std/primitives/units

material Copper:
    category: conductor
    properties:
        resistivity: 1.68e-8Ω·m
        color: "#B87333"

material FR4:
    category: insulator
    properties:
        resistivity: 1e16Ω·m
        color: "#2E7D32"

component SimpleResistor:
    pins: [A, B]
    
    layout:
        shape: Rectangle(2mm, 1mm, 0.5mm)
        pin_positions:
            A at [0mm, 0.5mm, 0.25mm]
            B at [2mm, 0.5mm, 0.25mm]
    
    electrical:
        resistance: 1kΩ
    
    metadata:
        component_type: "Resistor"
        value: "1kΩ"
    
    render:
        type: procedural
        shape: box
        body_color: "#B87333"

space NoComponentsPlacedTest:
    dimensions: 20mm by 20mm by 2mm
    grid: 200 by 200 by 20
    origin: tl by t
    
    nets:
        VCC: power
    
    ## Base substrate
    add substrate(FR4) spanning [x:0.1mm, y:0.1mm, z:1] to [x:19.9mm, y:19.9mm, z:2]
    
    ## ========================================================================
    ## NO COMPONENTS ERROR TEST
    ## ========================================================================
    ## Try to place the FIRST component using relative positioning
    ## This should fail because there are no anchors available yet
    
    ## M1: Try to use relative positioning as the first component (ERROR!)
    ## Should say "No components have been placed yet"
    ## Should suggest "Use absolute positioning for the first component"
    add SimpleResistor named M1 at M2.right + 1mm
