# Manual Routing: Ring-to-Pad (Top Layer Only)
#
# One circular pad (Ring) and one rectangular pad, manually routed.
# No via barrel, no bottom rings — just top copper.

import * from @std/primitives/units
import Copper from @std/materials/conductors

profile RoutingTestProfile:
    stackup:
        top:    [material: Copper, thickness: 35um]
        core:   [material: FR4,    thickness: 1.5mm]
        bottom: [material: Copper, thickness: 35um]
    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm
    via:
        min_diameter: 0.3mm
        min_enclosure: 0.15mm
        min_spacing: 0.25mm
    manufacturing:
        copper_thickness: 35um
    clearance:
        high_voltage: 1.0mm
        safety_factor: 1.5
    layer:
        min_thickness: 35um

component RingPad:
    pins: [P]
    layout:
        shape: Rectangle(0.7mm, 0.7mm, 0.035mm)
        pin_positions:
            P at [0.35mm, 0.35mm, 0mm]
        add pour(Copper) named Ring on layer: self:
            device: P
            boundary: Circle([x: 0mm, y: 0mm], 0.35mm)

component RectPad:
    pins: [P]
    layout:
        shape: Rectangle(1.0mm, 0.5mm, 0.035mm)
        pin_positions:
            P at [0.5mm, 0.25mm, 0mm]
        add pour(Copper) named Pad on layer: self:
            device: P
            boundary: [x: -0.5mm, y: -0.25mm] to [x: 0.5mm, y: 0.25mm]

space RingToPadBoard:
    dimensions: 12mm by 6mm by 1.57mm
    grid: 120 by 60 by 16
    origin: bl by b
    profile: RoutingTestProfile

    # Ring at (2, 3)
    add RingPad named Ring_A at [x: 1.65mm, y: 2.65mm] on layer: top:
        merge: true

    # Pad at (8, 3)
    add RectPad named Pad_B at [x: 7.5mm, y: 2.75mm] on layer: top:
        merge: true

    # Manual route: center of Ring_A to center of Pad_B
    route Ring_A.P to Pad_B.P:
        path: [ [x: 2.0mm, y: 3.0mm, z: 1.535mm], [x: 8.0mm, y: 3.0mm, z: 1.535mm] ]
