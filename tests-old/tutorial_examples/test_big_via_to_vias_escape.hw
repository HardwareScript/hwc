# Test script for Big Via-to-Multiple-Via Port Escape Routing
# Fanout from a large plated through-hole via to smaller vias
# - Central large via (0.6mm drill, 0.3mm annular ring = 1.2mm outer)
# - 4 smaller vias at cardinal positions (0.3mm drill, 0.2mm ring)
# - Routes using exit/enter port specifications
#
# Validates large via fanout with mixed via sizes.

import * from @std/primitives/units
import Copper from @std/materials/conductors

profile BigViaProfile:
    stackup:
        top:    [material: Copper, thickness: 35um]
        core:   [material: FR4,    thickness: 1.5mm]
        bottom: [material: Copper, thickness: 35um]
    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm
    via:
        min_diameter: 0.3mm
        min_enclosure: 0.15mm
        min_spacing: 0.25mm
    manufacturing:
        copper_thickness: 35um
    clearance:
        high_voltage: 1.0mm
        safety_factor: 1.5
    layer:
        min_thickness: 35um

# Anchor Pin for vias
component Pin:
    pins: [P]
    layout:
        shape: Rectangle(0.1mm, 0.1mm, 0.035mm)
        pin_positions:
            P at [0.05mm, 0.05mm, 0mm]

space BigViaBoard:
    dimensions: 20mm by 20mm by 1.57mm
    grid: 200 by 200 by 16
    origin: bl by b
    profile: BigViaProfile

    # Central large via - 0.6mm drill, 0.3mm annular ring
    add contact(Copper) named BigVia at [x: 10mm, y: 10mm] spanning layer: top to bottom:
        net: NET_BIG_VIA
        drill_diameter: 0.6mm
        enclosure: 0.3mm
    add Pin named BigViaAnchor at [x: 10mm, y: 10mm] on layer: top:
        merge: true

    # Small via N - above center
    add contact(Copper) named ViaN at [x: 10mm, y: 14mm] spanning layer: top to bottom:
        net: NET_VIA_N
        drill_diameter: 0.3mm
        enclosure: 0.2mm
    add Pin named ViaNAnchor at [x: 10mm, y: 14mm] on layer: top:
        merge: true

    # Small via S - below center
    add contact(Copper) named ViaS at [x: 10mm, y: 4mm] spanning layer: top to bottom:
        net: NET_VIA_S
        drill_diameter: 0.3mm
        enclosure: 0.2mm
    add Pin named ViaSAnchor at [x: 10mm, y: 4mm] on layer: top:
        merge: true

    # Small via E - right of center
    add contact(Copper) named ViaE at [x: 15mm, y: 10mm] spanning layer: top to bottom:
        net: NET_VIA_E
        drill_diameter: 0.3mm
        enclosure: 0.2mm
    add Pin named ViaEAnchor at [x: 15mm, y: 10mm] on layer: top:
        merge: true

    # Small via W - left of center
    add contact(Copper) named ViaW at [x: 4mm, y: 10mm] spanning layer: top to bottom:
        net: NET_VIA_W
        drill_diameter: 0.3mm
        enclosure: 0.2mm
    add Pin named ViaWAnchor at [x: 4mm, y: 10mm] on layer: top:
        merge: true

    # Routes from big via to each small via
    route BigViaAnchor.P to ViaNAnchor.P:
        exit: North
        enter: South

    route BigViaAnchor.P to ViaSAnchor.P:
        exit: South
        enter: North

    route BigViaAnchor.P to ViaEAnchor.P:
        exit: East
        enter: West

    route BigViaAnchor.P to ViaWAnchor.P:
        exit: West
        enter: East
