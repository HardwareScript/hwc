# Test script for Pad-to-Pad AUTOMATIC routing using Adaptive Router
# Uses West and East origin points with automatic route connection

import * from @std/primitives/units
import Copper from @std/materials/conductors

profile AutoRouteProfile:
    stackup:
        top:    [material: Copper, thickness: 35um]
        core:   [material: FR4,    thickness: 1.5mm]
        bottom: [material: Copper, thickness: 35um]
    trace:
        min_width: 0.2mm
        min_spacing: 0.2mm
    via:
        min_diameter: 0.3mm
        min_enclosure: 0.15mm
        min_spacing: 0.25mm
    manufacturing:
        copper_thickness: 35um
    clearance:
        high_voltage: 1.0mm
        safety_factor: 1.5
    layer:
        min_thickness: 35um

component Pad:
    pins: [P]
    layout:
        shape: Rectangle(0.6mm, 0.6mm, 0.035mm)
        pin_positions:
            P at [0.3mm, 0.3mm, 0mm]
        add pour(Copper) named Pad on layer: self:
            device: P
            # FIXED: Centered relative to Pin P (0.3, 0.3)
            boundary: [x: -0.3mm, y: -0.3mm] to [x: 0.3mm, y: 0.3mm]

space AutoRouteBoard:
    dimensions: 12mm by 6mm by 1.57mm
    grid: 120 by 60 by 16
    origin: bl by b
    profile: AutoRouteProfile

    # West Origin Point - Left pad
    add Pad named West at [x: 2mm, y: 3mm] on layer: top:
        merge: true

    # East Origin Point - Right pad
    add Pad named East at [x: 8mm, y: 3mm] on layer: top:
        merge: true

    # Automatic route: Adaptive router connects West.P to East.P
    route West.P to East.P
