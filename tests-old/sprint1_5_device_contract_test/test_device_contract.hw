## Sprint 1.5: Device Contract Enforcement Test
## Tests that the compiler validates device materials against contracts
##
## This test demonstrates:
## 1. Valid NMOS with correct materials (should PASS)
## 2. Device contract validation from @std/foundry/transistors
##
## Expected behavior:
## - Compiler loads device contracts from @std/foundry/transistors
## - Validates each terminal's material against the contract
## - Provides detailed error messages showing expected vs found materials

import * from @std/primitives/units
import NMOS, PMOS from @std/foundry/transistors

## Define materials for this test with proper visual properties
material Polysilicon:
    category: conductor
    properties:
        resistivity: 1e-4Ω·m
        color: "#808080"
        opacity: 1.0
        outline_opacity: 0.0
        roughness: 0.7
        metallic: 0.3

material Silicon_N:
    category: semiconductor
    properties:
        resistivity: 1.0e-3Ω·m
        color: "#4A4A4A"
        opacity: 1.0
        outline_opacity: 0.0
        roughness: 0.7
        metallic: 0.3

material Silicon_P:
    category: semiconductor
    properties:
        resistivity: 2.0e-3Ω·m
        color: "#6A6A6A"
        opacity: 0.3
        outline_opacity: 0.8
        roughness: 0.7
        metallic: 0.3

## Module definition: Logical intent
module SimpleNMOS:
    pins: [
        input VIN,
        output VOUT,
        ground GND
    ]
    
    add NMOS named M1
    route M1.gate to VIN
    route M1.source to GND
    route M1.drain to VOUT
    route M1.bulk to GND

## Space definition: Physical implementation
## 
## SURFACE-TO-SURFACE MANDATE:
## - Pours occupy conductive layers (Layer 3, Layer 5)
## - Contacts occupy dielectric layers (Layer 4)
## - Connectivity through face-touching at Z-boundaries
## - Zero material interpenetration
space SimpleNMOS_Layout implements SimpleNMOS:
    dimensions: 1mm by 1mm by 1mm
    grid: 1000 by 1000 by 10
    origin: tl by t
    
    ## Substrate: P-type silicon base (Layers 1-2)
    add substrate(Silicon_P) spanning [x:1um, y:1um, z:1] to [x:999um, y:999um, z:2]
    
    ## ========================================================================
    ## LAYER 3: NMOS TRANSISTOR GEOMETRY (Conductive Layer)
    ## ========================================================================
    
    ## NMOS Gate (Polysilicon) - Center channel region
    add pour(Polysilicon) named M1_Gate on z:3:
        device: M1.gate
        net: VIN
        boundary: [x: 200um, y: 300um] to [x: 300um, y: 400um]
    
    ## NMOS Source (Silicon_N) - Below gate
    add pour(Silicon_N) named M1_Source on z:3:
        device: M1.source
        net: GND
        boundary: [x: 200um, y: 100um] to [x: 300um, y: 299um]
    
    ## NMOS Drain (Silicon_N) - Above gate  
    add pour(Silicon_N) named M1_Drain on z:3:
        device: M1.drain
        net: VOUT
        boundary: [x: 200um, y: 401um] to [x: 300um, y: 700um]
    
    ## NMOS Bulk (Silicon_P) - Left of source
    add pour(Silicon_P) named M1_Bulk on z:3:
        device: M1.bulk
        net: GND
        boundary: [x: 100um, y: 100um] to [x: 199um, y: 299um]
    
    ## ========================================================================
    ## LAYER 4: DIELECTRIC LAYER (Contact/Via Layer)
    ## ========================================================================
    ## Contacts live here - they occupy ONLY this layer
    ## Bottom face touches top of Layer 3, top face touches bottom of Layer 5
    
    ## ========================================================================
    ## LAYER 5: METAL INTERCONNECT (Conductive Layer)
    ## ========================================================================
    
    ## GND Metal rail connecting Source and Bulk
    add pour(Polysilicon) named GND_Metal on z:5:
        net: GND
        boundary: [x: 100um, y: 100um] to [x: 300um, y: 299um]
    
    ## ========================================================================
    ## VERTICAL INTERCONNECTS: Contacts on Layer 4 ONLY
    ## ========================================================================
    
    ## Via_Source: Connects M1_Source (Layer 3) to GND_Metal (Layer 5)
    ## Lives entirely on Layer 4 (dielectric layer)
    ## Position: Center of source region
    add contact(Polysilicon) named Via_Source net: GND at [x: 250um, y: 200um] spanning z:4 to z:4
    
    ## Via_Bulk: Connects M1_Bulk (Layer 3) to GND_Metal (Layer 5)
    ## Lives entirely on Layer 4 (dielectric layer)
    ## Position: Center of bulk region
    add contact(Polysilicon) named Via_Bulk net: GND at [x: 150um, y: 200um] spanning z:4 to z:4
