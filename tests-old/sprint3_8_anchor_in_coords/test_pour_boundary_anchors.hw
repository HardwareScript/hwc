## Sprint 3.8: Anchor References in Coordinate Expressions
## Test: Pour boundaries using anchor references
##
## This test verifies:
## 1. Pour boundary coordinates can use anchor references
## 2. Syntax: boundary: last.right + [x: 2mm, y: 0mm] to last.right + [x: 12mm, y: 10mm]
## 3. Both 'from' and 'to' coordinates can use anchor references
##
## Expected behavior:
## - Pour boundaries parse with anchor references
## - Pours are correctly positioned relative to anchors
## - No manual calculation required
##
## Use Case: Creating power distribution networks with automatic spacing

import * from @std/primitives/units
import Silicon_P from @std/materials/doped_semiconductors
import Copper from @std/materials/conductors

## ============================================================================
## SPACE: Test Pour Boundaries with Anchor References
## ============================================================================

space TestPourBoundaries:
    dimensions: 100mm by 30mm by 2mm
    grid: 100000 by 30000 by 2
    origin: tl by t
    
    ## Base substrate
    add substrate(Silicon_P) spanning [x:1um, y:1um, z:0] to [x:99999um, y:29999um, z:1]
    
    ## ========================================================================
    ## TEST 1: First pour with absolute coordinates (anchor)
    ## ========================================================================
    
    add pour(Copper) named Rail0 on z:1:
        boundary: [x:5mm, y:10mm] to [x:15mm, y:20mm]
        net: VDD
    
    ## Expected: (5mm, 10mm) to (15mm, 20mm)
    
    ## ========================================================================
    ## TEST 2: Pour boundary using anchor reference with offset vector
    ## Positioned 2mm to the right of Rail0
    ## ========================================================================
    
    add pour(Copper) named Rail1 on z:1:
        boundary: [x: Rail0.right + 2mm, y: 10mm] to [x: Rail0.right + 12mm, y: 20mm]
        net: VDD
    
    ## Expected: (15mm + 2mm, 10mm) to (15mm + 12mm, 20mm) = (17mm, 10mm) to (27mm, 20mm)
    
    ## ========================================================================
    ## TEST 3: Pour boundary using 'last' keyword
    ## Chained positioning for power distribution network
    ## ========================================================================
    
    add pour(Copper) named Rail2 on z:1:
        boundary: [x: last.right + 2mm, y: 10mm] to [x: last.right + 12mm, y: 20mm]
        net: VDD
    
    ## Expected: (27mm + 2mm, 10mm) to (27mm + 12mm, 20mm) = (29mm, 10mm) to (39mm, 20mm)
    
    ## ========================================================================
    ## TEST 4: Pour boundary with Y-axis anchor reference
    ## Positioned below the previous rail
    ## ========================================================================
    
    add pour(Copper) named Rail3 on z:1:
        boundary: [x: 5mm, y: Rail0.bottom - 8mm] to [x: 15mm, y: Rail0.bottom - 2mm]
        net: GND
    
    ## Expected: (5mm, 10mm - 8mm) to (15mm, 10mm - 2mm) = (5mm, 2mm) to (15mm, 8mm)
    
    ## ========================================================================
    ## TEST 5: Pour boundary with both coordinates using anchor references
    ## Complex positioning relative to multiple anchors
    ## ========================================================================
    
    add pour(Copper) named Rail4 on z:1:
        boundary: [x: Rail2.right + 2mm, y: Rail3.top + 1mm] to [x: Rail2.right + 12mm, y: Rail3.top + 7mm]
        net: VDD
    
    ## Expected: 
    ## X: Rail2.right + 2mm = 39mm + 2mm = 41mm
    ## Y: Rail3.top + 1mm = 8mm + 1mm = 9mm
    ## To: (41mm + 10mm, 9mm + 6mm) = (51mm, 15mm)
