import * from @std/primitives/units

shape HexagonalVia:
    points:
        - [x: -100nm, y: 0nm]
        - [x: -50nm, y: 87nm]
        - [x: 50nm, y: 87nm]
        - [x: 100nm, y: 0nm]
        - [x: 50nm, y: -87nm]
        - [x: -50nm, y: -87nm]

shape SquareVia(width: Measurement):
    points:
        - [x: -width / 2, y: -width / 2]
        - [x: width / 2, y: -width / 2]
        - [x: width / 2, y: width / 2]
        - [x: -width / 2, y: width / 2]

profile HEXAGONAL_TEST:
    description: "Test profile using custom hexagonal via shape"
    
    trace:
        min_width: 100nm
        min_spacing: 100nm
    
    via:
        min_diameter: 200nm
        min_enclosure: 50nm
        shape: HexagonalVia
    
    manufacturing:
        grid_snapping: true
        track_pitch: 200nm
        copper_thickness: 500nm
    
    clearance:
        high_voltage: 500nm
        safety_factor: 1.5
    
    layer:
        min_thickness: 500nm
    
    stackup:
        m1: [material: Copper, thickness: 500nm]
        d1: [material: SiO2,   thickness: 1um]
        m2: [material: Copper, thickness: 500nm]
        d2: [material: SiO2,   thickness: 1um]
        m3: [material: Copper, thickness: 500nm]
        d3: [material: SiO2,   thickness: 1um]
        m4: [material: Copper, thickness: 500nm]
        si: [material: Silicon, thickness: 10um]

    routing:
        m1: horizontal
        m2: vertical
        m3: horizontal
        m4: vertical

component Pad:
    pins: [p]
    layout:
        shape: Rectangle(1um, 1um, 500nm)
        pin_positions:
            p at [0.5um, 0.5um]
        pad_shapes:
            p: Rectangle(1um, 1um)

space HEXAGONAL_Space:
    profile: HEXAGONAL_TEST
    dimensions: 100um by 100um by 20um
    grid: 100 by 100 by 20
    origin: bl by b
    
    add Pad named P1 at [x: 10um, y: 10um, z: 0nm]
    add Pad named P2 at [x: 50um, y: 50um, z: 4500nm]
    
    route P1.p to P2.p:
        path:
            - [x: 10um, y: 10um, z: 0nm]
            - [x: 20um, y: 10um, z: 0nm]
            - [x: 20um, y: 10um, z: 1500nm]
            - [x: 20um, y: 30um, z: 1500nm]
            - [x: 20um, y: 30um, z: 3000nm]
            - [x: 40um, y: 30um, z: 3000nm]
            - [x: 40um, y: 30um, z: 4500nm]
            - [x: 40um, y: 50um, z: 4500nm]
            - [x: 50um, y: 50um, z: 4500nm]
