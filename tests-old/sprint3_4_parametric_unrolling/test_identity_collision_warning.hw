## Test: Identity Collision Warning (The Black Box Check)
## 
## This test demonstrates the identity collision detection system that warns
## when different loop iterations produce the same net name due to:
## - Integer division truncation
## - Modulo operations
## - Other mathematical operations that map multiple inputs to the same output
##
## Expected behavior: Compiler warns but continues (informational warning)

import * from @std/primitives/units
import Silicon_P from @std/materials/doped_semiconductors
import Copper from @std/materials/conductors

## ============================================================================
## SPACE: Identity Collision Test
## ============================================================================

space IdentityCollisionTest:
    dimensions: 100mm by 20mm by 2mm
    grid: 100000 by 20000 by 2
    origin: tl by t
    
    ## Base substrate
    add substrate(Silicon_P) spanning [x:1um, y:1um, z:0] to [x:99999um, y:19999um, z:1]
    
    ## ========================================================================
    ## TEST 1: Integer Division Truncation
    ## i/2 with i=0,1 both produce 0
    ## i/2 with i=2,3 both produce 1
    ## EXPECTED WARNING: Collision[0] appears in iterations [0, 1]
    ##                   Collision[1] appears in iterations [2, 3]
    ## ========================================================================
    for i in 0..3:
        add pour(Copper) named Test1_i on z:1:
            net: Collision[i / 2]
            boundary: [x: i * 10mm + 1mm, y: 2mm] to [x: i * 10mm + 8mm, y: 4mm]
    
    ## ========================================================================
    ## TEST 2: Another Division Pattern
    ## (i + 1) / 3 produces: 0,0,1,1,1,2
    ## EXPECTED WARNING: Div2[0] appears in iterations [0, 1]
    ##                   Div2[1] appears in iterations [2, 3, 4]
    ## ========================================================================
    for i in 0..5:
        add pour(Copper) named Test2_i on z:1:
            net: Div2[(i + 1) / 3]
            boundary: [x: i * 10mm + 1mm, y: 6mm] to [x: i * 10mm + 8mm, y: 8mm]
    
    ## ========================================================================
    ## TEST 3: Intentional Net Sharing (No collision - this is correct!)
    ## All pours connected to the same net (VDD rail)
    ## EXPECTED WARNING: VDD appears in iterations [0, 1, 2, 3]
    ## This is intentional and correct - just informational
    ## ========================================================================
    for i in 0..3:
        add pour(Copper) named VDD_Rail_i on z:1:
            net: VDD
            boundary: [x: i * 10mm + 1mm, y: 10mm] to [x: i * 10mm + 8mm, y: 12mm]
