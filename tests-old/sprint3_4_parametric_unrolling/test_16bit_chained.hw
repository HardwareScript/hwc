## Sprint 3.4: Parametric Unrolling - 16-bit with Chained Positioning (DEBUG)
## Test: 16-bit adder using `last` keyword for automatic spacing
##
## This is a smaller version of test_64bit_chained.hw for debugging GAP1
## (Coordinate Inheritance Failure)
##
## Expected behavior:
## - Components should stay in straight rows (Y coordinate inherited)
## - Each row should have consistent Y values
## - X should increment by (8mm + 2mm) = 10mm per component

import * from @std/primitives/units
import Silicon_P from @std/materials/doped_semiconductors

## ============================================================================
## COMPONENT DEFINITION: Simple Adder Block
## ============================================================================

component Adder:
    pins: [a, b, carry_in, sum, carry_out]
    
    layout:
        shape: Rectangle(8mm, 4mm, 0.5mm)
    
    metadata:
        component_type: "1-bit Adder"
        description: "Single bit full adder for 16-bit processor"
    
    render:
        type: procedural
        shape: box
        body_color: "#4CAF50"

## ============================================================================
## SPACE: 16-bit Adder with Chained Positioning (DEBUG VERSION)
## ============================================================================

space Test16BitChained:
    dimensions: 200mm by 20mm by 4mm
    grid: 200000 by 20000 by 4
    origin: tl by t
    
    ## Base substrate
    add substrate(Silicon_P) spanning [x:1um, y:1um, z:0] to [x:199999um, y:19999um, z:2]
    
    ## ========================================================================
    ## 16-BIT ADDER: Using `last` keyword for automatic chaining
    ## 
    ## Layout: 2 rows × 8 columns = 16 adders
    ## - Each adder: 8mm × 4mm
    ## - Spacing: 2mm between components
    ## - Total width per row: 8 × (8mm + 2mm) = 80mm
    ## 
    ## GAP1 TEST: All components in a row should have the SAME Y coordinate
    ## ========================================================================
    
    ## Row 0: Bits 0-7 (first component needs absolute position)
    add Adder named Adder[0] at [x: 5mm, y: 5mm, z: 1]
    for i in 1..7:
        add Adder named Adder[i] at last.right + 2mm
    
    ## Row 1: Bits 8-15
    add Adder named Adder[8] at [x: 5mm, y: 10mm, z: 1]
    for i in 9..15:
        add Adder named Adder[i] at last.right + 2mm
