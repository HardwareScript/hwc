## Test circular dependency detection in spatial positioning
## M1 depends on M2, and M2 depends on M1
## v0.1.6 Gap 7: Spatial Topological Sorting

import * from @std/primitives/units
import Silicon_P from @std/materials/doped_semiconductors

component NMOS:
    pins: [gate]
    layout:
        shape: Rectangle(10um, 10um, 1um)
        pin_positions:
            gate at [5um, 5um]

space CircularDep:
    dimensions: 100um by 100um by 2um
    grid: 1000 by 1000 by 2
    origin: tl by t

    ## Base substrate
    add substrate(Silicon_P) spanning [x:0um, y:0um, z:0] to [x:100um, y:100um, z:1]

    ## Circular dependency: M1 -> M2 -> M1
    add NMOS named M1 at [x: M2.right + 2um, y: 10um, z: 2]
    add NMOS named M2 at [x: M1.right + 2um, y: 10um, z: 2]
