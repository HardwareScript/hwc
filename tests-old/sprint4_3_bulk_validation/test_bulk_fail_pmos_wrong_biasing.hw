## ============================================================================
## Task 4.3: Bulk Connection Validation - FAIL Case (PMOS Wrong Biasing)
## ============================================================================
##
## This test verifies that bulk validation FAILS when PMOS bulk is connected
## to the wrong power rail (GND instead of VDD).
##
## Expected: ❌ Invalid bulk biasing for PMOS 'M1'
##           Bulk connected to 'GND', expected 'VDD'

import * from @std/primitives/units
import * from @std/foundry/transistors
import * from @std/materials/doped_semiconductors

## ============================================================================
## Logical Schematic (Module)
## ============================================================================

module PmosWrongBulk:
    pins: [
        input VIN,
        output VOUT,
        power VDD,
        ground GND
    ]
    
    ## PMOS with WRONG bulk connection (connected to GND instead of VDD)
    add PMOS named M1
    route M1.gate to VIN
    route M1.source to VDD
    route M1.drain to VOUT
    route M1.bulk to GND  # ❌ WRONG: PMOS bulk should be VDD, not GND!

## ============================================================================
## Physical Layout (Space)
## ============================================================================

space PmosWrongBulkLayout implements PmosWrongBulk:
    dimensions: 2mm by 2mm by 1mm
    grid: 20 by 20 by 10
    
    ## Net classifications (required for physics-driven bulk validation)
    net_classifications:
        VDD: power
        GND: ground
        VIN: signal
        VOUT: signal
    
    ## ========================================================================
    ## PMOS Transistor (M1) - Silicon layer
    ## ========================================================================
    
    add pour(Polysilicon) named M1_Gate on z:5:
        device: M1.gate
        net: VIN
        boundary: [x: 400um, y: 400um] to [x: 600um, y: 1200um]
    
    add pour(Silicon_P) named M1_Source on z:3:
        device: M1.source
        net: VDD
        boundary: [x: 400um, y: 200um] to [x: 600um, y: 400um]
    
    add pour(Silicon_P) named M1_Drain on z:3:
        device: M1.drain
        net: VOUT
        boundary: [x: 400um, y: 1200um] to [x: 600um, y: 1400um]
    
    ## ❌ WRONG: PMOS bulk (Silicon_N) connected to GND instead of VDD
    ## This violates physics: N-type bulk in PMOS must be at highest potential
    ## to prevent forward-biasing the source-bulk PN junction
    add pour(Silicon_N) named M1_Bulk on z:3:
        device: M1.bulk
        net: GND  # ❌ WRONG! Should be VDD
        boundary: [x: 200um, y: 700um] to [x: 400um, y: 900um]
