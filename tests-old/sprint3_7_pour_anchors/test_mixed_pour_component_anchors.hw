## Sprint 3.7: Pour Bounding Box Tracking - Mixed Pour and Component Anchors
## Test: Components and pours positioned relative to each other
##
## This test verifies:
## 1. Components can be positioned relative to pours
## 2. Pours can be positioned relative to components
## 3. 'last' keyword works across both pours and components
## 4. BoundingBoxTracker handles mixed entity types correctly
##
## Expected behavior:
## - Pour placed relative to component works
## - Component placed relative to pour works
## - 'last' resolves to the most recently placed entity (pour or component)
## - No type confusion or anchor resolution errors
##
## Use Case: Real-world PCB/IC layout with mixed components and pours

import * from @std/primitives/units
import Silicon_P from @std/materials/doped_semiconductors
import Copper from @std/materials/conductors

## ============================================================================
## COMPONENT DEFINITION: IC Package
## ============================================================================

component ICPackage:
    pins: [vdd, gnd, input, output]
    
    layout:
        shape: Rectangle(5mm, 5mm, 1mm)
        
        pin_positions:
            vdd at [2500um, 500um]
            gnd at [2500um, 4500um]
            input at [500um, 2500um]
            output at [4500um, 2500um]
    
    metadata:
        component_type: "IC Package"
        description: "Integrated circuit package"
    
    render:
        type: procedural
        shape: box
        body_color: "#000000"

## ============================================================================
## SPACE: Test Mixed Pour and Component Anchors
## ============================================================================

space TestMixedAnchors:
    dimensions: 60mm by 40mm by 2mm
    grid: 60000 by 40000 by 2
    origin: tl by t
    
    ## Base substrate
    add substrate(Silicon_P) spanning [x:1um, y:1um, z:0] to [x:59999um, y:39999um, z:1]
    
    ## ========================================================================
    ## MIXED PLACEMENT SEQUENCE:
    ## 
    ## 1. Component at absolute position
    ## 2. Pour relative to component (ground plane around IC)
    ## 3. Another component relative to pour
    ## 4. Another pour relative to last component
    ## 5. Final component using 'last' (should resolve to the last pour)
    ## ========================================================================
    
    ## 1. First IC at absolute position
    add ICPackage named IC1 at [x: 10mm, y: 10mm, z: 2]
    
    ## 2. Ground plane to the right of IC1 (calculated manually for now)
    ## TODO: Support anchor references in boundary coordinates (Item 13)
    add pour(Copper) named GroundPlane1 on z:1:
        boundary: [x:17mm, y:8mm] to [x:27mm, y:18mm]
        net: GND
    
    ## 3. Second IC to the right of the ground plane
    add ICPackage named IC2 at [x: 29mm, y: 8mm, z: 2]
    
    ## 4. Power plane above IC2
    add pour(Copper) named PowerPlane1 on z:1:
        boundary: [x:27mm, y:15mm] to [x:37mm, y:21mm]
        net: VDD
    
    ## 5. Third IC (calculated manually for now)
    add ICPackage named IC3 at [x: 39mm, y: 15mm, z: 2]
    
    ## ========================================================================
    ## VERIFICATION EXPECTATIONS:
    ## 
    ## IC1: (10mm, 10mm, z:1) with size (5mm, 5mm, 1mm)
    ##      bbox: (10mm, 10mm, z:1) to (15mm, 15mm, z:2)
    ## 
    ## GroundPlane1: IC1.right + (2mm, -2mm) to IC1.right + (12mm, 8mm)
    ##               = (15mm + 2mm, 10mm - 2mm) to (15mm + 12mm, 10mm + 8mm)
    ##               = (17mm, 8mm) to (27mm, 18mm)
    ## 
    ## IC2: GroundPlane1.right + (2mm, 0mm, 0)
    ##      = (27mm + 2mm, 8mm, z:1) = (29mm, 8mm, z:1)
    ##      bbox: (29mm, 8mm, z:1) to (34mm, 13mm, z:2)
    ## 
    ## PowerPlane1: IC2.top + (-2mm, 2mm) to IC2.top + (8mm, 8mm)
    ##              = (29mm - 2mm, 13mm + 2mm) to (29mm + 8mm, 13mm + 8mm)
    ##              = (27mm, 15mm) to (37mm, 21mm)
    ## 
    ## IC3: last.right + (2mm, 0mm, 0) where last = PowerPlane1
    ##      = (37mm + 2mm, 15mm, z:1) = (39mm, 15mm, z:1)
    ## ========================================================================
