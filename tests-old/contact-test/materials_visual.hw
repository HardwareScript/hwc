# Test Contact - Material Definitions with God-Tier Visual API (v0.1.6)
# Demonstrates the new PBR visual properties

# N-Doped Silicon (Electron-rich, for NMOS)
material Silicon_N:
    category: semiconductor
    properties:
        resistivity: 1.0e-3Ω·m
        thermal_conductivity: 148W/(m·K)
        density: 2329kg/m³
        melting_point: 1414C
        max_current_density: 1e6A/mm²
        color: "#4A4A4A"
        opacity: 1.0
        roughness: 0.7
        metallic: 0.3
        band_gap: 1.12eV
        doping_type: "n-type"
        doping_concentration: 1e16/cm³

# P-Doped Silicon (Hole-rich, for PMOS)
material Silicon_P:
    category: semiconductor
    properties:
        resistivity: 2.0e-3Ω·m
        thermal_conductivity: 148W/(m·K)
        density: 2329kg/m³
        melting_point: 1414C
        max_current_density: 1e6A/mm²
        color: "#6A6A6A"
        opacity: 1.0
        roughness: 0.7
        metallic: 0.3
        band_gap: 1.12eV
        doping_type: "p-type"
        doping_concentration: 1e16/cm³

# Silicon Dioxide (Gate Insulator) - GLASS APPEARANCE
material SiliconDioxide:
    category: insulator
    properties:
        resistivity: 1e16Ω·m
        thermal_conductivity: 1.4W/(m·K)
        density: 2200kg/m³
        melting_point: 1713C
        max_current_density: 0A/mm²
        color: "#E0F7FA"
        opacity: 0.15
        outline_opacity: 0.8
        roughness: 0.05
        metallic: 0.0
        dielectric_constant: 3.9

# Polysilicon (Gate Material) - MATTE SEMICONDUCTOR
material Polysilicon:
    category: conductor
    properties:
        resistivity: 1e-4Ω·m
        thermal_conductivity: 34W/(m·K)
        density: 2320kg/m³
        melting_point: 1414C
        max_current_density: 1e5A/mm²
        color: "#808080"
        opacity: 1.0
        outline_opacity: 0.0
        roughness: 0.7
        metallic: 0.3

# Aluminum (Metal Interconnect) - POLISHED METAL
material Aluminum:
    category: conductor
    properties:
        resistivity: 2.82e-8Ω·m
        thermal_conductivity: 237W/(m·K)
        density: 2700kg/m³
        melting_point: 660C
        max_current_density: 10A/mm²
        color: "#D1D5DB"
        opacity: 1.0
        outline_opacity: 0.0
        roughness: 0.2
        metallic: 1.0

# Tungsten (Via/Contact Fill Material) - SOLID PILLAR
material Tungsten:
    category: conductor
    properties:
        resistivity: 5.6e-8Ω·m
        thermal_conductivity: 173W/(m·K)
        density: 19250kg/m³
        melting_point: 3422C
        max_current_density: 50A/mm²
        color: "#505050"
        opacity: 1.0
        outline_opacity: 0.0
        roughness: 0.4
        metallic: 1.0
