    route TX10.P7 to RX10.P7
    route TX11.P0 to RX11.P0
    route TX11.P1 to RX11.P1
    route TX11.P2 to RX11.P2
    route TX11.P3 to RX11.P3
    route TX11.P4 to RX11.P4
    route TX11.P5 to RX11.P5
    route TX11.P6 to RX11.P6
    route TX11.P7 to RX11.P7
    route TX12.P0 to RX12.P0
    route TX12.P1 to RX12.P1
    route TX12.P2 to RX12.P2
    route TX12.P3 to RX12.P3
    route TX12.P4 to RX12.P4
    route TX12.P5 to RX12.P5
    route TX12.P6 to RX12.P6
    route TX12.P7 to RX12.P7
    route TX13.P0 to RX13.P0
    route TX13.P1 to RX13.P1
    route TX13.P2 to RX13.P2
    route TX13.P3 to RX13.P3
    route TX13.P4 to RX13.P4
